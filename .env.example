# VALEK ACADEMY – Vzorové proměnné prostředí
# Zkopírujte do .env pro lokální běh, nebo vložte do Vercel Dashboard -> Settings -> Environment Variables

# --- TinaCMS Cloud konfigurace (pro produkční /admin) ---
# TINA_CLIENT_ID=vas_tina_client_id
# TINA_TOKEN=vas_tina_read_write_token

# --- Lokální TinaCMS vývoj (pro offline editaci přes Tina CLI) ---
# TINA_PUBLIC_IS_LOCAL=true

# --- Resend API (pro automatické odesílání e-mailů o rezervaci) ---
# Získejte zdarma na https://resend.com (3 000 e-mailů měsíčně zdarma)
# RESEND_API_KEY=re_123456789abcdef
# RESEND_FROM_EMAIL="VALEK ACADEMY <info@valekacademy.cz>"
# RESEND_TO_ADMIN="info@valekacademy.cz"
