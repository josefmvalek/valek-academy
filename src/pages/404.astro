---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getHomePageData } from '../lib/data';

const page = await getHomePageData();
const navbar = page?.navbar || {};
const footer = page?.footer || {};
const contact = page?.contact || {};
---

<Layout
  title="404: Stránka nenalezena | VALEK ACADEMY"
  description="Stránka nebyla nalezena. Vraťte se na úvodní stránku VALEK ACADEMY nebo si prohlédněte rozvrh a ceník doučování angličtiny v Uherském Hradišti."
  canonical="https://valekacademy.cz/404"
>
  <Navbar
    navbar={navbar}
    contact={contact}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  <main class="flex-grow flex items-center justify-center py-20 px-4 sm:px-6 relative overflow-hidden">
    <!-- Decorative background glow elements -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-amber-200/40 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-10 w-72 h-72 bg-orange-200/30 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative max-w-2xl w-full text-center mx-auto z-10 bg-white/70 backdrop-blur-md border border-[#E8DCBF] rounded-3xl p-8 sm:p-12 shadow-xl shadow-amber-900/5">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100/80 border border-amber-300 text-amber-900 font-extrabold text-xs uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Chyba 404 • Stránka nenalezena
      </div>

      <!-- Watermark 404 -->
      <div class="text-7xl sm:text-8xl font-black text-amber-500/25 tracking-tighter leading-none mb-3 font-display select-none">
        404
      </div>

      <!-- Heading -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A190F] tracking-tight mb-4 font-display">
        Zabloudili jste? Žádný strach!
      </h1>

      <!-- Description -->
      <p class="text-base sm:text-lg text-[#5C473A] max-w-lg mx-auto mb-8 leading-relaxed font-sans">
        Stránka, kterou hledáte, se buď přestěhovala, nebo ještě nebyla vytvořena. Pan Válek vás bezpečně navede zpět do doučovny.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 mb-8">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm sm:text-base shadow-lg shadow-amber-500/25 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>🏠</span>
          <span>Zpět na úvodní stránku</span>
        </a>

        <a
          href="/rozvrh"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-[#FAF7F2] hover:bg-amber-50 text-[#2A190F] font-bold text-sm sm:text-base border border-[#E8DCBF] hover:border-amber-400 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>📅</span>
          <span>Rozvrh hodin</span>
        </a>

        <a
          href="/cenik"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-[#FAF7F2] hover:bg-amber-50 text-[#2A190F] font-bold text-sm sm:text-base border border-[#E8DCBF] hover:border-amber-400 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>💰</span>
          <span>Ceník & kalkulačka</span>
        </a>
      </div>

      <!-- Direct Contact Helpline -->
      <div class="pt-6 border-t border-[#E8DCBF]/60 text-xs sm:text-sm text-[#78716C] flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4">
        <span>Potřebujete s něčím poradit?</span>
        <a
          href="https://wa.me/420792372642"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-bold text-emerald-700 hover:text-emerald-800 transition-colors"
        >
          <span>💬</span>
          <span>Napsat na WhatsApp (+420 792 372 642)</span>
        </a>
      </div>
    </div>
  </main>

  <Footer
    footer={footer}
    contact={contact}
    email={contact.email}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />
</Layout>
