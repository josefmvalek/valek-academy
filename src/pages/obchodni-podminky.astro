---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import LegalContent from '../components/LegalContent.astro';
import VisualEditor from '../components/VisualEditor.astro';
import { getHomePageData, getLegalPageDataQuery } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getHomePageData();
const navbar = page?.navbar || {};
const footer = page?.footer || {};
const contact = page?.contact || {};

const queryResult = await getLegalPageDataQuery('terms.json');
const legal = queryResult.data?.legal || {};
const title = legal.title || "Všeobecné obchodní podmínky (VOP)";
const seoDescription = legal.seoDescription || "Všeobecné obchodní podmínky pro poskytování výuky a doučování angličtiny ve VALEK ACADEMY (Josef Válek, Uherské Hradiště).";
---

<Layout
  title={`${title} | VALEK ACADEMY`}
  description={seoDescription}
  canonical="https://valekacademy.cz/obchodni-podminky"
>
  <Navbar
    navbar={navbar}
    contact={contact}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  <TinaIsland name="terms" wrapper={islands.terms.wrapper} primary>
    <LegalContent legal={legal} type="terms" />
  </TinaIsland>

  <Footer
    footer={footer}
    contact={contact}
    email={contact.email}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />
  {import.meta.env.DEV && <VisualEditor />}
</Layout>
