---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import VisualEditor from '../components/VisualEditor.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import CenikContent from '../components/CenikContent.astro';
import { getHomePageData, getPricingPageDataQuery } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getHomePageData();
const navbar = page?.navbar || {};
const footer = page?.footer || {};
const contact = page?.contact || {};
const stickyCta = page?.stickyCta || {};
const whatsappWidget = page?.whatsappWidget || {};

const cenikQuery = await getPricingPageDataQuery();
const cenik = (cenikQuery.data as any)?.cenik || {};
const calculator = cenik?.calculator || page?.pricing?.calculator || {};

const seoTitle = cenik?.seo?.metaTitle || cenik?.title || "Podrobný ceník výuky angličtiny, balíčky slev & kalkulátor | VALEK ACADEMY Uherské Hradiště";
const seoDesc = cenik?.seo?.metaDescription || cenik?.header?.subtitle || "Kompletní ceník kurzů angličtiny pro děti i dospělé v Uherském Hradišti. 1. ukázková lekce 100% ZDARMA, slevy až 30 % za balíčky a frekvenci. Žádné platby předem.";
const canonical = cenik?.seo?.canonicalUrl || "https://valekacademy.cz/cenik";
---

<Layout
  title={seoTitle}
  description={seoDesc}
  canonical={canonical}
  faqItems={cenik?.faq?.items}
>
  <Navbar
    navbar={navbar}
    contact={contact}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  <main class="flex-grow w-full max-w-full min-w-0 overflow-x-hidden bg-gradient-to-b from-[#FAF7F2] via-[#FFFDF9] to-[#FAF7F2] py-8 sm:py-12 md:py-16">
    <TinaIsland name="cenik" wrapper={islands.cenik.wrapper} primary>
      <CenikContent
        cenik={cenik}
        calculator={calculator}
        phone={contact.phone?.replace('+', '')}
      />
    </TinaIsland>
  </main>

  {stickyCta.enabled !== false && (
    <MobileStickyCTA
      ctaLink="/rozvrh#kontakt"
      ctaText={stickyCta.text || "🎁 1. lekce 100% ZDARMA"}
      stickyCta={stickyCta}
    />
  )}
  {whatsappWidget.enabled !== false && (
    <WhatsAppFloating
      phone={whatsappWidget.phone || contact.phone?.replace('+', '')}
      message={whatsappWidget.message || "Dobrý den pane Válku, rád/a bych se zeptal/a na ceník a volná místa ve skupince na 1. lekci zdarma."}
      tooltipText={whatsappWidget.tooltipText || contact.whatsappText}
      badgeNotificationText={whatsappWidget.badgeNotificationText}
      contact={contact}
      whatsappWidget={whatsappWidget}
    />
  )}

  <Footer
    footer={footer}
    contact={contact}
    email={contact.email}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  {import.meta.env.DEV && <VisualEditor />}
</Layout>
