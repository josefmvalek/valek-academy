---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import LegalContent from '../components/LegalContent.astro';
import VisualEditor from '../components/VisualEditor.astro';
import { getHomePageData, getLegalPageDataQuery } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getHomePageData();
const navbar = page?.navbar || {};
const footer = page?.footer || {};
const contact = page?.contact || {};

const queryResult = await getLegalPageDataQuery('privacy.json');
const legal = queryResult.data?.legal || {};
const title = legal.title || "Zásady ochrany osobních údajů & používání cookies";
const seoDescription = legal.seoDescription || "Informace o zpracování osobních údajů a používání cookies dle GDPR a platné české legislativy pro VALEK ACADEMY (Josef Válek, Uherské Hradiště).";
---

<Layout
  title={`${title} | VALEK ACADEMY`}
  description={seoDescription}
  canonical="https://valekacademy.cz/ochrana-osobnich-udaju"
>
  <Navbar
    navbar={navbar}
    contact={contact}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  <TinaIsland name="privacy" wrapper={islands.privacy.wrapper} primary>
    <LegalContent legal={legal} type="privacy" />
  </TinaIsland>

  <Footer
    footer={footer}
    contact={contact}
    email={contact.email}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />
  {import.meta.env.DEV && <VisualEditor />}
</Layout>
