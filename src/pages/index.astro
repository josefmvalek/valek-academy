---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import VisualEditor from '../components/VisualEditor.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import PageContent from '../components/PageContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getHomePageDataQuery, getSchedulePageData } from '../lib/data';
import { islands } from '../lib/islands';

const queryResult = await getHomePageDataQuery();
const page = queryResult.data?.page || {};
const schedulePage = await getSchedulePageData();
const schedule = schedulePage?.schedule;
const hero = page.hero || {};
const contact = page.contact || {};
const stickyCta = page.stickyCta || {};
const seo = page.seo || {};
const whatsappWidget = page.whatsappWidget || {};
---

<Layout
  seo={seo}
  faqItems={page.faq?.items}
  title={seo.metaTitle || page.title || "VALEK ACADEMY | Angličtina pro děti v malých skupinkách s rodilým mluvčím"}
  description={seo.metaDescription || hero.subtitle || "VALEK ACADEMY: Výuka angličtiny v malých skupinkách hrou a deskovkami. Josef Válek vyrostl v Melbourne, žije 25+ let v ČR a učí s čistou výslovností rodilého mluvčího."}
>
  <TinaIsland name="page" wrapper={islands.page.wrapper} primary>
    <PageContent page={page} schedule={schedule} />
  </TinaIsland>

  {stickyCta.enabled !== false && <MobileStickyCTA ctaLink={stickyCta.link || "#kontakt"} ctaText={stickyCta.text} stickyCta={stickyCta} />}
  {whatsappWidget.enabled !== false && (
    <WhatsAppFloating
      phone={whatsappWidget.phone || contact.phone?.replace('+', '')}
      message={whatsappWidget.message || contact.whatsappMessage}
      tooltipText={whatsappWidget.tooltipText || contact.whatsappText}
      badgeNotificationText={whatsappWidget.badgeNotificationText}
      contact={contact}
      whatsappWidget={whatsappWidget}
    />
  )}
  {import.meta.env.DEV && <VisualEditor />}
</Layout>
