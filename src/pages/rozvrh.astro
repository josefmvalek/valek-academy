---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import VisualEditor from '../components/VisualEditor.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import RozvrhContent from '../components/RozvrhContent.astro';
import { getHomePageData, getSchedulePageDataQuery } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getHomePageData();
const navbar = page?.navbar || {};
const footer = page?.footer || {};
const contact = page?.contact || {};

const rozvrhQuery = await getSchedulePageDataQuery();
const rozvrh = (rozvrhQuery.data as any)?.rozvrh || {};

const seoTitle = rozvrh?.seo?.metaTitle || rozvrh?.title || "Rozvrh hodin & rezervace zvířecí skupinky | VALEK ACADEMY Uherské Hradiště";
const seoDesc = rozvrh?.seo?.metaDescription || "Kompletní týdenní rozvrh 15 zvířecích skupin výuky angličtiny hrou v Uherském Hradišti. 1.–3. třída, 4.–6. třída, 7.–13. třída i dospělí. Rezervace 1. lekce zdarma.";
const canonical = rozvrh?.seo?.canonicalUrl || "https://valekacademy.cz/rozvrh";
---

<Layout
  title={seoTitle}
  description={seoDesc}
  canonical={canonical}
>
  <Navbar
    navbar={navbar}
    contact={contact}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  <main class="flex-grow w-full max-w-full min-w-0 bg-gradient-to-b from-[#FAF7F2] via-[#FFFDF9] to-[#FAF7F2]">
    <TinaIsland name="rozvrh" wrapper={islands.rozvrh.wrapper} primary>
      <RozvrhContent
        rozvrh={rozvrh}
        contact={contact}
      />
    </TinaIsland>
  </main>

  <MobileStickyCTA ctaLink="#kontakt" ctaText="🎁 1. lekce 100% ZDARMA" />
  <WhatsAppFloating
    phone={contact.phone?.replace('+', '')}
    message="Dobrý den pane Válku, prohlížím si váš rozvrh hodin a rád/a bych se zeptal/a na volná místa ve zvířecí skupince na 1. lekci zdarma."
    tooltipText={contact.whatsappText}
    contact={contact}
  />

  <Footer
    footer={footer}
    contact={contact}
    email={contact.email}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  {import.meta.env.DEV && <VisualEditor />}
</Layout>
