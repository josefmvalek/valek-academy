---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import ScheduleBlocks from '../components/ScheduleBlocks.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactInfoCard from '../components/ContactInfoCard.astro';
import VisualEditor from '../components/VisualEditor.astro';
import { getHomePageData } from '../lib/data';

const page = await getHomePageData();
const navbar = page?.navbar || {};
const footer = page?.footer || {};
const contact = page?.contact || {};
const schedule = page?.schedule || {};

const seoTitle = "Rozvrh hodin & rezervace zvířecí skupinky | VALEK ACADEMY Uherské Hradiště";
const seoDesc = "Kompletní týdenní rozvrh 15 zvířecích skupin výuky angličtiny hrou v Uherském Hradišti. 1.–3. třída, 4.–6. třída, 7.–13. třída i dospělí. Rezervace 1. lekce zdarma.";
---

<Layout
  title={seoTitle}
  description={seoDesc}
  canonical="https://valekacademy.cz/rozvrh"
>
  <Navbar
    navbar={navbar}
    contact={contact}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  <main class="flex-grow w-full max-w-full min-w-0 bg-gradient-to-b from-[#FAF7F2] via-[#FFFDF9] to-[#FAF7F2]">
    
    <!-- Top Breadcrumb Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-stone-600 hover:text-amber-900 transition-colors group">
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <span>Zpět na hlavní stránku</span>
      </a>
    </div>

    <!-- Main Schedule Component -->
    <ScheduleBlocks schedule={schedule} />

    <!-- Dedicated Reservation Section on the same page -->
    <section id="kontakt" class="py-12 sm:py-16 bg-white border-t border-parchment-300 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mx-auto text-center space-y-2 mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full vintage-ribbon text-xs font-black uppercase tracking-wider text-espresso-950">
            <span>📝</span>
            <span>OBJEDNÁNÍ & REZERVACE LEKCE</span>
          </div>
          <h2 class="font-heading font-black text-2xl sm:text-4xl text-espresso-950">
            Přihláška na 1. ukázkovou lekci ZDARMA
          </h2>
          <p class="text-xs sm:text-base text-espresso-800/80">
            Vybrali jste si skupinku v rozvrhu výše? Zde vyplňte krátký kontakt a Josef se vám ozve s potvrzením termínu.
          </p>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 items-start">
          <ContactForm contact={contact} />
          <ContactInfoCard contact={contact} />
        </div>

      </div>
    </section>

  </main>

  <WhatsAppFloating
    phone={contact.phone?.replace('+', '')}
    message="Dobrý den Josefe, prohlížím si váš rozvrh hodin a rád/a bych se zeptal/a na volná místa ve zvířecí skupince na 1. lekci zdarma."
    tooltipText={contact.whatsappText}
    contact={contact}
  />

  <Footer
    footer={footer}
    contact={contact}
    email={contact.email}
    phone={contact.phone}
    phoneFormatted={contact.phoneFormatted}
  />

  {import.meta.env.DEV && <VisualEditor />}
</Layout>
