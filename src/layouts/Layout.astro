---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
import { ClientRouter } from 'astro:transitions';
import fontPlusJakarta400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import fontPlusJakarta700 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  noindex?: boolean;
  faqItems?: Array<{ question?: string; answer?: string; [key: string]: any }>;
  seo?: {
    metaTitle?: string;
    metaDescription?: string;
    canonicalUrl?: string;
    ogImage?: string;
    keywords?: string;
  };
}

const {
  seo,
  faqItems,
  noindex = false,
  title = seo?.metaTitle || "Josef Válek | Angličtina hrou a bez stresu – pro děti i dospělé",
  description = seo?.metaDescription || "Výuka angličtiny a doučování přirozeně a hrou. Pan Válek vyrostl v Melbourne, žije 25+ let v ČR a učí s čistou výslovností rodilého mluvčího.",
  canonical = seo?.canonicalUrl || "https://valekacademy.cz/",
  ogImage = seo?.ogImage || "https://valekacademy.cz/images/og-valek-academy.jpg",
  keywords = seo?.keywords || "výuka angličtiny, doučování angličtiny, Uherské Hradiště, angličtina hrou, Josef Válek",
} = Astro.props;

// Ensure OpenGraph and Twitter card image is an absolute URL
const normalizedOgImage = ogImage.startsWith('http://') || ogImage.startsWith('https://')
  ? ogImage
  : `https://valekacademy.cz${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isSubpage = pathname !== '/';

let subpageName = "";
if (pathname === '/cenik') subpageName = "Podrobný ceník & kalkulátor slev";
else if (pathname === '/rozvrh') subpageName = "Rozvrh hodin & rezervace skupinky";
else if (pathname === '/galerie') subpageName = "Fotogalerie doučovny a her";
else if (pathname === '/blog') subpageName = "Rádce pro rodiče & Tipy z doučovny";
else if (pathname.startsWith('/blog/')) subpageName = title.split('|')[0].trim();
else if (pathname === '/obchodni-podminky') subpageName = "Všeobecné obchodní podmínky";
else if (pathname === '/ochrana-osobnich-udaju') subpageName = "Ochrana osobních údajů";

const hasFaq = Boolean(faqItems && faqItems.length > 0);
const isCoursePage = (pathname === '/' || pathname === '/rozvrh' || pathname === '/cenik') && !noindex;

const schemaGraph: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["EducationalOrganization", "LanguageSchool", "LocalBusiness"],
      "@id": "https://valekacademy.cz/#organization",
      "name": "VALEK ACADEMY",
      "legalName": "Josef Válek",
      "identifier": "72419563",
      "alternateName": [
        "VALEK ACADEMY Uherské Hradiště",
        "Doučování angličtiny Josef Válek",
        "Angličtina Uherské Hradiště"
      ],
      "description": "Trpělivá a hravá výuka angličtiny pro žáky ZŠ a studenty v malých skupinkách (4–8 dětí) formou deskových her v Uherském Hradišti. Lektor Josef Válek (BBA RMIT Melbourne, 25+ let v ČR).",
      "url": "https://valekacademy.cz",
      "sameAs": [
        "https://www.firmy.cz/detail/13271737-valek-academy-uherske-hradiste"
      ],
      "telephone": "+420792372642",
      "email": "info@valekacademy.cz",
      "image": "https://valekacademy.cz/images/og-valek-academy.jpg",
      "logo": "https://valekacademy.cz/images/valek-academy-logo.webp",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Růžová 1238",
        "addressLocality": "Uherské Hradiště",
        "postalCode": "686 01",
        "addressCountry": "CZ"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 49.0708,
        "longitude": 17.4665
      },
      "hasMap": "https://maps.google.com/?q=R%C5%AF%C5%BEov%C3%A1+1238,+686+01+Uhersk%C3%A9+Hradi%C5%A1t%C4%9B",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "19:00"
        }
      ],
      "priceRange": "320 Kč – 480 Kč",
      "currenciesAccepted": "CZK",
      "paymentAccepted": "Hotově, Bankovní převod",
      "areaServed": [
        "Uherské Hradiště",
        "Kunovice",
        "Staré Město",
        "Babice",
        "Jalubí",
        "Kněžpole",
        "Ostrožská Nová Ves",
        "Uherský Brod"
      ]
    },
    ...(hasFaq ? [
      {
        "@type": "FAQPage",
        "@id": `https://valekacademy.cz${pathname}#faq`,
        "mainEntity": faqItems!.map((item: any) => ({
          "@type": "Question",
          "name": item.question || "",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": (item.answer || "").replace(/<[^>]*>?/gm, "").trim()
          }
        }))
      }
    ] : []),
    ...(isCoursePage ? [
      {
        "@type": "Course",
        "@id": "https://valekacademy.cz/#course",
        "name": "Hravá angličtina pro žáky ZŠ v malých skupinkách",
        "description": "Výuka a doučování angličtiny pro děti hrou a deskovými hrami (Karak, Scrabble, Story Cubes) v malých skupinkách 4–8 dětí v Uherském Hradišti.",
        "provider": {
          "@type": "Organization",
          "name": "VALEK ACADEMY",
          "sameAs": "https://valekacademy.cz"
        },
        "offers": {
          "@type": "Offer",
          "price": "320",
          "priceCurrency": "CZK",
          "category": "Doučování angličtiny pro žáky ZŠ",
          "availability": "https://schema.org/InStock"
        }
      }
    ] : []),
    ...(pathname.startsWith('/blog/') && !noindex ? [
      {
        "@type": "BlogPosting",
        "@id": `${canonical}#article`,
        "headline": title.split('|')[0].trim(),
        "description": description,
        "image": normalizedOgImage,
        "author": {
          "@type": "Person",
          "name": "Josef Válek",
          "url": "https://valekacademy.cz/#o-mne"
        },
        "publisher": {
          "@type": "Organization",
          "name": "VALEK ACADEMY",
          "logo": {
            "@type": "ImageObject",
            "url": "https://valekacademy.cz/images/valek-academy-logo.webp"
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonical
        }
      }
    ] : []),
    ...(isSubpage && !noindex ? [
      {
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        "itemListElement": pathname.startsWith('/blog/') && pathname !== '/blog' ? [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Domů",
            "item": "https://valekacademy.cz"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Rádce pro rodiče & Tipy",
            "item": "https://valekacademy.cz/blog"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": subpageName || title.split('|')[0].trim(),
            "item": canonical
          }
        ] : [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Domů",
            "item": "https://valekacademy.cz"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": subpageName || title,
            "item": canonical
          }
        ]
      }
    ] : [])
  ]
};
---

<!doctype html>
<html lang="cs" class="scroll-smooth overflow-x-clip w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload key self-hosted font weights for zero FOUT -->
    <link rel="preload" href={fontPlusJakarta400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontPlusJakarta700} as="font" type="font/woff2" crossorigin />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {noindex ? (
      <>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:image" content={normalizedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VALEK ACADEMY • Angličtina pro děti v malých skupinkách s rodilým mluvčím" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={normalizedOgImage} />

    <!-- Local SEO Geo Meta Tags -->
    <meta name="geo.region" content="CZ-ZL" />
    <meta name="geo.placename" content="Uherské Hradiště" />
    <meta name="geo.position" content="49.0708;17.4665" />
    <meta name="ICBM" content="49.0708, 17.4665" />

    <!-- Canonical Tag & XML Sitemap -->
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Astro v5 ClientRouter for seamless SPA navigation without flash -->
    <ClientRouter />

    <!-- Schema.org Structured Data (JSON-LD) for Local Business, Reviews, FAQ, Courses & Breadcrumbs -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph)}></script>
  </head>
  <body class="bg-[#FAF7F2] text-[#2A190F] antialiased selection:bg-amber-200 selection:text-[#2A190F] min-h-screen flex flex-col font-sans overflow-x-clip w-full max-w-full relative">
    <slot />
    <BackToTop />

    <!-- Dynamic Tab Title on Page Inactivity / Tab Switch -->
    <script is:inline>
      (function () {
        const truePageTitle = document.title;
        const awayTitle = "🎁 1. lekce angličtiny pro děti je zdarma – VALEK ACADEMY";
        let returnTimer = null;

        document.addEventListener("visibilitychange", function () {
          if (document.hidden) {
            document.title = awayTitle;
          } else {
            if (returnTimer) clearTimeout(returnTimer);
            document.title = "👋 Vítejte zpět! | VALEK ACADEMY";
            returnTimer = setTimeout(function () {
              document.title = truePageTitle;
            }, 2000);
          }
        });
      })();
    </script>

    <!-- Smooth Scroll-Driven Reveal Observer & Number Counters -->
    <script is:inline>
      (function () {
        const isInIframe = window.self !== window.top;
        if (isInIframe) {
          document.documentElement.classList.add('in-iframe');
          if (document.body) document.body.classList.add('in-iframe');
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function animateCounter(el) {
          const rawTarget = el.getAttribute('data-counter-target');
          if (!rawTarget) return;
          const target = parseFloat(rawTarget);
          if (isNaN(target)) return;

          const prefix = el.getAttribute('data-counter-prefix') || '';
          const suffix = el.getAttribute('data-counter-suffix') || '';
          const duration = parseInt(el.getAttribute('data-counter-duration') || '1200', 10);

          if (isInIframe || prefersReducedMotion) {
            el.textContent = `${prefix}${target}${suffix}`;
            return;
          }

          const startTime = performance.now();
          function updateCounter(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Ease out cubic
            const easeProgress = 1 - Math.pow(1 - progress, 3);
            const currentVal = Math.floor(easeProgress * target);
            el.textContent = `${prefix}${currentVal}${suffix}`;

            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              el.textContent = `${prefix}${target}${suffix}`;
            }
          }
          requestAnimationFrame(updateCounter);
        }

        function initScrollFeatures() {
          const revealSelector = '.reveal-on-scroll, .reveal-from-left, .reveal-from-right, .reveal-scale';
          
          if (isInIframe || prefersReducedMotion) {
            document.querySelectorAll(revealSelector).forEach(el => el.classList.add('is-visible'));
            document.querySelectorAll('[data-counter-target]').forEach(el => animateCounter(el));
            return;
          }

          const revealObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

          document.querySelectorAll(revealSelector).forEach(el => revealObserver.observe(el));

          const counterObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                animateCounter(entry.target);
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.2 });

          document.querySelectorAll('[data-counter-target]').forEach(el => counterObserver.observe(el));
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollFeatures);
        } else {
          initScrollFeatures();
        }
        document.addEventListener('astro:page-load', initScrollFeatures);

        // TinaCMS iframe auto-observer to ensure newly rendered elements stay visible
        if (isInIframe) {
          const makeVisible = () => {
            document.querySelectorAll('.reveal-on-scroll:not(.is-visible), .reveal-from-left:not(.is-visible), .reveal-from-right:not(.is-visible), .reveal-scale:not(.is-visible)').forEach(el => el.classList.add('is-visible'));
            document.querySelectorAll('[data-counter-target]').forEach(el => animateCounter(el));
          };
          makeVisible();
          const mutObserver = new MutationObserver(makeVisible);
          mutObserver.observe(document.documentElement, { childList: true, subtree: true });
        }
      })();
    </script>
  </body>
</html>
