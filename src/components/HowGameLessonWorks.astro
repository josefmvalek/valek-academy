---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface Props {
  className?: string;
  howItWorks?: {
    badge?: string;
    title?: string;
    subtitle?: string;
    quote?: string;
    gamesTitle?: string;
    gamesSubtitle?: string;
    phrasesLabel?: string;
    gameSpotlights?: any[];
    poster?: {
      tag?: string;
      title?: string;
      desc?: string;
      [key: string]: any;
    };
    bottomCta?: {
      title?: string;
      desc?: string;
      ctaText?: string;
      ctaLink?: string;
      [key: string]: any;
    };
    [key: string]: any;
  };
}

const { className = "", howItWorks = {} } = Astro.props;

const defaultGameSpotlights = [
  {
    icon: "🗺️",
    title: "Catan, doba kamenná & pohádkové dobrodružství",
    tag: "Strategie & Vyjednávání",
    badge: "1.–6. třída ZŠ",
    accent: "border-amber-400 bg-amber-50/60",
    desc: "Budování osad, těžba surovin a plánování tahů. Děti mezi sebou v angličtině vyjednávají obchody (dřevo za ovci), popisují strategii na mapě a házejí kostkou. Přirozená soutěživost a obrovský zápal!",
    phrases: ["I want to trade two sheep for one wood.", "I'll build a new road and a settlement here.", "It's my turn to roll the dice!"]
  },
  {
    icon: "🔤",
    title: "Scrabble & Slovní rébusy",
    tag: "Pravopis & Paměť bez biflování",
    badge: "Všechny věkové kategorie",
    accent: "border-emerald-400 bg-emerald-50/60",
    desc: "Z písmenkových kostek a karet skládáme nová slovíčka a křížovky. Děti si bleskově zapamatují pravopis a správnou stavbu anglických slov bez mechanického vypisování do sešitu.",
    phrases: ["How many points is the letter Z?", "Can I connect my word here?", "Triple word score!"]
  },
  {
    icon: "🎲",
    title: "Story Cubes & Vyprávění příběhů",
    tag: "Tvorba vět & Plynulost řeči",
    badge: "Ztráta ostychu",
    accent: "border-blue-400 bg-blue-50/60",
    desc: "9 obrázkových kostek vytvoří miliony příběhů. Děti se učí spojovat myšlenky do celých vět, reagovat na kamarády a mluvit bez zdlouhavého překládání z češtiny v hlavě.",
    phrases: ["Once upon a time in Australia...", "Suddenly, an alien landed near the river.", "What happened next?"]
  },
  {
    icon: "🎨",
    title: "Dixit & Australské kvízy",
    tag: "Představivost & Reálie",
    badge: "Starší žáci & maturanti",
    accent: "border-purple-400 bg-purple-50/60",
    desc: "Krásně ilustrované karty rozvíjejí fantazii, metafory a barvité popisy. Prokládáme je reáliemi ze života v Melbourne, australskými zvířaty a typickým přátelským humorem.",
    phrases: ["This picture looks like a dream.", "Koalas sleep twenty hours a day!", "I vote for card number three."]
  }
];

const badge = howItWorks.badge || "Metodika výuky hrou v malých skupinkách";
const title = howItWorks.title || "Jak deskovky a hry ve skupince pomáhají dětem mluvit anglicky?";
const subtitle = howItWorks.subtitle || "V partě vrstevníků vzniká přirozená soutěživost a smích. Dítě ztrácí ostych a jazyk si osvojí stejně přirozeně jako mateřštinu.";
const quote = howItWorks.quote || "„Hodiny se dělí dle zájmových oblastí, každý si najde své.“";
const gamesTitle = howItWorks.gamesTitle || "Jaké hry s dětmi hrajeme a co rozvíjejí:";
const gamesSubtitle = howItWorks.gamesSubtitle || "Hry vybíráme individuálně podle věku dětí a jejich zájmů.";
const phrasesLabel = howItWorks.phrasesLabel || "Reálné věty, které děti v zápalu hry používají:";
const gameSpotlights = howItWorks.gameSpotlights || defaultGameSpotlights;

const poster = howItWorks.poster || {
  tag: "Atmosféra naší doučovny v Uherském Hradišti",
  title: "Karak, Scrabble, Story Cubes a desítky dalších her",
  desc: "Děti se učí v zápalu hry. Pravidla, strategie a reakce probíhají v přirozené angličtině – bez strachu ze zkoušení u tabule či špatných známek."
};
---

<section id="hry" class="py-8 sm:py-12 md:py-20 relative bg-surface-base border-b border-parchment-300 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`bg-gradient-to-b from-white via-parchment-50 to-white rounded-card-xl p-5 sm:p-8 md:p-10 border-2 border-amber-300/80 shadow-card space-y-6 sm:space-y-12 ${className}`}>
  
  <!-- Header with Poster Quote -->
  <div class="text-center max-w-3xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-xs font-black uppercase tracking-wider text-amber-950" data-tina-field={tinaField(howItWorks, 'badge')} data-edit-key="howItWorks.badge" data-edit-label="Štítek metodiky">
      <span>🎲</span> <span>{badge}</span>
    </div>
    <h2 class="font-heading font-black text-fluid-h2 text-espresso-950 tracking-tight" data-tina-field={tinaField(howItWorks, 'title')} data-edit-key="howItWorks.title" data-edit-label="Nadpis metodiky" set:html={formatRichText(title)}>
    </h2>
    <p class="text-espresso-800/85 text-fluid-body leading-relaxed">
      <strong data-tina-field={tinaField(howItWorks, 'quote')} data-edit-key="howItWorks.quote" data-edit-label="Motto metodiky" set:html={formatRichText(quote)}></strong> <span data-tina-field={tinaField(howItWorks, 'subtitle')} data-edit-key="howItWorks.subtitle" data-edit-label="Podnadpis metodiky" set:html={formatRichText(subtitle)}></span>
    </p>
  </div>

  <!-- Visual Showcase: The Real 3D Board Game Table Artwork with Glass Overlay -->
  <div class="relative rounded-card-xl overflow-hidden border-2 border-amber-400 shadow-card-lift group reveal-scale">
    <img
      src={poster.image || "/images/board-games-3d.webp"}
      alt="Deskové hry pro výuku angličtiny ve Valek Academy"
      class="w-full h-[320px] sm:h-80 md:h-96 lg:h-[420px] object-cover group-hover:scale-105 transition-transform duration-700"
      width="1376"
      height="768"
      loading="lazy"
      data-tina-field={howItWorks.poster ? tinaField(poster, 'image') : undefined}
      data-edit-key="howItWorks.poster.image"
      data-edit-type="image"
      data-edit-label="Obrázek deskových her"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-espresso-950/95 via-espresso-950/60 to-espresso-950/20 flex flex-col justify-end p-4 sm:p-6 md:p-10">
      <div class="space-y-2 max-w-2xl" data-tina-field={tinaField(howItWorks, 'poster')}>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400 text-espresso-950 text-xs font-black uppercase tracking-wider shadow-2xs" data-tina-field={tinaField(poster, 'tag')}>
          <span>✨</span> <span>{poster.tag}</span>
        </div>
        <h3 class="font-heading font-black text-fluid-h2 text-white leading-tight" data-tina-field={tinaField(poster, 'title')}>
          {poster.title}
        </h3>
        <p class="text-xs sm:text-sm text-amber-100/90 leading-relaxed font-normal" data-tina-field={tinaField(poster, 'desc')}>
          {poster.desc}
        </p>
      </div>
    </div>
  </div>

  <!-- 4 Interactive Board Game Spotlight Cards -->
  <div class="space-y-4">
    <div class="text-center max-w-xl mx-auto">
      <h3 class="font-heading font-black text-fluid-h3 text-espresso-950" data-tina-field={tinaField(howItWorks, 'gamesTitle')} data-edit-key="howItWorks.gamesTitle" data-edit-label="Nadpis her">
        {gamesTitle}
      </h3>
      <p class="text-xs sm:text-sm text-stone-600 mt-1" data-tina-field={tinaField(howItWorks, 'gamesSubtitle')} data-edit-key="howItWorks.gamesSubtitle" data-edit-label="Podnadpis her">
        {gamesSubtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
      {gameSpotlights.map((game, idx) => (
        <div
          data-tina-field={tinaField(howItWorks, 'gameSpotlights', idx)}
          class={`reveal-on-scroll stagger-${idx + 1} p-5 sm:p-6 rounded-card-lg border-2 bg-surface-card ${game.accent} shadow-tile hover:shadow-card-lift transition-all group flex flex-col justify-between`}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="text-3xl group-hover:scale-110 transition-transform">{game.icon}</span>
                <div>
                  <h4 class="font-heading font-black text-base sm:text-lg text-espresso-950" data-tina-field={tinaField(game, 'title')} data-edit-key={`howItWorks.gameSpotlights.${idx}.title`} data-edit-label="Název hry">
                    {game.title}
                  </h4>
                  <span class="text-xs font-bold text-amber-900 block" data-tina-field={tinaField(game, 'tag')} data-edit-key={`howItWorks.gameSpotlights.${idx}.tag`} data-edit-label="Zaměření hry">
                    {game.tag}
                  </span>
                </div>
              </div>
              <span class="text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-white border border-parchment-300 text-espresso-900 flex-shrink-0 shadow-2xs" data-tina-field={tinaField(game, 'badge')} data-edit-key={`howItWorks.gameSpotlights.${idx}.badge`} data-edit-label="Štítek hry">
                {game.badge}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-espresso-800/90 leading-relaxed font-normal" data-tina-field={tinaField(game, 'desc')} data-edit-key={`howItWorks.gameSpotlights.${idx}.desc`} data-edit-label="Popis hry">
              {game.desc}
            </p>
          </div>

          <!-- Sample In-Game English Phrases (Styled as Physical Scrabble / Game Tiles) -->
          <div class="pt-3 mt-3 border-t border-parchment-200/80">
            <div class="text-[11px] font-black uppercase tracking-wider text-stone-500 mb-2 flex items-center gap-1.5" data-tina-field={tinaField(howItWorks, 'phrasesLabel')} data-edit-key="howItWorks.phrasesLabel" data-edit-label="Popisek vět">
              <span>🗣️</span> <span>{phrasesLabel}</span>
            </div>
            <div class="flex flex-wrap gap-2" data-tina-field={tinaField(game, 'phrases')}>
              {(game.phrases || []).map((phrase: string, pIdx: number) => (
                <span class="px-2.5 py-1 rounded-card-sm bg-white border border-parchment-300 text-xs font-semibold text-espresso-900 italic shadow-2xs hover:border-amber-400 hover:shadow-tile transition-all cursor-default" data-edit-key={`howItWorks.gameSpotlights.${idx}.phrases.${pIdx}`} data-edit-label={`Fráze ${idx + 1}.${pIdx + 1}`}>
                  „{phrase}“
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

    </div>
  </div>
</section>
