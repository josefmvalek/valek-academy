---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface Props {
  calculator?: {
    enabled?: boolean;
    badge?: string;
    title?: string;
    subtitle?: string;
    basePrice?: number;
    basePriceTeens?: number;
    ctaText?: string;
    note?: string;
    step1Title?: string;
    step1Badge?: string;
    step2Title?: string;
    step2Badge?: string;
    resultBadge?: string;
    savingsBadge?: string;
    modeKidsLabel?: string;
    modeKidsBadge?: string;
    modeTeensLabel?: string;
    modeTeensBadge?: string;
    noteKids?: string;
    noteTeens?: string;
    targetGroupLabel?: string;
    periodLabel?: string;
    frequencyLabel?: string;
    totalLessonsLabel?: string;
    unitPriceLabel?: string;
    standardPriceLabel?: string;
    youSaveLabel?: string;
    perLessonSuffix?: string;
    totalPriceLabel?: string;
    whatsappBtnText?: string;
    buddyDiscountEnabled?: boolean;
    buddyDiscountPercent?: number;
    buddyDiscountTitle?: string;
    buddyDiscountBadge?: string;
    buddyDiscountDesc?: string;
    buddyDiscountResultLabel?: string;
    durations?: any[];
    frequencies?: any[];
    [key: string]: any;
  };
  phone?: string;
}

const { calculator = {}, phone = "420792372642" } = Astro.props;

const enabled = calculator.enabled !== false;
const badge = calculator.badge || "CHYTRÝ KALKULÁTOR BALÍČKŮ";
const title = calculator.title || "Spočítejte si slevu za předplatné a frekvenci";
const subtitle = calculator.subtitle || "Čím delší období a čím častěji student chodí, tím nižší je cena za lekci. Využijte pololetní balíček nebo roční předplatné pro maximální úsporu.";
const basePrice = calculator.basePrice || 320;
const basePriceTeens = calculator.basePriceTeens || 480;
const ctaText = calculator.ctaText || "Vyzkoušet 1. lekci zdarma s touto slevou →";
const note = calculator.note || "🎁 1. ukázková lekce je vždy 100% ZDARMA. Platbu řešíte až po první hodině, když je student spokojený.";

const step1Title = calculator.step1Title || "Vyberte délku období (balíček):";
const step1Badge = calculator.step1Badge || "až -30 % sleva (od 224 Kč/h)";
const step2Title = calculator.step2Title || "Kolikrát týdně chcete chodit?";
const step2Badge = calculator.step2Badge || "extra bonus za frekvenci";
const resultBadge = calculator.resultBadge || "Váš kalkulovaný balíček:";
const savingsBadge = calculator.savingsBadge || "Ušetříte";

const modeKidsLabel = calculator.modeKidsLabel || "Děti (1.–6. třída)";
const modeKidsBadge = calculator.modeKidsBadge || "60 min";
const modeTeensLabel = calculator.modeTeensLabel || "SŠ & dospělí";
const modeTeensBadge = calculator.modeTeensBadge || "90 min";

const noteKids = calculator.noteKids || "💡 Jak slevy fungují pro žáky ZŠ (60 min): Slevy se odvíjejí od délky balíčku a frekvence: měsíční zkušební (<b>320 Kč / 60 min.</b>), čtvrtletní (<b>304 Kč / 60 min.</b>), nejoblíbenější pololetní (<b>272 Kč / 60 min.</b> = jen cca 1 100 Kč měsíčně) a roční či při docházce 2× týdně pouhých <b>245 Kč / 60 min.</b> (úspora až 30 %).";
const noteTeens = calculator.noteTeens || "💡 Jak slevy fungují pro SŠ a dospělé (90 min): Základní sazba za 90 minut je <b>480 Kč</b> (odpovídá 320 Kč/h). U pololetního balíčku klesá na <b>408 Kč / 90 min</b> (= 272 Kč/h, celkem 8 160 Kč za 20 devadesátiminutových lekcí) a u ročního předplatného či docházky 2× týdně na <b>360 Kč / 90 min</b> (= 240 Kč/h, úspora až 30 %).";

const targetGroupLabel = calculator.targetGroupLabel || "Cílová skupina:";
const periodLabel = calculator.periodLabel || "Délka období:";
const frequencyLabel = calculator.frequencyLabel || "Frekvence:";
const totalLessonsLabel = calculator.totalLessonsLabel || "Celkem lekcí v balíčku:";
const unitPriceLabel = calculator.unitPriceLabel || "Přepočtená cena za lekci:";
const standardPriceLabel = calculator.standardPriceLabel || "Běžná základní cena:";
const youSaveLabel = calculator.youSaveLabel || "Ušetříte";
const perLessonSuffix = calculator.perLessonSuffix || " / lekce";
const totalPriceLabel = calculator.totalPriceLabel || "Celková cena balíčku";
const whatsappBtnText = calculator.whatsappBtnText || "Odeslat tuto kalkulaci přímo na WhatsApp";

const buddyDiscountEnabled = calculator.buddyDiscountEnabled !== false;
const buddyDiscountPercent = calculator.buddyDiscountPercent ?? 5;
const buddyDiscountTitle = calculator.buddyDiscountTitle || "Přijdeme ve dvou (kamarád ze třídy / sourozenec)";
const buddyDiscountBadge = calculator.buddyDiscountBadge || "EXTRA SLEVA -5 % PRO OBA";
const buddyDiscountDesc = calculator.buddyDiscountDesc || "Zapíšete se společně se spolužákem nebo sourozencem? Získáte oba dodatečnou slevu 5 % z celkové ceny balíčku.";
const buddyDiscountResultLabel = calculator.buddyDiscountResultLabel || "👫 Sleva pro dva (kamarád / sourozenec):";

// Default duration presets if not configured
const defaultDurations = [
  { weeks: 4, label: "1 měsíc", periodDesc: "4 týdny výuky", badgeKids: "320 Kč / 60 min.", badgeTeens: "480 Kč / 90 min.", badge: "320 Kč / 60 min.", baseDiscount: 0 },
  { weeks: 12, label: "3 měsíce", periodDesc: "12 týdnů (čtvrtletí)", badgeKids: "304 Kč / 60 min.", badgeTeens: "456 Kč / 90 min.", badge: "304 Kč / 60 min.", baseDiscount: 5 },
  { weeks: 20, label: "Pololetí", periodDesc: "20 týdnů (půl roku)", badgeKids: "272 Kč / 60 min.", badgeTeens: "408 Kč / 90 min.", badge: "272 Kč / 60 min.", popular: true, baseDiscount: 15 },
  { weeks: 40, label: "Celý rok", periodDesc: "40 týdnů (školní rok)", badgeKids: "256 Kč / 60 min.", badgeTeens: "384 Kč / 90 min.", badge: "256 Kč / 60 min.", bestValue: true, baseDiscount: 20 },
];

// Default frequency presets if not configured
const defaultFrequencies = [
  { freq: 1, label: "1× týdně", desc: "Standardní tempo hrou", bonus: 0, badge: "Standardní" },
  { freq: 2, label: "2× týdně", desc: "Rychlý pokrok & sazba 220 Kč", bonus: 9, badge: "Doporučeno (220 Kč/h)", recommended: true },
  { freq: 3, label: "3× týdně", desc: "Intenzivní příprava & testy", bonus: 9, badge: "Max. intenzita" },
];

const durations = (calculator.durations && calculator.durations.length > 0) ? calculator.durations : defaultDurations;
const frequencies = (calculator.frequencies && calculator.frequencies.length > 0) ? calculator.frequencies : defaultFrequencies;
---

{enabled && (
  <div
    id="kalkulator-balicku"
    data-base-price-kids={basePrice}
    data-base-price-teens={basePriceTeens}
    data-phone={phone}
    data-note-kids={noteKids}
    data-note-teens={noteTeens}
    data-cohort-kids={`🎒 ${modeKidsLabel} (${modeKidsBadge})`}
    data-cohort-teens={`🎓 ${modeTeensLabel} (${modeTeensBadge})`}
    data-badge-kids-unit={modeKidsBadge}
    data-badge-teens-unit={modeTeensBadge}
    data-buddy-enabled={buddyDiscountEnabled ? "true" : "false"}
    data-buddy-percent={buddyDiscountPercent}
    data-buddy-title={buddyDiscountTitle}
    data-buddy-result-label={buddyDiscountResultLabel}
    class="mt-12 sm:mt-16 bg-gradient-to-br from-[#FFFDF9] via-white to-[#FDF8EE] rounded-2xl sm:rounded-3xl p-3 sm:p-8 md:p-10 border-2 border-amber-300 shadow-xl relative overflow-hidden w-full max-w-full min-w-0"
  >
    
    <!-- Background subtle aura -->
    <div class="absolute -right-24 -top-24 w-80 h-80 bg-amber-200/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-24 -bottom-24 w-80 h-80 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-black uppercase tracking-wider text-espresso-950 mb-3" data-tina-field={tinaField(calculator, 'badge')}>
        <span>🧮</span>
        <span data-edit-key="cenik.calculator.badge" data-edit-label="Odznak kalkulátoru">{badge}</span>
      </div>
      <h3 class="font-heading font-black text-xl sm:text-3xl md:text-4xl text-espresso-950 tracking-tight" data-tina-field={tinaField(calculator, 'title')} data-edit-key="cenik.calculator.title" data-edit-label="Nadpis kalkulátoru" set:html={formatRichText(title)}>
      </h3>
      <p class="text-espresso-800/80 text-xs sm:text-base mt-2" data-tina-field={tinaField(calculator, 'subtitle')} data-edit-key="cenik.calculator.subtitle" data-edit-label="Podnadpis kalkulátoru" set:html={formatRichText(subtitle)}>
      </p>
    </div>

    <!-- Mode Switcher: 60 min (Děti ZŠ) vs 90 min (2. stupeň, SŠ & Dospělí) -->
    <div class="max-w-xl mx-auto mb-8 sm:mb-10 relative z-10">
      <div class="bg-amber-100/70 p-1 sm:p-1.5 rounded-2xl flex items-center gap-1 sm:gap-1.5 border border-amber-300/80 shadow-inner">
        <button
          type="button"
          id="calc-mode-kids"
          class="calc-mode-btn flex-1 py-2.5 sm:py-3 px-2 sm:px-4 rounded-xl font-heading font-black text-[11px] sm:text-sm text-espresso-950 bg-white shadow-xs border border-amber-400 transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer focus:outline-hidden"
          data-mode="kids"
          aria-pressed="true"
        >
          <span class="text-sm sm:text-lg">🎒</span>
          <span class="flex flex-col sm:flex-row sm:items-center sm:gap-1.5 text-left sm:text-center leading-tight">
            <span data-tina-field={tinaField(calculator, 'modeKidsLabel')} data-edit-key="cenik.calculator.modeKidsLabel" data-edit-label="Přepínač Děti">{modeKidsLabel}</span>
            <span class="text-[10px] sm:text-xs font-extrabold text-amber-800 bg-amber-100 px-1.5 py-0.5 rounded-md self-start sm:self-auto" data-tina-field={tinaField(calculator, 'modeKidsBadge')} data-edit-key="cenik.calculator.modeKidsBadge" data-edit-label="Čas Děti">{modeKidsBadge}</span>
          </span>
        </button>
        <button
          type="button"
          id="calc-mode-teens"
          class="calc-mode-btn flex-1 py-2.5 sm:py-3 px-2 sm:px-4 rounded-xl font-heading font-bold text-[11px] sm:text-sm text-stone-600 hover:text-espresso-950 bg-transparent transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer focus:outline-hidden"
          data-mode="teens"
          aria-pressed="false"
        >
          <span class="text-sm sm:text-lg">🎓</span>
          <span class="flex flex-col sm:flex-row sm:items-center sm:gap-1.5 text-left sm:text-center leading-tight">
            <span data-tina-field={tinaField(calculator, 'modeTeensLabel')} data-edit-key="cenik.calculator.modeTeensLabel" data-edit-label="Přepínač SŠ & dospělí">{modeTeensLabel}</span>
            <span class="text-[10px] sm:text-xs font-extrabold text-purple-800 bg-purple-100 px-1.5 py-0.5 rounded-md self-start sm:self-auto" data-tina-field={tinaField(calculator, 'modeTeensBadge')} data-edit-key="cenik.calculator.modeTeensBadge" data-edit-label="Čas SŠ & dospělí">{modeTeensBadge}</span>
          </span>
        </button>
      </div>
    </div>

    <!-- Main Grid: Controls (Left) & Result (Right) -->
    <div class="grid lg:grid-cols-12 gap-8 items-start relative z-10 w-full min-w-0">
      
      <!-- Interactive Selectors (Left 7 Cols) -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-7 flex flex-col justify-start w-full max-w-full min-w-0">
        
        <!-- Step 1: Duration (Weeks) -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-heading font-black text-xs sm:text-sm uppercase tracking-wider text-espresso-950 flex items-center gap-1.5" data-tina-field={tinaField(calculator, 'step1Title')}>
              <span class="w-5 h-5 rounded-full bg-amber-400 text-espresso-950 font-black text-xs flex items-center justify-center">1</span>
              <span data-edit-key="cenik.calculator.step1Title" data-edit-label="Nadpis Krok 1">{step1Title}</span>
            </span>
            <span class="text-[11px] font-bold text-amber-800 bg-amber-100/80 px-2 py-0.5 rounded-full" data-tina-field={tinaField(calculator, 'step1Badge')}>
              <span data-edit-key="cenik.calculator.step1Badge" data-edit-label="Štítek Krok 1">{step1Badge}</span>
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5" role="radiogroup" aria-label="Délka období výuky">
            {durations.map((d: any, idx: number) => {
              const discount = Number(d.baseDiscount ?? 0);
              const calcRateKids = Math.round(basePrice * (1 - discount / 100));
              const calcRateTeens = Math.round(basePriceTeens * (1 - discount / 100));
              const badgeKids = d.badgeKids || `${calcRateKids} Kč / ${modeKidsBadge}`;
              const badgeTeens = d.badgeTeens || `${calcRateTeens} Kč / ${modeTeensBadge}`;
              return (
                <button
                  type="button"
                  data-tina-field={tinaField(calculator, 'durations', idx)}
                  data-weeks={d.weeks}
                  data-base-discount={d.baseDiscount}
                  data-badge-kids={badgeKids}
                  data-badge-teens={badgeTeens}
                  data-badge={badgeKids}
                  data-label={d.label}
                  data-period-desc={d.periodDesc}
                  class:list={[
                    "calc-duration-btn p-2 sm:p-3 rounded-xl sm:rounded-2xl border text-left transition-all relative flex flex-col justify-between cursor-pointer focus:outline-hidden min-w-0 min-h-[52px]",
                    d.weeks === 20
                      ? "bg-amber-100/90 border-amber-500 ring-2 ring-amber-400 shadow-sm"
                      : "bg-white/90 border-parchment-300 hover:border-amber-300 hover:bg-parchment-100/60"
                  ]}
                  aria-checked={d.weeks === 20 ? "true" : "false"}
                >
                  {d.popular && (
                    <span class="absolute -top-2 right-1.5 text-[8px] sm:text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-amber-400 text-espresso-950 shadow-2xs max-w-[85%] truncate">
                      Populární
                    </span>
                  )}
                  {d.bestValue && (
                    <span class="absolute -top-2 right-1.5 text-[8px] sm:text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-emerald-600 text-white shadow-2xs max-w-[85%] truncate">
                      Nejvýhodnější
                    </span>
                  )}
                  <div>
                    <div class="font-heading font-black text-sm sm:text-base text-espresso-950" data-edit-key={`cenik.calculator.durations.${idx}.label`} data-edit-label="Název období">{d.label}</div>
                    <div class="text-[11px] text-espresso-800/70" data-edit-key={`cenik.calculator.durations.${idx}.periodDesc`} data-edit-label="Popis období">{d.periodDesc}</div>
                  </div>
                  <div
                    class="mt-2 pt-1 border-t border-parchment-200 text-xs font-extrabold text-amber-900 calc-duration-badge leading-tight"
                    data-edit-key={`cenik.calculator.durations.${idx}.badgeKids`}
                    data-edit-label={`Štítek ceny Děti (${d.label})`}
                  >
                    {badgeKids}
                  </div>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Step 2: Frequency (Lessons per week) -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-heading font-black text-xs sm:text-sm uppercase tracking-wider text-espresso-950 flex items-center gap-1.5" data-tina-field={tinaField(calculator, 'step2Title')}>
              <span class="w-5 h-5 rounded-full bg-amber-400 text-espresso-950 font-black text-xs flex items-center justify-center">2</span>
              <span data-edit-key="cenik.calculator.step2Title" data-edit-label="Nadpis Krok 2">{step2Title}</span>
            </span>
            <span class="text-[11px] font-bold text-amber-800 bg-amber-100/80 px-2 py-0.5 rounded-full" data-tina-field={tinaField(calculator, 'step2Badge')}>
              <span data-edit-key="cenik.calculator.step2Badge" data-edit-label="Štítek Krok 2">{step2Badge}</span>
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="radiogroup" aria-label="Frekvence výuky týdně">
            {frequencies.map((f: any, idx: number) => (
              <button
                type="button"
                data-tina-field={tinaField(calculator, 'frequencies', idx)}
                data-freq={f.freq}
                data-bonus={f.bonus}
                data-badge={f.badge}
                data-label={f.label}
                class:list={[
                  "calc-freq-btn p-3 rounded-2xl border text-left transition-all relative flex flex-col justify-between cursor-pointer focus:outline-hidden",
                  f.freq === 1
                    ? "bg-amber-100/90 border-amber-500 ring-2 ring-amber-400 shadow-sm"
                    : "bg-white/90 border-parchment-300 hover:border-amber-300 hover:bg-parchment-100/60"
                ]}
                aria-checked={f.freq === 1 ? "true" : "false"}
              >
                {f.recommended && (
                  <span class="absolute -top-2 right-2 text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-amber-400 text-espresso-950 shadow-2xs">
                    Doporučeno
                  </span>
                )}
                <div>
                  <div class="font-heading font-black text-sm sm:text-base text-espresso-950" data-edit-key={`cenik.calculator.frequencies.${idx}.label`} data-edit-label="Název frekvence">{f.label}</div>
                  <div class="text-[11px] text-espresso-800/70" data-edit-key={`cenik.calculator.frequencies.${idx}.desc`} data-edit-label="Popis frekvence">{f.desc}</div>
                </div>
                <div class="mt-2 pt-1 border-t border-parchment-200 text-xs font-extrabold text-amber-900 calc-freq-badge" data-edit-key={`cenik.calculator.frequencies.${idx}.badge`} data-edit-label="Štítek frekvence">
                  {f.badge}
                </div>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 3 / Bonus Option: Buddy / Sibling Discount -->
        {buddyDiscountEnabled && (
          <div
            id="calc-buddy-card"
            class="p-4 rounded-2xl bg-amber-50/70 hover:bg-amber-50 border-2 border-dashed border-amber-300 hover:border-amber-500 transition-all cursor-pointer group shadow-2xs select-none"
            role="checkbox"
            aria-checked="false"
            tabindex="0"
          >
            <div class="flex items-start gap-3">
              <div class="pt-0.5">
                <input
                  type="checkbox"
                  id="calc-buddy-checkbox"
                  class="w-5 h-5 rounded-md border-2 border-amber-400 text-amber-600 focus:ring-amber-400 focus:ring-offset-0 cursor-pointer accent-amber-600 transition-all pointer-events-none"
                  tabindex="-1"
                />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span
                    class="font-heading font-black text-xs sm:text-sm text-espresso-950 flex items-center gap-1.5"
                    data-tina-field={tinaField(calculator, 'buddyDiscountTitle')}
                  >
                    <span>👫</span>
                    <span data-edit-key="cenik.calculator.buddyDiscountTitle" data-edit-label="Kamarádská sleva nadpis">{buddyDiscountTitle}</span>
                  </span>
                  <span
                    class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-2xs group-hover:bg-emerald-200 transition-colors"
                    data-tina-field={tinaField(calculator, 'buddyDiscountBadge')}
                  >
                    <span data-edit-key="cenik.calculator.buddyDiscountBadge" data-edit-label="Kamarádská sleva štítek">{buddyDiscountBadge}</span>
                  </span>
                </div>
                <p
                  class="text-[11px] sm:text-xs text-espresso-800/80 leading-relaxed font-normal"
                  data-tina-field={tinaField(calculator, 'buddyDiscountDesc')}
                  data-edit-key="cenik.calculator.buddyDiscountDesc"
                  data-edit-label="Kamarádská sleva popis"
                >
                  {buddyDiscountDesc}
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Explanatory note -->
        <div
          id="calc-explanatory-note"
          class="p-3.5 rounded-xl bg-parchment-100/80 border border-parchment-300/80 text-[11px] sm:text-xs text-espresso-800 leading-relaxed"
          data-tina-field={tinaField(calculator, 'noteKids')}
          data-edit-key="cenik.calculator.noteKids"
          data-edit-label="Vysvětlující text (Děti)"
          set:html={formatRichText(noteKids)}
        >
        </div>

      </div>

      <!-- Result Card (Right 5 Cols) -->
      <div class="lg:col-span-5 bg-gradient-to-b from-white via-[#FFFDF9] to-amber-50/50 rounded-2xl sm:rounded-3xl p-3.5 sm:p-7 border-2 border-amber-400 shadow-lg flex flex-col justify-between relative w-full max-w-full min-w-0">
        
        <!-- Top Badge -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-parchment-200 pb-3 mb-4 min-w-0">
          <span class="text-xs font-black uppercase tracking-wider text-amber-950 flex-1 min-w-[170px]" data-tina-field={tinaField(calculator, 'resultBadge')}>
            <span data-edit-key="cenik.calculator.resultBadge" data-edit-label="Štítek výsledku">{resultBadge}</span>
          </span>
          <span id="calc-total-discount-badge" class="px-2.5 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300 flex-shrink-0">
            -22 % SLEVA
          </span>
        </div>

        <!-- Details list -->
        <div class="space-y-3.5 mb-6">
          
          <div class="flex flex-wrap items-center justify-between gap-y-1 text-xs sm:text-sm text-stone-600">
            <span data-tina-field={tinaField(calculator, 'targetGroupLabel')} data-edit-key="cenik.calculator.targetGroupLabel" data-edit-label="Popisek Cílová skupina">{targetGroupLabel}</span>
            <span id="calc-cohort-display" class="font-bold text-espresso-950">🎒 {modeKidsLabel} ({modeKidsBadge})</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-y-1 text-xs sm:text-sm text-stone-600">
            <span data-tina-field={tinaField(calculator, 'periodLabel')} data-edit-key="cenik.calculator.periodLabel" data-edit-label="Popisek Délka období">{periodLabel}</span>
            <span id="calc-period-display" class="font-bold text-espresso-950">Pololetí (20 týdnů)</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-y-1 text-xs sm:text-sm text-stone-600">
            <span data-tina-field={tinaField(calculator, 'frequencyLabel')} data-edit-key="cenik.calculator.frequencyLabel" data-edit-label="Popisek Frekvence">{frequencyLabel}</span>
            <span id="calc-freq-display" class="font-bold text-espresso-950">1× týdně</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-y-1 text-xs sm:text-sm text-stone-600">
            <span data-tina-field={tinaField(calculator, 'totalLessonsLabel')} data-edit-key="cenik.calculator.totalLessonsLabel" data-edit-label="Popisek Celkem lekcí">{totalLessonsLabel}</span>
            <span id="calc-lessons-display" class="font-bold text-espresso-950">20 lekcí</span>
          </div>

          <!-- Buddy discount active highlight pill (smooth animation without layout shift) -->
          <div
            id="calc-buddy-status-container"
            class="grid transition-all duration-300 ease-out grid-rows-[0fr] opacity-0 overflow-hidden"
          >
            <div class="overflow-hidden min-h-0">
              <div
                id="calc-buddy-status-row"
                class="p-2 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs font-bold flex items-center justify-between gap-2 my-1"
              >
                <span class="flex items-center gap-1.5 truncate">
                  <span>👫</span>
                  <span id="calc-buddy-status-label" data-tina-field={tinaField(calculator, 'buddyDiscountResultLabel')} data-edit-key="cenik.calculator.buddyDiscountResultLabel" data-edit-label="Kamarádská sleva výsledek">{buddyDiscountResultLabel}</span>
                </span>
                <span id="calc-buddy-status-badge" class="px-2 py-0.5 rounded-md bg-emerald-200 text-emerald-950 font-black text-[11px] flex-shrink-0">
                  -{buddyDiscountPercent} % pro oba
                </span>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-parchment-200">
            <span id="calc-breakdown-pill" class="inline-block text-[11px] font-bold text-amber-900 bg-amber-100/70 px-2.5 py-1 rounded-lg break-words max-w-full leading-relaxed">
              Pololetní balíček 250 Kč/h (cca 1 000 Kč měsíčně)
            </span>
          </div>

          <!-- Unit price comparison -->
          <div class="p-3.5 rounded-2xl bg-white border border-amber-200/90 space-y-1">
            <div class="flex flex-wrap items-baseline justify-between gap-y-1">
              <span id="calc-unit-label" class="text-xs text-stone-600 font-medium" data-tina-field={tinaField(calculator, 'unitPriceLabel')} data-edit-key="cenik.calculator.unitPriceLabel" data-edit-label="Popisek Cena za lekci">{unitPriceLabel}</span>
              <div class="text-right">
                <span id="calc-unit-price" class="font-heading font-black text-xl sm:text-2xl text-espresso-950">250 Kč</span>
                <span id="calc-unit-suffix" class="text-xs text-stone-500 font-normal"> / 60 min</span>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-y-1 text-[11px] text-stone-500 pt-1 border-t border-parchment-100">
              <span><span data-tina-field={tinaField(calculator, 'standardPriceLabel')} data-edit-key="cenik.calculator.standardPriceLabel" data-edit-label="Popisek Běžná cena">{standardPriceLabel}</span> <span id="calc-original-unit" class="line-through" data-edit-key="cenik.calculator.basePrice" data-edit-label="Základní cena Děti (Kč)">{basePrice} Kč</span></span>
              <span class="text-emerald-700 font-bold"><span data-tina-field={tinaField(calculator, 'youSaveLabel')} data-edit-key="cenik.calculator.youSaveLabel" data-edit-label="Popisek Ušetříte">{youSaveLabel}</span> <span id="calc-unit-saving">70 Kč</span><span data-tina-field={tinaField(calculator, 'perLessonSuffix')} data-edit-key="cenik.calculator.perLessonSuffix" data-edit-label="Přípona jednotky">{perLessonSuffix}</span></span>
            </div>
          </div>

          <!-- Total price -->
          <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-400 to-amber-500 text-espresso-950 shadow-md">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="text-[11px] font-extrabold uppercase tracking-wider block opacity-90" data-tina-field={tinaField(calculator, 'totalPriceLabel')}>
                  <span data-edit-key="cenik.calculator.totalPriceLabel" data-edit-label="Nadpis Celková cena">{totalPriceLabel}</span>
                </span>
                <span id="calc-total-price" class="font-heading font-black text-2xl sm:text-3xl tracking-tight">5 000 Kč</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-bold uppercase block opacity-80" data-tina-field={tinaField(calculator, 'savingsBadge')}>
                  <span data-edit-key="cenik.calculator.savingsBadge" data-edit-label="Štítek Úspora">{savingsBadge}</span>
                </span>
                <span id="calc-total-savings" class="font-heading font-black text-lg text-emerald-950 bg-white/40 px-2 py-0.5 rounded-lg">1 400 Kč</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Action buttons -->
        <div class="space-y-2.5">
          <button
            type="button"
            id="calc-cta-btn"
            class="btn-gold-pulse w-full py-3.5 px-4 rounded-xl font-heading font-black text-xs sm:text-sm text-espresso-950 bg-white hover:bg-amber-100 border-2 border-amber-500 shadow-sm transition-all cursor-pointer text-center"
            data-tina-field={tinaField(calculator, 'ctaText')}
          >
            <span data-edit-key="cenik.calculator.ctaText" data-edit-label="Text CTA tlačítka">{ctaText}</span>
          </button>

          <a
            id="calc-wa-btn"
            href={`https://wa.me/${phone}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl font-bold text-xs text-stone-700 hover:text-espresso-950 bg-white/70 hover:bg-white border border-parchment-300 transition-colors"
            data-tina-field={tinaField(calculator, 'whatsappBtnText')}
          >
            <span>💬</span>
            <span data-edit-key="cenik.calculator.whatsappBtnText" data-edit-label="Tlačítko WhatsApp">{whatsappBtnText}</span>
          </a>

          <p class="text-[10px] text-stone-500 text-center leading-tight pt-1" data-tina-field={tinaField(calculator, 'note')} data-edit-key="cenik.calculator.note" data-edit-label="Poznámka dole v kartě">
            {note}
          </p>
        </div>

      </div>

    </div>

  </div>
)}

<script>
  (() => {
    // Persistent state across TinaCMS island swaps
    let currentMode: 'kids' | 'teens' = 'kids';
    let selectedWeeks = 20;
    let selectedFreq = 1;
    let isBuddyDiscountActive = false;

    let audioCtx: AudioContext | null = null;
    function playClickPop() {
      try {
        const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtxClass) return;
        audioCtx = audioCtx || new AudioCtxClass();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(560, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(840, audioCtx.currentTime + 0.05);

        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.06);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.07);
      } catch(e) {}
    }

    const durationLabels: Record<number, string> = {
      4: "1 měsíc",
      12: "3 měsíce",
      20: "Pololetí",
      40: "Celý rok"
    };

    function updateBuddyUI(calc: HTMLElement) {
      const buddyCard = calc.querySelector<HTMLElement>('#calc-buddy-card');
      const buddyCheckbox = calc.querySelector<HTMLInputElement>('#calc-buddy-checkbox');
      const buddyStatusContainer = calc.querySelector<HTMLElement>('#calc-buddy-status-container');

      if (buddyCheckbox) {
        buddyCheckbox.checked = isBuddyDiscountActive;
      }
      if (buddyCard) {
        buddyCard.setAttribute('aria-checked', isBuddyDiscountActive ? 'true' : 'false');
        if (isBuddyDiscountActive) {
          buddyCard.classList.remove('bg-amber-50/70', 'border-dashed', 'border-amber-300');
          buddyCard.classList.add('bg-emerald-50', 'border-solid', 'border-emerald-500', 'ring-2', 'ring-emerald-400/50');
        } else {
          buddyCard.classList.remove('bg-emerald-50', 'border-solid', 'border-emerald-500', 'ring-2', 'ring-emerald-400/50');
          buddyCard.classList.add('bg-amber-50/70', 'border-dashed', 'border-amber-300');
        }
      }
      if (buddyStatusContainer) {
        if (isBuddyDiscountActive) {
          buddyStatusContainer.classList.remove('grid-rows-[0fr]', 'opacity-0');
          buddyStatusContainer.classList.add('grid-rows-[1fr]', 'opacity-100');
        } else {
          buddyStatusContainer.classList.remove('grid-rows-[1fr]', 'opacity-100');
          buddyStatusContainer.classList.add('grid-rows-[0fr]', 'opacity-0');
        }
      }
    }

    function updateModeButtonsUI(calc: HTMLElement) {
      const modeBtns = calc.querySelectorAll<HTMLButtonElement>('.calc-mode-btn');
      modeBtns.forEach(b => {
        const isSelected = b.getAttribute('data-mode') === currentMode;
        b.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        if (isSelected) {
          b.classList.remove('bg-transparent', 'text-stone-600', 'font-bold');
          b.classList.add('bg-white', 'text-espresso-950', 'shadow-xs', 'border-amber-400', 'font-black');
        } else {
          b.classList.remove('bg-white', 'text-espresso-950', 'shadow-xs', 'border-amber-400', 'font-black');
          b.classList.add('bg-transparent', 'text-stone-600', 'font-bold');
        }
      });
    }

    function updateDurationButtonsUI(calc: HTMLElement) {
      const durationBtns = calc.querySelectorAll<HTMLButtonElement>('.calc-duration-btn');
      durationBtns.forEach(b => {
        const weeks = parseInt(b.getAttribute('data-weeks') || '20', 10);
        const isSelected = weeks === selectedWeeks;
        b.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        if (isSelected) {
          b.classList.remove('bg-white/90', 'border-parchment-300');
          b.classList.add('bg-amber-100/90', 'border-amber-500', 'ring-2', 'ring-amber-400', 'shadow-sm');
        } else {
          b.classList.remove('bg-amber-100/90', 'border-amber-500', 'ring-2', 'ring-amber-400', 'shadow-sm');
          b.classList.add('bg-white/90', 'border-parchment-300');
        }
      });
    }

    function updateFreqButtonsUI(calc: HTMLElement) {
      const freqBtns = calc.querySelectorAll<HTMLButtonElement>('.calc-freq-btn');
      freqBtns.forEach(b => {
        const freq = parseInt(b.getAttribute('data-freq') || '1', 10);
        const isSelected = freq === selectedFreq;
        b.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        if (isSelected) {
          b.classList.remove('bg-white/90', 'border-parchment-300');
          b.classList.add('bg-amber-100/90', 'border-amber-500', 'ring-2', 'ring-amber-400', 'shadow-sm');
        } else {
          b.classList.remove('bg-amber-100/90', 'border-amber-500', 'ring-2', 'ring-amber-400', 'shadow-sm');
          b.classList.add('bg-white/90', 'border-parchment-300');
        }
      });
    }

    function updateDurationBadges(calc: HTMLElement) {
      const isKids = currentMode === 'kids';
      const basePriceKids = parseInt(calc.getAttribute('data-base-price-kids') || '320', 10);
      const basePriceTeens = parseInt(calc.getAttribute('data-base-price-teens') || '480', 10);
      const basePrice = isKids ? basePriceKids : basePriceTeens;
      const lessonUnit = isKids
        ? (calc.getAttribute('data-badge-kids-unit') || '60 min')
        : (calc.getAttribute('data-badge-teens-unit') || '90 min');

      const durationBtns = calc.querySelectorAll<HTMLButtonElement>('.calc-duration-btn');
      const freqBtns = calc.querySelectorAll<HTMLButtonElement>('.calc-freq-btn');
      const explanatoryNote = document.getElementById('calc-explanatory-note');
      const originalUnit = document.getElementById('calc-original-unit');

      durationBtns.forEach((btn, idx) => {
        const baseDiscount = parseFloat(btn.getAttribute('data-base-discount') || '0');
        const customBadgeKids = btn.getAttribute('data-badge-kids');
        const customBadgeTeens = btn.getAttribute('data-badge-teens');
        const badgeEl = btn.querySelector<HTMLElement>('.calc-duration-badge');
        if (!badgeEl) return;

        const rate = Math.round(basePrice * (1 - baseDiscount / 100));
        let badgeText = '';
        if (isKids) {
          badgeText = customBadgeKids || `${rate} Kč / ${lessonUnit}`;
          badgeEl.setAttribute('data-edit-key', `cenik.calculator.durations.${idx}.badgeKids`);
          badgeEl.setAttribute('data-edit-label', `Štítek ceny Děti (${btn.getAttribute('data-label') || ''})`);
        } else {
          badgeText = customBadgeTeens || `${rate} Kč / ${lessonUnit}`;
          badgeEl.setAttribute('data-edit-key', `cenik.calculator.durations.${idx}.badgeTeens`);
          badgeEl.setAttribute('data-edit-label', `Štítek ceny SŠ (${btn.getAttribute('data-label') || ''})`);
        }
        badgeEl.textContent = badgeText;
      });

      freqBtns.forEach(btn => {
        const customBadge = btn.getAttribute('data-badge');
        const badgeEl = btn.querySelector<HTMLElement>('.calc-freq-badge');
        if (!badgeEl) return;
        if (customBadge) {
          badgeEl.textContent = customBadge;
        }
      });

      if (originalUnit) {
        originalUnit.textContent = `${basePrice} Kč`;
        originalUnit.setAttribute('data-edit-key', isKids ? 'cenik.calculator.basePrice' : 'cenik.calculator.basePriceTeens');
        originalUnit.setAttribute('data-edit-label', isKids ? 'Základní cena Děti (Kč)' : 'Základní cena SŠ & dospělí (Kč)');
      }

      if (explanatoryNote) {
        const noteKidsHtml = calc.getAttribute('data-note-kids') || '<span class="font-bold text-espresso-950">💡 Jak slevy fungují pro žáky ZŠ (60 min):</span> Slevy se odvíjí od délky balíčku a frekvence: měsíční zkušební (<strong>320 Kč / 60 min.</strong>), čtvrtletní (<strong>304 Kč / 60 min.</strong>), nejoblíbenější pololetní (<strong>272 Kč / 60 min.</strong> = jen cca 1 100 Kč měsíčně) a roční či při docházce 2× týdně pouhých <strong>245 Kč / 60 min.</strong> (úspora až 30 %).';
        const noteTeensHtml = calc.getAttribute('data-note-teens') || '<span class="font-bold text-espresso-950">💡 Jak slevy fungují pro SŠ a dospělé (90 min):</span> Základní sazba za 90 minut je <strong>480 Kč</strong> (odpovídá 320 Kč/h). U pololetního balíčku klesá na <strong>408 Kč / 90 min</strong> (= 272 Kč/h, celkem 8 160 Kč za 20 lekcí) a u ročního předplatného či docházky 2× týdně na <strong>360 Kč / 90 min</strong> (= 240 Kč/h, úspora až 30 %).';

        explanatoryNote.innerHTML = isKids ? noteKidsHtml : noteTeensHtml;
        explanatoryNote.setAttribute('data-edit-key', isKids ? 'cenik.calculator.noteKids' : 'cenik.calculator.noteTeens');
        explanatoryNote.setAttribute('data-edit-label', isKids ? 'Vysvětlující text (Děti)' : 'Vysvětlující text (SŠ & dospělí)');
      }
    }

    function recalculate() {
      const calc = document.getElementById('kalkulator-balicku');
      if (!calc) return;

      const basePriceKids = parseInt(calc.getAttribute('data-base-price-kids') || '320', 10);
      const basePriceTeens = parseInt(calc.getAttribute('data-base-price-teens') || '480', 10);
      const phone = calc.getAttribute('data-phone') || '420792372642';

      const isKids = currentMode === 'kids';
      const basePrice = isKids ? basePriceKids : basePriceTeens;
      const lessonUnit = isKids ? '60 min' : '90 min';
      const cohortNameKids = calc.getAttribute('data-cohort-kids') || '🎒 Děti ZŠ (60 min)';
      const cohortNameTeens = calc.getAttribute('data-cohort-teens') || '🎓 2. stupeň, SŠ & dospělí (90 min)';
      const cohortName = isKids ? cohortNameKids : cohortNameTeens;

      const activeDurationBtn = calc.querySelector<HTMLButtonElement>(`.calc-duration-btn[data-weeks="${selectedWeeks}"]`) || calc.querySelector<HTMLButtonElement>('.calc-duration-btn');
      const activeFreqBtn = calc.querySelector<HTMLButtonElement>(`.calc-freq-btn[data-freq="${selectedFreq}"]`) || calc.querySelector<HTMLButtonElement>('.calc-freq-btn');

      const weeks = parseInt(activeDurationBtn?.getAttribute('data-weeks') || String(selectedWeeks), 10);
      const freq = parseInt(activeFreqBtn?.getAttribute('data-freq') || String(selectedFreq), 10);
      const baseDiscount = parseFloat(activeDurationBtn?.getAttribute('data-base-discount') || '0');
      const bonus = parseFloat(activeFreqBtn?.getAttribute('data-bonus') || '0');
      const durationLabel = activeDurationBtn?.getAttribute('data-label') || (durationLabels[weeks] || `${weeks} týdnů`);
      const freqLabel = activeFreqBtn?.getAttribute('data-label') || `${freq}× týdně`;

      const totalLessons = weeks * freq;

      const buddyPercent = parseFloat(calc.getAttribute('data-buddy-percent') || '5');
      const buddyBonus = isBuddyDiscountActive ? buddyPercent : 0;

      // Celková sleva v % z CMS: základní sleva balíčku + bonusová sleva za frekvenci + kamarádská sleva
      const totalDiscount = Math.min(60, Math.max(0, Math.round((baseDiscount + bonus + buddyBonus) * 10) / 10));

      // Přepočtená cena za lekci po slevě (vypočtená přímo ze zadané základní ceny a slevy v CMS)
      const discountedPricePerLesson = totalDiscount > 0
        ? Math.round(basePrice * (1 - totalDiscount / 100))
        : basePrice;

      let tierExplanation = "";
      if (isBuddyDiscountActive && freq >= 2 && bonus > 0) {
        tierExplanation = `${durationLabel} + ${freq}× týdně + kamarád (-${buddyPercent} %) • sleva ${totalDiscount} % (${discountedPricePerLesson} Kč / ${lessonUnit})`;
      } else if (isBuddyDiscountActive) {
        tierExplanation = `${durationLabel} + kamarád (-${buddyPercent} %) • sleva ${totalDiscount} % (${discountedPricePerLesson} Kč / ${lessonUnit})`;
      } else if (freq >= 2 && bonus > 0) {
        tierExplanation = `${durationLabel} + bonus ${freq}× týdně (sleva ${totalDiscount} %, sazba ${discountedPricePerLesson} Kč / ${lessonUnit})`;
      } else if (totalDiscount > 0) {
        tierExplanation = `${durationLabel} (${lessonUnit}) • sleva ${totalDiscount} % (${discountedPricePerLesson} Kč / lekce)`;
      } else {
        tierExplanation = `${durationLabel} (${lessonUnit}) • základní cena ${basePrice} Kč / lekce`;
      }

      const savingPerLesson = Math.max(0, basePrice - discountedPricePerLesson);
      const totalOriginalCost = basePrice * totalLessons;
      const totalDiscountedCost = discountedPricePerLesson * totalLessons;
      const allSavings = Math.max(0, totalOriginalCost - totalDiscountedCost);

      const cohortDisplay = document.getElementById('calc-cohort-display');
      const totalDiscountBadge = document.getElementById('calc-total-discount-badge');
      const periodDisplay = document.getElementById('calc-period-display');
      const freqDisplay = document.getElementById('calc-freq-display');
      const lessonsDisplay = document.getElementById('calc-lessons-display');
      const breakdownPill = document.getElementById('calc-breakdown-pill');
      const unitPrice = document.getElementById('calc-unit-price');
      const unitSuffix = document.getElementById('calc-unit-suffix');
      const originalUnit = document.getElementById('calc-original-unit');
      const unitSaving = document.getElementById('calc-unit-saving');
      const totalPrice = document.getElementById('calc-total-price');
      const totalSavings = document.getElementById('calc-total-savings');
      const waBtn = document.getElementById('calc-wa-btn') as HTMLAnchorElement | null;

      if (cohortDisplay) cohortDisplay.textContent = cohortName;
      if (totalDiscountBadge) {
        totalDiscountBadge.textContent = totalDiscount > 0 ? `Sleva ${totalDiscount} %` : `Základní sazba`;
      }
      if (periodDisplay) periodDisplay.textContent = `${durationLabel} (${weeks} týdnů)`;
      if (freqDisplay) freqDisplay.textContent = freqLabel;
      if (lessonsDisplay) lessonsDisplay.textContent = `${totalLessons} lekcí`;
      if (breakdownPill) breakdownPill.textContent = tierExplanation;
      if (unitPrice) unitPrice.textContent = `${discountedPricePerLesson} Kč`;
      if (unitSuffix) unitSuffix.textContent = ` / ${lessonUnit}`;
      if (originalUnit) {
        originalUnit.textContent = `${basePrice} Kč`;
        originalUnit.setAttribute('data-edit-key', isKids ? 'cenik.calculator.basePrice' : 'cenik.calculator.basePriceTeens');
        originalUnit.setAttribute('data-edit-label', isKids ? 'Základní cena Děti (Kč)' : 'Základní cena SŠ & dospělí (Kč)');
      }
      if (unitSaving) unitSaving.textContent = `${savingPerLesson} Kč`;
      if (totalPrice) totalPrice.textContent = `${totalDiscountedCost.toLocaleString('cs-CZ')} Kč`;
      if (totalSavings) totalSavings.textContent = `${allSavings.toLocaleString('cs-CZ')} Kč`;

      const periodName = `${durationLabel} (${weeks} týdnů)`;
      const modeLabel = isKids ? "Děti ZŠ (60minutové lekce)" : "2. stupeň, SŠ & dospělí (90minutové lekce)";
      const buddyWaLine = isBuddyDiscountActive ? `\n• Uplatněna kamarádská / sourozenecká sleva (-${buddyPercent} % pro obě děti)` : "";
      const waMsg = `Dobrý den, pane Válku, v kalkulátoru na webu Valek Academy jsem si spočítal(a) balíček pro: ${modeLabel}\n• Období: ${periodName}\n• Frekvence: ${freqLabel} (celkem ${totalLessons} lekcí)${buddyWaLine}\n• Cena: ${discountedPricePerLesson} Kč / ${lessonUnit} (sleva ${totalDiscount} %, celkem ${totalDiscountedCost.toLocaleString('cs-CZ')} Kč).\n\nRádi bychom si domluvili 1. ukázkovou lekci zdarma.`;
      if (waBtn) {
        waBtn.href = `https://wa.me/${phone}?text=${encodeURIComponent(waMsg)}`;
      }
    }

    function syncCalculator() {
      const calc = document.getElementById('kalkulator-balicku');
      if (!calc) return;
      updateModeButtonsUI(calc);
      updateDurationButtonsUI(calc);
      updateFreqButtonsUI(calc);
      updateBuddyUI(calc);
      updateDurationBadges(calc);
      recalculate();
    }

    let lastHandledTime = 0;
    function handleCalculatorInteraction(e: Event) {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const calc = target.closest('#kalkulator-balicku') as HTMLElement | null;
      if (!calc) return;

      // Mode button
      const modeBtn = target.closest<HTMLButtonElement>('.calc-mode-btn');
      if (modeBtn) {
        playClickPop();
        const mode = modeBtn.getAttribute('data-mode') === 'teens' ? 'teens' : 'kids';
        currentMode = mode;
        syncCalculator();
        return;
      }

      // Duration button
      const durationBtn = target.closest<HTMLButtonElement>('.calc-duration-btn');
      if (durationBtn) {
        playClickPop();
        const weeks = parseInt(durationBtn.getAttribute('data-weeks') || '20', 10);
        selectedWeeks = weeks;
        syncCalculator();
        return;
      }

      // Frequency button
      const freqBtn = target.closest<HTMLButtonElement>('.calc-freq-btn');
      if (freqBtn) {
        playClickPop();
        const freq = parseInt(freqBtn.getAttribute('data-freq') || '1', 10);
        selectedFreq = freq;
        syncCalculator();
        return;
      }

      // Buddy discount card toggle
      const buddyCard = target.closest('#calc-buddy-card');
      if (buddyCard) {
        playClickPop();
        isBuddyDiscountActive = !isBuddyDiscountActive;
        syncCalculator();
        return;
      }

      // CTA button (prefill form)
      const ctaBtn = target.closest<HTMLButtonElement>('#calc-cta-btn');
      if (ctaBtn) {
        playClickPop();
        const isKids = currentMode === 'kids';
        const formSelect = document.getElementById('segment-select') as HTMLSelectElement | null;
        if (formSelect) {
          formSelect.value = isKids
            ? "🎲 Děti na ZŠ (Skupinka 4–8 dětí hrou) – 1. LEKCE 100% ZDARMA"
            : "🎓 Střední škola a maturita [Přednostní čekací listina]";
          formSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }

        const msgField = document.getElementById('message') as HTMLTextAreaElement | null;
        if (msgField) {
          const modeLabel = isKids ? "Děti ZŠ (60minutové lekce)" : "2. stupeň, SŠ & dospělí (90minutové lekce)";
          const buddyPercent = parseFloat(calc.getAttribute('data-buddy-percent') || '5');
          const buddyLine = isBuddyDiscountActive ? `\n• Přijdeme ve dvou (kamarád ze třídy / sourozenec) – chceme uplatnit slevu ${buddyPercent} % pro obě děti.` : "";
          msgField.value = `Dobrý den, pane Válku, máme zájem o balíček z kalkulátoru (${modeLabel}):\n• Období: ${selectedWeeks} týdnů\n• Frekvence: ${selectedFreq}× týdně${buddyLine}\n\nRádi bychom nejprve nezávazně vyzkoušeli 1. lekci 100% zdarma.`;
        }

        const contactSection = document.getElementById('kontakt');
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: 'smooth' });
        } else {
          // On subpages without inline contact form: redirect to homepage contact section with prefill query params
          const modeParam = isKids ? 'deti' : 'teens';
          const buddyParam = isBuddyDiscountActive ? '1' : '0';
          window.location.href = `/?program=${modeParam}&weeks=${selectedWeeks}&freq=${selectedFreq}&buddy=${buddyParam}#kontakt`;
          return;
        }

        const formCard = document.getElementById('contact-form')?.parentElement;
        if (formCard) {
          formCard.classList.add('ring-4', 'ring-amber-400', 'border-amber-500');
          setTimeout(() => {
            formCard.classList.remove('ring-4', 'ring-amber-400', 'border-amber-500');
          }, 2500);
        }

        const nameInput = document.getElementById('name') as HTMLInputElement | null;
        if (nameInput) {
          setTimeout(() => nameInput.focus(), 600);
        }
        return;
      }
    }

    document.addEventListener('pointerdown', (e) => {
      lastHandledTime = Date.now();
      handleCalculatorInteraction(e);
    }, true);

    document.addEventListener('click', (e) => {
      if (Date.now() - lastHandledTime < 350) return;
      handleCalculatorInteraction(e);
    }, true);

    document.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        const target = e.target as HTMLElement | null;
        if (target && target.closest('#calc-buddy-card')) {
          e.preventDefault();
          playClickPop();
          isBuddyDiscountActive = !isBuddyDiscountActive;
          syncCalculator();
        }
      }
    });

    document.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;
      const calc = document.getElementById('kalkulator-balicku');
      if (!calc) return;

      if (target.classList?.contains('calc-duration-badge')) {
        const btn = target.closest<HTMLButtonElement>('.calc-duration-btn');
        if (btn) {
          if (currentMode === 'kids') {
            btn.setAttribute('data-badge-kids', target.textContent || '');
          } else {
            btn.setAttribute('data-badge-teens', target.textContent || '');
          }
        }
      } else if (target.id === 'calc-explanatory-note') {
        if (currentMode === 'kids') {
          calc.setAttribute('data-note-kids', target.innerHTML);
        } else {
          calc.setAttribute('data-note-teens', target.innerHTML);
        }
      } else if (target.id === 'calc-original-unit') {
        const num = parseInt((target.textContent || '').replace(/[^\d]/g, ''), 10);
        if (!isNaN(num) && num > 0) {
          if (currentMode === 'kids') {
            calc.setAttribute('data-base-price-kids', String(num));
          } else {
            calc.setAttribute('data-base-price-teens', String(num));
          }
          syncCalculator();
        }
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncCalculator);
    } else {
      syncCalculator();
    }
    document.addEventListener('astro:page-load', syncCalculator);

    let calcTimeout: any = null;
    const calcObserver = new MutationObserver((mutations) => {
      const isInternal = mutations.every(m => {
        const target = m.target as HTMLElement;
        return target && (
          target.id === 'calc-unit-price' ||
          target.id === 'calc-total-price' ||
          target.id === 'calc-total-savings' ||
          target.id === 'calc-total-discount-badge' ||
          target.id === 'calc-breakdown-pill' ||
          target.id === 'calc-cohort-display' ||
          target.id === 'calc-period-display' ||
          target.id === 'calc-freq-display' ||
          target.id === 'calc-lessons-display' ||
          target.id === 'calc-unit-saving' ||
          target.id === 'calc-original-unit' ||
          target.id === 'calc-explanatory-note' ||
          target.classList?.contains('calc-duration-badge') ||
          target.closest?.('.calc-duration-badge') !== null
        );
      });
      if (isInternal) return;

      clearTimeout(calcTimeout);
      calcTimeout = setTimeout(() => {
        syncCalculator();
      }, 50);
    });

    const bindCalcObserver = () => {
      calcObserver.disconnect();
      const calcRoot = document.getElementById('kalkulator');
      if (calcRoot) {
        calcObserver.observe(calcRoot, { childList: true, subtree: true, attributes: true });
      }
    };

    bindCalcObserver();
    document.addEventListener('astro:page-load', bindCalcObserver);
    document.addEventListener('astro:before-swap', () => {
      calcObserver.disconnect();
    });
  })();
</script>
