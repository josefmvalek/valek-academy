---
interface Stat {
  number: string;
  label: string;
}

interface Props {
  hero: {
    badge?: string;
    title?: string;
    subtitle?: string;
    ctaPrimaryText?: string;
    ctaPrimaryLink?: string;
    ctaSecondaryText?: string;
    ctaSecondaryLink?: string;
    stats?: Stat[];
  };
}

const { hero } = Astro.props;

const badge = hero.badge || "🎯 Individuální & firemní výuka angličtiny | Online i osobně";
const title = hero.title || "Rozmluvte se anglicky s lehkostí a bez strachu z chyb.";
const subtitle = hero.subtitle || "Přestaňte se učit poučky nazpaměť. Praktická angličtina šitá na míru vašim cílům – od každodenní konverzace a sebevědomí v práci až po úspěch u zkoušek a maturity.";
const ctaPrimaryText = hero.ctaPrimaryText || "Nezávazná úvodní lekce zdarma";
const ctaPrimaryLink = hero.ctaPrimaryLink || "#kontakt";
const ctaSecondaryText = hero.ctaSecondaryText || "Zobrazit ceník a balíčky";
const ctaSecondaryLink = hero.ctaSecondaryLink || "#cenik";
const stats = hero.stats || [
  { number: "10+ let", label: "aktivní lektorské praxe" },
  { number: "150+", label: "spokojených studentů" },
  { number: "4.9 / 5", label: "průměrné hodnocení studentů" },
  { number: "98 %", label: "úspěšnost u zkoušek a pohovorů" }
];
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden bg-hero-pattern">
  <!-- Subtle ambient decorative glow circles -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-brand-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[300px] h-[300px] bg-accent-600/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Trust Tagline Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glow-badge text-xs sm:text-sm font-semibold tracking-wide">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
          </span>
          <span>{badge}</span>
        </div>

        <!-- Main Punchy Headline -->
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-[1.12]">
          Rozmluvte se anglicky <span class="text-gradient-gold">s lehkostí</span> a bez strachu z chyb.
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          {subtitle}
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href={ctaPrimaryLink}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-display font-bold text-base text-navy-950 bg-gradient-to-r from-brand-400 to-brand-500 hover:from-brand-300 hover:to-brand-400 shadow-glow-brand transition-all hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            <span>{ctaPrimaryText}</span>
            <svg class="w-5 h-5 text-navy-950 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={ctaSecondaryLink}
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-2xl font-display font-semibold text-base text-slate-200 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 transition-all hover:border-slate-600 text-center"
          >
            {ctaSecondaryText}
          </a>
        </div>

        <!-- Quick Trust Indicators -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-6 pt-2 text-xs sm:text-sm text-slate-400 font-medium">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Nezávazně & bez poplatku</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>100% individuální přístup</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Učební materiály v ceně</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Card / Interactive Proof Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer glowing ambient ring -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-brand-500/30 to-accent-600/30 blur-xl opacity-70"></div>
          
          <!-- Main Profile / Proof Glass Card -->
          <div class="relative glass-card rounded-3xl p-6 sm:p-8 space-y-6">
            
            <!-- Tutor Badge Header -->
            <div class="flex items-center gap-4">
              <div class="relative">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-400 to-amber-600 p-0.5 shadow-lg">
                  <div class="w-full h-full rounded-[14px] bg-navy-900 flex items-center justify-center font-display font-extrabold text-2xl text-brand-400">
                    JV
                  </div>
                </div>
                <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-navy-950 flex items-center justify-center" title="Připraven k výuce">
                  <span class="w-2 h-2 rounded-full bg-white"></span>
                </div>
              </div>

              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-display font-bold text-xl text-white">Mgr. Josef Válek</h3>
                  <span class="text-xs font-semibold px-2 py-0.5 rounded bg-brand-500/20 text-brand-300 border border-brand-500/30">Lektor</span>
                </div>
                <p class="text-sm text-slate-400">10+ let praxe • TEFL metodika • Brno & Online</p>
                <div class="flex items-center gap-1 text-amber-400 text-xs mt-1">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                  <span class="text-slate-300 font-semibold ml-1">4.9 / 5.0</span>
                </div>
              </div>
            </div>

            <!-- Focus highlights -->
            <div class="space-y-3 pt-2">
              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5 font-bold text-sm">
                  🗣️
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white">Praktická konverzace</h4>
                  <p class="text-xs text-slate-400">Žádné memorování tabulek, ale okamžitá komunikace od 1. lekce.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                <div class="w-8 h-8 rounded-lg bg-accent-500/10 text-accent-400 flex items-center justify-center flex-shrink-0 mt-0.5 font-bold text-sm">
                  💼
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white">Business English & Kariéra</h4>
                  <p class="text-xs text-slate-400">Příprava na pohovory, meetingy, prezentace a e-maily pro zahraniční týmy.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-400 flex items-center justify-center flex-shrink-0 mt-0.5 font-bold text-sm">
                  🎓
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-white">Zkoušky & Maturita (98% úspěch)</h4>
                  <p class="text-xs text-slate-400">Cílený trénink Cambridge FCE, CAE i státní a profilové maturity.</p>
                </div>
              </div>
            </div>

            <!-- Live Availability Pill -->
            <div class="p-3.5 rounded-xl bg-gradient-to-r from-emerald-950/40 to-navy-900 border border-emerald-500/30 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-xs font-semibold text-emerald-300">Přijímám nové studenty pro tento semestr</span>
              </div>
              <a href="#kontakt" class="text-xs font-bold text-brand-400 hover:text-brand-300 hover:underline">
                Rezervovat →
              </a>
            </div>

          </div>

        </div>
      </div>

    </div>

    <!-- Social Proof Metrics Bar -->
    <div class="mt-16 sm:mt-24 pt-12 border-t border-slate-800/80">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {stats.map((item) => (
          <div class="glass-card rounded-2xl p-6 text-center group hover:border-brand-500/30 transition-all">
            <div class="font-display font-extrabold text-3xl sm:text-4xl text-gradient-gold tracking-tight group-hover:scale-105 transition-transform">
              {item.number}
            </div>
            <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1.5">
              {item.label}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
