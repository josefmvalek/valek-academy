---
import ParrotLogo from './ParrotLogo.astro';
import AudioPreview from './AudioPreview.astro';

interface Stat {
  number: string;
  label: string;
}

interface Props {
  hero: {
    badge?: string;
    title?: string;
    subtitle?: string;
    ctaPrimaryText?: string;
    ctaPrimaryLink?: string;
    ctaSecondaryText?: string;
    ctaSecondaryLink?: string;
    stats?: Stat[];
  };
}

const { hero } = Astro.props;

const badge = hero.badge || "ANGLIČTINA S ČECHOAUSTRALANEM • HRY • DESKOVKY • KONVERZACE";
const title = hero.title || "Hravá angličtina v malých skupinkách";
const subtitle = hero.subtitle || "Konec nudného biflování gramatických pouček u tabule. Josef Válek vyrůstal v Austrálii a otevírá v Uherském Hradišti doučovnu pro děti v přátelských malých skupinkách plnou deskových her, karet a přirozené konverzace s autentickým přízvukem.";
const ctaPrimaryText = hero.ctaPrimaryText || "Vyzkoušet 1. lekci zdarma";
const ctaPrimaryLink = hero.ctaPrimaryLink || "#kontakt";
const ctaSecondaryText = hero.ctaSecondaryText || "Jak výuka hrou funguje";
const ctaSecondaryLink = hero.ctaSecondaryLink || "#programy";
const stats = hero.stats || [
  { number: "1. lekce", label: "100% ZDARMA na vyzkoušení" },
  { number: "3–6 dětí", label: "v malé přátelské skupince" },
  { number: "Deskovky", label: "a hry dle zájmů dítěte" },
  { number: "Austrálie", label: "kde Josef vyrůstal (rodilý akcent)" }
];
---

<section class="relative pt-4 pb-6 sm:pt-8 sm:pb-10 md:pt-10 md:pb-12 overflow-hidden bg-gradient-to-b from-parchment-100/80 via-parchment-50 to-parchment-100/60 border-b border-parchment-200">
  
  <!-- Subtle decorative ambient circles in warm vintage gold and sky navy -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-amber-200/25 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-10 w-80 h-80 bg-blue-200/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-4 sm:space-y-6 text-center lg:text-left">

        <!-- Main Headline in Academy Serif Font -->
        <h1 class="font-academy font-black text-3xl sm:text-5xl lg:text-6xl text-espresso-950 tracking-tight leading-[1.14]">
          Hravá angličtina <br class="hidden sm:inline" />
          <span class="text-amber-800">v malých skupinkách</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-espresso-800/90 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          {subtitle}
        </p>

        <!-- Ornate Dark Banner Quote directly from the poster -->
        <div class="vintage-banner-dark rounded-2xl p-3.5 sm:p-5 shadow-md flex flex-col sm:flex-row items-center gap-3 sm:gap-4 text-center sm:text-left">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-2xl flex-shrink-0 text-amber-300">
            🎙️
          </div>
          <div class="space-y-1">
            <p class="text-xs sm:text-sm text-amber-100 font-medium italic leading-snug">
              „Vaše dítě či vnouče se pobaví, rozmluví, potlačí český přízvuk a získá plynulost a obratnost.“
            </p>
            <div class="text-[11px] font-extrabold uppercase tracking-wider text-amber-400">
              ★ DOPŘEJTE SVÉMU DÍTĚTI VÝHODU! ★
            </div>
          </div>
        </div>

        <!-- Program Category Filter Buttons (without scrabble tiles) -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 pt-0.5 text-xs">
          <a href="#program-zs" class="px-3 py-1.5 rounded-lg bg-amber-200/90 text-espresso-950 border border-amber-400 font-bold transition-colors flex items-center gap-1.5 shadow-xs">
            <span>🎲</span> <span>Děti ZŠ (Skupinky)</span>
            <span class="bg-amber-400 text-espresso-950 text-[10px] px-1.5 py-0.2 rounded font-extrabold">1. zdarma</span>
          </a>
          <a href="#program-dospeli" class="px-3 py-1.5 rounded-lg bg-parchment-100 hover:bg-parchment-200 text-espresso-700 border border-parchment-300 font-medium transition-colors flex items-center gap-1.5">
            <span>💼</span> <span>Dospělí</span>
            <span class="text-[10px] text-stone-500 bg-white px-1.5 py-0.2 rounded border border-parchment-300">brzy</span>
          </a>
          <a href="#program-ss" class="px-3 py-1.5 rounded-lg bg-parchment-100 hover:bg-parchment-200 text-espresso-700 border border-parchment-300 font-medium transition-colors flex items-center gap-1.5">
            <span>🎓</span> <span>Maturita</span>
            <span class="text-[10px] text-stone-500 bg-white px-1.5 py-0.2 rounded border border-parchment-300">brzy</span>
          </a>
          <a href="#scio" class="px-3 py-1.5 rounded-lg bg-parchment-100 hover:bg-parchment-200 text-espresso-700 border border-parchment-300 font-medium transition-colors flex items-center gap-1.5">
            <span>📐</span> <span>SCIO</span>
            <span class="text-[10px] text-stone-500 bg-white px-1.5 py-0.2 rounded border border-parchment-300">brzy</span>
          </a>
        </div>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-1 sm:pt-2">
          <a
            href={ctaPrimaryLink}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 sm:py-4 rounded-2xl font-display font-bold text-base text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 border border-amber-500 shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            <span>🎁 {ctaPrimaryText}</span>
            <svg class="w-5 h-5 text-espresso-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={ctaSecondaryLink}
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 sm:py-4 rounded-2xl font-display font-semibold text-base text-espresso-800 hover:text-espresso-950 bg-parchment-50 hover:bg-parchment-100 border border-parchment-300 shadow-xs transition-all hover:border-parchment-400 text-center"
          >
            {ctaSecondaryText}
          </a>
        </div>

        <!-- Key Trust Badges -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-5 pt-1 text-xs sm:text-sm text-espresso-800 font-medium">
          <div class="flex items-center gap-1.5">
            <span class="text-amber-700 font-bold text-base">🎁</span>
            <span class="font-bold text-espresso-950">1. lekce 100% ZDARMA</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-emerald-700 font-bold">✓</span>
            <span>Malé skupinky 3 až 6 dětí</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-emerald-700 font-bold">✓</span>
            <span>Všechny deskovky v ceně</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Academy Feature Card (clean, without poster preview) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer subtle warm golden aura -->
          <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-br from-amber-300/40 via-amber-100/30 to-blue-300/30 blur-xl opacity-70"></div>
          
          <!-- Main Academy Parchment Card -->
          <div class="relative bg-parchment-50 rounded-3xl p-5 sm:p-6 lg:p-7 shadow-soft-lg border-2 border-parchment-300 space-y-4">
            
            <!-- Instructor Profile Card Header -->
            <div class="p-3.5 sm:p-4 rounded-2xl bg-white border border-parchment-200 shadow-xs flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <ParrotLogo className="w-12 h-12 flex-shrink-0" />
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-academy font-bold text-base sm:text-lg text-espresso-950 leading-tight">
                      Josef Válek
                    </h3>
                  </div>
                  <p class="text-xs text-stone-600 font-medium mt-0.5">Vyrostl v Austrálii • 25+ let v ČR</p>
                  <p class="text-[11px] text-amber-800 font-semibold mt-0.5 flex items-center gap-1">
                    <span>🇦🇺</span> Autentický akcent & hravá výuka
                  </p>
                </div>
              </div>
              <div class="flex-shrink-0">
                <span class="text-[10px] uppercase font-bold bg-amber-100 text-amber-950 border border-amber-300 px-2 py-1 rounded-xl inline-block text-center shadow-2xs leading-tight">
                  1. lekce<br/>zdarma
                </span>
              </div>
            </div>

            <!-- Audio Preview Widget -->
            <AudioPreview />

            <!-- Highlight Benefits Micro-Grid -->
            <div class="grid grid-cols-2 gap-2.5 text-xs">
              <div class="p-3 rounded-xl bg-white border border-parchment-200/90 shadow-2xs flex items-start gap-2.5">
                <span class="text-lg leading-none">🎲</span>
                <div>
                  <div class="font-bold text-espresso-950">Výuka hrou</div>
                  <div class="text-[11px] text-stone-500 mt-0.5">Deskovky, kvízy & karty</div>
                </div>
              </div>
              <div class="p-3 rounded-xl bg-white border border-parchment-200/90 shadow-2xs flex items-start gap-2.5">
                <span class="text-lg leading-none">👥</span>
                <div>
                  <div class="font-bold text-espresso-950">Skupinky 3–6</div>
                  <div class="text-[11px] text-stone-500 mt-0.5">Žádný strach z mluvení</div>
                </div>
              </div>
            </div>

            <!-- Availability banner -->
            <div class="p-3 rounded-xl bg-emerald-50/90 border border-emerald-300/80 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-ping"></span>
                <span class="text-xs font-bold text-emerald-950">Otevřeno pro zápis dětí</span>
              </div>
              <a href="#kontakt" class="text-xs font-bold text-emerald-800 hover:text-emerald-950 underline flex-shrink-0">
                Vyzkoušet zdarma →
              </a>
            </div>

          </div>

        </div>
      </div>

    </div>

    <!-- Social Proof Metrics Bar with Compact Mobile Spacing -->
    <div class="mt-4 sm:mt-8 pt-4 sm:pt-6 border-t border-parchment-200/80">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 lg:gap-6">
        {stats.map((item) => (
          <div class="bg-parchment-50 rounded-xl sm:rounded-2xl p-3 sm:p-4 lg:p-5 text-center border border-parchment-200 shadow-xs hover:border-amber-400 hover:shadow-sm transition-all">
            <div class="font-academy font-extrabold text-xl sm:text-2xl lg:text-3xl text-espresso-950 tracking-tight">
              {item.number}
            </div>
            <div class="text-xs sm:text-sm text-espresso-800/80 font-medium mt-0.5 sm:mt-1">
              {item.label}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
