---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  ctaText?: string;
  ctaLink?: string;
  stickyCta?: any;
}

const {
  ctaText = "🎁 1. ukázková lekce 100% ZDARMA",
  ctaLink = "#kontakt",
  stickyCta = {}
} = Astro.props;

const text = stickyCta.text || ctaText || "🎁 1. ukázková lekce 100% ZDARMA";
const link = stickyCta.link || ctaLink || "#kontakt";
---

<!-- Floating Bottom Bar for Mobile Devices -->
<aside
  id="mobile-sticky-cta"
  class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-surface-base/95 backdrop-blur-md border-t border-surface-border shadow-card-lift px-4 py-3 transition-transform duration-300 translate-y-0"
  aria-label="Rychlá akce: Rezervace lekce zdarma"
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    <a
      href={link}
      id="mobile-sticky-cta-btn"
      class="btn-gold-pulse shadow-dice-btn active:shadow-dice-btn-active w-full py-3.5 px-4 rounded-card-md font-heading font-black text-xs sm:text-sm text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-500 flex items-center justify-center gap-2 text-center cursor-pointer transition-transform"
      data-tina-field={stickyCta ? tinaField(stickyCta, 'text') : undefined}
    >
      <span data-edit-key="stickyCta.text" data-edit-label="Mobilní lišta text">{text}</span>
      <span class="font-black text-espresso-950">→</span>
    </a>
  </div>
</aside>

<script>
  function initMobileStickyCta() {
    const bar = document.getElementById('mobile-sticky-cta');
    const contactSection = document.getElementById('kontakt');

    if (!bar || !contactSection) return;

    // Smooth scroll handler
    const btn = document.getElementById('mobile-sticky-cta-btn');
    if (btn) {
      btn.addEventListener('click', (e) => {
        const href = btn.getAttribute('href');
        if (href && href.startsWith('#')) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }

    // Auto-hide when user is already at the contact form & adjust WhatsApp widget position
    const waWidget = document.getElementById('floating-whatsapp-widget');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          bar.classList.add('translate-y-full');
          if (waWidget) {
            waWidget.classList.remove('bottom-20');
            waWidget.classList.add('bottom-4');
          }
        } else {
          bar.classList.remove('translate-y-full');
          if (waWidget) {
            waWidget.classList.remove('bottom-4');
            waWidget.classList.add('bottom-20');
          }
        }
      });
    }, { threshold: 0.15 });

    observer.observe(contactSection);
  }

  document.addEventListener('DOMContentLoaded', initMobileStickyCta);
  document.addEventListener('astro:page-load', initMobileStickyCta);
</script>
