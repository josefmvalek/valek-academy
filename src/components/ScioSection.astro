---
interface Props {
  scio: {
    badge?: string;
    title?: string;
    subtitle?: string;
    tagline?: string;
    features?: string[];
    ctaText?: string;
    ctaLink?: string;
  };
}

const { scio } = Astro.props;

const badge = scio.badge || "PŘIPRAVUJEME BRZY";
const title = scio.title || "Příprava na přijímací zkoušky na SŠ a SCIO testy";
const subtitle = scio.subtitle || "Kromě angličtiny plánujeme také klidné a trpělivé procvičování jednotných přijímaček (CERMAT / SCIO) z Českého jazyka a Matematiky pro žáky 5. a 9. tříd.";
const tagline = scio.tagline || "Dostaňte se na střední školu nebo gymnázium v klidu a se správnou strategií.";
const features = scio.features || [
  "Rozbor typových testových úloh z matematiky a češtiny",
  "Osvědčené postupy a strategie pro zvládnutí časového limitu",
  "Pravidelné testy nanečisto s detailním rozborem každé chyby",
  "Trpělivé vysvětlení logiky úloh bez paniky a zbytečného tlaku"
];
const ctaText = scio.ctaText || "Předběžně se zapsat na čekací listinu";
const ctaLink = scio.ctaLink || "#kontakt";
---

<section id="scio" class="py-10 md:py-14 relative bg-gradient-to-b from-parchment-50 via-parchment-100/50 to-parchment-50 border-y border-parchment-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-white rounded-3xl p-6 sm:p-10 md:p-12 border-2 border-parchment-300 shadow-soft-lg relative overflow-hidden">
      
      <!-- Subtle top-right decorative shape -->
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-100/40 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-bold uppercase tracking-wider text-espresso-900">
            <span>🎯</span> <span>{badge}</span>
          </div>

          <h2 class="font-academy font-bold text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight leading-tight">
            {title}
          </h2>

          <p class="text-base sm:text-lg text-espresso-800/90 leading-relaxed">
            {subtitle}
          </p>

          <div class="p-4 rounded-2xl bg-parchment-100 border border-parchment-300 text-espresso-950 font-medium text-sm">
            💡 {tagline}
          </div>

          <!-- Feature Grid -->
          <div class="grid sm:grid-cols-2 gap-4 pt-2">
            {features.map((feat, idx) => (
              <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                  {idx + 1}
                </div>
                <p class="text-xs sm:text-sm text-slate-700 font-medium leading-snug">
                  {feat}
                </p>
              </div>
            ))}
          </div>

          <div class="pt-4">
            <a
              href={ctaLink}
              class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-display font-bold text-base text-white bg-blue-700 hover:bg-blue-800 shadow-md transition-all hover:scale-[1.02] active:scale-[0.98]"
            >
              <span>{ctaText}</span>
              <span>→</span>
            </a>
            <span class="block sm:inline sm:ml-4 text-xs text-slate-500 mt-2 sm:mt-0">
              * Zápis na čekací listinu je zcela nezávazný
            </span>
          </div>

        </div>

        <!-- Right: Subjects Showcase Card -->
        <div class="lg:col-span-5">
          <div class="bg-gradient-to-br from-oxford-900 to-oxford-950 text-white rounded-3xl p-8 sm:p-10 shadow-xl space-y-6">
            
            <div class="flex items-center justify-between pb-4 border-b border-white/10">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Přijímačky na SŠ</span>
              <span class="text-xs bg-amber-400/20 text-amber-300 border border-amber-400/30 px-2.5 py-1 rounded-full font-bold">Připravujeme brzy</span>
            </div>

            <!-- Subject 1: Czech -->
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
              <div class="flex items-center gap-3">
                <span class="text-2xl">📖</span>
                <div>
                  <h4 class="font-display font-bold text-base text-white">Český jazyk a literatura</h4>
                  <p class="text-xs text-slate-300">Čtenářská gramotnost, pravopis a rozbor textu</p>
                </div>
              </div>
              <p class="text-xs text-slate-400 pl-9">
                Cílený nácvik na záludné úlohy s porozuměním textu a syntaktické rozbory vět.
              </p>
            </div>

            <!-- Subject 2: Math -->
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
              <div class="flex items-center gap-3">
                <span class="text-2xl">📐</span>
                <div>
                  <h4 class="font-display font-bold text-base text-white">Matematika & Geometrie</h4>
                  <p class="text-xs text-slate-300">Logické úlohy, zlomky, rovnice a konstrukce</p>
                </div>
              </div>
              <p class="text-xs text-slate-400 pl-9">
                Srozumitelný postup krok za krokem. Žádné memorování vzorců bez pochopení souvislostí.
              </p>
            </div>

            <div class="text-center pt-2">
              <p class="text-xs text-slate-400">
                Přípravu vede zkušený pedagog s trpělivým a povzbudivým přístupem.
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
</section>
