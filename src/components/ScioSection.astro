---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface Props {
  scio: {
    badge?: string;
    title?: string;
    subtitle?: string;
    tagline?: string;
    features?: string[];
    ctaText?: string;
    ctaLink?: string;
    [key: string]: any;
  };
}

const { scio } = Astro.props;

const badge = scio.badge || "PŘIPRAVUJEME PRO DALŠÍ SEMESTR";
const title = scio.title || "Příprava na přijímací zkoušky na SŠ a SCIO testy";
const subtitle = scio.subtitle || "Kromě angličtiny plánujeme také klidné a trpělivé procvičování jednotných přijímaček (CERMAT / SCIO) z Českého jazyka a Matematiky pro žáky 5. a 9. tříd.";
const tagline = scio.tagline || "Dostaňte se na střední školu nebo gymnázium v klidu a se správnou strategií.";
const features = scio.features || [
  "Rozbor typových testových úloh z matematiky a češtiny",
  "Osvědčené postupy a strategie pro zvládnutí časového limitu",
  "Pravidelné testy nanečisto s detailním rozborem každé chyby",
  "Trpělivé vysvětlení logiky úloh bez paniky a zbytečného tlaku"
];
const ctaText = scio.ctaText || "Předběžně se zapsat na čekací listinu";
const ctaLink = scio.ctaLink || "#kontakt";
const guaranteeNote = scio.guaranteeNote || "* Zápis je 100% nezávazný, dáme vám vědět přednostně";
const subjectsTitle = scio.subjectsTitle || "Přijímačky na SŠ (5. & 9. třída)";
const subjectsBadge = scio.subjectsBadge || "Čekací listina";
const subjectsNote = scio.subjectsNote || "Přípravu v Uherském Hradišti vede zkušený pedagog s klidným a trpělivým přístupem.";
const subjects = scio.subjects || [
  {
    icon: "📖",
    title: "Český jazyk a literatura",
    subtitle: "Čtenářská gramotnost, pravopis a rozbory vět",
    desc: "Cílený nácvik na záludné úlohy s porozuměním textu a syntaktické rozbory vět bez stresu."
  },
  {
    icon: "📐",
    title: "Matematika & Geometrie",
    subtitle: "Logické úlohy, zlomky, rovnice a konstrukce",
    desc: "Srozumitelný postup krok za krokem. Žádné memorování vzorců bez pochopení souvislostí."
  }
];
---

<section id="scio" class="py-12 md:py-16 relative bg-gradient-to-b from-white via-parchment-100/50 to-white border-y border-parchment-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-gradient-to-br from-[#FFFDF9] via-white to-parchment-50 rounded-3xl p-6 sm:10 md:p-12 border-2 border-amber-300/80 shadow-soft-lg relative overflow-hidden">
      
      <!-- Subtle ambient glow -->
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-200/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        
        <!-- Left: Copy & Bullet Points -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-xs font-extrabold uppercase tracking-wider text-amber-950" data-tina-field={tinaField(scio, 'badge')} data-edit-key="scio.badge" data-edit-label="Štítek SCIO">
            <span>🎯</span> <span>{badge}</span>
          </div>

          <h2 class="font-academy font-black text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight leading-tight" data-tina-field={tinaField(scio, 'title')} data-edit-key="scio.title" data-edit-label="Nadpis SCIO" set:html={formatRichText(title)}>
          </h2>

          <p class="text-base sm:text-lg text-espresso-800/90 leading-relaxed" data-tina-field={tinaField(scio, 'subtitle')} data-edit-key="scio.subtitle" data-edit-label="Podnadpis SCIO" set:html={formatRichText(subtitle)}>
          </p>

          <div class="p-4 rounded-2xl bg-amber-50 border border-amber-300 text-espresso-950 font-bold text-sm flex items-center gap-2.5" data-tina-field={tinaField(scio, 'tagline')}>
            <span class="text-lg">💡</span> <span data-edit-key="scio.tagline" data-edit-label="Slogan SCIO" set:html={formatRichText(tagline)}></span>
          </div>

          <!-- Feature Grid -->
          <div class="grid sm:grid-cols-2 gap-3.5 pt-1" data-tina-field={tinaField(scio, 'features')}>
            {features.map((feat: string, idx: number) => (
              <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-parchment-300 shadow-2xs">
                <div class="w-7 h-7 rounded-lg bg-amber-400 text-espresso-950 flex items-center justify-center font-black text-xs flex-shrink-0 mt-0.5">
                  {idx + 1}
                </div>
                <p class="text-xs sm:text-sm text-espresso-900 font-medium leading-snug" data-edit-key={`scio.features.${idx}`} data-edit-label="Bod přípravy" set:html={formatRichText(feat)}>
                </p>
              </div>
            ))}
          </div>

          <div class="pt-3 flex flex-wrap items-center gap-4">
            <a
              href={ctaLink}
              id="scio-cta"
              class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-heading font-black text-base text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 border border-amber-600 shadow-md transition-all hover:scale-105 active:scale-95 cursor-pointer"
            >
              <span data-tina-field={tinaField(scio, 'ctaText')} data-edit-key="scio.ctaText" data-edit-label="Tlačítko SCIO">{ctaText}</span>
              <span>→</span>
            </a>
            <span class="text-xs text-stone-500 font-medium" data-tina-field={tinaField(scio, 'guaranteeNote')} data-edit-key="scio.guaranteeNote" data-edit-label="Garanční poznámka SCIO" set:html={formatRichText(guaranteeNote)}>
            </span>
          </div>

        </div>

        <!-- Right: Subjects Showcase Card in Elegant Vintage Navy & Amber -->
        <div class="lg:col-span-5">
          <div class="bg-gradient-to-br from-[#1C2833] via-espresso-950 to-[#120A05] text-white rounded-3xl p-7 sm:p-9 shadow-xl border-2 border-amber-500/30 space-y-5">
            
            <div class="flex items-center justify-between pb-4 border-b border-white/10">
              <span class="text-xs font-black uppercase tracking-wider text-amber-300 flex items-center gap-1.5">
                <span>📐</span> <span data-tina-field={tinaField(scio, 'subjectsTitle')} data-edit-key="scio.subjectsTitle" data-edit-label="Nadpis předmětů SCIO">{subjectsTitle}</span>
              </span>
              <span class="text-[10px] bg-amber-400/20 text-amber-300 border border-amber-400/30 px-2.5 py-0.5 rounded-full font-bold" data-tina-field={tinaField(scio, 'subjectsBadge')} data-edit-key="scio.subjectsBadge" data-edit-label="Štítek předmětů SCIO">
                {subjectsBadge}
              </span>
            </div>

            <!-- Subjects list -->
            {subjects.map((subj: any, idx: number) => (
              <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-1.5" data-tina-field={tinaField(subj, 'title')}>
                <div class="flex items-center gap-3">
                  <span class="text-2xl" data-edit-key={`scio.subjects.${idx}.icon`}>{subj.icon || "📖"}</span>
                  <div>
                    <h4 class="font-heading font-black text-base text-white" data-edit-key={`scio.subjects.${idx}.title`} data-edit-label="Název předmětu" set:html={formatRichText(subj.title)}></h4>
                    {subj.subtitle && <p class="text-xs text-amber-200/80" data-edit-key={`scio.subjects.${idx}.subtitle`} data-edit-label="Podtitul předmětu" set:html={formatRichText(subj.subtitle)}></p>}
                  </div>
                </div>
                {subj.desc && <p class="text-xs text-stone-300 pl-9 leading-relaxed" data-edit-key={`scio.subjects.${idx}.desc`} data-edit-label="Popis předmětu" set:html={formatRichText(subj.desc)}></p>}
              </div>
            ))}

            <div class="text-center pt-2 border-t border-white/10">
              <p class="text-xs text-stone-400" data-tina-field={tinaField(scio, 'subjectsNote')} data-edit-key="scio.subjectsNote" data-edit-label="Poznámka předmětů SCIO" set:html={formatRichText(subjectsNote)}>
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const scioBtn = document.getElementById('scio-cta');
  const segmentSelect = document.getElementById('segment-select') as HTMLSelectElement | null;

  scioBtn?.addEventListener('click', () => {
    if (segmentSelect) {
      segmentSelect.selectedIndex = 3; // SCIO testy
    }
  });
</script>
