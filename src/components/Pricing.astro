---
interface Tier {
  name: string;
  price: string;
  period: string;
  description: string;
  isPopular?: boolean;
  badge?: string;
  features?: string[];
  ctaText?: string;
  ctaLink?: string;
}

interface Props {
  pricing: {
    badge?: string;
    title?: string;
    subtitle?: string;
    guarantee?: string;
    tiers?: Tier[];
  };
}

const { pricing } = Astro.props;

const badge = pricing.badge || "JASNÝ CENÍK";
const title = pricing.title || "Férové ceny bez skrytých poplatků a závazků";
const subtitle = pricing.subtitle || "Začněte nezávaznou 20minutovou konzultací zdarma a sami se rozhodněte, jaký formát vám bude vyhovovat.";
const guarantee = pricing.guarantee || "💡 Garance spokojenosti: Pokud po 1. placené lekci nebudete spokojeni, vrátím vám 100 % částky zpět.";
const tiers = pricing.tiers || [];
---

<section id="cenik" class="py-20 md:py-32 relative bg-navy-900/60 border-t border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glow-badge text-xs font-semibold uppercase tracking-wider">
        {badge}
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
        {title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <!-- Pricing Tiers Grid -->
    <div class="grid lg:grid-cols-3 gap-8 items-stretch">
      {tiers.map((tier) => {
        const isPopular = tier.isPopular;
        return (
          <div class={`rounded-3xl p-8 sm:p-10 flex flex-col justify-between relative transition-all duration-300 ${
            isPopular
              ? 'bg-gradient-to-b from-navy-850 to-slate-900 border-2 border-brand-400 shadow-glow-brand lg:-translate-y-3 z-10'
              : 'glass-card border border-slate-700/60 hover:border-slate-600'
          }`}>
            
            <!-- Popular Ribbon / Badge -->
            {isPopular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-gradient-to-r from-brand-400 to-amber-500 text-navy-950 shadow-md">
                  ★ {tier.badge || "Nejoblíbenější"}
                </span>
              </div>
            )}

            <div class="space-y-6">
              <!-- Tier Top info -->
              <div>
                {!isPopular && tier.badge && (
                  <span class="inline-block text-xs font-bold text-brand-400 tracking-wider uppercase mb-2">
                    {tier.badge}
                  </span>
                )}
                <h3 class="font-display font-bold text-2xl text-white">
                  {tier.name}
                </h3>
                <p class="text-sm text-slate-400 mt-2 min-h-[40px]">
                  {tier.description}
                </p>
              </div>

              <!-- Price Display -->
              <div class="pt-4 pb-2 border-y border-slate-800 flex items-baseline gap-2">
                <span class="font-display font-black text-4xl sm:text-5xl text-white tracking-tight">
                  {tier.price}
                </span>
                <span class="text-sm text-slate-400 font-medium">
                  {tier.period}
                </span>
              </div>

              <!-- Features list -->
              <div class="space-y-3">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Balíček obsahuje:</div>
                <ul class="space-y-3">
                  {(tier.features || []).map((feat) => (
                    <li class="flex items-start gap-3 text-sm text-slate-300">
                      <svg class={`w-4 h-4 flex-shrink-0 mt-0.5 ${isPopular ? 'text-brand-400' : 'text-emerald-400'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-8 mt-8 border-t border-slate-800">
              <a
                href={tier.ctaLink || "#kontakt"}
                class={`w-full inline-flex items-center justify-center py-4 px-6 rounded-2xl font-display font-bold text-base transition-all text-center ${
                  isPopular
                    ? 'bg-gradient-to-r from-brand-400 to-brand-500 hover:from-brand-300 hover:to-brand-400 text-navy-950 shadow-glow-brand hover:scale-105 active:scale-95'
                    : 'bg-slate-800 hover:bg-slate-700 text-white border border-slate-700'
                }`}
              >
                {tier.ctaText || "Vybrat tento balíček"}
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Guarantee Banner -->
    <div class="mt-16 max-w-3xl mx-auto text-center">
      <div class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 text-slate-300 text-sm sm:text-base leading-relaxed">
        {guarantee}
      </div>
    </div>

  </div>
</section>
