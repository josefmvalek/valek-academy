---
import { tinaField } from '@tinacms/astro/tina-field';

interface Tier {
  [key: string]: any;
  name: string;
  price: string;
  period: string;
  description: string;
  isPopular?: boolean;
  badge?: string;
  features?: string[];
  ctaText?: string;
  ctaLink?: string;
}

interface Pillar {
  [key: string]: any;
  icon?: string;
  title: string;
  desc: string;
}

interface Props {
  pricing: {
    badge?: string;
    title?: string;
    subtitle?: string;
    guarantee?: string;
    tiers?: Tier[] | Record<string, Tier>;
    pillars?: Pillar[];
  };
}

const { pricing = {} } = Astro.props;

const badge = pricing.badge || "CENÍK & 1. LEKCE ZDARMA";
const title = pricing.title || "Transparentní ceny – pro děti 1. lekce zcela zdarma";
const subtitle = pricing.subtitle || "Pro děti na ZŠ je 1. celá lekce v malé skupince 100% ZDARMA. Ostatní programy otevřeme brzy (můžete se nezávazně zapsat na čekací listinu).";
const guarantee = pricing.guarantee || "🎁 1. LEKCE 100% ZDARMA & FÉROVÉ ZÁRUKY: Přijďte si s dítětem nezávazně zahrát deskovky a vyzkoušet atmosféru v malé skupince. Žádné platby předem ani skryté závazky.";
const rawTiers = pricing.tiers;
const tiers: Tier[] = Array.isArray(rawTiers)
  ? (rawTiers as Tier[])
  : rawTiers && typeof rawTiers === 'object'
    ? (Object.values(rawTiers) as Tier[])
    : [];

const defaultPillars: Pillar[] = [
  {
    icon: "🛡️",
    title: "Náhrady při nemoci",
    desc: "Lekce vám nepropadne – možnost připojení online z domova nebo náhrada v paralelní skupince."
  },
  {
    icon: "📝",
    title: "Bez smluv na pololetí",
    desc: "Žádné vázání na půl roku dopředu ani platby naslepo. Platíte flexibilně měsíčně až po 1. lekci."
  },
  {
    icon: "🎁",
    title: "1. lekce 100% zdarma",
    desc: "Celých 60 minut hrou v malé skupince na vyzkoušení bez jakýchkoliv závazků."
  }
];

const pillars = pricing.pillars || defaultPillars;
---

<section id="cenik" class="py-8 sm:py-12 md:py-16 relative bg-[#FDFBF7] border-t border-parchment-300 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-6 md:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-bold uppercase tracking-wider text-espresso-950" data-tina-field={tinaField(pricing, 'badge')} data-edit-key="pricing.badge" data-edit-label="Štítek ceníku">
        {badge}
      </div>
      <h2 class="font-heading font-black text-2xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight" data-tina-field={tinaField(pricing, 'title')} data-edit-key="pricing.title" data-edit-label="Nadpis ceníku">
        {title}
      </h2>
      <p class="text-espresso-800/80 text-sm sm:text-lg" data-tina-field={tinaField(pricing, 'subtitle')} data-edit-key="pricing.subtitle" data-edit-label="Podnadpis ceníku">
        {subtitle}
      </p>
    </div>

    <!-- Mobile Tier Switcher Tabs (Cuts scrolling on phones and lets users easily check upcoming programs) -->
    <div class="lg:hidden mb-6">
      <div class="text-center text-[11px] font-black uppercase tracking-wider text-amber-950/80 mb-2">
        Vyberte kategorii ceníku:
      </div>
      <div class="grid grid-cols-3 gap-1.5 p-1.5 rounded-2xl bg-parchment-200 border border-parchment-300 shadow-2xs" id="pricing-tabs">
        {tiers.map((_, idx) => (
          <button
            type="button"
            class:list={[
              "pricing-tab-btn py-2.5 px-1.5 rounded-xl font-heading text-xs transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer",
              idx === 0
                ? "bg-amber-400 text-espresso-950 shadow-xs border border-amber-500 font-black"
                : "bg-transparent text-espresso-800 hover:text-espresso-950 font-bold border border-transparent"
            ]}
            data-target={`pricing-tier-${idx}`}
          >
            <span class="text-base">{idx === 0 ? "🎒" : idx === 1 ? "💼" : "🎓"}</span>
            <span class="truncate font-black text-[11px]">{idx === 0 ? "Děti ZŠ" : idx === 1 ? "Dospělí" : "Maturita"}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Pricing Tiers Grid -->
    <div class="grid lg:grid-cols-3 gap-6 sm:gap-8 items-stretch" id="pricing-grid">
      {tiers.map((tier, idx) => {
        const isPopular = tier.isPopular;
        return (
          <div
            id={`pricing-tier-${idx}`}
            data-tina-field={tinaField(pricing, 'tiers', idx)}
            class:list={[
              "pricing-card rounded-3xl p-6 sm:p-8 md:p-10 flex-col justify-between relative transition-all duration-300",
              idx === 0 ? "flex lg:flex" : "hidden lg:flex",
              isPopular
                ? "bg-gradient-to-b from-[#FFFDF9] via-white to-[#FFFDF9] border-2 border-amber-400 shadow-xl glow-amber lg:-translate-y-3 z-10"
                : "bg-white border border-parchment-300 shadow-xs opacity-90 hover:opacity-100 hover:shadow-md"
            ]}
          >
            
            <!-- Popular Ribbon / Badge -->
            {isPopular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap">
                <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-400 text-espresso-950 shadow-md" data-tina-field={tinaField(tier, 'badge')} data-edit-key={`pricing.tiers.${idx}.badge`} data-edit-label="Štítek karty">
                  {!tier.badge?.includes('🎁') && <span>🎁</span>}
                  <span>{tier.badge || "1. LEKCE ZDARMA"}</span>
                </span>
              </div>
            )}

            <div class="space-y-6">
              <!-- Tier Top info -->
              <div>
                {!isPopular && (
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-stone-600 bg-parchment-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider mb-2 border border-parchment-300" data-tina-field={tinaField(tier, 'badge')}>
                    <span>⏳</span> <span>{tier.badge || "Připravujeme brzy"}</span>
                  </span>
                )}
                <h3 class="font-heading font-black text-2xl text-espresso-950" data-tina-field={tinaField(tier, 'name')} data-edit-key={`pricing.tiers.${idx}.name`} data-edit-label="Název programu">
                  {tier.name}
                </h3>
                <p class="text-sm text-espresso-800/80 mt-2 min-h-[40px]" data-tina-field={tinaField(tier, 'description')} data-edit-key={`pricing.tiers.${idx}.description`} data-edit-label="Popis programu">
                  {tier.description}
                </p>
              </div>

              <!-- Price Display (Keeps 390 Kč strictly together on one line) -->
              <div class="pt-4 pb-2 border-y border-parchment-200 flex flex-wrap sm:flex-nowrap items-baseline gap-x-3 gap-y-1">
                <span class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight whitespace-nowrap shrink-0" data-tina-field={tinaField(tier, 'price')} data-edit-key={`pricing.tiers.${idx}.price`} data-edit-label="Cena">
                  {tier.price}
                </span>
                <span class="text-xs sm:text-sm text-stone-500 font-medium" data-tina-field={tinaField(tier, 'period')} data-edit-key={`pricing.tiers.${idx}.period`} data-edit-label="Období">
                  {tier.period}
                </span>
              </div>

              <!-- Features list -->
              <div class="space-y-3" data-tina-field={tinaField(tier, 'features')}>
                <div class="text-xs font-bold uppercase tracking-wider text-stone-400">Balíček obsahuje:</div>
                <ul class="space-y-3">
                  {(tier.features || []).map((feat, fIdx) => (
                    <li class="flex items-start gap-3 text-sm text-espresso-800">
                      <svg class={`w-4 h-4 flex-shrink-0 mt-0.5 ${isPopular ? 'text-amber-600' : 'text-emerald-600'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span data-edit-key={`pricing.tiers.${idx}.features.${fIdx}`} data-edit-label="Položka v ceně">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-8 mt-8 border-t border-parchment-200">
              <a
                href={tier.ctaLink || "#kontakt"}
                class={`w-full inline-flex items-center justify-center py-4 px-6 rounded-2xl font-heading font-black text-base transition-all text-center cursor-pointer ${
                  isPopular
                    ? 'btn-gold-pulse bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 text-espresso-950 border border-amber-500'
                    : 'bg-parchment-100 hover:bg-parchment-200 text-espresso-950 border border-parchment-300'
                }`}
                data-tina-field={tinaField(tier, 'ctaText')}
                data-edit-key={`pricing.tiers.${idx}.ctaText`}
                data-edit-label="Text tlačítka"
              >
                {tier.ctaText || (isPopular ? "🎁 Vyzkoušet 1. lekci zdarma" : "Zapsat se na čekací listinu")}
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Fairness & Flexibility Pillars -->
    <div class="mt-10 sm:mt-14 max-w-4xl mx-auto space-y-5">
      <div class="grid sm:grid-cols-3 gap-3.5">
        {pillars.map((pillar, pIdx) => (
          <div
            data-tina-field={tinaField(pricing, 'pillars', pIdx)}
            class="bg-white/90 rounded-2xl p-4 border border-amber-300/80 shadow-2xs text-center space-y-1.5 hover:border-amber-400 transition-colors"
          >
            <div class="text-2xl">{pillar.icon}</div>
            <h4 class="font-heading font-black text-xs sm:text-sm text-espresso-950" data-tina-field={tinaField(pillar, 'title')} data-edit-key={`pricing.pillars.${pIdx}.title`} data-edit-label="Název garance">
              {pillar.title}
            </h4>
            <p class="text-[11px] text-espresso-800/80 leading-snug" data-tina-field={tinaField(pillar, 'desc')} data-edit-key={`pricing.pillars.${pIdx}.desc`} data-edit-label="Popis garance">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Main Guarantee Callout -->
      <div class="text-center">
        <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-amber-100/90 via-white to-amber-100/90 border-2 border-amber-300/90 text-espresso-950 text-xs sm:text-sm md:text-base leading-relaxed font-bold shadow-xs" data-tina-field={tinaField(pricing, 'guarantee')} data-edit-key="pricing.guarantee" data-edit-label="Garance ceníku">
          {guarantee}
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initPricingTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.pricing-tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('.pricing-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');
        if (!targetId) return;

        // Reset all tabs
        tabs.forEach(t => {
          t.classList.remove('bg-amber-400', 'text-espresso-950', 'shadow-xs', 'border-amber-500', 'font-black');
          t.classList.add('bg-transparent', 'text-espresso-800', 'font-bold', 'border-transparent');
        });

        // Activate clicked tab
        tab.classList.remove('bg-transparent', 'text-espresso-800', 'font-bold', 'border-transparent');
        tab.classList.add('bg-amber-400', 'text-espresso-950', 'shadow-xs', 'border-amber-500', 'font-black');

        // Toggle card visibility on mobile
        cards.forEach(card => {
          if (card.id === targetId) {
            card.classList.remove('hidden');
            card.classList.add('flex');
          } else {
            card.classList.remove('flex');
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initPricingTabs);
  document.addEventListener('astro:page-load', initPricingTabs);
</script>

