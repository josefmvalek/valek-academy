---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface Tier {
  [key: string]: any;
  name: string;
  price: string;
  period: string;
  description: string;
  isPopular?: boolean;
  badge?: string;
  features?: string[];
  ctaText?: string;
  ctaLink?: string;
}

interface Pillar {
  [key: string]: any;
  icon?: string;
  title: string;
  desc: string;
}

interface Props {
  pricing: {
    [key: string]: any;
    badge?: string;
    title?: string;
    subtitle?: string;
    tabsLabel?: string;
    featuresLabel?: string;
    guarantee?: string;
    tiers?: Tier[] | Record<string, Tier>;
    pillars?: Pillar[];
    calculator?: any;
  };
}

const { pricing = {} } = Astro.props;

const badge = pricing.badge || "CENÍK & 1. LEKCE ZDARMA";
const title = pricing.title || "Transparentní ceny – pro děti 1. lekce zcela zdarma";
const subtitle = pricing.subtitle || "Pro děti na ZŠ je 1. celá lekce v malé skupince 100% ZDARMA. Ostatní programy otevřeme brzy (můžete se nezávazně zapsat na čekací listinu).";
const tabsLabel = pricing.tabsLabel || "Vyberte kategorii ceníku:";
const featuresLabel = pricing.featuresLabel || "Balíček obsahuje:";
const guarantee = pricing.guarantee || "🎁 1. LEKCE 100% ZDARMA & FÉROVÉ ZÁRUKY: Přijďte si s dítětem nezávazně zahrát deskovky a vyzkoušet atmosféru v malé skupince. Žádné platby předem ani skryté závazky.";
const fullPricingBtnText = pricing.fullPricingBtnText || "Otevřít podrobný a kompletní ceník všech programů & slev";
const fullPricingBtnNote = pricing.fullPricingBtnNote || "Samostatná stránka s detailním rozpadem cen pro 1. i 2. stupeň, dospělé, kalkulátorem a platebními podmínkami.";
const fullPricingBtnLink = pricing.fullPricingBtnLink || "/cenik";
const rawTiers = pricing.tiers;
const tiers: Tier[] = Array.isArray(rawTiers)
  ? (rawTiers as Tier[])
  : rawTiers && typeof rawTiers === 'object'
    ? (Object.values(rawTiers) as Tier[])
    : [];

const defaultPillars: Pillar[] = [
  {
    icon: "🛡️",
    title: "Náhrady při nemoci",
    desc: "Lekce vám nepropadne – při omluvě bezplatná náhrada v paralelní prezenční skupince v jiný den."
  },
  {
    icon: "📝",
    title: "Bez smluv na pololetí",
    desc: "Žádné vázání na půl roku dopředu ani platby naslepo. Platíte flexibilně měsíčně až po 1. lekci."
  },
  {
    icon: "🎁",
    title: "1. lekce 100% zdarma",
    desc: "Celých 60 minut hrou v malé skupince na vyzkoušení bez jakýchkoliv závazků."
  }
];

const pillars = pricing.pillars || defaultPillars;
---

<section id="cenik" class="py-8 sm:py-12 md:py-16 relative bg-[#FDFBF7] border-t border-parchment-300 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-6 md:mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full vintage-ribbon text-xs font-black uppercase tracking-wider text-espresso-950 shadow-xs" data-tina-field={tinaField(pricing, 'badge')} data-edit-key="pricing.badge" data-edit-label="Štítek ceníku">
        {badge}
      </div>
      <h2 class="font-heading font-black text-fluid-h2 text-espresso-950 tracking-tight" data-tina-field={tinaField(pricing, 'title')} data-edit-key="pricing.title" data-edit-label="Nadpis ceníku" set:html={formatRichText(title)}>
      </h2>
      <p class="text-espresso-800/85 text-fluid-body max-w-2xl mx-auto" data-tina-field={tinaField(pricing, 'subtitle')} data-edit-key="pricing.subtitle" data-edit-label="Podnadpis ceníku" set:html={formatRichText(subtitle)}>
      </p>
    </div>

    <!-- Mobile Tier Switcher Tabs (Cuts scrolling on phones and lets users easily check upcoming programs) -->
    <div class="md:hidden mb-6">
      <div class="text-center text-xs font-black uppercase tracking-wider text-amber-950/80 mb-2" data-tina-field={tinaField(pricing as any, 'tabsLabel')} data-edit-key="pricing.tabsLabel" data-edit-label="Popisek přepínače ceníku">
        {tabsLabel}
      </div>
      <div class="grid grid-cols-3 gap-1 sm:gap-1.5 p-1 sm:p-1.5 rounded-card-md bg-parchment-200 border border-parchment-300 shadow-2xs" id="pricing-tabs">
        {tiers.map((t, idx) => (
          <button
            type="button"
            class:list={[
              "pricing-tab-btn py-2 sm:py-2.5 px-1 sm:px-1.5 rounded-card-sm font-heading text-[10px] sm:text-xs transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer",
              idx === 0
                ? "bg-amber-400 text-espresso-950 shadow-xs border border-amber-500 font-black"
                : "bg-transparent text-espresso-800 hover:text-espresso-950 font-bold border border-transparent"
            ]}
            data-target={`pricing-tier-${idx}`}
          >
            <span class="text-base">{idx === 0 ? "🎒" : idx === 1 ? "🎓" : "💼"}</span>
            <span class="truncate font-black text-xs">{t.name ? t.name.split(' ')[0] + ' ' + (t.name.split(' ')[1] || '') : (idx === 0 ? "Děti ZŠ" : idx === 1 ? "Maturita" : "Dospělí")}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Pricing Tiers Grid -->
    <div class="grid md:grid-cols-3 gap-6 sm:gap-8 items-stretch" id="pricing-grid">
      {tiers.map((tier, idx) => {
        const isPopular = tier.isPopular;
        return (
          <div
            id={`pricing-tier-${idx}`}
            data-tina-field={tinaField(pricing, 'tiers', idx)}
            class:list={[
              `pricing-card reveal-on-scroll stagger-${idx + 1} rounded-card-xl p-6 sm:p-8 md:p-10 flex-col justify-between relative transition-all duration-300`,
              idx === 0 ? "flex md:flex" : "hidden md:flex",
              isPopular
                ? "bg-gradient-to-b from-[#FFFDF9] via-white to-[#FFFDF9] border-2 border-amber-400 shadow-xl glow-amber md:-translate-y-3 z-10"
                : "bg-white border border-parchment-300 shadow-card opacity-90 hover:opacity-100 hover:shadow-card-lift"
            ]}
          >
            
            <!-- Popular Ribbon / Badge -->
            {isPopular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap">
                <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-400 text-espresso-950 shadow-md" data-tina-field={tinaField(tier, 'badge')} data-edit-key={`pricing.tiers.${idx}.badge`} data-edit-label="Štítek karty">
                  {!tier.badge?.includes('🎁') && <span>🎁</span>}
                  <span>{tier.badge || "1. LEKCE ZDARMA"}</span>
                </span>
              </div>
            )}

            <div class="space-y-6">
              <!-- Tier Top info -->
              <div>
                {!isPopular && (
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-600 bg-parchment-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider mb-2 border border-parchment-300" data-tina-field={tier.badge ? tinaField(tier, 'badge') : undefined}>
                    <span>⏳</span> <span>{tier.badge || "Připravujeme brzy"}</span>
                  </span>
                )}
                <h3 class="font-heading font-black text-2xl text-espresso-950" data-tina-field={tinaField(tier, 'name')} data-edit-key={`pricing.tiers.${idx}.name`} data-edit-label="Název programu">
                  {tier.name}
                </h3>
                <p class="text-sm text-espresso-800/80 mt-2 min-h-[40px]" data-tina-field={tinaField(tier, 'description')} data-edit-key={`pricing.tiers.${idx}.description`} data-edit-label="Popis programu" set:html={formatRichText(tier.description)}>
                </p>
              </div>

              <!-- Price Display (Keeps 320 Kč strictly together on one line) -->
              <div class="pt-4 pb-2 border-y border-parchment-200 flex flex-wrap sm:flex-nowrap items-center gap-x-3 gap-y-1">
                <span class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight whitespace-nowrap shrink-0" data-tina-field={tinaField(tier, 'price')} data-edit-key={`pricing.tiers.${idx}.price`} data-edit-label="Cena">
                  {tier.price}
                </span>
                <span class="text-xs sm:text-sm text-stone-500 font-medium leading-snug" data-tina-field={tinaField(tier, 'period')} data-edit-key={`pricing.tiers.${idx}.period`} data-edit-label="Období">
                  {tier.period}
                </span>
              </div>

              <!-- Features list -->
              <div class="space-y-3" data-tina-field={tinaField(tier, 'features')}>
                <div class="text-xs font-bold uppercase tracking-wider text-stone-400" data-tina-field={tinaField(pricing as any, 'featuresLabel')} data-edit-key="pricing.featuresLabel" data-edit-label="Nadpis výhod balíčku">{featuresLabel}</div>
                <ul class="space-y-3">
                  {(tier.features || []).map((feat, fIdx) => (
                    <li class="flex items-start gap-3 text-sm text-espresso-800">
                      <svg class={`w-4 h-4 flex-shrink-0 mt-0.5 ${isPopular ? 'text-amber-600' : 'text-emerald-600'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span data-edit-key={`pricing.tiers.${idx}.features.${fIdx}`} data-edit-label="Položka v ceně" set:html={formatRichText(feat)}></span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-8 mt-8 border-t border-parchment-200">
              <a
                href={tier.ctaLink || "#kontakt"}
                data-pricing-target={
                  tier.name.toLowerCase().includes('dospěl')
                    ? 'adults'
                    : tier.name.toLowerCase().includes('střed') || tier.name.toLowerCase().includes('maturit')
                    ? 'teens'
                    : 'kids'
                }
                class={`pricing-cta-btn w-full inline-flex items-center justify-center py-4 px-6 rounded-card-md font-heading font-black text-base transition-all text-center cursor-pointer ${
                  isPopular
                    ? 'btn-gold-pulse bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 text-espresso-950 border border-amber-500 shadow-dice-btn active:shadow-dice-btn-active'
                    : 'btn-dice-secondary bg-parchment-100 hover:bg-parchment-200 text-espresso-950 border border-parchment-300'
                }`}
                data-tina-field={tinaField(tier, 'ctaText')}
                data-edit-key={`pricing.tiers.${idx}.ctaText`}
                data-edit-label="Text tlačítka"
              >
                {tier.ctaText || (isPopular ? "🎁 Vyzkoušet 1. lekci zdarma" : "Zapsat se na čekací listinu")}
              </a>
            </div>

          </div>
        );
      })}
    </div>


    <!-- Fairness & Flexibility Pillars -->
    <div class="mt-10 sm:mt-14 max-w-4xl mx-auto space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        {pillars.map((pillar, pIdx) => (
          <div
            data-tina-field={tinaField(pricing, 'pillars', pIdx)}
            class="bg-white/90 rounded-2xl p-4 border border-amber-300/80 shadow-2xs text-center space-y-1.5 hover:border-amber-400 transition-colors"
          >
            <div class="text-2xl">{pillar.icon}</div>
            <h4 class="font-heading font-black text-xs sm:text-sm text-espresso-950" data-tina-field={tinaField(pillar, 'title')} data-edit-key={`pricing.pillars.${pIdx}.title`} data-edit-label="Název garance">
              {pillar.title}
            </h4>
            <p class="text-[11px] text-espresso-800/80 leading-snug" data-tina-field={tinaField(pillar, 'desc')} data-edit-key={`pricing.pillars.${pIdx}.desc`} data-edit-label="Popis garance">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Main Guarantee Callout -->
      <div class="text-center">
        <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-amber-100/90 via-white to-amber-100/90 border-2 border-amber-300/90 text-espresso-950 text-xs sm:text-sm md:text-base leading-relaxed font-bold shadow-xs" data-tina-field={tinaField(pricing, 'guarantee')} data-edit-key="pricing.guarantee" data-edit-label="Garance ceníku" set:html={formatRichText(guarantee)}>
        </div>
      </div>
    </div>

    <!-- Large Prominent Button linking to Dedicated /cenik page -->
    <div class="mt-10 sm:mt-12 text-center max-w-2xl mx-auto">
      <a
        href={fullPricingBtnLink}
        class="btn-gold-pulse group w-full sm:w-auto inline-flex items-center justify-center gap-2 sm:gap-3 py-3.5 sm:py-5 px-5 sm:px-10 rounded-2xl font-heading font-black text-sm sm:text-lg text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border-2 border-amber-500 shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all"
        data-tina-field={tinaField(pricing, 'fullPricingBtnText')}
      >
        <span class="text-2xl group-hover:scale-110 transition-transform">🏷️</span>
        <span data-edit-key="pricing.fullPricingBtnText" data-edit-label="Tlačítko na ceník">{fullPricingBtnText}</span>
        <span class="group-hover:translate-x-1.5 transition-transform font-black">→</span>
      </a>
      <p class="text-xs text-stone-500 mt-2 font-medium" data-tina-field={tinaField(pricing, 'fullPricingBtnNote')}>
        <span data-edit-key="pricing.fullPricingBtnNote" data-edit-label="Popis odkazu ceníku">{fullPricingBtnNote}</span>
      </p>
    </div>

  </div>
</section>

<script>
  (() => {
    let activePricingTarget = 'pricing-card-0';

    function syncPricingTabsUI() {
      const tabs = document.querySelectorAll<HTMLButtonElement>('.pricing-tab-btn');
      const cards = document.querySelectorAll<HTMLElement>('.pricing-card');

      tabs.forEach((tab) => {
        const targetId = tab.getAttribute('data-target');
        const isSelected = targetId === activePricingTarget;
        if (isSelected) {
          tab.classList.remove('bg-transparent', 'text-espresso-800', 'font-bold', 'border-transparent');
          tab.classList.add('bg-amber-400', 'text-espresso-950', 'shadow-xs', 'border-amber-500', 'font-black');
        } else {
          tab.classList.remove('bg-amber-400', 'text-espresso-950', 'shadow-xs', 'border-amber-500', 'font-black');
          tab.classList.add('bg-transparent', 'text-espresso-800', 'font-bold', 'border-transparent');
        }
      });

      cards.forEach((card) => {
        if (card.id === activePricingTarget) {
          card.classList.remove('hidden');
          card.classList.add('flex');
        } else {
          card.classList.remove('flex');
          card.classList.add('hidden');
        }
      });
    }

    let lastHandledTime = 0;
    function handlePricingInteraction(e: Event) {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const tabBtn = target.closest<HTMLButtonElement>('.pricing-tab-btn');
      if (tabBtn) {
        const targetId = tabBtn.getAttribute('data-target');
        if (targetId) {
          activePricingTarget = targetId;
          syncPricingTabsUI();
        }
        return;
      }

      const ctaBtn = target.closest<HTMLAnchorElement>('.pricing-cta-btn');
      if (ctaBtn) {
        const pricingTarget = ctaBtn.getAttribute('data-pricing-target');
        if (!pricingTarget) return;

        const segmentSelect = document.getElementById('segment-select') as HTMLSelectElement | null;
        if (!segmentSelect) return;

        let matchingValue = '';
        if (pricingTarget === 'adults') {
          matchingValue = Array.from(segmentSelect.options).find(o => o.value.toLowerCase().includes('dospěl') || o.value.toLowerCase().includes('konverzace'))?.value || '';
        } else if (pricingTarget === 'teens') {
          matchingValue = Array.from(segmentSelect.options).find(o => o.value.toLowerCase().includes('středoškoláci') || o.value.toLowerCase().includes('maturita') || o.value.toLowerCase().includes('střední'))?.value || '';
        } else if (pricingTarget === 'kids') {
          matchingValue = Array.from(segmentSelect.options).find(o => o.value.toLowerCase().includes('děti na zš'))?.value || '';
        }

        if (matchingValue) {
          segmentSelect.value = matchingValue;
          segmentSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
        return;
      }
    }

    document.addEventListener('pointerdown', (e) => {
      lastHandledTime = Date.now();
      handlePricingInteraction(e);
    }, true);

    document.addEventListener('click', (e) => {
      if (Date.now() - lastHandledTime < 350) return;
      handlePricingInteraction(e);
    }, true);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncPricingTabsUI);
    } else {
      syncPricingTabsUI();
    }
    document.addEventListener('astro:page-load', syncPricingTabsUI);

    let lastPricingTab = document.querySelector('.pricing-tab-btn');
    const pricingObserver = new MutationObserver(() => {
      const currentPricingTab = document.querySelector('.pricing-tab-btn');
      if (currentPricingTab && currentPricingTab !== lastPricingTab) {
        lastPricingTab = currentPricingTab;
        syncPricingTabsUI();
      }
    });

    const bindPricingObserver = () => {
      pricingObserver.disconnect();
      const el = document.getElementById('cenik');
      if (el && (window.self !== window.top || import.meta.env.DEV)) {
        pricingObserver.observe(el, { childList: true, subtree: true });
      }
    };

    bindPricingObserver();
    document.addEventListener('astro:page-load', bindPricingObserver);
    document.addEventListener('astro:before-swap', () => {
      pricingObserver.disconnect();
    });
  })();
</script>

