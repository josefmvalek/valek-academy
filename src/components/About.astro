---
import PassportBadge from './PassportBadge.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Pillar {
  [key: string]: any;
  icon?: string;
  title: string;
  description: string;
}

interface GalleryItem {
  [key: string]: any;
  image: string;
  title: string;
  desc: string;
}

interface Credentials {
  [key: string]: any;
  title?: string;
  subtitle?: string;
  points?: string[];
  note?: string;
  guarantee?: string;
}

interface Props {
  about: {
    badge?: string;
    title?: string;
    teacherName?: string;
    role?: string;
    bio?: string;
    quote?: string;
    pillars?: Pillar[];
    credentials?: Credentials;
    [key: string]: any;
  };
  locationInfo?: {
    gallery?: GalleryItem[];
    [key: string]: any;
  };
}

const { about = {}, locationInfo = {} } = Astro.props;

const defaultGallery: GalleryItem[] = [
  {
    image: "/images/doucovna-stul.webp",
    title: "Útulný herní stůl pro 4–8 dětí",
    desc: "Prostorný stůl, kde se děti učí v uvolněné atmosféře plné her a bez pocitu školní lavice."
  },
  {
    image: "/images/doucovna-hry.webp",
    title: "Knihovnička a deskové hry",
    desc: "Karak, Scrabble, Dixit, Story Cubes a desítky dalších her pro všechny věkové kategorie."
  }
];

const gallery = locationInfo.gallery || defaultGallery;

const badge = about.badge || "PŘÍBĚH LEKTORA";
const title = about.title || "Čech, který vyrostl v Austrálii – a teď učí s úsměvem a trpělivostí";
const teacherName = about.teacherName || "Josef Válek";
const role = about.role || "BBA (RMIT Univ., Melbourne) • Překladatel a lektor";
const bio = about.bio || "Dobrý den! Jmenuji se Josef Válek. V Austrálii jsem žil od útlého dětství až do dospělosti, kde jsem chodil do školy a získal naprosto přirozený cit pro angličtinu a autentický přízvuk. V České republice však žiji již více než 25 let – mluvím tedy naprosto přirozeně česky a přesně vím, s čím Češi v angličtině bojují. Dlouhá léta jsem se živil jako překladatel a soukromý učitel angličtiny. Nyní otevírám svou doučovnu v Uherském Hradišti a zaměřuji se na to, co funguje nejlépe: učit děti angličtinu hravě v malých skupinkách plných deskovek, smíchu a zdravé soutěživosti.";
const quote = about.quote || "„Děti se nepotřebují biflovat gramatické poučky nazpaměť. Když k učení přistoupíme hravě – přes deskovky, karty a partu kamarádů ve skupince – jazyk do nich vklouzne přirozeně a začnou se na každou hodinu těšit.“";
const quoteAuthor = about.quoteAuthor || "— JOSEF VÁLEK, ZAKLADATEL VALEK ACADEMY";
const ctaText = about.ctaText || "Vyzkoušet s dítětem 1. lekci zdarma";
const locationNote = about.locationNote || "📍 Růžová 1238, Uherské Hradiště";
const pillars = about.pillars || [
  {
    icon: "🎲",
    title: "Výuka v malých skupinkách",
    description: "Skupinky 4–8 dětí jsou ideální pro deskovky. Děti komunikují mezi sebou i s lektorem a učení je pro ně zábavou."
  },
  {
    icon: "🇦🇺",
    title: "Australský přízvuk & cit pro jazyk",
    description: "Díky vyrůstání v Melbourne předávám přirozenou intonaci a moderní živý jazyk bez českého tvrdého akcentu."
  },
  {
    icon: "🇨🇿",
    title: "25+ let v ČR & rodná čeština",
    description: "Žádná jazyková bariéra. Cokoliv složitějšího rád vysvětlím v češtině a s naprostým pochopením pro školní látku."
  },
  {
    icon: "🎁",
    title: "1. ukázková lekce ZDARMA",
    description: "Přijďte si nezávazně vyzkoušet atmosféru. Dítě si zahraje deskovku a sami uvidíte, jak se mu to líbí."
  }
];

const defaultCredentials: Credentials = {
  title: "Proč se učit s Josefem?",
  subtitle: "BBA, RMIT Univ., Melbourne • 25+ let v ČR",
  points: [
    "Vyrůstal v Melbourne: Přirozená výslovnost a živá slovní zásoba bez typického českého přízvuku.",
    "25+ let v České republice: Žádná komunikační bariéra – složitou látku v klidu vysvětlí v češtině.",
    "Výuka hrou v malých skupinkách: Deskovky a karty ve skupince 4–8 dětí, které odbourají strach ze známkování.",
    "Vzdělání z Melbourne: Titul BBA z renomované RMIT University v Austrálii."
  ],
  note: "VALEK ACADEMY • Doučovna Uherské Hradiště",
  guarantee: "🎁 1. ukázková lekce je 100% ZDARMA"
};

const credentials = about.credentials || defaultCredentials;
---

<section id="o-mne" class="py-8 sm:py-12 md:py-16 relative bg-white border-t border-parchment-200 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-6 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-xs font-extrabold uppercase tracking-wider text-amber-950" data-tina-field={tinaField(about, 'badge')} data-edit-key="about.badge" data-edit-label="Štítek O lektorovi">
        <span class="w-2 h-2 rounded-full bg-amber-600"></span>
        <span>{badge}</span>
      </div>
      <h2 class="font-academy font-black text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight" data-tina-field={tinaField(about, 'title')} data-edit-key="about.title" data-edit-label="Nadpis O lektorovi">
        {title}
      </h2>
    </div>

    <!-- Tutor Introduction Bio & Credentials Card -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-10 sm:mb-14">
      
      <!-- Bio Text Column -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-amber-100 border border-amber-300 text-espresso-950 text-xs font-extrabold" data-tina-field={tinaField(about, 'role')} data-edit-key="about.role" data-edit-label="Role lektora">
          <span>🎓</span> <span>{role}</span>
        </div>

        <h3 class="font-heading font-black text-2xl sm:text-3xl text-espresso-950">
          Ahoj, jsem <span class="text-amber-800" data-tina-field={tinaField(about, 'teacherName')} data-edit-key="about.teacherName" data-edit-label="Jméno lektora">{teacherName}</span>
        </h3>

        <p class="text-espresso-800/90 text-base sm:text-lg leading-relaxed" data-tina-field={tinaField(about, 'bio')} data-edit-key="about.bio" data-edit-label="Životopis / Bio">
          {bio}
        </p>

        <!-- Blockquote Callout -->
        <blockquote class="relative p-5 sm:p-7 rounded-2xl bg-parchment-50 border-l-4 border-amber-500 border-t border-r border-b border-parchment-300 shadow-xs text-espresso-900 italic">
          <p class="relative z-10 text-espresso-900 text-base font-medium leading-relaxed" data-tina-field={tinaField(about, 'quote')} data-edit-key="about.quote" data-edit-label="Citát lektora">
            {quote}
          </p>
          <div class="mt-3 text-xs font-black text-amber-900 not-italic uppercase tracking-wider flex items-center gap-2" data-tina-field={tinaField(about, 'quoteAuthor')} data-edit-key="about.quoteAuthor" data-edit-label="Autor citátu">
            <span>🎲</span>
            <span>{quoteAuthor}</span>
          </div>
        </blockquote>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="#kontakt" class="inline-flex items-center gap-2 font-heading font-black text-amber-900 hover:text-amber-700 transition-colors group text-sm" data-tina-field={tinaField(about, 'ctaText')} data-edit-key="about.ctaText" data-edit-label="Odkaz na 1. lekci">
            <span>{ctaText}</span>
            <span class="group-hover:translate-x-1.5 transition-transform">→</span>
          </a>
          <span class="text-stone-300 hidden sm:inline">•</span>
          <span class="text-xs text-stone-500 font-medium" data-tina-field={tinaField(about, 'locationNote')} data-edit-key="about.locationNote" data-edit-label="Poznámka s adresou">{locationNote}</span>
        </div>
      </div>

      <!-- Experience & Credentials Highlight Box -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-b from-[#FFFDF9] via-white to-parchment-50 rounded-3xl p-6 sm:p-8 border-2 border-amber-300 shadow-soft-lg space-y-5 relative overflow-hidden" data-tina-field={tinaField(about, 'credentials')}>
          <div class="flex items-center justify-between pb-5 border-b border-parchment-200 gap-4">
            <div class="flex items-center gap-3.5 sm:gap-4 min-w-0">
              <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border-2 border-amber-400 shadow-md flex-shrink-0 group">
                <img
                  src="/images/josef-valek.webp"
                  alt="Josef Válek – Lektor Valek Academy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  width="80"
                  height="80"
                  loading="lazy"
                />
                <span class="absolute bottom-0 inset-x-0 bg-espresso-950/85 text-[8px] sm:text-[9px] text-amber-300 text-center py-0.5 font-black uppercase tracking-wider">
                  Melbourne
                </span>
              </div>
              <div class="min-w-0">
                <h4 class="font-heading font-black text-lg sm:text-xl text-espresso-950 leading-tight" data-tina-field={tinaField(credentials, 'title')}>
                  {credentials.title}
                </h4>
                <p class="text-xs text-amber-900 font-extrabold mt-1" data-tina-field={tinaField(credentials, 'subtitle')}>{credentials.subtitle}</p>
              </div>
            </div>
            <PassportBadge className="w-16 h-16 -mr-1 hidden sm:inline-block flex-shrink-0" />
          </div>

          <ul class="space-y-3.5 text-sm text-espresso-800" data-tina-field={tinaField(credentials, 'points')}>
            {(credentials.points || []).map((point: string) => {
              const colonIndex = point.indexOf(':');
              return (
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full bg-amber-200 text-amber-950 flex items-center justify-center font-black text-xs flex-shrink-0 mt-0.5">✓</span>
                  <span>
                    {colonIndex !== -1 ? (
                      <>
                        <strong>{point.slice(0, colonIndex + 1)}</strong>
                        {point.slice(colonIndex + 1)}
                      </>
                    ) : (
                      point
                    )}
                  </span>
                </li>
              );
            })}
          </ul>

          <div class="p-4 rounded-2xl bg-amber-100/80 border border-amber-300 text-center">
            <div class="text-xs font-bold text-amber-950" data-tina-field={tinaField(credentials, 'note')}>{credentials.note}</div>
            <div class="text-sm sm:text-base font-heading font-black text-espresso-950 mt-0.5" data-tina-field={tinaField(credentials, 'guarantee')}>{credentials.guarantee}</div>
          </div>
        </div>
      </div>

    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {pillars.map((pillar, idx) => (
        <div
          data-tina-field={tinaField(about, 'pillars', idx)}
          class="bg-parchment-50 rounded-2xl p-5 sm:p-6 border border-parchment-300 shadow-xs hover:shadow-md hover:border-amber-400 transition-all space-y-2.5"
        >
          <div class="text-3xl">
            {pillar.icon}
          </div>
          <h4 class="font-heading font-bold text-base sm:text-lg text-espresso-950" data-tina-field={tinaField(pillar, 'title')} data-edit-key={`about.pillars.${idx}.title`} data-edit-label="Název pilíře">
            {pillar.title}
          </h4>
          <p class="text-xs sm:text-sm text-espresso-800/80 leading-relaxed font-normal" data-tina-field={tinaField(pillar, 'description')} data-edit-key={`about.pillars.${idx}.description`} data-edit-label="Popis pilíře">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Classroom Photo Gallery: Cozy Learning Environment -->
    <div id="kde-ucime" class="mt-12 sm:mt-16 pt-10 border-t border-parchment-200">
      <div class="max-w-2xl mb-6">
        <div class="text-[11px] font-black uppercase tracking-wider text-amber-900 mb-1 flex items-center gap-1.5 font-bold">
          <span>📸</span> <span>Fotogalerie prostor</span>
        </div>
        <h3 class="font-heading font-black text-2xl sm:text-3xl text-espresso-950">
          Nahlédněte do doučovny v Uherském Hradišti
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-1">
          Klidné, čisté a rodinné prostředí v Růžové ulici s velkým stolem na deskovky a přirozenou konverzaci. Děti se tu cítí bezpečně a uvolněně.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
        {gallery.map((item, idx) => (
          <div
            data-tina-field={tinaField(locationInfo, 'gallery', idx)}
            class="group rounded-3xl overflow-hidden border-2 border-parchment-300 hover:border-amber-400 bg-white shadow-xs hover:shadow-card-lift transition-all duration-300"
          >
            <div class="relative overflow-hidden aspect-video">
              <img
                src={item.image}
                alt={item.title}
                data-tina-field={tinaField(item, 'image')}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-espresso-950/80 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
              <span class="absolute bottom-3 left-3 px-2.5 py-1 rounded-lg bg-espresso-950/80 backdrop-blur-xs text-white text-[11px] font-bold border border-white/20">
                📍 Růžová 1238, UH
              </span>
            </div>
            <div class="p-5 space-y-1.5">
              <h4 class="font-heading font-black text-base text-espresso-950" data-tina-field={tinaField(item, 'title')} data-edit-key={`location.gallery.${idx}.title`} data-edit-label="Název fotky">
                {item.title}
              </h4>
              <p class="text-xs text-espresso-800/85 leading-relaxed font-normal" data-tina-field={tinaField(item, 'desc')} data-edit-key={`location.gallery.${idx}.desc`} data-edit-label="Popis fotky">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
