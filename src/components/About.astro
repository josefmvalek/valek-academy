---
import ParrotLogo from './ParrotLogo.astro';
import PassportBadge from './PassportBadge.astro';

interface Pillar {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  about: {
    badge?: string;
    title?: string;
    teacherName?: string;
    role?: string;
    bio?: string;
    quote?: string;
    pillars?: Pillar[];
  };
}

const { about } = Astro.props;

const badge = about.badge || "PŘÍBĚH LEKTORA";
const title = about.title || "Čech, který vyrostl v Austrálii – a teď učí s úsměvem a trpělivostí";
const teacherName = about.teacherName || "Josef Válek";
const role = about.role || "Dlouholetý překladatel a lektor angličtiny";
const bio = about.bio || "Dobrý den! Jmenuji se Josef Válek. V Austrálii jsem žil od útlého dětství až do dospělosti, kde jsem chodil do školy a získal naprosto přirozený cit pro angličtinu a autentický přízvuk. V České republice však žiji již více než 25 let – mluvím tedy naprosto přirozeně česky a přesně vím, s čím Češi v angličtině bojují. Dlouhá léta jsem se živil jako překladatel a soukromý učitel angličtiny pro dospělé. Nyní otevírám svou novou doučovnu a zaměřuji se na to, co funguje nejlépe: učit děti angličtinu hravě v malých skupinkách plných deskovek, smíchu a zdravé soutěživosti.";
const quote = about.quote || "„Děti se nepotřebují biflovat gramatické poučky nazpaměť. Když k učení přistoupíme hravě – přes deskovky, karty a partu kamarádů ve skupince – jazyk do nich vklouzne přirozeně a začnou se na každou hodinu těšit.“";
const pillars = about.pillars || [];
---

<section id="o-mne" class="py-8 sm:py-12 md:py-16 relative bg-parchment-100/70 border-t border-parchment-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-2.5 sm:space-y-3 mb-6 sm:mb-10 md:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-bold uppercase tracking-wider text-amber-950">
        <span class="w-2 h-2 rounded-full bg-amber-600"></span>
        <span>{badge}</span>
      </div>
      <h2 class="font-academy font-bold text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight">
        {title}
      </h2>
    </div>

    <!-- Tutor Introduction Bio & Quote -->
    <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-center mb-8 sm:mb-12">
      
      <!-- Bio Text -->
      <div class="lg:col-span-7 space-y-4 sm:space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-amber-100/90 text-espresso-950 text-xs font-bold border border-amber-300">
          <span>🎓</span> {role}
        </div>

        <h3 class="font-academy font-bold text-2xl sm:text-3xl text-espresso-950">
          Ahoj, jsem <span class="text-amber-900">{teacherName}</span>
        </h3>

        <p class="text-espresso-800/90 text-base sm:text-lg leading-relaxed">
          {bio}
        </p>

        <!-- Blockquote Callout -->
        <blockquote class="relative p-4 sm:p-7 rounded-2xl bg-white border-l-4 border-amber-500 border-t border-r border-b border-parchment-300 shadow-xs text-espresso-900 italic">
          <p class="relative z-10 text-espresso-900 text-base font-normal leading-relaxed">
            {quote}
          </p>
          <div class="mt-3 text-xs font-bold text-amber-900 not-italic uppercase tracking-wider flex items-center gap-2">
            <span>🎲</span>
            <span>— {teacherName}, lektor VALEK ACADEMY</span>
          </div>
        </blockquote>

        <div class="pt-2">
          <a href="#kontakt" class="inline-flex items-center gap-2 font-display font-bold text-amber-900 hover:text-amber-700 transition-colors group text-sm">
            <span>Vyzkoušet s dítětem 1. lekci zdarma</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Experience Highlight Box -->
      <div class="lg:col-span-5">
        <div class="bg-parchment-50 rounded-3xl p-5 sm:p-7 md:p-9 border-2 border-parchment-300 shadow-soft-lg space-y-4 sm:space-y-6">
          <div class="flex items-center justify-between pb-3 sm:pb-4 border-b border-parchment-200 gap-3">
            <div class="flex items-center gap-3">
              <ParrotLogo className="w-12 h-12 sm:w-13 sm:h-13" />
              <div>
                <h4 class="font-academy font-bold text-base sm:text-lg text-espresso-950">
                  Proč začít s Josefem?
                </h4>
                <p class="text-xs text-stone-600">BBA, RMIT Univ., Melbourne • 25+ let v ČR</p>
              </div>
            </div>
            <PassportBadge className="w-20 h-20 -mr-2 hidden sm:inline-block flex-shrink-0" />
          </div>

          <ul class="space-y-3 text-sm text-espresso-800">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-amber-200 text-amber-950 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Vyrůstal v Austrálii:</strong> Přirozená výslovnost a živá slovní zásoba bez českého přízvuku.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-amber-200 text-amber-950 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>25+ let v České republice:</strong> Žádná komunikační bariéra – vše v klidu vysvětlí v češtině.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-amber-200 text-amber-950 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Výuka hrou v malých skupinkách:</strong> Deskovky a karty ve skupince 3–6 dětí, které odbourají strach ze zkoušení.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-amber-200 text-amber-950 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Vzdělání z Melbourne:</strong> Titul BBA z renomované RMIT University v Austrálii.</span>
            </li>
          </ul>

          <div class="p-3.5 sm:p-4 rounded-2xl bg-amber-100/70 border border-amber-300 text-center">
            <div class="text-xs font-semibold text-amber-900">VALEK ACADEMY • Uherské Hradiště</div>
            <div class="text-sm sm:text-base font-academy font-bold text-espresso-950 mt-0.5">🎁 1. ukázková lekce je 100% ZDARMA</div>
          </div>
        </div>
      </div>

    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-6">
      {pillars.map((pillar) => (
        <div class="bg-white rounded-2xl p-4 sm:p-6 border border-parchment-300 shadow-xs hover:shadow-md hover:border-amber-400 transition-all space-y-2 sm:space-y-3">
          <div class="text-2xl sm:text-3xl">
            {pillar.icon}
          </div>
          <h4 class="font-academy font-bold text-base sm:text-lg text-espresso-950">
            {pillar.title}
          </h4>
          <p class="text-xs sm:text-sm text-espresso-800/80 leading-relaxed font-normal">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
