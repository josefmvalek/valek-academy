---
interface Pillar {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  about: {
    badge?: string;
    title?: string;
    teacherName?: string;
    role?: string;
    bio?: string;
    quote?: string;
    experienceYears?: string;
    pillars?: Pillar[];
  };
}

const { about } = Astro.props;

const badge = about.badge || "O MNĚ A MÉ METODICE";
const title = about.title || "Angličtina pro reálný život – bez biflování a zbytečného stresu";
const teacherName = about.teacherName || "Mgr. Josef Válek";
const role = about.role || "Certifikovaný lektor angličtiny s mezinárodní praxí";
const bio = about.bio || "Jmenuji se Josef Válek a již více než 10 let pomáhám dospělým, studentům i manažerům překonávat jazykovou bariéru. Věřím, že naučit se mluvit cizím jazykem nemá být utrpení plné nudných gramatických cvičení ze zaprášených učebnic. Můj přístup staví na přirozené konverzaci, bezpečném přátelském prostředí a tématech, která vás skutečně zajímají a využijete je v praxi.";
const quote = about.quote || "„Mým cílem není naučit vás odrecitovat předpřítomný čas, ale zajistit, abyste bez váhání zvládli objednat hotel, odprezentovat projekt nebo v klidu zavolat zahraničnímu klientovi.“";
const pillars = about.pillars || [];
---

<section id="o-mne" class="py-20 md:py-32 relative bg-navy-900/60 border-t border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glow-badge text-xs font-semibold uppercase tracking-wider">
        {badge}
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
        {title}
      </h2>
    </div>

    <!-- Tutor Introduction Bio & Quote -->
    <div class="grid lg:grid-cols-12 gap-12 items-center mb-20">
      
      <!-- Bio Text -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-brand-500/10 text-brand-400 text-xs font-bold border border-brand-500/20">
          🎓 {role}
        </div>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-white">
          Ahoj, jsem <span class="text-brand-400">{teacherName}</span>
        </h3>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          {bio}
        </p>

        <!-- Blockquote Callout -->
        <blockquote class="relative p-6 rounded-2xl bg-slate-900/90 border-l-4 border-brand-500 border-t border-r border-b border-slate-800 text-slate-200 italic">
          <div class="text-3xl text-brand-500/40 font-serif leading-none mb-2">“</div>
          <p class="relative z-10 text-slate-200 text-sm sm:text-base font-normal leading-relaxed">
            {quote}
          </p>
          <div class="mt-3 text-xs font-semibold text-brand-400 not-italic uppercase tracking-wide">
            — {teacherName}
          </div>
        </blockquote>

        <div class="pt-2">
          <a href="#kontakt" class="inline-flex items-center gap-2 font-display font-semibold text-brand-400 hover:text-brand-300 transition-colors group text-sm">
            <span>Chci zjistit, jak by vypadala výuka se mnou</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Experience Highlight Box -->
      <div class="lg:col-span-5">
        <div class="glass-card rounded-3xl p-8 border border-slate-700/60 relative overflow-hidden space-y-6">
          <div class="absolute -right-8 -top-8 w-40 h-40 bg-brand-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <h4 class="font-display font-bold text-xl text-white">
            V čem je můj přístup jiný?
          </h4>

          <ul class="space-y-4 text-sm text-slate-300">
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Žádné zkoušení u tabule:</strong> Uvolněná, přátelská atmosféra u kávy nebo čaje přes obrazovku.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Mluvíte především vy:</strong> Lektor funguje jako průvodce, sparingpartner a podpora, nikoliv jako přednášející profesor.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Okamžitý přenos do praxe:</strong> Co se naučíme v pondělí, můžete v úterý použít při psaní e-mailu nebo v práci.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">✓</span>
              <span><strong>Vše v cloudu:</strong> Žádné ztracené papíry. Všechna slovíčka a materiály máte pohromadě ve své online složce.</span>
            </li>
          </ul>

          <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-center">
            <div class="text-xs text-slate-400">Průměrná doba do odbourání strachu z mluvení</div>
            <div class="text-xl font-display font-bold text-brand-400 mt-0.5">Pouhé 3 až 5 lekcí</div>
          </div>
        </div>
      </div>

    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {pillars.map((pillar, idx) => (
        <div class="glass-card glass-card-hover rounded-2xl p-6 relative group space-y-4">
          <div class="w-12 h-12 rounded-xl bg-brand-500/10 border border-brand-500/20 text-brand-400 flex items-center justify-center font-bold text-xl group-hover:bg-brand-500 group-hover:text-navy-950 transition-all">
            {idx === 0 && "🗣️"}
            {idx === 1 && "🛡️"}
            {idx === 2 && "🧭"}
            {idx === 3 && "💻"}
          </div>
          <h4 class="font-display font-bold text-lg text-white group-hover:text-brand-400 transition-colors">
            {pillar.title}
          </h4>
          <p class="text-sm text-slate-400 leading-relaxed">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
