---
interface Phrase {
  id: string;
  buttonLabel: string;
  short: string;
  en: string;
  cz: string;
  duration?: number;
}

interface Props {
  audio?: {
    title?: string;
    subtitlePrompt?: string;
    phrases?: Phrase[];
  };
}

const { audio = {} } = Astro.props;

const defaultPhrases: Phrase[] = [
  {
    id: "gday",
    buttonLabel: "🦘 „G'day mate!“",
    short: "G'day mate! I'm Josef.",
    en: "G'day, mate! Welcome to Valek Academy. Let's roll the dice and have fun speaking English together!",
    cz: "Ahoj kamaráde! Vítejte ve Valek Academy. Hoďme kostkou a pojďme si hravě povídat anglicky!",
    duration: 10
  },
  {
    id: "dice",
    buttonLabel: "🎲 „Let's roll the dice!“",
    short: "Let's roll the dice!",
    en: "Let's roll the dice! It's your turn. What board game are we going to play today?",
    cz: "Hoďme kostkou! Jsi na řadě. Jakou deskovou hru si dnes zahrajeme?",
    duration: 8
  },
  {
    id: "noworries",
    buttonLabel: "✨ „No worries at all!“",
    short: "No worries at all!",
    en: "No worries at all! Never fear making mistakes. In our small team, we learn by laughing and playing!",
    cz: "Žádný stres! Z chyb si vůbec nic nedělej. V naší partě se učíme smíchem a hrou!",
    duration: 9
  }
];

const phrases: Phrase[] = (audio.phrases && audio.phrases.length > 0) ? audio.phrases : defaultPhrases;
const firstPhrase = phrases[0] || defaultPhrases[0];

const phrasesMap: Record<string, { en: string; cz: string; short: string; duration: number }> = {};
phrases.forEach((p) => {
  phrasesMap[p.id] = {
    en: p.en,
    cz: p.cz,
    short: p.short,
    duration: p.duration || (p.id === 'dice' ? 8 : p.id === 'noworries' ? 9 : 10)
  };
});
---

<div
  class="relative max-w-2xl mx-auto w-full bg-gradient-to-r from-espresso-950 via-[#26150C] to-espresso-950 text-white rounded-2xl sm:rounded-full p-2.5 sm:px-4 sm:py-2.5 shadow-card-lift border border-amber-500/40 hover:border-amber-400/70 transition-all duration-300"
  id="hero-audio-pill"
  data-phrases={JSON.stringify(phrasesMap)}
>
  <!-- Ambient glow -->
  <div class="absolute inset-0 rounded-2xl sm:rounded-full bg-gradient-to-r from-amber-500/10 via-amber-400/5 to-emerald-500/10 blur-md pointer-events-none -z-10"></div>

  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 sm:gap-4 min-w-0">
    
    <!-- Left: Play button + Waveform + Current Quote -->
    <div class="flex items-center gap-3 min-w-0 flex-1">
      <!-- Play / Pause Button -->
      <button
        type="button"
        id="pill-play-btn"
        class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-espresso-950 flex items-center justify-center shadow-md hover:scale-105 active:scale-95 transition-all flex-shrink-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-300"
        aria-label="Přehrát hlasovou ukázku Josefa"
      >
        <svg id="pill-play-icon" class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg id="pill-pause-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
      </button>

      <!-- Soundwave Visualizer Bars -->
      <div class="flex items-center gap-1 h-5 flex-shrink-0" id="pill-soundwave" aria-hidden="true">
        <span class="w-1 bg-amber-400/40 rounded-full h-2 transition-all duration-200 wave-bar"></span>
        <span class="w-1 bg-amber-400/40 rounded-full h-3 transition-all duration-200 wave-bar"></span>
        <span class="w-1 bg-amber-400/40 rounded-full h-5 transition-all duration-200 wave-bar"></span>
        <span class="w-1 bg-amber-400/40 rounded-full h-3 transition-all duration-200 wave-bar"></span>
        <span class="w-1 bg-amber-400/40 rounded-full h-2 transition-all duration-200 wave-bar"></span>
      </div>

      <!-- Text & Accent Header -->
      <div class="min-w-0 flex-1 text-left">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-wider text-amber-300 flex items-center gap-1">
            <span>🇦🇺</span>
            <span>Josefův rodilý akcent</span>
          </span>
          <span class="text-stone-400 text-[10px] hidden sm:inline">•</span>
          <span id="pill-status-label" class="text-[10px] sm:text-[11px] text-stone-300 font-medium truncate">
            Klikněte pro poslech (10s)
          </span>
        </div>
        <p id="pill-quote-text" class="text-xs sm:text-[13px] font-medium text-white/95 italic truncate mt-0.5">
          „{firstPhrase.en}“
        </p>
      </div>
    </div>

    <!-- Right: Quick Phrase Switcher Chips -->
    <div class="flex items-center gap-1.5 flex-shrink-0 justify-end sm:justify-start pt-1 sm:pt-0 border-t sm:border-t-0 border-white/10">
      {phrases.map((p, idx) => (
        <button
          type="button"
          class={`pill-phrase-btn text-[11px] font-bold px-2.5 py-1 rounded-full transition-all cursor-pointer border ${
            idx === 0
              ? 'bg-amber-400 text-espresso-950 border-amber-300 shadow-2xs'
              : 'bg-white/10 hover:bg-white/20 text-amber-100/90 border-white/10'
          }`}
          data-phrase={p.id}
          title={p.cz}
        >
          {p.id === 'gday' && '🦘 G\'day'}
          {p.id === 'dice' && '🎲 Kostky'}
          {p.id === 'noworries' && '✨ Pohoda'}
          {p.id !== 'gday' && p.id !== 'dice' && p.id !== 'noworries' && p.buttonLabel}
        </button>
      ))}
    </div>

  </div>

  <!-- Hidden native audio element -->
  <audio id="hero-pill-native-audio" preload="none" class="hidden"></audio>
</div>

<style>
  @keyframes wavePulse {
    0%, 100% { height: 6px; }
    50% { height: 18px; }
  }

  .wave-animating .wave-bar:nth-child(1) {
    animation: wavePulse 0.8s ease-in-out infinite 0.1s;
    background-color: #f59e0b !important;
  }
  .wave-animating .wave-bar:nth-child(2) {
    animation: wavePulse 0.7s ease-in-out infinite 0.25s;
    background-color: #fbbf24 !important;
  }
  .wave-animating .wave-bar:nth-child(3) {
    animation: wavePulse 0.9s ease-in-out infinite 0.05s;
    background-color: #f59e0b !important;
  }
  .wave-animating .wave-bar:nth-child(4) {
    animation: wavePulse 0.65s ease-in-out infinite 0.3s;
    background-color: #fbbf24 !important;
  }
  .wave-animating .wave-bar:nth-child(5) {
    animation: wavePulse 0.85s ease-in-out infinite 0.15s;
    background-color: #f59e0b !important;
  }
</style>

<script>
  function initHeroAudioPill() {
    const pill = document.getElementById('hero-audio-pill');
    if (!pill) return;

    const playBtn = document.getElementById('pill-play-btn');
    const playIcon = document.getElementById('pill-play-icon');
    const pauseIcon = document.getElementById('pill-pause-icon');
    const soundwave = document.getElementById('pill-soundwave');
    const statusLabel = document.getElementById('pill-status-label');
    const quoteText = document.getElementById('pill-quote-text');
    const nativeAudio = document.getElementById('hero-pill-native-audio') as HTMLAudioElement | null;
    const phraseBtns = document.querySelectorAll<HTMLButtonElement>('.pill-phrase-btn');

    let phrases: Record<string, { en: string; cz: string; short: string; duration: number }> = {
      gday: {
        en: "G'day, mate! Welcome to Valek Academy. Let's roll the dice and have fun speaking English together!",
        cz: "Ahoj kamaráde! Vítejte ve Valek Academy. Hoďme kostkou a pojďme si hravě povídat anglicky!",
        short: "G'day mate! I'm Josef.",
        duration: 10
      },
      dice: {
        en: "Let's roll the dice! It's your turn. What board game are we going to play today?",
        cz: "Hoďme kostkou! Jsi na řadě. Jakou deskovou hru si dnes zahrajeme?",
        short: "Let's roll the dice!",
        duration: 8
      },
      noworries: {
        en: "No worries at all! Never fear making mistakes. In our small team, we learn by laughing and playing!",
        cz: "Žádný stres! Z chyb si vůbec nic nedělej. V naší partě se učíme smíchem a hrou!",
        short: "No worries at all!",
        duration: 9
      }
    };

    if (pill.dataset.phrases) {
      try {
        const parsed = JSON.parse(pill.dataset.phrases);
        phrases = { ...phrases, ...parsed };
      } catch (e) {}
    }

    let activeKey = 'gday';
    let isPlaying = false;
    let synth: SpeechSynthesis | null = null;
    let audioCtx: AudioContext | null = null;

    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      synth = window.speechSynthesis;
    }

    function playWarmChime() {
      try {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioContextClass) return;
        audioCtx = audioCtx || new AudioContextClass();
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        const notes = [261.63, 329.63, 392.00, 523.25];
        notes.forEach((freq, idx) => {
          if (!audioCtx) return;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.08);
          gain.gain.setValueAtTime(0.001, audioCtx.currentTime + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.12, audioCtx.currentTime + idx * 0.08 + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.08 + 1.2);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(audioCtx.currentTime + idx * 0.08);
          osc.stop(audioCtx.currentTime + idx * 0.08 + 1.3);
        });
      } catch (e) {}
    }

    function stopAudio() {
      isPlaying = false;
      if (synth) synth.cancel();
      if (nativeAudio) {
        nativeAudio.pause();
        nativeAudio.currentTime = 0;
      }
      if (playIcon) playIcon.classList.remove('hidden');
      if (pauseIcon) pauseIcon.classList.add('hidden');
      if (soundwave) soundwave.classList.remove('wave-animating');
      if (statusLabel) statusLabel.textContent = 'Klikněte pro poslech (10s)';
    }

    function fallbackSpeech() {
      if (!synth) {
        stopAudio();
        return;
      }
      synth.cancel();
      const data = phrases[activeKey] || phrases.gday;
      const utter = new SpeechSynthesisUtterance(data.en);
      const voices = synth.getVoices();
      const auVoice = voices.find(v => v.lang === 'en-AU' || v.lang.startsWith('en-AU'))
        || voices.find(v => v.lang === 'en-GB' || v.lang.startsWith('en-GB'))
        || voices.find(v => v.lang.startsWith('en'));
      if (auVoice) utter.voice = auVoice;
      utter.lang = auVoice?.lang || 'en-AU';
      utter.rate = 0.95;
      utter.pitch = 1.0;

      utter.onstart = () => {
        if (statusLabel) {
          statusLabel.innerHTML = '<span class="text-emerald-400 font-bold animate-pulse">● Hraje ukázka</span>';
        }
      };
      utter.onend = () => stopAudio();
      utter.onerror = () => stopAudio();
      synth.speak(utter);
    }

    function startPlayback() {
      isPlaying = true;
      if (playIcon) playIcon.classList.add('hidden');
      if (pauseIcon) pauseIcon.classList.remove('hidden');
      if (soundwave) soundwave.classList.add('wave-animating');
      if (statusLabel) {
        statusLabel.innerHTML = '<span class="text-emerald-400 font-bold animate-pulse">● Hraje ukázka</span>';
      }

      if (nativeAudio) {
        nativeAudio.src = `/audio/${activeKey}.mp3`;
        nativeAudio.oncanplay = () => {
          if (!isPlaying) return;
          nativeAudio.play().catch(() => {
            playWarmChime();
            fallbackSpeech();
          });
        };
        nativeAudio.onended = () => stopAudio();
        nativeAudio.onerror = () => {
          if (nativeAudio.src.endsWith('.mp3')) {
            nativeAudio.src = `/audio/${activeKey}.wav`;
            nativeAudio.play().catch(() => {
              playWarmChime();
              fallbackSpeech();
            });
          } else {
            playWarmChime();
            fallbackSpeech();
          }
        };
        nativeAudio.load();
      } else {
        playWarmChime();
        fallbackSpeech();
      }
    }

    function selectPhrase(key: string) {
      activeKey = key;
      const data = phrases[key] || phrases.gday;
      if (quoteText) {
        quoteText.textContent = `„${data.en}“`;
      }

      phraseBtns.forEach(btn => {
        if (btn.dataset.phrase === key) {
          btn.className = 'pill-phrase-btn text-[11px] font-bold px-2.5 py-1 rounded-full transition-all cursor-pointer border bg-amber-400 text-espresso-950 border-amber-300 shadow-2xs';
        } else {
          btn.className = 'pill-phrase-btn text-[11px] font-bold px-2.5 py-1 rounded-full transition-all cursor-pointer border bg-white/10 hover:bg-white/20 text-amber-100/90 border-white/10';
        }
      });

      stopAudio();
      startPlayback();
    }

    playBtn?.addEventListener('click', () => {
      if (isPlaying) {
        stopAudio();
      } else {
        startPlayback();
      }
    });

    phraseBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.phrase || 'gday';
        selectPhrase(key);
      });
    });
  }

  // Support Astro view transitions / direct DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAudioPill);
  } else {
    initHeroAudioPill();
  }
  document.addEventListener('astro:page-load', initHeroAudioPill);
</script>
