        </a>
        <div class="flex items-center justify-center gap-4 text-xs text-stone-500 font-medium flex-wrap">
          <span>15 zvířecích skupinek</span>
          <span>•</span>
          <span>Přímé objednání 1. lekce zdarma</span>
          <span>•</span>
          <a href="#kontakt" class="underline hover:text-amber-900 font-bold">Rychlá rezervace dole na stránce ↓</a>
        </div>
      </div>

    </div>
  </section>
)}

<!-- Client-side script for interactive filtering and smooth booking connection -->
<script>
  (() => {
    // Persistent state across island replacements in TinaCMS
    let activeScheduleView: 'smart' | 'full' = 'smart';
    let activeSmartCohort = '1.–3. třída';
    const activeSmartDays = new Set<string>(['all']);
    let activeFullCohort = 'all';

    function updateViewUI() {
      const smartFinderView = document.getElementById('smart-finder-view');
      const fullScheduleView = document.getElementById('full-schedule-view');
      const viewSmartFinderBtn = document.getElementById('view-smart-finder-btn');
      const viewFullScheduleBtn = document.getElementById('view-full-schedule-btn');

      if (!smartFinderView || !fullScheduleView) return;

      if (activeScheduleView === 'smart') {
        smartFinderView.classList.remove('hidden');
        fullScheduleView.classList.add('hidden');

        viewSmartFinderBtn?.classList.remove('bg-transparent', 'text-espresso-800', 'font-bold');
        viewSmartFinderBtn?.classList.add('bg-espresso-950', 'text-amber-300', 'shadow-xs', 'font-black');
        viewSmartFinderBtn?.setAttribute('aria-selected', 'true');

        viewFullScheduleBtn?.classList.remove('bg-espresso-950', 'text-amber-300', 'shadow-xs', 'font-black');
        viewFullScheduleBtn?.classList.add('bg-transparent', 'text-espresso-800', 'font-bold');
        viewFullScheduleBtn?.setAttribute('aria-selected', 'false');
      } else {
        smartFinderView.classList.add('hidden');
        fullScheduleView.classList.remove('hidden');

        viewFullScheduleBtn?.classList.remove('bg-transparent', 'text-espresso-800', 'font-bold');
        viewFullScheduleBtn?.classList.add('bg-espresso-950', 'text-amber-300', 'shadow-xs', 'font-black');
        viewFullScheduleBtn?.setAttribute('aria-selected', 'true');

        viewSmartFinderBtn?.classList.remove('bg-espresso-950', 'text-amber-300', 'shadow-xs', 'font-black');
        viewSmartFinderBtn?.classList.add('bg-transparent', 'text-espresso-800', 'font-bold');
        viewSmartFinderBtn?.setAttribute('aria-selected', 'false');
      }
    }

    function getCohortCategory(str: string): 'primary' | 'middle' | 'older' | 'other' {
      if (!str) return 'other';
      const s = str.toLowerCase();
      if (s.includes('1.–3') || s.includes('1-3') || s.includes('1. stupeň') || s.includes('1. stupen') || /\b[1-3]\b|\b[1-3]\./.test(s)) return 'primary';
      if (s.includes('4.–6') || s.includes('4-6') || s.includes('2. stupeň') || s.includes('2. stupen') || /\b[4-6]\b|\b[4-6]\./.test(s)) return 'middle';
      if (s.includes('7.–9') || s.includes('7-9') || s.includes('7.–13') || s.includes('7-13') || s.includes('sš') || s.includes('ss') || s.includes('maturit') || s.includes('střední') || s.includes('stredni') || /\b[7-9]\b|\b[7-9]\./.test(s)) return 'older';
      return 'other';
    }

    function matchesCohort(groupCohort: string, selectedCohort: string): boolean {
      if (!selectedCohort || selectedCohort === 'all') return true;
      if (groupCohort === selectedCohort) return true;
      const catGroup = getCohortCategory(groupCohort);
      const catSel = getCohortCategory(selectedCohort);
      if (catGroup !== 'other' && catGroup === catSel) return true;
      return groupCohort.trim().toLowerCase() === selectedCohort.trim().toLowerCase();
    }

    function updateCohortButtonsUI() {
      const smartCohortBtns = document.querySelectorAll<HTMLButtonElement>('.smart-cohort-btn');
      smartCohortBtns.forEach((b) => {
        const btnCohort = b.getAttribute('data-smart-cohort') || '';
        if (matchesCohort(btnCohort, activeSmartCohort)) {
          b.classList.remove('bg-parchment-50', 'border-parchment-300');
          b.classList.add('bg-amber-100/90', 'border-amber-500', 'shadow-2xs');
        } else {
          b.classList.remove('bg-amber-100/90', 'border-amber-500', 'shadow-2xs');
          b.classList.add('bg-parchment-50', 'border-parchment-300');
        }
      });
    }

    function updateDayButtonsUI() {
      const smartDayBtns = document.querySelectorAll<HTMLButtonElement>('.smart-day-btn');
      smartDayBtns.forEach((b) => {
        const bDay = b.getAttribute('data-smart-day') || 'all';
        const isActive = activeSmartDays.has(bDay);
        b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) {
          b.classList.remove('bg-white', 'text-espresso-900', 'border-parchment-300', 'hover:border-amber-400', 'hover:bg-amber-50', 'font-bold');
          b.classList.add('bg-espresso-950', 'text-amber-300', 'border-espresso-950', 'shadow-2xs', 'font-black');
        } else {
          b.classList.remove('bg-espresso-950', 'text-amber-300', 'border-espresso-950', 'shadow-2xs', 'font-black');
          b.classList.add('bg-white', 'text-espresso-900', 'border-parchment-300', 'hover:border-amber-400', 'hover:bg-amber-50', 'font-bold');
        }
      });
    }

    function updateSmartFilters() {
      const smartCards = document.querySelectorAll<HTMLElement>('.smart-result-card');
      const smartMatchCount = document.getElementById('smart-match-count');
      const smartEmptyState = document.getElementById('smart-empty-state');
      let visibleCount = 0;

      smartCards.forEach((card) => {
        const cCohort = card.getAttribute('data-smart-cohort') || '';
        const cDay = card.getAttribute('data-smart-day') || '';

        const cohortMatch = matchesCohort(cCohort, activeSmartCohort);
        const dayMatch = activeSmartDays.has('all') || (cDay !== '' && activeSmartDays.has(cDay));

        if (cohortMatch && dayMatch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (smartMatchCount) {
        if (visibleCount === 0) {
          smartMatchCount.textContent = 'Nenalezena žádná skupinka';
        } else if (visibleCount === 1) {
          smartMatchCount.textContent = 'Zobrazena 1 skupinka';
        } else if (visibleCount >= 2 && visibleCount <= 4) {
          smartMatchCount.textContent = `Zobrazeny ${visibleCount} skupinky`;
        } else {
          smartMatchCount.textContent = `Zobrazeno ${visibleCount} skupinek`;
        }
      }

      if (smartEmptyState) {
        if (visibleCount === 0) {
          smartEmptyState.classList.remove('hidden');
        } else {
          smartEmptyState.classList.add('hidden');
        }
      }

      updateSmartCarouselUI();
    }

    function updateSmartCarouselUI() {
      const container = document.getElementById('smart-cards-container');
      const prevBtn = document.getElementById('smart-prev-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('smart-next-btn') as HTMLButtonElement | null;
      const pageIndicator = document.getElementById('smart-carousel-page');
      const dotsContainer = document.getElementById('smart-carousel-dots');
      const gradient = document.getElementById('smart-carousel-gradient');

      if (!container) return;

      const visibleCards = Array.from(container.querySelectorAll<HTMLElement>('.smart-result-card')).filter(
        (c) => c.style.display !== 'none'
      );
      const total = visibleCards.length;

      const controls = document.getElementById('smart-carousel-controls');
      if (controls) {
        controls.style.display = total <= 1 ? 'none' : 'flex';
      }
      if (gradient) {
        gradient.style.display = total <= 1 ? 'none' : 'block';
      }

      if (total <= 1) {
        if (dotsContainer) dotsContainer.innerHTML = '';
        return;
      }

      const cardWidth = (visibleCards[0]?.offsetWidth || 280) + 12;
      const scrollLeft = container.scrollLeft;
      const activeIndex = Math.max(0, Math.min(total - 1, Math.round(scrollLeft / cardWidth)));

      if (pageIndicator) {
        pageIndicator.textContent = `${activeIndex + 1}/${total}`;
      }

      if (prevBtn) {
        prevBtn.disabled = activeIndex === 0;
      }
      if (nextBtn) {
        nextBtn.disabled = activeIndex >= total - 1;
        if (activeIndex >= total - 1) {
          nextBtn.classList.remove('animate-pulse');
        } else {
          nextBtn.classList.add('animate-pulse');
        }
      }

      if (dotsContainer) {
        dotsContainer.innerHTML = '';
        visibleCards.forEach((_, idx) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = `h-2 rounded-full transition-all cursor-pointer ${
            idx === activeIndex ? 'bg-amber-600 w-6 shadow-xs' : 'bg-parchment-300 hover:bg-parchment-400 w-2'
          }`;
          dot.setAttribute('aria-label', `Přejít na skupinku ${idx + 1}`);
          dot.setAttribute('data-smart-dot-idx', String(idx));
          dotsContainer.appendChild(dot);
        });
      }
    }

    function updateFullCohortFilter() {
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.schedule-filter-btn');
      const groupCards = document.querySelectorAll<HTMLElement>('.schedule-group-card');
      const cohortSelect = document.getElementById('schedule-cohort-select') as HTMLSelectElement | null;

      if (cohortSelect && cohortSelect.value !== activeFullCohort) {
        cohortSelect.value = activeFullCohort;
      }

      filterButtons.forEach((b) => {
        const bCohort = b.getAttribute('data-cohort') || '';
        if (matchesCohort(bCohort, activeFullCohort)) {
          b.classList.remove('bg-white', 'text-espresso-900', 'border-parchment-300', 'hover:bg-amber-50');
          b.classList.add('bg-espresso-950', 'text-amber-300', 'border-espresso-950');
        } else {
          b.classList.remove('bg-espresso-950', 'text-amber-300', 'border-espresso-950');
          b.classList.add('bg-white', 'text-espresso-900', 'border-parchment-300', 'hover:bg-amber-50');
        }
      });

      groupCards.forEach((card) => {
        const cardCohort = card.getAttribute('data-cohort') || '';
        if (matchesCohort(cardCohort, activeFullCohort)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    let hasBoundCarouselScroll = false;
    function bindCarouselScroll() {
      const container = document.getElementById('smart-cards-container');
      if (container && !hasBoundCarouselScroll) {
        hasBoundCarouselScroll = true;
        container.addEventListener('scroll', () => {
          window.requestAnimationFrame(updateSmartCarouselUI);
        }, { passive: true });
      }
    }

    function syncAllUI() {
      updateViewUI();
      updateCohortButtonsUI();
      updateDayButtonsUI();
      updateSmartFilters();
      updateFullCohortFilter();
      bindCarouselScroll();
    }

    let lastHandledTime = 0;
    function handleInteractiveEvent(e: Event) {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. Smart Cohort Buttons (e.g. 1.–3., 4.–6., 7.–13.)
      const cohortBtn = target.closest<HTMLButtonElement>('.smart-cohort-btn');
      if (cohortBtn) {
        const cohort = cohortBtn.getAttribute('data-smart-cohort');
        if (cohort) {
          activeSmartCohort = cohort;
          updateCohortButtonsUI();
          updateSmartFilters();
          return;
        }
      }

      // 2. Schedule View Switcher
      const smartViewBtn = target.closest('#view-smart-finder-btn');
      if (smartViewBtn) {
        activeScheduleView = 'smart';
        updateViewUI();
        return;
      }

      const fullViewBtn = target.closest('#view-full-schedule-btn');
      if (fullViewBtn) {
        activeScheduleView = 'full';
        updateViewUI();
        return;
      }

      const switchToFullBtn = target.closest('#smart-switch-to-full-btn');
      if (switchToFullBtn) {
        activeScheduleView = 'full';
        updateViewUI();
        const switcher = document.getElementById('schedule-mode-switcher');
        switcher?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      // 2b. Smart Carousel Mobile Controls
      const prevCarouselBtn = target.closest('#smart-prev-btn');
      if (prevCarouselBtn) {
        const container = document.getElementById('smart-cards-container');
        if (container) {
          const visibleCards = Array.from(container.querySelectorAll<HTMLElement>('.smart-result-card')).filter(c => c.style.display !== 'none');
          const cardWidth = visibleCards[0]?.offsetWidth || 280;
          container.scrollBy({ left: -(cardWidth + 12), behavior: 'smooth' });
        }
        return;
      }

      const nextCarouselBtn = target.closest('#smart-next-btn');
      if (nextCarouselBtn) {
        const container = document.getElementById('smart-cards-container');
        if (container) {
          const visibleCards = Array.from(container.querySelectorAll<HTMLElement>('.smart-result-card')).filter(c => c.style.display !== 'none');
          const cardWidth = visibleCards[0]?.offsetWidth || 280;
          container.scrollBy({ left: cardWidth + 12, behavior: 'smooth' });
        }
        return;
      }

      const dotBtn = target.closest<HTMLButtonElement>('[data-smart-dot-idx]');
      if (dotBtn) {
        const idx = parseInt(dotBtn.getAttribute('data-smart-dot-idx') || '0', 10);
        const container = document.getElementById('smart-cards-container');
        if (container) {
          const visibleCards = Array.from(container.querySelectorAll<HTMLElement>('.smart-result-card')).filter(c => c.style.display !== 'none');
          visibleCards[idx]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
        return;
      }

      // 3. Day Filter Buttons (Pills)
      const dayBtn = target.closest<HTMLButtonElement>('.smart-day-btn');
      if (dayBtn) {
        const day = dayBtn.getAttribute('data-smart-day') || 'all';
        if (day === 'all') {
          activeSmartDays.clear();
          activeSmartDays.add('all');
        } else {
          activeSmartDays.delete('all');
          if (activeSmartDays.has(day)) {
            activeSmartDays.delete(day);
            if (activeSmartDays.size === 0) {
              activeSmartDays.add('all');
            }
          } else {
            activeSmartDays.add(day);
          }
        }
        updateDayButtonsUI();
        updateSmartFilters();
        return;
      }

      // 4. Reset Day Filter
      const resetDayBtn = target.closest('#smart-reset-day-btn');
      if (resetDayBtn) {
        activeSmartDays.clear();
        activeSmartDays.add('all');
        updateDayButtonsUI();
        updateSmartFilters();
        return;
      }

      // 5. Full Schedule Cohort Filter Tabs
      const fullFilterBtn = target.closest<HTMLButtonElement>('.schedule-filter-btn');
      if (fullFilterBtn) {
        const cohort = fullFilterBtn.getAttribute('data-cohort') || 'all';
        activeFullCohort = cohort;
        updateFullCohortFilter();
        return;
      }

      // 6. Select Group CTAs
      const selectBtn = target.closest<HTMLButtonElement>('[data-select-group]');
      if (selectBtn) {
        const id = selectBtn.getAttribute('data-select-group');
        const name = selectBtn.getAttribute('data-group-name');
        const day = selectBtn.getAttribute('data-group-day');
        const time = selectBtn.getAttribute('data-group-time');
        const cohort = selectBtn.getAttribute('data-group-cohort');
        const animal = selectBtn.getAttribute('data-group-animal');
        const emoji = selectBtn.getAttribute('data-group-emoji');
        const status = selectBtn.getAttribute('data-group-status');

        if (status === 'full') return;

        window.dispatchEvent(new CustomEvent('valek:select-group', {
          detail: { id, name, day, time, cohort, animal, emoji, status }
        }));

        const contactSection = document.getElementById('kontakt');
        contactSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      // 7. Special Slots (Adults / 1-on-1)
      const specialBtn = target.closest<HTMLAnchorElement>('.special-slot-btn');
      if (specialBtn) {
        const slotName = specialBtn.getAttribute('data-select-special');
        if (!slotName) return;

        window.dispatchEvent(new CustomEvent('valek:select-group', {
          detail: {
            id: 'special',
            name: slotName,
            day: 'Dle domluvy',
            time: 'Flexibilní',
            cohort: slotName.includes('Dospělí') ? 'Dospělí & Profese' : 'Individuální 1 na 1',
            animal: slotName,
            emoji: slotName.includes('Dospělí') ? '💼' : '👤',
            status: 'open'
          }
        }));

        const contactSection = document.getElementById('kontakt');
        contactSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
    }

    // Capture pointerdown before TinaCMS click-to-edit stops event propagation
    document.addEventListener('pointerdown', (e) => {
      lastHandledTime = Date.now();
      handleInteractiveEvent(e);
    }, true);

    // Fallback click listener (e.g. keyboard navigation or simulated clicks)
    document.addEventListener('click', (e) => {
      if (Date.now() - lastHandledTime < 350) return;
      handleInteractiveEvent(e);
    }, true);

    // Dropdown change delegation
    document.addEventListener('change', (e) => {
      const select = (e.target as HTMLElement)?.closest<HTMLSelectElement>('#schedule-cohort-select');
      if (select) {
        activeFullCohort = select.value;
        updateFullCohortFilter();
      }
    }, true);

    // Initial sync
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncAllUI);
    } else {
      syncAllUI();
    }
    document.addEventListener('astro:page-load', syncAllUI);

    // Observe TinaCMS island swaps to preserve selected cohort & filter states
    let lastContainer = document.getElementById('smart-finder-view');
    const observer = new MutationObserver(() => {
      const currentContainer = document.getElementById('smart-finder-view');
      if (currentContainer && currentContainer !== lastContainer) {
        lastContainer = currentContainer;
        syncAllUI();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>
