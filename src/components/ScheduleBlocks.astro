{enabled && (
  <section id="harmonogram" class="py-12 sm:py-16 md:py-20 bg-gradient-to-b from-[#FFFDF9] via-[#FAF7F2] to-[#FFFDF9] border-b border-parchment-300 relative overflow-hidden">
    <div id="rozvrh" class="absolute -top-24"></div>
    
    <!-- Subtle decorative ambient blobs -->
    <div class="absolute top-0 right-10 w-96 h-96 bg-amber-200/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-96 h-96 bg-emerald-200/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center space-y-3 mb-8 sm:mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-black uppercase tracking-wider text-espresso-950" data-tina-field={tinaField(schedule, 'badge')} data-edit-key="schedule.badge" data-edit-label="Štítek rozvrhu">
          <span>⏰</span>
          <span>{badge}</span>
        </div>
        <h2 class="font-heading font-black text-2xl sm:text-3xl md:text-4xl text-espresso-950 tracking-tight" data-tina-field={tinaField(schedule, 'title')} data-edit-key="schedule.title" data-edit-label="Nadpis rozvrhu" set:html={formatRichText(title)}>
        </h2>
        <p class="text-espresso-800/80 text-sm sm:text-base leading-relaxed" data-tina-field={tinaField(schedule, 'subtitle')} data-edit-key="schedule.subtitle" data-edit-label="Podnadpis rozvrhu" set:html={formatRichText(subtitle)}>
        </p>
      </div>

      <!-- Rolling Enrollment System Highlight Banner -->
      <div class="max-w-5xl mx-auto mb-10 p-5 sm:p-7 rounded-3xl bg-amber-50/90 border-2 border-amber-300/90 shadow-soft-sm relative overflow-hidden">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
          <div class="space-y-3 flex-1">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-200/80 border border-amber-400 text-espresso-950 text-[11px] font-black uppercase tracking-wider" data-tina-field={tinaField(schedule, 'rollingSystemBadge')} data-edit-key="schedule.rollingSystemBadge" data-edit-label="Štítek plynulého systému">
              <span>{rollingSystemBadge}</span>
            </div>
            <h3 class="font-heading font-black text-xl sm:text-2xl text-espresso-950 leading-snug" data-tina-field={tinaField(schedule, 'rollingSystemTitle')} data-edit-key="schedule.rollingSystemTitle" data-edit-label="Nadpis plynulého systému">
              {rollingSystemTitle}
            </h3>
            <p class="text-xs sm:text-sm text-espresso-900/85 leading-relaxed font-normal" data-tina-field={tinaField(schedule, 'rollingSystemText')} data-edit-key="schedule.rollingSystemText" data-edit-label="Popis plynulého systému" set:html={formatRichText(rollingSystemText)}>
            </p>
          </div>

          <!-- 3 Quick Pillars of Rolling Intake -->
          <div class="w-full lg:w-80 flex-shrink-0 grid grid-cols-1 gap-2.5">
            <div class="p-3 rounded-2xl bg-white/90 border border-amber-200 flex items-center gap-3 shadow-2xs">
              <span class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-black text-base flex-shrink-0" data-tina-field={tinaField(schedule, 'pillar1Number')} data-edit-key="schedule.pillar1Number" data-edit-label="Pilíř 1 číslo">{pillar1Number}</span>
              <div class="text-xs">
                <strong class="text-espresso-950 block font-heading" data-tina-field={tinaField(schedule, 'pillar1Title')} data-edit-key="schedule.pillar1Title" data-edit-label="Pilíř 1 nadpis">{pillar1Title}</strong>
                <span class="text-stone-600 text-[11px]" data-tina-field={tinaField(schedule, 'pillar1Desc')} data-edit-key="schedule.pillar1Desc" data-edit-label="Pilíř 1 popis">{pillar1Desc}</span>
              </div>
            </div>

            <div class="p-3 rounded-2xl bg-white/90 border border-amber-200 flex items-center gap-3 shadow-2xs">
              <span class="w-9 h-9 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center font-black text-base flex-shrink-0" data-tina-field={tinaField(schedule, 'pillar2Number')} data-edit-key="schedule.pillar2Number" data-edit-label="Pilíř 2 číslo">{pillar2Number}</span>
              <div class="text-xs">
                <strong class="text-espresso-950 block font-heading" data-tina-field={tinaField(schedule, 'pillar2Title')} data-edit-key="schedule.pillar2Title" data-edit-label="Pilíř 2 nadpis">{pillar2Title}</strong>
                <span class="text-stone-600 text-[11px]" data-tina-field={tinaField(schedule, 'pillar2Desc')} data-edit-key="schedule.pillar2Desc" data-edit-label="Pilíř 2 popis">{pillar2Desc}</span>
              </div>
            </div>

            <div class="p-3 rounded-2xl bg-white/90 border border-amber-200 flex items-center gap-3 shadow-2xs">
              <span class="w-9 h-9 rounded-xl bg-purple-100 text-purple-900 flex items-center justify-center font-black text-base flex-shrink-0" data-tina-field={tinaField(schedule, 'pillar3Icon')} data-edit-key="schedule.pillar3Icon" data-edit-label="Pilíř 3 ikona">{pillar3Icon}</span>
              <div class="text-xs">
                <strong class="text-espresso-950 block font-heading" data-tina-field={tinaField(schedule, 'pillar3Title')} data-edit-key="schedule.pillar3Title" data-edit-label="Pilíř 3 nadpis">{pillar3Title}</strong>
                <span class="text-stone-600 text-[11px]" data-tina-field={tinaField(schedule, 'pillar3Desc')} data-edit-key="schedule.pillar3Desc" data-edit-label="Pilíř 3 popis">{pillar3Desc}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Why In-Person Callout Banner -->
      <div class="max-w-5xl mx-auto mb-8 p-4 sm:p-5 rounded-card-lg bg-emerald-50/80 border border-emerald-300/80 flex flex-col sm:flex-row items-center gap-4 shadow-2xs">
        <span class="text-3xl flex-shrink-0" data-tina-field={tinaField(schedule, 'whyInPersonIcon')} data-edit-key="schedule.whyInPersonIcon" data-edit-label="Ikona naživo">{whyInPersonIcon}</span>
        <div class="space-y-1 text-center sm:text-left flex-1">
          <h4 class="font-heading font-black text-sm sm:text-base text-emerald-950" data-tina-field={tinaField(schedule, 'whyInPersonTitle')} data-edit-key="schedule.whyInPersonTitle" data-edit-label="Nadpis naživo">{whyInPersonTitle}</h4>
          <p class="text-xs text-emerald-900/80 leading-relaxed font-normal" data-tina-field={tinaField(schedule, 'whyInPersonText')} data-edit-key="schedule.whyInPersonText" data-edit-label="Popis naživo" set:html={formatRichText(whyInPersonText)}></p>
        </div>
      </div>

      <!-- Mode Switcher: Smart Group Finder vs Full 15-Group Schedule -->
      <div class="flex items-center justify-center gap-2 mb-8" id="schedule-mode-switcher">
        <div class="inline-flex p-1.5 rounded-card-md bg-parchment-200 border border-parchment-300 shadow-2xs" role="tablist" aria-label="Režim zobrazení rozvrhu">
          <button
            type="button"
            id="view-smart-finder-btn"
            role="tab"
            aria-selected="true"
            aria-controls="smart-finder-view"
            class="schedule-view-toggle px-4 sm:px-6 py-2.5 rounded-card-sm text-xs sm:text-sm font-black transition-all bg-espresso-950 text-amber-300 shadow-xs flex items-center gap-2 cursor-pointer"
            data-view="smart"
          >
            <span>🎯</span>
            <span data-tina-field={tinaField(schedule, 'smartFinderTabLabel')} data-edit-key="schedule.smartFinderTabLabel" data-edit-label="Přepínač: Vyhledávač">{smartFinderTabLabel}</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-400 text-espresso-950 uppercase font-black tracking-wider" data-tina-field={tinaField(schedule, 'smartFinderTabBadge')} data-edit-key="schedule.smartFinderTabBadge" data-edit-label="Štítek přepínače">{smartFinderTabBadge}</span>
          </button>
          <button
            type="button"
            id="view-full-schedule-btn"
            role="tab"
            aria-selected="false"
            aria-controls="full-schedule-view"
            class="schedule-view-toggle px-4 sm:px-6 py-2.5 rounded-card-sm text-xs sm:text-sm font-bold text-espresso-800 hover:text-espresso-950 transition-all flex items-center gap-2 cursor-pointer"
            data-view="full"
          >
            <span>📋</span>
            <span data-tina-field={tinaField(schedule, 'fullScheduleTabLabel')} data-edit-key="schedule.fullScheduleTabLabel" data-edit-label="Přepínač: Celý rozvrh">{fullScheduleTabLabel}</span>
          </button>
        </div>
      </div>

      <!-- 1. SMART GROUP FINDER VIEW (Default & Fast) -->
      <div id="smart-finder-view" class="space-y-4 sm:space-y-6 mb-8">
        <div class="max-w-5xl mx-auto p-3.5 sm:p-8 rounded-card-xl bg-white border-2 border-amber-400 shadow-card-lift relative overflow-hidden">
          
          <!-- Top subtle ribbon -->
          <div class="flex items-center justify-between gap-2 mb-3 sm:mb-6 pb-2.5 sm:pb-4 border-b border-parchment-200">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-950 text-xs font-black uppercase tracking-wider border border-amber-300" data-tina-field={tinaField(schedule, 'smartFinderBadge')} data-edit-key="schedule.smartFinderBadge" data-edit-label="Štítek vyhledávače">
                {smartFinderBadge}
              </span>
              <span class="text-xs text-stone-500 font-bold hidden sm:inline" data-tina-field={tinaField(schedule, 'smartFinderTime')} data-edit-key="schedule.smartFinderTime" data-edit-label="Odhad času">{smartFinderTime}</span>
            </div>
            <span class="text-xs text-emerald-800 font-bold" data-tina-field={tinaField(schedule, 'smartFinderFree')} data-edit-key="schedule.smartFinderFree" data-edit-label="Štítek lekce zdarma">{smartFinderFree}</span>
          </div>

          <!-- Step 1: Cohort Selection (Compact 3-col mobile grid) -->
          <div class="space-y-2 sm:space-y-3 mb-3.5 sm:mb-6">
            <label class="block text-xs sm:text-sm font-black uppercase tracking-wider text-espresso-950" data-tina-field={tinaField(schedule, 'smartStep1Title')} data-edit-key="schedule.smartStep1Title" data-edit-label="Krok 1: Nadpis">
              {smartStep1Title}
            </label>
            <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5" id="smart-cohort-buttons">
              <button
                type="button"
                data-smart-cohort="1.–3. třída"
                class="smart-cohort-btn p-2 sm:p-3.5 rounded-card-md border-2 text-center sm:text-left transition-all cursor-pointer flex flex-col sm:flex-row items-center gap-1 sm:gap-3 bg-amber-100/90 border-amber-500 shadow-2xs group"
              >
                <span class="text-xl sm:text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">🎒</span>
                <div class="min-w-0 w-full">
                  <div class="font-heading font-black text-[11px] min-[360px]:text-xs sm:text-sm text-espresso-950 leading-tight" data-tina-field={tinaField(schedule, 'smartCohort1Title')} data-edit-key="schedule.smartCohort1Title" data-edit-label="Krok 1: 1.–3. třída">{smartCohort1Title}</div>
                  <div class="text-[10px] sm:text-xs text-stone-600 truncate mt-0.5" data-tina-field={tinaField(schedule, 'smartCohort1Sub')} data-edit-key="schedule.smartCohort1Sub" data-edit-label="Krok 1: 1.–3. třída čas">{smartCohort1Sub}</div>
                </div>
              </button>

              <button
                type="button"
                data-smart-cohort="4.–6. třída"
                class="smart-cohort-btn p-2 sm:p-3.5 rounded-card-md border-2 text-center sm:text-left transition-all cursor-pointer flex flex-col sm:flex-row items-center gap-1 sm:gap-3 bg-parchment-50 border-parchment-300 hover:border-amber-400 group"
              >
                <span class="text-xl sm:text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">🚀</span>
                <div class="min-w-0 w-full">
                  <div class="font-heading font-black text-[11px] min-[360px]:text-xs sm:text-sm text-espresso-950 leading-tight" data-tina-field={tinaField(schedule, 'smartCohort2Title')} data-edit-key="schedule.smartCohort2Title" data-edit-label="Krok 1: 4.–6. třída">{smartCohort2Title}</div>
                  <div class="text-[10px] sm:text-xs text-stone-600 truncate mt-0.5" data-tina-field={tinaField(schedule, 'smartCohort2Sub')} data-edit-key="schedule.smartCohort2Sub" data-edit-label="Krok 1: 4.–6. třída čas">{smartCohort2Sub}</div>
                </div>
              </button>

              <button
                type="button"
                data-smart-cohort="7.–9. třída & SŠ"
                class="smart-cohort-btn p-2 sm:p-3.5 rounded-card-md border-2 text-center sm:text-left transition-all cursor-pointer flex flex-col sm:flex-row items-center gap-1 sm:gap-3 bg-parchment-50 border-parchment-300 hover:border-amber-400 group"
              >
                <span class="text-xl sm:text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">🎓</span>
                <div class="min-w-0 w-full">
                  <div class="font-heading font-black text-[11px] min-[360px]:text-xs sm:text-sm text-espresso-950 leading-tight" data-tina-field={tinaField(schedule, 'smartCohort3Title')} data-edit-key="schedule.smartCohort3Title" data-edit-label="Krok 1: 7.–9. třída & SŠ">{smartCohort3Title}</div>
                  <div class="text-[10px] sm:text-xs text-stone-600 truncate mt-0.5" data-tina-field={tinaField(schedule, 'smartCohort3Sub')} data-edit-key="schedule.smartCohort3Sub" data-edit-label="Krok 1: 7.–9. třída čas">{smartCohort3Sub}</div>
                </div>
              </button>
            </div>
          </div>

          <!-- Step 2: Day Selection (Scrollable chip bar on mobile) -->
          <div class="space-y-2 sm:space-y-3 mb-3.5 sm:mb-6 pb-3 sm:pb-6 border-b border-parchment-200">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <label class="block text-xs sm:text-sm font-black uppercase tracking-wider text-espresso-950" data-tina-field={tinaField(schedule, 'smartStep2Title')} data-edit-key="schedule.smartStep2Title" data-edit-label="Krok 2: Nadpis">
                {smartStep2Title}
              </label>
              <span class="text-[10px] sm:text-[11px] font-bold text-amber-900 bg-amber-100/80 border border-amber-300/70 px-2 py-0.5 sm:px-2.5 sm:py-0.5 rounded-full flex items-center gap-1 shadow-2xs" data-tina-field={tinaField(schedule, 'smartDayMultiNote')} data-edit-key="schedule.smartDayMultiNote" data-edit-label="Krok 2: Výběr více dní">
                {smartDayMultiNote}
              </span>
            </div>
            <div class="flex overflow-x-auto sm:flex-wrap gap-1.5 sm:gap-2 pb-1.5 sm:pb-0 scrollbar-none no-scrollbar -mx-1 px-1" id="smart-day-pills">
              <button
                type="button"
                data-smart-day="all"
                aria-pressed="true"
                class="smart-day-btn flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-black transition-all cursor-pointer border bg-espresso-950 text-amber-300 border-espresso-950 shadow-2xs select-none whitespace-nowrap"
              >
                <span data-tina-field={tinaField(schedule, 'smartDayAllLabel')} data-edit-key="schedule.smartDayAllLabel" data-edit-label="Krok 2: Všechny dny">{smartDayAllLabel}</span>
              </button>
              <button
                type="button"
                data-smart-day="Pondělí"
                aria-pressed="false"
                class="smart-day-btn flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold transition-all cursor-pointer border bg-white text-espresso-900 border-parchment-300 hover:border-amber-400 hover:bg-amber-50 select-none whitespace-nowrap"
              >
                Pondělí
              </button>
              <button
                type="button"
                data-smart-day="Úterý"
                aria-pressed="false"
                class="smart-day-btn flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold transition-all cursor-pointer border bg-white text-espresso-900 border-parchment-300 hover:border-amber-400 hover:bg-amber-50 select-none whitespace-nowrap"
              >
                Úterý
              </button>
              <button
                type="button"
                data-smart-day="Středa"
                aria-pressed="false"
                class="smart-day-btn flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold transition-all cursor-pointer border bg-white text-espresso-900 border-parchment-300 hover:border-amber-400 hover:bg-amber-50 select-none whitespace-nowrap"
              >
                Středa
              </button>
              <button
                type="button"
                data-smart-day="Čtvrtek"
                aria-pressed="false"
                class="smart-day-btn flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold transition-all cursor-pointer border bg-white text-espresso-900 border-parchment-300 hover:border-amber-400 hover:bg-amber-50 select-none whitespace-nowrap"
              >
                Čtvrtek
              </button>
              <button
                type="button"
                data-smart-day="Pátek"
                aria-pressed="false"
                class="smart-day-btn flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold transition-all cursor-pointer border bg-white text-espresso-900 border-parchment-300 hover:border-amber-400 hover:bg-amber-50 select-none whitespace-nowrap"
              >
                Pátek
              </button>
            </div>
          </div>

          <!-- Matching Results Showcase Area -->
          <div class="space-y-3 sm:space-y-4">
            <div class="flex items-center justify-between gap-2">
              <div class="min-w-0">
                <span class="text-xs font-black uppercase tracking-wider text-amber-950 block truncate" data-tina-field={tinaField(schedule, 'smartResultsTitle')} data-edit-key="schedule.smartResultsTitle" data-edit-label="Nadpis doporučených skupinek">
                  {smartResultsTitle}
                </span>
                <span id="smart-match-count" class="text-xs font-bold text-stone-500">
                  Zobrazeno skupinek: 5
                </span>
              </div>

              <!-- Mobile Carousel Controls: Arrows & Page Indicator -->
              <div class="flex sm:hidden items-center gap-1.5 flex-shrink-0" id="smart-carousel-controls">
                <button
                  type="button"
                  id="smart-prev-btn"
                  aria-label="Předchozí skupinka"
                  class="w-8 h-8 rounded-full bg-white hover:bg-amber-100 border-2 border-amber-300 text-espresso-950 flex items-center justify-center font-black text-sm shadow-2xs active:scale-90 transition-all cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                >
                  ←
                </button>
                <span id="smart-carousel-page" class="text-[11px] font-black text-amber-950 px-1 font-mono">1/5</span>
                <button
                  type="button"
                  id="smart-next-btn"
                  aria-label="Další skupinka"
                  class="w-8 h-8 rounded-full bg-amber-400 hover:bg-amber-300 border-2 border-amber-500 text-espresso-950 flex items-center justify-center font-black text-sm shadow-2xs active:scale-90 transition-all cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed animate-pulse"
                >
                  →
                </button>
              </div>
            </div>

            <!-- Horizontal Carousel with prominent peek and edge indicator -->
            <div class="relative">
              <div
                class="flex sm:grid overflow-x-auto sm:overflow-visible sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 pb-2 sm:pb-0 snap-x snap-mandatory -mx-2 px-2 sm:mx-0 sm:px-0"
                id="smart-cards-container"
                role="region"
                aria-roledescription="carousel"
                aria-label="Doporučené zvířecí skupinky"
                style="scrollbar-width: none; -ms-overflow-style: none;"
              >
                {groups.map((group, idx) => {
                  const cap = getCapacityInfo(group);
                  const walkHint = group.walkHint || getLocalWalkHint(group.cohort);
                  const isInitialSmartVisible = matchesCohort(group.cohort, '1.–3. třída');
                  return (
                    <div
                      data-tina-field={tinaField(schedule, 'groups', idx)}
                      data-smart-card-id={group.id}
                      data-smart-cohort={group.cohort}
                      data-smart-day={group.day}
                      role="group"
                      aria-roledescription="slide"
                      aria-label={`${group.emoji || '🐾'} ${group.animal} – ${group.day} ${group.time}`}
                      style={{ display: isInitialSmartVisible ? 'flex' : 'none' }}
                      class="smart-result-card flex-shrink-0 w-[78vw] min-[400px]:w-[80vw] max-w-[310px] snap-center sm:w-auto sm:max-w-none bg-surface-highlight rounded-card-lg p-4 sm:p-5 border-2 border-amber-300/80 hover:border-amber-500 shadow-card hover:shadow-card-lift transition-all flex-col justify-between"
                    >
                    <div class="space-y-3">
                      <div class="flex items-center justify-between gap-2 flex-wrap">
                        <span class="px-2.5 py-1 rounded-card-sm bg-espresso-950 text-white text-xs font-black">
                          {group.day} • {group.time}
                        </span>
                        <span class:list={["px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider border", cap.badgeClass]}>
                          {cap.badgeText}
                        </span>
                      </div>

                      <div class="flex items-center gap-3 pt-1">
                        <span
                          class="text-3xl w-12 h-12 rounded-card-md bg-amber-100 flex items-center justify-center border border-amber-300 shadow-2xs flex-shrink-0"
                          data-tina-field={tinaField(group, 'emoji')}
                          data-edit-key={`schedule.groups.${idx}.emoji`}
                          data-edit-label="Emoji"
                        >
                          {group.emoji}
                        </span>
                        <div class="min-w-0">
                          <h4
                            class="font-heading font-black text-lg text-espresso-950 truncate"
                            data-tina-field={tinaField(group, 'animal')}
                            data-edit-key={`schedule.groups.${idx}.animal`}
                            data-edit-label="Zvíře"
                          >
                            {group.animal}
                          </h4>
                          <span
                            class="text-xs font-bold text-amber-900 truncate block"
                            data-tina-field={tinaField(group, 'cohortBadge')}
                            data-edit-key={`schedule.groups.${idx}.cohortBadge`}
                            data-edit-label="Štítek zaměření"
                          >
                            {group.cohortBadge || group.cohort}
                          </span>
                        </div>
                      </div>

                      <p
                        class="text-xs text-espresso-800/85 leading-relaxed font-normal min-h-[36px]"
                        data-tina-field={tinaField(group, 'description')}
                        data-edit-key={`schedule.groups.${idx}.description`}
                        data-edit-label="Popis skupinky"
                        set:html={formatRichText(group.description || "")}
                      >
                      </p>

                      <div
                        class="p-2.5 rounded-card-sm bg-amber-50/90 border border-amber-200 text-[11px] text-amber-950 font-medium leading-snug"
                        data-tina-field={tinaField(group, 'walkHint')}
                        data-edit-key={`schedule.groups.${idx}.walkHint`}
                        data-edit-label="Docházkový tip"
                      >
                        {walkHint}
                      </div>

                      <!-- Capacity Strip (Smart Scarcity) -->
                      <div class="space-y-1.5 pt-2 border-t border-parchment-200">
                        {cap.showMeter ? (
                          <div class="space-y-1">
                            <div class="flex items-center justify-between text-[11px]">
                              <span class="font-black text-amber-950 flex items-center gap-1">
                                <span>🔥</span>
                                <span
                                  data-tina-field={tinaField(group, 'occupiedSeats')}
                                  data-edit-key={`schedule.groups.${idx}.occupiedSeats`}
                                  data-edit-label="Počet obsazených míst"
                                >
                                  {cap.meterLabel}
                                </span>
                              </span>
                              <span class="text-[10px] font-bold text-amber-800">
                                {cap.meterSub}
                              </span>
                            </div>
                            <div class="w-full h-2 rounded-full bg-parchment-200 overflow-hidden flex">
                              <div class:list={["h-full transition-all duration-500", cap.indicatorColor]} style={`width: ${cap.percentage}%;`}></div>
                            </div>
                          </div>
                        ) : (
                          <div class="flex items-center justify-between text-[11px] py-0.5">
                            <div class="flex items-center gap-1.5">
                              <span class="text-stone-400 text-xs">👥</span>
                              <span
                                class="font-bold text-espresso-950"
                                data-tina-field={tinaField(group, 'occupiedSeats')}
                                data-edit-key={`schedule.groups.${idx}.occupiedSeats`}
                                data-edit-label="Kapacita skupinky"
                              >
                                {cap.meterLabel}
                              </span>
                            </div>
                            <span class:list={[
                              "text-[10px] font-bold px-2 py-0.5 rounded-full border",
                              cap.status === 'open' ? "bg-emerald-50 text-emerald-800 border-emerald-200" :
                              cap.status === 'waiting_list' ? "bg-amber-50 text-amber-800 border-amber-200" :
                              "bg-red-50 text-red-800 border-red-200"
                            ]}>
                              {cap.meterSub}
                            </span>
                          </div>
                        )}
                      </div>
                    </div>

                    <div class="pt-4 mt-4 border-t border-parchment-200">
                      <button
                        type="button"
                        data-select-group={group.id}
                        data-group-name={`${group.emoji} ${group.day} ${group.time} • ${group.animal} (${group.cohort})`}
                        data-group-day={group.day}
