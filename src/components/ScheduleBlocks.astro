---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface GroupItem {
  id: string;
  day: string;
  time: string;
  animal: string;
  emoji: string;
  cohort: string;
  cohortBadge?: string;
  walkHint?: string;
  occupiedSeats?: number;
  maxSeats?: number;
  waitingListSeats?: number;
  statusOverride?: string;
  description?: string;
  [key: string]: any;
}

interface Props {
  schedule?: {
    enabled?: boolean;
    badge?: string;
    title?: string;
    subtitle?: string;
    rollingSystemBadge?: string;
    rollingSystemTitle?: string;
    rollingSystemText?: string;
    ctaText?: string;
    smartFinderTabLabel?: string;
    smartFinderTabBadge?: string;
    fullScheduleTabLabel?: string;
    smartFinderBadge?: string;
    smartFinderTime?: string;
    smartFinderFree?: string;
    smartStep1Title?: string;
    smartCohort1Title?: string;
    smartCohort1Sub?: string;
    smartCohort2Title?: string;
    smartCohort2Sub?: string;
    smartCohort3Title?: string;
    smartCohort3Sub?: string;
    smartStep2Title?: string;
    smartDayMultiNote?: string;
    smartDayAllLabel?: string;
    smartResultsTitle?: string;
    smartEmptyTitle?: string;
    smartEmptyText?: string;
    smartEmptyReset?: string;
    smartSwitchToFull?: string;
    groups?: GroupItem[];
    [key: string]: any;
  };
}

const { schedule = {} } = Astro.props;

const enabled = schedule.enabled !== false;
const badge = schedule.badge || "PŘEHLEDNÝ ČASOVÝ ROZVRH & REZERVACE";
const title = schedule.title || "Pravidelný týdenní rozvrh: Vyberte si svou zvířecí skupinku";
const subtitle = schedule.subtitle || "Výuka probíhá 100% osobně v doučovně v Uherském Hradišti (Růžová 1238). Žádné sezení u monitoru přes internet – deskovky, karty a přirozená konverzace naživo.";
const rollingSystemBadge = schedule.rollingSystemBadge || "🔄 PLYNULÝ CELOROČNÍ SYSTÉM";
const rollingSystemTitle = schedule.rollingSystemTitle || "Žádný začátek ani konec – do party se můžete přidat kdykoliv";
const rollingSystemText = schedule.rollingSystemText || "Kurz nemá pevné datum začátku ani konce. Nové studenty přijímáme plynule po celý rok, pokud je ve skupince volno. Pan Válek dbá na to, aby skupinky byly věkově i jazykově sladěné a děti si v partě skvěle rozuměly. Jakmile se třída naplní (8 míst), otevírá se 4místná čekací listina. **Garance výhodné ceny:** Pro nově příchozí se cena po naplnění mírně zvyšuje, ale stávající studenti si drží svou původní příznivou sazbu po celou dobu!";

// Smart Group Finder Props
const smartFinderTabLabel = schedule.smartFinderTabLabel || "Chytrý 2krokový vyhledávač";
const smartFinderTabBadge = schedule.smartFinderTabBadge || "Doporučeno";
const fullScheduleTabLabel = schedule.fullScheduleTabLabel || "Celý týdenní rozvrh (15)";

const smartFinderBadge = schedule.smartFinderBadge || "🎯 RYCHLÝ VÝBĚR VHODNÉ SKUPINKY";
const smartFinderTime = schedule.smartFinderTime || "Zabere 15 vteřin";
const smartFinderFree = schedule.smartFinderFree || "🎁 1. lekce 100% ZDARMA";

const smartStep1Title = schedule.smartStep1Title || "1. Do jaké třídy dítě chodí?";
const smartCohort1Title = schedule.smartCohort1Title || "1.–3. třída ZŠ";
const smartCohort1Sub = schedule.smartCohort1Sub || "12:30–13:30 • 60 min";
const smartCohort2Title = schedule.smartCohort2Title || "4.–6. třída ZŠ";
const smartCohort2Sub = schedule.smartCohort2Sub || "13:30–14:30 • 60 min";
const smartCohort3Title = schedule.smartCohort3Title || "7.–9. třída & SŠ";
const smartCohort3Sub = schedule.smartCohort3Sub || "14:30–16:00 • 90 min";

const smartStep2Title = schedule.smartStep2Title || "2. Které dny po škole se vám nejvíc hodí?";
const smartDayMultiNote = schedule.smartDayMultiNote || "✨ Lze vybrat i více dní najednou";
const smartDayAllLabel = schedule.smartDayAllLabel || "🌟 Kdykoliv v týdnu";

const smartResultsTitle = schedule.smartResultsTitle || "🎯 Doporučené zvířecí skupinky pro váš výběr:";
const smartEmptyTitle = schedule.smartEmptyTitle || "Pro tento den a ročník jsme nenašli odpovídající skupinku";
const smartEmptyText = schedule.smartEmptyText || "Zkuste přepnout den na „Kdykoliv v týdnu“ nebo se podívejte do celého týdenního rozvrhu.";
const smartEmptyReset = schedule.smartEmptyReset || "Zobrazit všechny dny v týdnu";
const smartSwitchToFull = schedule.smartSwitchToFull || "Chcete si prohlédnout všech 15 skupinek v kompletní týdenní tabulce? Přepnout na celý rozvrh →";

const whyInPersonIcon = schedule.whyInPersonIcon || "🎲";
const whyInPersonTitle = schedule.whyInPersonTitle || "Proč učíme 100% naživo v doučovně a ne přes internet?";
const whyInPersonText = schedule.whyInPersonText || "Děti i studenti tráví u monitorů hodiny denně. Jazyk hrou funguje nejlépe při živém očním kontaktu, házení kostkou, smíchu a týmových deskovkách. U obrazovky takové zapojení nevznikne. V učebně mají děti i studenti telefony bezpečně odložené v taškách – vytváříme klidný offline prostor bez displejů, kde se naplno ponoří do hry a živé komunikace.";

const pillar1Number = schedule.pillar1Number || "8";
const pillar1Title = schedule.pillar1Title || "Optimální kapacita 8 míst";
const pillar1Desc = schedule.pillar1Desc || "Ideální pro deskovky, karty a každé dítě se dostane ke slovu.";

const pillar2Number = schedule.pillar2Number || "4";
const pillar2Title = schedule.pillar2Title || "Čekací listina (4 místa)";
const pillar2Desc = schedule.pillar2Desc || "Přednostní čekací listina pro případ uvolnění místa v partě.";

const pillar3Icon = schedule.pillar3Icon || "🔒";
const pillar3Title = schedule.pillar3Title || "Garance stálé ceny";
const pillar3Desc = schedule.pillar3Desc || "Stávající studenti si drží svou původní příznivou sazbu natrvalo.";

const filterAllLabel = schedule.filterAllLabel || "🌟 Všechny skupinky (15)";
const filterGrade13Label = schedule.filterGrade13Label || "🎒 1.–3. třída (12:30–13:30 • 60 min)";
const filterGrade46Label = schedule.filterGrade46Label || "🚀 4.–6. třída (13:30–14:30 • 60 min)";
const filterGrade713Label = schedule.filterGrade713Label || "🎓 7.–9. třída & SŠ (14:30–16:00 • 90 min)";

const legendOpen = schedule.legendOpen || "Volná místa";
const legendWaitingList = schedule.legendWaitingList || "Čekací listina";
const legendFull = schedule.legendFull || "Plně obsazeno";

const adultsBlock = schedule.adultsBlock || {};
const individualBlock = schedule.individualBlock || {};

// Fallback 15 Australian animal groups if not provided
const defaultGroups: GroupItem[] = [
  // 12:30 - 13:30 (1.-3. třída)
  { id: "kangaroos", day: "Pondělí", time: "12:30 – 13:30", animal: "Kangaroos", emoji: "🦘", cohort: "1.–3. třída", cohortBadge: "Družina & První krůčky hrou", occupiedSeats: 5, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Hravý start po vyučování pro nejmenší školáky. Základní slovíčka, barvy, čísla a zvířata formou karet a deskovek." },
  { id: "koalas", day: "Úterý", time: "12:30 – 13:30", animal: "Koalas", emoji: "🐨", cohort: "1.–3. třída", cohortBadge: "Pohodová parta & Dobble", occupiedSeats: 7, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Klidná a trpělivá skupinka pro odbourání ostychu z mluvení. Obrázkové karty a čistá výslovnost rodilého mluvčího od malička." },
  { id: "wombats", day: "Středa", time: "12:30 – 13:30", animal: "Wombats", emoji: "🐻", cohort: "1.–3. třída", cohortBadge: "Karak Junior & Karty", occupiedSeats: 8, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Základní kapacita 8 dětí je plná. Přijímáme přihlášky na přednostní čekací listinu pro případ uvolnění místa." },
  { id: "wallabies", day: "Čtvrtek", time: "12:30 – 13:30", animal: "Wallabies", emoji: "🦘", cohort: "1.–3. třída", cohortBadge: "Pohyb & Rychlá reakce", occupiedSeats: 4, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Skupinka plná energie, házení kostkou a veselých konverzačních her. Ideální pro živější děti po škole." },
  { id: "tasmanian-devils", day: "Pátek", time: "12:30 – 13:30", animal: "Tasmanian devils", emoji: "😈", cohort: "1.–3. třída", cohortBadge: "Páteční herní klub", occupiedSeats: 6, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Páteční odměna za celý týden. Žádné učebnice, čistá radost ze hry a spontánní mluvení v angličtině." },

  // 13:30 - 14:30 (4.-6. třída)
  { id: "rabbits", day: "Pondělí", time: "13:30 – 14:30", animal: "Rabbits", emoji: "🐇", cohort: "4.–6. třída", cohortBadge: "Karak & Slovní zásoba", occupiedSeats: 6, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Propojení školního učiva s populárními deskovkami. Rozšiřování slovní zásoby a tvoření celých vět bez váhání." },
  { id: "foxes", day: "Úterý", time: "13:30 – 14:30", animal: "Foxes", emoji: "🦊", cohort: "4.–6. třída", cohortBadge: "Strategie & Codenames", occupiedSeats: 7, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Bystrá parta mladých stratégů. Asociační hry, dedukce a přirozené domlouvání pravidel v angličtině." },
  { id: "brumbies", day: "Středa", time: "13:30 – 14:30", animal: "Brumbies", emoji: "🐎", cohort: "4.–6. třída", cohortBadge: "Plynulost & Sebevědomí", occupiedSeats: 5, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Svoboda vyjadřování bez strachu z gramatických chyb. Lektor trpělivě navádí na správnou větnou stavbu." },
  { id: "camels", day: "Čtvrtek", time: "13:30 – 14:30", animal: "Camels", emoji: "🐪", cohort: "4.–6. třída", cohortBadge: "Vytrvalost & Hloubka", occupiedSeats: 9, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Velmi žádaný čtvrteční slot. Základních 8 míst je obsazeno, přijímáme zájemce na čekací listinu (zbývají 3 místa)." },
  { id: "cane-toads", day: "Pátek", time: "13:30 – 14:30", animal: "Cane toads", emoji: "🐸", cohort: "4.–6. třída", cohortBadge: "Páteční výzva & Smích", occupiedSeats: 4, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Legendární australské ropuchy přinášejí pořádnou porci humoru, blafovacích karetních her a uvolněné zábavy." },

  // 14:30 - 16:00 (7.-9. třída & SŠ)
  { id: "crocodiles", day: "Pondělí", time: "14:30 – 16:00", animal: "Crocodiles", emoji: "🐊", cohort: "7.–9. třída & SŠ", cohortBadge: "Maturita & Pokročilá konverzace", occupiedSeats: 6, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Intenzivní 90minutový ponor. Společenská témata, argumentace, simulace ústní zkoušky a bohatá moderní slovní zásoba." },
  { id: "sharks", day: "Úterý", time: "14:30 – 16:00", animal: "Sharks", emoji: "🦈", cohort: "7.–9. třída & SŠ", cohortBadge: "Příprava na SŠ & SCIO testy", occupiedSeats: 7, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Pohotovost a přesnost. Trénink typových úloh na přijímačky, práce s textem a poslech rodilého mluvčího." },
  { id: "snakes", day: "Středa", time: "14:30 – 16:00", animal: "Snakes", emoji: "🐍", cohort: "7.–9. třída & SŠ", cohortBadge: "Debatní klub & Reálie", occupiedSeats: 12, maxSeats: 8, waitingListSeats: 4, statusOverride: "full", description: "Tato skupinka dosáhla maximální kapacity včetně čekací listiny (12/12). Pro zájemce doporučujeme čtvrtek či pátek." },
  { id: "spiders", day: "Čtvrtek", time: "14:30 – 16:00", animal: "Spiders", emoji: "🕷️", cohort: "7.–9. třída & SŠ", cohortBadge: "Maturitní témata & Eseje", occupiedSeats: 5, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Jeden ze 2 specializovaných bloků zaměřených na maturitní didaktické testy, rozbor článků a mluvený projev." },
  { id: "buffalos", day: "Pátek", time: "14:30 – 16:00", animal: "Buffalos", emoji: "🐃", cohort: "7.–9. třída & SŠ", cohortBadge: "Pohodový závěr týdne", occupiedSeats: 4, maxSeats: 8, waitingListSeats: 4, statusOverride: "auto", description: "Páteční 90minutovka pro středoškoláky. Společenské hry v angličtině (Risk, Cluedo, Codenames) a diskuze o filmech a hudbě." }
];

const groups = (schedule.groups && schedule.groups.length > 0) ? schedule.groups : defaultGroups;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = pathname === '/';
const initialCohort: string = isHomePage ? '1.–3. třída' : 'all';

const bottomCtaText = isHomePage
  ? (schedule.bottomCtaText || "Otevřít velký rozvrh hodin & rezervaci místa ve skupince →")
  : (schedule.ctaText || "Vybrat skupinku a rezervovat 1. lekci zdarma ↓");
const bottomCtaHref = isHomePage ? "/rozvrh" : "#kontakt";

function getCohortCategory(str: string): 'primary' | 'middle' | 'older' | 'other' {
  if (!str) return 'other';
  const s = str.toLowerCase();
  if (s.includes('1.–3') || s.includes('1-3') || s.includes('1. stupeň') || s.includes('1. stupen') || /\b[1-3]\b|\b[1-3]\./.test(s)) return 'primary';
  if (s.includes('4.–6') || s.includes('4-6') || s.includes('2. stupeň') || s.includes('2. stupen') || /\b[4-6]\b|\b[4-6]\./.test(s)) return 'middle';
  if (s.includes('7.–9') || s.includes('7-9') || s.includes('7.–13') || s.includes('7-13') || s.includes('sš') || s.includes('ss') || s.includes('maturit') || s.includes('střední') || s.includes('stredni') || /\b[7-9]\b|\b[7-9]\./.test(s)) return 'older';
  return 'other';
}

function matchesCohort(groupCohort: string, selectedCohort: string): boolean {
  if (!selectedCohort || selectedCohort === 'all') return true;
  if (groupCohort === selectedCohort) return true;
  const catGroup = getCohortCategory(groupCohort);
  const catSel = getCohortCategory(selectedCohort);
  if (catGroup !== 'other' && catGroup === catSel) return true;
  return groupCohort.trim().toLowerCase() === selectedCohort.trim().toLowerCase();
}

// Helper to compute capacity state with Smart Scarcity (no "0/8" cold-start stigma)
function getCapacityInfo(group: GroupItem) {
  const maxSeats = Number(group.maxSeats) || 8;
  const wlSeats = Number(group.waitingListSeats) || 4;
  const occupied = Number(group.occupiedSeats ?? 0);
  const totalMax = maxSeats + wlSeats; // 12
  const override = group.statusOverride || 'auto';

  // 1. Plně obsazeno (override nebo zaplněna základní kapacita i čekací listina)
  if (override === 'full' || (override !== 'open' && override !== 'waiting_list' && occupied >= totalMax)) {
    return {
      status: 'full',
      badgeText: "Plně obsazeno",
      badgeClass: "bg-red-100 text-red-900 border-red-300 font-bold",
      indicatorColor: "bg-red-500",
      ctaText: "Plně obsazeno (zkuste jiný den)",
      ctaDisabled: true,
      percentage: 100,
      occupiedCount: totalMax,
      maxCount: totalMax,
      availableInBase: 0,
      availableInWl: 0,
      isUrgent: false,
      showMeter: false,
      meterLabel: `Kapacita ${maxSeats} míst naplněna`,
      meterSub: "Plně obsazeno",
    };
  }

  // 2. Čekací listina (override nebo zaplněno základních 8 míst)
  if (override === 'waiting_list' || (override !== 'open' && occupied >= maxSeats)) {
    const wlOccupied = Math.max(1, occupied - maxSeats);
    const wlAvailable = Math.max(0, wlSeats - wlOccupied);
    return {
      status: 'waiting_list',
      badgeText: "Čekací listina",
      badgeClass: "bg-amber-100 text-amber-950 border-amber-300 font-bold",
      indicatorColor: "bg-amber-500",
      ctaText: `Zapsat na čekací listinu →`,
      ctaDisabled: false,
      percentage: Math.min(100, Math.round(((maxSeats + wlOccupied) / totalMax) * 100)),
      occupiedCount: maxSeats + wlOccupied,
      maxCount: totalMax,
      availableInBase: 0,
      availableInWl: wlAvailable,
      isUrgent: false,
      showMeter: false,
      meterLabel: `Základních ${maxSeats} míst obsazeno`,
      meterSub: `Čekací listina (${wlAvailable} ${wlAvailable === 1 ? 'místo' : wlAvailable < 5 ? 'místa' : 'míst'})`,
    };
  }

  // 3. Volná místa – Smart Scarcity
  const freeSeats = Math.max(0, maxSeats - occupied);
  // Zobrazit urgenci a teploměr POUZE pokud zbývá 1–2 místa A alespoň 1 student už je přihlášen
  const isUrgent = freeSeats > 0 && freeSeats <= 2 && occupied > 0;

  if (isUrgent) {
    const freeText = freeSeats === 1 ? "1 volné místo" : "2 volná místa";
    return {
      status: 'open',
      badgeText: `🔥 Poslední ${freeText}!`,
      badgeClass: "bg-amber-200 text-amber-950 border-amber-400 font-black shadow-xs",
      indicatorColor: "bg-amber-500",
      ctaText: "Vybrat tuto skupinku →",
      ctaDisabled: false,
      percentage: Math.min(100, Math.round((occupied / maxSeats) * 100)),
      occupiedCount: occupied,
      maxCount: maxSeats,
      availableInBase: freeSeats,
      availableInWl: wlSeats,
      isUrgent: true,
      showMeter: true,
      meterLabel: `Rychle se plní (${occupied}/${maxSeats})`,
      meterSub: `Zbývá jen ${freeText}`,
    };
  }

  // Běžný stav (volno, 0 až 5 dětí) – čisté, pozitivní zobrazení bez trapného 0/8
  return {
    status: 'open',
    badgeText: "🟢 Volná místa",
    badgeClass: "bg-emerald-100 text-emerald-950 border-emerald-300 font-bold",
    indicatorColor: "bg-emerald-500",
    ctaText: "Vybrat tuto skupinku →",
    ctaDisabled: false,
    percentage: 0,
    occupiedCount: occupied,
    maxCount: maxSeats,
    availableInBase: freeSeats,
    availableInWl: wlSeats,
    isUrgent: false,
    showMeter: false,
    meterLabel: `Kapacita: max. ${maxSeats} dětí`,
    meterSub: "Osobní přístup",
  };
}

function getLocalWalkHint(cohort: string) {
  if (cohort === '1.–3. třída') {
    return '📍 Uh. Hradiště: 12:30 – Ideální po obědě a družině. Ze ZŠ UNESCO přes přechod 90 vteřin.';
  }
  if (cohort === '4.–6. třída') {
    return '📍 Uh. Hradiště: 13:30 – Plynule po 5. vyučovací hodině. Hraní Karak a aktivní mluvení.';
  }
  return '📍 Uh. Hradiště: 14:30 – 90 minut po škole. Maturitní speaking, SCIO a konverzace bez ostychu.';
}
