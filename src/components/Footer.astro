---
import ParrotLogo from './ParrotLogo.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  email?: string;
  phone?: string;
  phoneFormatted?: string;
  footer?: {
    description?: string;
    locationNote?: string;
    copyright?: string;
  };
}

const {
  email = "info@valekacademy.cz",
  phone = "+420792372642",
  phoneFormatted = "+420 792 372 642",
  footer = {}
} = Astro.props;

const description = footer.description || "Trpělivá výuka angličtiny v malých skupinkách formou deskových her a konverzace pro děti. Josef vyrostl v Melbourne, vystudoval BBA na RMIT University a učí s úsměvem a přirozeným přízvukem.";
const locationNote = footer.locationNote || "📍 Doučovna: Růžová 1238, Uherské Hradiště";
const copyright = footer.copyright || "VALEK ACADEMY • Mgr. Josef Válek. Všechna práva vyhrazena.";

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-parchment-300 pt-12 pb-10 text-espresso-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-parchment-200">
      
      <!-- Column 1: Brand & Mascot -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <ParrotLogo className="w-12 h-12 shadow-sm rounded-full" />
          <div>
            <span class="font-heading font-black text-xl text-espresso-950 block leading-tight">
              VALEK ACADEMY
            </span>
            <span class="text-xs text-amber-900 font-bold">
              Angličtina s Čechoaustralanem
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-espresso-800/80 max-w-sm leading-relaxed" data-tina-field={tinaField(footer, 'description')} data-edit-key="footer.description" data-edit-label="Popis v patičce">
          {description}
        </p>
        <div class="inline-block text-xs font-bold text-amber-900 bg-amber-50 px-3 py-1 rounded-xl border border-amber-200" data-tina-field={tinaField(footer, 'locationNote')} data-edit-key="footer.locationNote" data-edit-label="Poznámka k místu v patičce">
          {locationNote}
        </div>
      </div>

      <!-- Column 2: Programs Links -->
      <div class="md:col-span-3 space-y-3">
        <div class="font-heading font-bold text-xs uppercase tracking-wider text-espresso-950">
          Rychlá navigace
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-espresso-800 font-medium">
          <li><a href="#programy" class="hover:text-amber-800 transition-colors">🎲 Děti & ZŠ (Skupinky hrou)</a></li>
          <li><a href="#rozrazovac" class="hover:text-amber-800 transition-colors text-amber-900 font-bold">🧭 Rozřazovač skupinek</a></li>
          <li><a href="#metodika" class="hover:text-amber-800 transition-colors">⏱️ Průběh 60 min lekce</a></li>
          <li><a href="#o-mne" class="hover:text-amber-800 transition-colors">🇦🇺 O Josefovi (BBA Melbourne)</a></li>
          <li><a href="#cenik" class="hover:text-amber-800 transition-colors">🎁 Ceník & 1. lekce zdarma</a></li>
          <li><a href="#faq" class="hover:text-amber-800 transition-colors">❓ Časté dotazy (FAQ)</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact & Hours -->
      <div class="md:col-span-4 space-y-3">
        <div class="font-heading font-bold text-xs uppercase tracking-wider text-espresso-950">
          Kontakt & Doučovna
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-espresso-800">
          <li>
            <a href={`tel:${phone}`} class="hover:text-amber-800 transition-colors flex items-center gap-2 font-bold text-espresso-950">
              <span>📞</span> <span>{phoneFormatted}</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/420792372642" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-800 transition-colors flex items-center gap-2 font-bold text-emerald-800">
              <span>💬</span> <span>WhatsApp zpráva</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="hover:text-amber-800 transition-colors flex items-center gap-2 font-medium">
              <span>✉️</span> <span>{email}</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-stone-600">
            <span>📍</span> <span>Růžová 1238, Uherské Hradiště</span>
          </li>
          <li class="flex items-center gap-2 text-stone-600">
            <span>🕒</span> <span>Pondělí – Pátek: 8:00 – 19:00</span>
          </li>
          <li class="pt-1 text-[11px] text-stone-500 leading-snug">
            🚗 Rychlé spojení i z Kunovic, Starého Města, Babic, Jalubí či Ostrožské Nové Vsi.
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright row -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>
        © {currentYear} <span data-tina-field={tinaField(footer, 'copyright')} data-edit-key="footer.copyright" data-edit-label="Copyright">{copyright}</span>
      </p>

      <div class="flex items-center gap-6">
        <a href="#kontakt" class="hover:text-espresso-900 transition-colors font-bold text-amber-900">1. lekce zdarma</a>
        <span class="text-stone-300">•</span>
        <a href="/admin" class="hover:text-espresso-900 transition-colors flex items-center gap-1.5 font-semibold text-stone-600">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Správa webu (Admin)</span>
        </a>
      </div>
    </div>

  </div>
</footer>
