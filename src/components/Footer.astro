---
import ParrotLogo from './ParrotLogo.astro';

interface Props {
  email?: string;
  phone?: string;
  phoneFormatted?: string;
}

const {
  email = "josef.valek@email.cz",
  phone = "+420777123456",
  phoneFormatted = "+420 777 123 456"
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-parchment-100/90 border-t border-parchment-300 pt-14 pb-10 text-espresso-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-parchment-300">
      
      <!-- Column 1: Brand & Mascot -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3.5">
          <ParrotLogo className="w-12 h-12 shadow-sm rounded-full" />
          <div>
            <span class="font-academy font-black text-lg text-espresso-950 block leading-tight">
              VALEK ACADEMY
            </span>
            <span class="text-xs text-amber-900 font-semibold">
              Angličtina s Čechoaustralanem
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-espresso-800/80 max-w-sm leading-relaxed">
          Trpělivá výuka angličtiny v malých skupinkách formou deskových her a konverzace pro děti. Josef vyrostl v Austrálii, žije 25+ let v ČR a učí s úsměvem a přirozeným přízvukem.
        </p>
      </div>

      <!-- Column 2: Programs Links -->
      <div class="md:col-span-3 space-y-3">
        <div class="font-academy font-bold text-xs uppercase tracking-wider text-espresso-950">
          Programy doučování
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-espresso-800">
          <li><a href="#program-zs" class="hover:text-amber-900 transition-colors">🎲 Děti & ZŠ (Výuka hrou)</a></li>
          <li><a href="#program-dospeli" class="hover:text-amber-900 transition-colors">💼 Dospělí & Konverzace</a></li>
          <li><a href="#program-ss" class="hover:text-amber-900 transition-colors">🎓 Středoškoláci & Maturita</a></li>
          <li><a href="#scio" class="hover:text-amber-900 transition-colors">📐 SCIO & Přijímačky na SŠ</a></li>
          <li><a href="#cenik" class="hover:text-amber-900 transition-colors">Ceník & 1. lekce zdarma</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact & Hours -->
      <div class="md:col-span-4 space-y-3">
        <div class="font-academy font-bold text-xs uppercase tracking-wider text-espresso-950">
          Kontakt & Rezervace
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-espresso-800">
          <li>
            <a href={`tel:${phone}`} class="hover:text-amber-800 transition-colors flex items-center gap-2 font-semibold">
              <span>📞</span> <span>{phoneFormatted}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="hover:text-amber-800 transition-colors flex items-center gap-2 font-semibold">
              <span>✉️</span> <span>{email}</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-stone-600">
            <span>📍</span> <span>Online (celá ČR) / Osobně po domluvě</span>
          </li>
          <li class="flex items-center gap-2 text-stone-600">
            <span>🕒</span> <span>Pondělí – Pátek: 8:00 – 19:00</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright row -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>
        © {currentYear} VALEK ACADEMY • Josef Válek. Všechna práva vyhrazena.
      </p>

      <div class="flex items-center gap-6">
        <a href="#kontakt" class="hover:text-espresso-900 transition-colors">1. lekce zdarma</a>
        <span class="text-parchment-300">•</span>
        <a href="/admin" class="hover:text-espresso-900 transition-colors flex items-center gap-1.5 font-semibold text-espresso-800">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Administrace webu</span>
        </a>
      </div>
    </div>

  </div>
</footer>
