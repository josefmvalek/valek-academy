---
import ParrotLogo from './ParrotLogo.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  email?: string;
  phone?: string;
  phoneFormatted?: string;
  contact?: any;
  footer?: {
    brandName?: string;
    brandTagline?: string;
    description?: string;
    locationNote?: string;
    navTitle?: string;
    navLinks?: Array<{ label: string; href: string }>;
    contactTitle?: string;
    commuteNote?: string;
    bottomCtaText?: string;
    adminLinkText?: string;
    copyright?: string;
    [key: string]: any;
  };
}

const {
  email = "info@valekacademy.cz",
  phone = "+420792372642",
  phoneFormatted = "+420 792 372 642",
  contact = {},
  footer = {}
} = Astro.props;

const brandName = footer.brandName || "VALEK ACADEMY";
const brandTagline = footer.brandTagline || "Angličtina s Čechoaustralanem";
const description = footer.description || "Trpělivá výuka angličtiny v malých skupinkách formou deskových her a konverzace pro děti. Josef vyrostl v Melbourne, vystudoval BBA na RMIT University a učí s úsměvem a přirozeným přízvukem.";
const locationNote = footer.locationNote || "📍 Doučovna: Růžová 1238, Uherské Hradiště";
const navTitle = footer.navTitle || "Rychlá navigace";
const defaultNavLinks = [
  { label: "🎲 Děti & ZŠ (Skupinky hrou)", href: "#programy" },
  { label: "🧭 Rozřazovač skupinek", href: "#rozrazovac" },
  { label: "⏱️ Průběh 60 min lekce", href: "#metodika" },
  { label: "🦘 O Josefovi (BBA Melbourne)", href: "#o-mne" },
  { label: "🎁 Ceník & 1. lekce zdarma", href: "#cenik" },
  { label: "❓ Časté dotazy (FAQ)", href: "#faq" }
];
const navLinks = footer.navLinks || defaultNavLinks;
const contactTitle = footer.contactTitle || "Kontakt & Doučovna";
const commuteNote = footer.commuteNote || "🚗 Rychlé spojení i z Kunovic, Starého Města, Babic, Jalubí či Ostrožské Nové Vsi.";
const bottomCtaText = footer.bottomCtaText || "1. lekce zdarma";
const adminLinkText = footer.adminLinkText || "Správa webu (Admin)";
const copyright = footer.copyright || "VALEK ACADEMY • Mgr. Josef Válek. Všechna práva vyhrazena.";

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-parchment-300 pt-12 pb-10 text-espresso-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-parchment-200">
      
      <!-- Column 1: Brand & Mascot -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <ParrotLogo className="w-12 h-12 shadow-sm rounded-full" />
          <div>
            <span class="font-heading font-black text-xl text-espresso-950 block leading-tight" data-tina-field={tinaField(footer, 'brandName')} data-edit-key="footer.brandName" data-edit-label="Název akademie">
              {brandName}
            </span>
            <span class="text-xs text-amber-900 font-bold" data-tina-field={tinaField(footer, 'brandTagline')} data-edit-key="footer.brandTagline" data-edit-label="Slogan akademie">
              {brandTagline}
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-espresso-800/80 max-w-sm leading-relaxed" data-tina-field={tinaField(footer, 'description')} data-edit-key="footer.description" data-edit-label="Popis v patičce">
          {description}
        </p>
        <div class="inline-block text-xs font-bold text-amber-900 bg-amber-50 px-3 py-1 rounded-xl border border-amber-200" data-tina-field={tinaField(footer, 'locationNote')} data-edit-key="footer.locationNote" data-edit-label="Poznámka k místu v patičce">
          {locationNote}
        </div>
      </div>

      <!-- Column 2: Programs Links -->
      <div class="md:col-span-3 space-y-3">
        <div class="font-heading font-bold text-xs uppercase tracking-wider text-espresso-950" data-tina-field={tinaField(footer, 'navTitle')} data-edit-key="footer.navTitle" data-edit-label="Nadpis navigace">
          {navTitle}
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-espresso-800 font-medium">
          {navLinks.map((link: any, idx: number) => (
            <li data-tina-field={tinaField(footer, 'navLinks', idx)}>
              <a href={link.href} class={`hover:text-amber-800 transition-colors ${link.href === '#rozrazovac' ? 'text-amber-900 font-bold' : ''}`} data-tina-field={tinaField(link, 'label')}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contact & Hours -->
      <div class="md:col-span-4 space-y-3">
        <div class="font-heading font-bold text-xs uppercase tracking-wider text-espresso-950" data-tina-field={tinaField(footer, 'contactTitle')} data-edit-key="footer.contactTitle" data-edit-label="Nadpis kontaktu">
          {contactTitle}
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-espresso-800">
          <li>
            <a href={`tel:${phone}`} class="hover:text-amber-800 transition-colors flex items-center gap-2 font-bold text-espresso-950">
              <span>📞</span> <span data-tina-field={tinaField(contact, 'phoneFormatted')}>{phoneFormatted}</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/420792372642" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-800 transition-colors flex items-center gap-2 font-bold text-emerald-800">
              <span>💬</span> <span data-tina-field={tinaField(contact, 'whatsappText')}>WhatsApp zpráva</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="hover:text-amber-800 transition-colors flex items-center gap-2 font-medium">
              <span>✉️</span> <span data-tina-field={tinaField(contact, 'email')}>{email}</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-stone-600">
            <span>📍</span> <span data-tina-field={tinaField(contact, 'location')}>Růžová 1238, Uherské Hradiště</span>
          </li>
          <li class="flex items-center gap-2 text-stone-600">
            <span>🕒</span> <span data-tina-field={tinaField(contact, 'hours')}>Pondělí – Pátek: 8:00 – 19:00</span>
          </li>
          <li class="pt-1 text-[11px] text-stone-500 leading-snug" data-tina-field={tinaField(footer, 'commuteNote')} data-edit-key="footer.commuteNote" data-edit-label="Dostupnost obcí">
            {commuteNote}
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright row -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>
        © {currentYear} <span data-tina-field={tinaField(footer, 'copyright')} data-edit-key="footer.copyright" data-edit-label="Copyright">{copyright}</span>
      </p>

      <div class="flex items-center gap-6">
        <a href="#kontakt" class="hover:text-espresso-900 transition-colors font-bold text-amber-900" data-tina-field={tinaField(footer, 'bottomCtaText')} data-edit-key="footer.bottomCtaText" data-edit-label="Spodní odkaz 1. lekce">{bottomCtaText}</a>
        <span class="text-stone-300">•</span>
        <a href="/admin" class="hover:text-espresso-900 transition-colors flex items-center gap-1.5 font-semibold text-stone-600">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span data-tina-field={tinaField(footer, 'adminLinkText')} data-edit-key="footer.adminLinkText" data-edit-label="Spodní odkaz Admin">{adminLinkText}</span>
        </a>
      </div>
    </div>

  </div>
</footer>

