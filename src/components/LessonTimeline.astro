---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface Props {
  className?: string;
  timeline?: {
    badge?: string;
    title?: string;
    subtitle?: string;
    phases?: any[];
    [key: string]: any;
  };
}

const { className = "", timeline = {} } = Astro.props;

const defaultPhases = [
  {
    time: "00–10 min",
    icon: "☕",
    badge: "1. Fáze: Zahřátí",
    title: "G'day chat & vypnutí školního stresu",
    desc: "Dítě přijde po celém dni ve škole. Žádné zkoušení ani testy – sedneme si do kruhu, dáme si čaj, zahrajeme 5minutovou postřehovou hru a přirozeně přepneme hlavu do angličtiny.",
    highlight: "Odbourání ostychu hned od první minuty"
  },
  {
    time: "10–35 min",
    icon: "🎲",
    badge: "2. Fáze: Hlavní hra",
    title: "Deskovka v angličtině & rodilý přízvuk",
    desc: "Srdce celé lekce. Hrajeme Scrabble, Story Cubes nebo Karak. Děti házejí kostkou, vymýšlejí strategie a v zápalu hry reagují v angličtině úplně automaticky a bez přemýšlení o poučkách.",
    highlight: "Přirozený australský přízvuk a živá mluva"
  },
  {
    time: "35–50 min",
    icon: "🎒",
    badge: "3. Fáze: Školní látka",
    title: "Vysvětlení v češtině & pomoc s úkoly",
    desc: "Co se ve škole zdálo složité, najednou dává smysl. Mr. Válek v klidu v rodné češtině dovysvětlí gramatiku, projde s dětmi problematická cvičení a připraví je na písemky.",
    highlight: "Jistota do školy a lepší známky v žákovské"
  },
  {
    time: "50–60 min",
    icon: "🌟",
    badge: "4. Fáze: Závěr",
    title: "Minikvíz, pochvala a razítko do pasu",
    desc: "Krátké zopakování nově pochycených slovíček, pochvala za aktivitu a razítko do australského cestovatelského pasu. Dítě odchází s úsměvem a těší se na příští týden.",
    highlight: "Dítě odchází sebevědomé a motivované"
  }
];

const badge = timeline.badge || "Jak probíhá každá hodina";
const title = timeline.title || "60 minut v doučovně pana Válka: Krok za krokem";
const subtitle = timeline.subtitle || "Proč výuka hrou funguje lépe než sezení v lavici? Podívejte se, jak máme každou minutu promyšlenou pro maximální rozvoj dítěte.";
const phases = timeline.phases || defaultPhases;
const calloutTitle = timeline.calloutTitle || "Chcete si tento 60minutový zážitek vyzkoušet naživo?";
const calloutDesc = timeline.calloutDesc || "První lekce v malé skupince dětí (Uherské Hradiště) je 100% ZDARMA a nezávazná.";
const calloutCtaText = timeline.calloutCtaText || "Vyzkoušet zdarma →";
const calloutCtaLink = timeline.calloutCtaLink || "#kontakt";
---

<section id="metodika" class={`py-12 md:py-16 bg-surface-base border-b border-parchment-200 relative overflow-hidden ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-xs font-extrabold uppercase tracking-wider text-amber-950" data-tina-field={tinaField(timeline, 'badge')} data-edit-key="timeline.badge" data-edit-label="Štítek časové osy">
        <span>⏱️</span> <span>{badge}</span>
      </div>
      <h2 class="font-heading font-black text-fluid-h2 text-espresso-950 tracking-tight" data-tina-field={tinaField(timeline, 'title')} data-edit-key="timeline.title" data-edit-label="Nadpis časové osy" set:html={formatRichText(title)}>
      </h2>
      <p class="text-espresso-800/85 text-fluid-body" data-tina-field={tinaField(timeline, 'subtitle')} data-edit-key="timeline.subtitle" data-edit-label="Podnadpis časové osy" set:html={formatRichText(subtitle)}>
      </p>
    </div>

    <!-- 4 Phases Grid with Timeline Connectors -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {phases.map((phase, idx) => (
        <div
          data-tina-field={tinaField(timeline, 'phases', idx)}
          class="rounded-card-lg p-6 sm:p-7 bg-surface-card border-2 border-parchment-300 shadow-tile hover:border-amber-400 hover:shadow-card-lift transition-all flex flex-col justify-between group relative"
        >
          
          <!-- Top Row: Time Badge & Icon -->
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-black px-2.5 py-1 rounded-card-sm bg-amber-400 text-espresso-950 shadow-2xs" data-tina-field={tinaField(phase, 'time')} data-edit-key={`timeline.phases.${idx}.time`} data-edit-label="Čas fáze">
                {phase.time}
              </span>
              <span class="w-12 h-12 rounded-card-md bg-white border border-parchment-300 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-2xs">
                {phase.icon}
              </span>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-900 block mb-1" data-tina-field={tinaField(phase, 'badge')} data-edit-key={`timeline.phases.${idx}.badge`} data-edit-label="Štítek fáze">
                {phase.badge}
              </span>
              <h3 class="font-heading font-black text-lg text-espresso-950 leading-snug" data-tina-field={tinaField(phase, 'title')} data-edit-key={`timeline.phases.${idx}.title`} data-edit-label="Název fáze">
                {phase.title}
              </h3>
            </div>

            <p class="text-xs sm:text-sm text-espresso-800/80 leading-relaxed" data-tina-field={tinaField(phase, 'desc')} data-edit-key={`timeline.phases.${idx}.desc`} data-edit-label="Popis fáze">
              {phase.desc}
            </p>
          </div>

          <!-- Bottom Benefit Highlight -->
          <div class="pt-4 mt-5 border-t border-parchment-200">
            <div class="flex items-center gap-2 text-xs font-bold text-emerald-900">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span data-tina-field={tinaField(phase, 'highlight')} data-edit-key={`timeline.phases.${idx}.highlight`} data-edit-label="Přínos fáze">{phase.highlight}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Bottom Guarantee Callout -->
    <div class="mt-10 max-w-3xl mx-auto text-center p-5 sm:p-6 rounded-card-xl bg-amber-50/90 border-2 border-amber-300 shadow-card flex flex-col sm:flex-row items-center justify-center gap-4">
      <div class="w-12 h-12 rounded-card-md bg-amber-400 text-espresso-950 flex items-center justify-center text-2xl flex-shrink-0 font-bold shadow-xs">
        🎁
      </div>
      <div class="text-center sm:text-left">
        <div class="font-heading font-black text-sm sm:text-base text-espresso-950" data-tina-field={tinaField(timeline, 'calloutTitle')} data-edit-key="timeline.calloutTitle" data-edit-label="Výzva nadpis">
          {calloutTitle}
        </div>
        <p class="text-xs text-stone-600 mt-0.5" data-tina-field={tinaField(timeline, 'calloutDesc')} data-edit-key="timeline.calloutDesc" data-edit-label="Výzva popis">
          {calloutDesc}
        </p>
      </div>
      <a
        href={calloutCtaLink}
        class="flex-shrink-0 px-6 py-3 rounded-card-md font-heading font-black text-xs sm:text-sm text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-500 shadow-dice-btn active:shadow-dice-btn-active btn-gold-pulse transition-all cursor-pointer"
        data-tina-field={tinaField(timeline, 'calloutCtaText')}
        data-edit-key="timeline.calloutCtaText"
        data-edit-label="Výzva tlačítko"
      >
        {calloutCtaText}
      </a>
    </div>

  </div>
</section>
