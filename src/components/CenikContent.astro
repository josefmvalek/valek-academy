---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';
import PackageCalculator from './PackageCalculator.astro';

interface Program {
  id: string;
  icon?: string;
  cohortBadge?: string;
  popularBadge?: string;
  title: string;
  description?: string;
  baseRate?: string;
  baseRateNote?: string;
  packageRate?: string;
  packageRateNote?: string;
  fullYearRate?: string;
  fullYearRateNote?: string;
  timeSlots?: string;
  features?: string[];
  ctaPrimaryText?: string;
  ctaPrimaryLink?: string;
  ctaSecondaryText?: string;
  ctaSecondaryLink?: string;
  [key: string]: any;
}

interface TableRow {
  period: string;
  tag?: string;
  frequency?: string;
  lessons?: string;
  basePrice?: string;
  discount?: string;
  unitPrice?: string;
  totalPrice?: string;
  isPopular?: boolean;
  isRecommended?: boolean;
  isBestValue?: boolean;
  [key: string]: any;
}

interface GuaranteeItem {
  icon?: string;
  title: string;
  text?: string;
  [key: string]: any;
}

interface FAQItem {
  question: string;
  answer?: string;
  [key: string]: any;
}

interface Props {
  cenik?: {
    title?: string;
    backLinkText?: string;
    header?: {
      badge?: string;
      title?: string;
      subtitle?: string;
    };
    programs?: Program[];
    comparisonTable?: {
      badge?: string;
      title?: string;
      subtitle?: string;
      rows?: TableRow[];
    };
    guarantees?: {
      badge?: string;
      title?: string;
      subtitle?: string;
      items?: GuaranteeItem[];
    };
    faq?: {
      title?: string;
      items?: FAQItem[];
    };
    ctaBanner?: {
      badge?: string;
      title?: string;
      subtitle?: string;
      primaryBtnText?: string;
      primaryBtnLink?: string;
      secondaryBtnText?: string;
      secondaryBtnLink?: string;
    };
    [key: string]: any;
  };
  calculator?: any;
  phone?: string;
}

const { cenik = {}, calculator = {}, phone = "420792372642" } = Astro.props;

const backLinkText = cenik.backLinkText || "Zpět na hlavní stránku";
const header = cenik.header || {};
const programs: Program[] = cenik.programs || [];
const comparisonTable = cenik.comparisonTable || {};
const comparisonRows: TableRow[] = comparisonTable.rows || [];
const guarantees = cenik.guarantees || {};
const guaranteeItems: GuaranteeItem[] = guarantees.items || [];
const faq = cenik.faq || {};
const faqItems: FAQItem[] = faq.items || [];
const ctaBanner = cenik.ctaBanner || {};

const themePresets: Record<string, {
  border: string;
  iconBg: string;
  badgeBg: string;
  priceBoxBg: string;
  badgeText: string;
  highlightText: string;
  primaryBtnStyle?: string;
}> = {
  kids: {
    border: 'border-2 border-amber-400 shadow-md',
    iconBg: 'bg-amber-100 border-amber-300 text-amber-900',
    badgeBg: 'bg-amber-400 text-espresso-950 border border-amber-500/70',
    priceBoxBg: 'bg-amber-50/70 border-amber-200/90',
    badgeText: 'text-amber-900',
    highlightText: 'text-amber-900',
    primaryBtnStyle: 'bg-amber-400 hover:bg-amber-300 border-amber-500 text-espresso-950 shadow-xs',
  },
  teens: {
    border: 'border-2 border-parchment-300 hover:border-amber-300 shadow-sm',
    iconBg: 'bg-purple-100 border-purple-300 text-purple-900',
    badgeBg: 'bg-purple-400 text-espresso-950 border border-purple-500/70',
    priceBoxBg: 'bg-purple-50/70 border-purple-200/80',
    badgeText: 'text-purple-900',
    highlightText: 'text-purple-900',
    primaryBtnStyle: 'bg-parchment-100 hover:bg-amber-100 border-parchment-300 hover:border-amber-400 text-espresso-950',
  },
  adults: {
    border: 'border-2 border-parchment-300 hover:border-amber-300 shadow-sm',
    iconBg: 'bg-blue-100 border-blue-300 text-blue-900',
    badgeBg: 'bg-blue-400 text-espresso-950 border border-blue-500/70',
    priceBoxBg: 'bg-blue-50/70 border-blue-200/80',
    badgeText: 'text-blue-900',
    highlightText: 'text-blue-900',
    primaryBtnStyle: 'bg-parchment-100 hover:bg-amber-100 border-parchment-300 hover:border-amber-400 text-espresso-950',
  },
  individual: {
    border: 'border-2 border-parchment-300 hover:border-amber-300 shadow-sm',
    iconBg: 'bg-emerald-100 border-emerald-300 text-emerald-900',
    badgeBg: 'bg-emerald-400 text-white border border-emerald-500/70',
    priceBoxBg: 'bg-emerald-50/70 border-emerald-200/80',
    badgeText: 'text-emerald-900',
    highlightText: 'text-emerald-900',
    primaryBtnStyle: 'bg-parchment-100 hover:bg-amber-100 border-parchment-300 hover:border-amber-400 text-espresso-950',
  },
};
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <!-- Top Breadcrumb -->
  <div class="mb-6 sm:mb-8">
    <a href="/" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-stone-600 hover:text-amber-900 transition-colors group">
      <span class="group-hover:-translate-x-1 transition-transform">←</span>
      <span data-tina-field={tinaField(cenik, 'backLinkText')} data-edit-key="cenik.backLinkText" data-edit-label="Zpět">{backLinkText}</span>
    </a>
  </div>

  <!-- Header -->
  <div class="max-w-4xl mx-auto text-center space-y-3 mb-10 sm:mb-14">
    {header.badge && (
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full vintage-ribbon text-xs font-black uppercase tracking-wider text-espresso-950 shadow-xs" data-tina-field={tinaField(header, 'badge')} data-edit-key="cenik.header.badge" data-edit-label="Štítek ceníku">
        <span>🏷️</span>
        <span>{header.badge}</span>
      </div>
    )}
    <h1 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight" data-tina-field={tinaField(header, 'title')} data-edit-key="cenik.header.title" data-edit-label="Nadpis ceníku">
      {header.title || "Podrobný ceník všech programů, slevové balíčky & férové podmínky"}
    </h1>
    <p class="text-espresso-800/85 text-sm sm:text-lg leading-relaxed max-w-3xl mx-auto font-normal" data-tina-field={tinaField(header, 'subtitle')} data-edit-key="cenik.header.subtitle" data-edit-label="Podnadpis ceníku" set:html={formatRichText(header.subtitle || "U nás neplatíte nic naslepo a nevážete se dlouhými smlouvami. Každý student začíná <strong>1. lekcí 100% ZDARMA</strong>. Teprve když je dítě nadšené, vyberete si výhodný balíček s motivační slevou až 30 %.")} />
  </div>

  <!-- 4 Core Programs Detailed Pricing Cards -->
  <div class="grid lg:grid-cols-2 gap-6 sm:gap-8 mb-14 sm:mb-18" data-tina-field={tinaField(cenik, 'programs')}>
    {programs.map((prog) => {
      const theme = themePresets[prog.id] || themePresets.kids;
      return (
        <div class={`bg-white rounded-3xl p-6 sm:p-8 flex flex-col justify-between relative group ${theme.border}`} data-tina-field={tinaField(prog)}>
          {prog.popularBadge && (
            <div class={`absolute -top-3.5 right-4 sm:right-6 text-[10px] sm:text-xs font-black uppercase tracking-wider px-3.5 py-1 rounded-full shadow-xs z-10 ${theme.badgeBg}`} data-tina-field={tinaField(prog, 'popularBadge')}>
              {prog.popularBadge}
            </div>
          )}

          <div class="space-y-4">
            <div class="flex items-center gap-3">
              {prog.icon && (
                <span class={`w-12 h-12 rounded-2xl border text-2xl flex items-center justify-center flex-shrink-0 ${theme.iconBg}`} data-tina-field={tinaField(prog, 'icon')}>
                  {prog.icon}
                </span>
              )}
              <div>
                {prog.cohortBadge && (
                  <span class={`text-[11px] font-black uppercase tracking-wider block ${theme.badgeText}`} data-tina-field={tinaField(prog, 'cohortBadge')}>
                    {prog.cohortBadge}
                  </span>
                )}
                <h2 class="font-heading font-black text-xl sm:text-2xl text-espresso-950" data-tina-field={tinaField(prog, 'title')}>
                  {prog.title}
                </h2>
              </div>
            </div>

            {prog.description && (
              <p class="text-xs sm:text-sm text-espresso-800/85 leading-relaxed font-normal" data-tina-field={tinaField(prog, 'description')}>
                {prog.description}
              </p>
            )}

            <!-- Pricing Details Box -->
            <div class={`p-4 rounded-2xl border space-y-2 ${theme.priceBoxBg}`}>
              {prog.baseRate && (
                <div class="flex items-baseline justify-between">
                  <span class="text-xs text-stone-600 font-medium">Základní sazba za lekci:</span>
                  <span class="font-heading font-black text-xl text-espresso-950" data-tina-field={tinaField(prog, 'baseRate')}>
                    {prog.baseRate} {prog.baseRateNote && <span class="text-xs text-stone-500 font-normal" data-tina-field={tinaField(prog, 'baseRateNote')}>{prog.baseRateNote}</span>}
                  </span>
                </div>
              )}
              {prog.packageRate && (
                <div class="flex items-baseline justify-between text-espresso-950">
                  <span class="text-xs font-bold">Pololetní balíček:</span>
                  <span class={`font-heading font-black text-lg ${theme.highlightText}`} data-tina-field={tinaField(prog, 'packageRate')}>
                    {prog.packageRate} {prog.packageRateNote && <span class="text-xs font-normal" data-tina-field={tinaField(prog, 'packageRateNote')}>{prog.packageRateNote}</span>}
                  </span>
                </div>
              )}
              {prog.fullYearRate && (
                <div class="flex items-baseline justify-between text-emerald-800">
                  <span class="text-xs font-bold">Při 2× týdně nebo celý rok:</span>
                  <span class="font-heading font-black text-lg" data-tina-field={tinaField(prog, 'fullYearRate')}>
                    {prog.fullYearRate} {prog.fullYearRateNote && <span class="text-xs font-normal" data-tina-field={prog.fullYearRateNote ? tinaField(prog, 'fullYearRateNote') : undefined}>{prog.fullYearRateNote}</span>}
                  </span>
                </div>
              )}
              {prog.timeSlots && (
                <div class="text-[11px] text-stone-600 border-t border-parchment-300/60 pt-1.5 flex items-center gap-1.5 font-medium" data-tina-field={tinaField(prog, 'timeSlots')}>
                  <span>⏰ Časové sloty:</span>
                  <strong>{prog.timeSlots}</strong>
                </div>
              )}
            </div>

            <!-- Features List -->
            {prog.features && prog.features.length > 0 && (
              <ul class="text-xs text-espresso-800 space-y-2 pt-1" data-tina-field={tinaField(prog, 'features')}>
                {prog.features.map((feat: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-600 font-black">✓</span>
                    <span set:html={formatRichText(feat)} />
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="pt-6 mt-6 border-t border-parchment-200 flex flex-col sm:flex-row items-center gap-3">
            {prog.ctaPrimaryText && (
              <a
                href={prog.ctaPrimaryLink || "/rozvrh"}
                class={`w-full ${prog.ctaSecondaryText ? 'sm:w-auto flex-1' : ''} inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl font-heading font-black text-xs border transition-all ${theme.primaryBtnStyle || 'bg-amber-400 text-espresso-950'}`}
                data-tina-field={tinaField(prog, 'ctaPrimaryText')}
              >
                <span>{prog.ctaPrimaryText}</span>
              </a>
            )}
            {prog.ctaSecondaryText && (
              <a
                href={prog.ctaSecondaryLink || "#kalkulator-balicku"}
                class="w-full sm:w-auto inline-flex items-center justify-center py-3 px-4 rounded-xl font-bold text-xs text-espresso-800 bg-parchment-100 hover:bg-parchment-200 border border-parchment-300 transition-colors"
                data-tina-field={tinaField(prog, 'ctaSecondaryText')}
              >
                <span>{prog.ctaSecondaryText}</span>
              </a>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Embedded Package Calculator Section -->
  <div class="mb-14 sm:mb-18">
    <PackageCalculator calculator={calculator} phone={phone} />
  </div>

  <!-- Srovnávací tabulka slev a balíčků -->
  {comparisonTable && (
    <div class="mb-14 sm:mb-18 bg-white rounded-3xl p-6 sm:p-8 md:p-10 border border-parchment-300 shadow-soft-sm" data-tina-field={tinaField(cenik, 'comparisonTable')}>
      <div class="max-w-3xl mb-6">
        {comparisonTable.badge && (
          <span class="text-xs font-black uppercase tracking-wider text-amber-900 block mb-1" data-tina-field={tinaField(comparisonTable, 'badge')}>
            {comparisonTable.badge}
          </span>
        )}
        <h2 class="font-heading font-black text-2xl sm:text-3xl text-espresso-950" data-tina-field={tinaField(comparisonTable, 'title')}>
          {comparisonTable.title || "Kolik přesně ušetříte při předplatném výuky?"}
        </h2>
        {comparisonTable.subtitle && (
          <p class="text-xs sm:text-sm text-stone-600 mt-1" data-tina-field={tinaField(comparisonTable, 'subtitle')}>
            {comparisonTable.subtitle}
          </p>
        )}
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-parchment-300 text-espresso-950 font-heading">
              <th class="py-3 px-3">Období balíčku</th>
              <th class="py-3 px-3">Frekvence</th>
              <th class="py-3 px-3">Celkem lekcí</th>
              <th class="py-3 px-3">Základní cena</th>
              <th class="py-3 px-3">Sleva</th>
              <th class="py-3 px-3">Cena za 1 lekci</th>
              <th class="py-3 px-3 text-right">Celková cena balíčku</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-parchment-200 text-espresso-900" data-tina-field={tinaField(comparisonTable, 'rows')}>
            {comparisonRows.map((row) => (
              <tr class={`hover:bg-amber-50/50 transition-colors ${row.isPopular ? 'bg-amber-50/40' : row.isRecommended ? 'bg-amber-100/30' : row.isBestValue ? 'bg-emerald-50/30' : ''}`} data-tina-field={tinaField(row)}>
                <td class="py-3 px-3 font-bold flex items-center gap-1.5 flex-wrap">
                  <span data-tina-field={tinaField(row, 'period')}>{row.period}</span>
                  {row.tag && (
                    <span class={`text-[9px] font-black uppercase px-1.5 py-0.5 rounded-sm ${row.isBestValue ? 'bg-emerald-600 text-white' : 'bg-amber-400 text-espresso-950'}`} data-tina-field={tinaField(row, 'tag')}>
                      {row.tag}
                    </span>
                  )}
                </td>
                <td class="py-3 px-3 font-bold text-amber-950" data-tina-field={tinaField(row, 'frequency')}>{row.frequency}</td>
                <td class="py-3 px-3 font-bold" data-tina-field={tinaField(row, 'lessons')}>{row.lessons}</td>
                <td class="py-3 px-3 line-through text-stone-400" data-tina-field={tinaField(row, 'basePrice')}>{row.basePrice}</td>
                <td class="py-3 px-3">
                  <span class={`px-2 py-0.5 rounded-full font-bold text-xs ${row.isRecommended || row.isBestValue ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900'}`} data-tina-field={tinaField(row, 'discount')}>
                    {row.discount}
                  </span>
                </td>
                <td class={`py-3 px-3 font-black text-espresso-950 ${row.isPopular ? 'text-amber-900 text-base' : row.isRecommended || row.isBestValue ? 'text-emerald-800 text-base' : ''}`} data-tina-field={tinaField(row, 'unitPrice')}>
                  {row.unitPrice}
                </td>
                <td class="py-3 px-3 font-heading font-black text-right text-espresso-950 text-base" data-tina-field={tinaField(row, 'totalPrice')}>
                  {row.totalPrice}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Férová pravidla & Platební podmínky (4 pillars) -->
  {guarantees && (
    <div class="mb-14 sm:mb-18" data-tina-field={tinaField(cenik, 'guarantees')}>
      <div class="max-w-3xl mb-8">
        {guarantees.badge && (
          <span class="text-xs font-black uppercase tracking-wider text-amber-900 block mb-1" data-tina-field={tinaField(guarantees, 'badge')}>
            {guarantees.badge}
          </span>
        )}
        <h2 class="font-heading font-black text-2xl sm:text-3xl text-espresso-950" data-tina-field={tinaField(guarantees, 'title')}>
          {guarantees.title || "Férové platební podmínky a záruky pro rodiče"}
        </h2>
        {guarantees.subtitle && (
          <p class="text-xs sm:text-sm text-stone-600 mt-1" data-tina-field={tinaField(guarantees, 'subtitle')}>
            {guarantees.subtitle}
          </p>
        )}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6" data-tina-field={tinaField(guarantees, 'items')}>
        {guaranteeItems.map((item) => (
          <div class="p-6 rounded-3xl bg-white border border-parchment-300 shadow-xs space-y-2.5" data-tina-field={tinaField(item)}>
            {item.icon && (
              <span class="w-10 h-10 rounded-xl bg-amber-100 text-amber-900 text-xl flex items-center justify-center font-bold" data-tina-field={tinaField(item, 'icon')}>
                {item.icon}
              </span>
            )}
            <h3 class="font-heading font-black text-base text-espresso-950" data-tina-field={tinaField(item, 'title')}>
              {item.title}
            </h3>
            {item.text && (
              <p class="text-xs text-stone-600 leading-relaxed font-normal" data-tina-field={tinaField(item, 'text')}>
                {item.text}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- FAQ sekce ke ceníku -->
  {faq && (
    <div class="mb-14 sm:mb-18 bg-parchment-100/70 rounded-3xl p-6 sm:p-8 md:p-10 border border-parchment-300" data-tina-field={tinaField(cenik, 'faq')}>
      <h2 class="font-heading font-black text-2xl sm:text-3xl text-espresso-950 mb-6 text-center" data-tina-field={tinaField(faq, 'title')}>
        {faq.title || "Časté dotazy ke ceníku a platbám"}
      </h2>
      <div class="grid md:grid-cols-2 gap-5 sm:gap-6 max-w-5xl mx-auto" data-tina-field={tinaField(faq, 'items')}>
        {faqItems.map((item) => (
          <div class="p-5 rounded-2xl bg-white border border-parchment-300 shadow-2xs space-y-1.5" data-tina-field={tinaField(item)}>
            <h3 class="font-heading font-bold text-sm text-espresso-950" data-tina-field={tinaField(item, 'question')}>
              {item.question}
            </h3>
            {item.answer && (
              <p class="text-xs text-stone-600 leading-relaxed font-normal" data-tina-field={tinaField(item, 'answer')} set:html={formatRichText(item.answer)} />
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Bottom Global Action Callout Banner -->
  {ctaBanner && (
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-espresso-950 via-espresso-900 to-espresso-950 text-white shadow-xl text-center space-y-5 relative overflow-hidden" data-tina-field={tinaField(cenik, 'ctaBanner')}>
      {ctaBanner.badge && (
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400 text-espresso-950 text-xs font-black uppercase tracking-wider" data-tina-field={tinaField(ctaBanner, 'badge')}>
          <span>🎁</span>
          <span data-edit-key="cenik.ctaBanner.badge" data-edit-label="Štítek banneru ceníku">{ctaBanner.badge}</span>
        </div>
      )}
      <h2 class="font-heading font-black text-2xl sm:text-4xl text-amber-300 tracking-tight max-w-2xl mx-auto" data-tina-field={tinaField(ctaBanner, 'title')} data-edit-key="cenik.ctaBanner.title" data-edit-label="Nadpis banneru ceníku">
        {ctaBanner.title || "Vyzkoušejte si atmosféru doučovny nezávazně a bez rizika"}
      </h2>
      {ctaBanner.subtitle && (
        <p class="text-stone-300 text-xs sm:text-base max-w-xl mx-auto leading-relaxed font-normal" data-tina-field={tinaField(ctaBanner, 'subtitle')} data-edit-key="cenik.ctaBanner.subtitle" data-edit-label="Podnadpis banneru ceníku">
          {ctaBanner.subtitle}
        </p>
      )}
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        {ctaBanner.primaryBtnText && (
          <a
            href={ctaBanner.primaryBtnLink || "/rozvrh"}
            class="btn-gold-pulse inline-flex items-center justify-center gap-2 py-3.5 px-8 rounded-2xl font-heading font-black text-sm text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-500 shadow-md hover:scale-105 transition-transform"
            data-tina-field={tinaField(ctaBanner, 'primaryBtnText')}
          >
            <span data-edit-key="cenik.ctaBanner.primaryBtnText" data-edit-label="Tlačítko banneru">{ctaBanner.primaryBtnText}</span>
          </a>
        )}
        {ctaBanner.secondaryBtnText && (
          <a
            href={ctaBanner.secondaryBtnLink || "/#kontakt"}
            class="inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-2xl font-heading font-bold text-sm text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-colors"
            data-tina-field={tinaField(ctaBanner, 'secondaryBtnText')}
          >
            <span data-edit-key="cenik.ctaBanner.secondaryBtnText" data-edit-label="Sekundární tlačítko">{ctaBanner.secondaryBtnText}</span>
          </a>
        )}
      </div>
    </div>
  )}

</div>
