  function handleSuccess(name: string, childName: string, phone: string, segment: string, group: string, days: string) {
    if (confirmParentName) confirmParentName.textContent = name || "vážený zákazníku";

    const lowerSeg = (segment || '').toLowerCase();
    const isAdult = lowerSeg.includes('dospěl') || lowerSeg.includes('konverzace');
    const isTeen = lowerSeg.includes('středoškoláci') || lowerSeg.includes('maturita') || lowerSeg.includes('střední');

    if (confirmChildName) {
      if (isAdult) {
        confirmChildName.textContent = "vás osobně";
      } else if (isTeen) {
        confirmChildName.textContent = childName ? `${childName}` : "vás (studenta SŠ)";
      } else {
        confirmChildName.textContent = childName || "vaše dítě";
      }
    }

    if (confirmPhoneNum) confirmPhoneNum.textContent = phone;
    if (confirmProgramLabel) confirmProgramLabel.textContent = segment || "Výuka hrou";
    
    if (group && confirmGroupLabel && confirmGroupRow) {
      confirmGroupLabel.textContent = group;
      confirmGroupRow.classList.remove('hidden');
    } else if (confirmGroupRow) {
      confirmGroupRow.classList.add('hidden');
    }

    if (confirmDaysLabel) confirmDaysLabel.textContent = days || "Kdykoliv v týdnu";

    // Setup Google Calendar Link
    if (addGoogleCalBtn) {
      const attendee = isAdult ? 'dospělého' : (childName || 'dítě');
      const calTitle = encodeURIComponent("1. ukázková lekce angličtiny ZDARMA | VALEK ACADEMY");
      const calDesc = encodeURIComponent(`Ukázková lekce angličtiny hrou v malé skupince pro ${attendee}.\nLektor: Josef Válek (+420 792 372 642)\nWeb: https://valekacademy.cz\nS sebou: Pouze přezůvky a dobrou náladu!`);
      const calLoc = encodeURIComponent("Růžová 1238, 686 01 Uherské Hradiště (naproti ZŠ UNESCO)");
      addGoogleCalBtn.href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calTitle}&details=${calDesc}&location=${calLoc}`;
    }

    // Setup WhatsApp Button Link with personalized message
    if (confirmWhatsAppBtn) {
      const attendee = isAdult ? 'mě' : (childName ? `mého syna/dceru ${childName}` : 'mé dítě');
      const waMsg = encodeURIComponent(`Dobrý den pane Válku, právě jsem odeslal/a rezervaci lekce pro ${attendee}. Rád/a bych se domluvil/a na konkrétním termínu.`);
      confirmWhatsAppBtn.href = `https://wa.me/420792372642?text=${waMsg}`;
    }

    // Hide input fields, reveal rich confirmation ticket
    if (fieldsWrapper && receiptEl) {
      fieldsWrapper.classList.add('hidden');
      receiptEl.classList.remove('hidden');
      receiptEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    triggerCelebration();
  }
</script>
