---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  contact?: {
    formBadge?: string;
    formBadgeNote?: string;
    formTitle?: string;
    formSubtitle?: string;
    submitButtonText?: string;
    securityNote?: string;
    web3formsKey?: string;
    phoneFormatted?: string;
    [key: string]: any;
  };
}

const { contact = {} } = Astro.props;

const formBadge = contact.formBadge || "🎁 1. LEKCE 100% ZDARMA";
const formBadgeNote = contact.formBadgeNote || "Nezávazná přihláška";
const formTitle = contact.formTitle || "Rezervace ukázkové lekce hrou";
const formSubtitle = contact.formSubtitle || "Vyplňte krátký formulář a Josef se vám ozve s návrhem volných dnů v doučovně v Uherském Hradišti.";
const submitButtonText = contact.submitButtonText || "🎁 Rezervovat 1. lekci ZDARMA";
const securityNote = contact.securityNote || "🔒 Vaše kontaktní údaje jsou v naprostém bezpečí. Odesláním berete na vědomí zpracování údajů pro domluvu lekce.";
const phoneFormatted = contact.phoneFormatted || "+420 792 372 642";
const web3formsKey = contact.web3formsKey || import.meta.env.PUBLIC_WEB3FORMS_KEY || "f49fa95f-e8a5-4b5b-b462-11980de8d1bc";
---

<div class="lg:col-span-7">
  <div class="bg-white rounded-3xl p-6 sm:p-8 md:p-10 border-2 border-amber-300/80 shadow-soft-lg relative">
    
    <div class="flex items-center gap-2 mb-2">
      <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-400 text-espresso-950" data-tina-field={tinaField(contact, 'formBadge')} data-edit-key="contact.formBadge" data-edit-label="Formulář - štítek">
        {formBadge}
      </span>
      <span class="text-xs text-stone-500 font-bold" data-tina-field={tinaField(contact, 'formBadgeNote')} data-edit-key="contact.formBadgeNote" data-edit-label="Formulář - poznámka ke štítku">{formBadgeNote}</span>
    </div>
    <h3 class="font-academy font-black text-2xl sm:text-3xl text-espresso-950 mb-1" data-tina-field={tinaField(contact, 'formTitle')} data-edit-key="contact.formTitle" data-edit-label="Formulář - nadpis">
      {formTitle}
    </h3>
    <p class="text-xs sm:text-sm text-stone-600 mb-6 font-normal" data-tina-field={tinaField(contact, 'formSubtitle')} data-edit-key="contact.formSubtitle" data-edit-label="Formulář - podnadpis">
      {formSubtitle}
    </p>

    <form id="contact-form" class="space-y-4 sm:space-y-5" data-access-key={web3formsKey}>
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <!-- Row 1: Segment Choice (Custom Rich Dropdown) -->
      <div class="relative custom-dropdown-container" id="custom-segment-dropdown">
        <label id="segment-label" class="block text-xs font-black uppercase tracking-wider text-espresso-950 mb-2">
          O jaký program máte zájem? <span class="text-red-500">*</span>
        </label>

        <!-- Hidden native select for form submit, accessibility & Tina fallback -->
        <select
          id="segment-select"
          name="segment"
          required
          class="sr-only"
          tabindex="-1"
          aria-hidden="true"
        >
          <option value="Děti na ZŠ (Výuka hrou v malé skupince 4–8 dětí) – 1. LEKCE ZDARMA" selected>
            🎲 Děti na ZŠ (Skupinka 4–8 dětí hrou) – 1. LEKCE 100% ZDARMA [Otevřeno]
          </option>
          <option value="Dospělí & Konverzace [Brzy – Čekací listina]">
            💼 Angličtina pro dospělé [Přednostní čekací listina]
          </option>
          <option value="Středoškoláci & Maturita [Brzy – Čekací listina]">
            🎓 Střední škola a maturita [Přednostní čekací listina]
          </option>
          <option value="SCIO testy & Přijímačky na SŠ [Brzy – Čekací listina]">
            📐 SCIO testy & Přijímačky na SŠ [Přednostní čekací listina]
          </option>
        </select>

        <!-- Custom Trigger Button -->
        <button
          type="button"
          id="segment-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="segment-label segment-trigger-title"
          class="w-full flex items-center justify-between gap-3 p-3.5 sm:p-4 rounded-2xl bg-parchment-50 hover:bg-white border-2 border-amber-300/80 hover:border-amber-500 focus:outline-none focus:border-amber-500 focus:ring-4 focus:ring-amber-400/20 text-left transition-all cursor-pointer shadow-2xs group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div id="segment-trigger-icon" class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-300 to-amber-400 text-espresso-950 border border-amber-400/80 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs font-bold">
              🎲
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span id="segment-trigger-title" class="font-heading font-black text-sm sm:text-base text-espresso-950 truncate">
                  Děti na ZŠ (Skupinka 4–8 dětí hrou)
                </span>
                <span id="segment-trigger-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs">
                  🎁 1. lekce ZDARMA • Otevřeno
                </span>
              </div>
              <p id="segment-trigger-desc" class="text-[11px] sm:text-xs text-stone-600 font-normal truncate mt-0.5">
                Pro žáky 1.–9. třídy • Deskovky, aktivní mluvení a přirozený přízvuk
              </p>
            </div>
          </div>

          <div class="w-8 h-8 rounded-xl bg-parchment-200/80 group-hover:bg-amber-200/80 flex items-center justify-center flex-shrink-0 transition-all border border-parchment-300/80">
            <svg id="segment-chevron" class="dropdown-chevron w-4 h-4 text-espresso-950 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </button>

        <!-- Custom Dropdown Menu Listbox -->
        <div
          id="segment-menu"
          role="listbox"
          tabindex="-1"
          class="custom-dropdown-menu absolute left-0 right-0 top-[calc(100%+8px)] z-50 bg-white/95 backdrop-blur-xl border-2 border-amber-400 rounded-2xl shadow-2xl p-2 space-y-1.5 transition-all duration-200 origin-top opacity-0 scale-95 pointer-events-none"
        >
          <!-- Option 1: Děti ZŠ -->
          <div
            role="option"
            aria-selected="true"
            data-value="Děti na ZŠ (Výuka hrou v malé skupince 4–8 dětí) – 1. LEKCE ZDARMA"
            data-icon="🎲"
            data-title="Děti na ZŠ (Skupinka 4–8 dětí hrou)"
            data-badge="🎁 1. lekce ZDARMA • Otevřeno"
            data-badge-class="bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs"
            data-desc="Pro žáky 1.–9. třídy • Deskovky, aktivní mluvení a přirozený přízvuk"
            class="segment-option p-3 rounded-xl border-2 border-amber-500 bg-amber-50/90 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt shadow-2xs"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-300 to-amber-400 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs font-bold border border-amber-400">
                🎲
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">Děti na ZŠ (Skupinka 4–8 dětí hrou)</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300">
                    🎁 1. lekce ZDARMA • Otevřeno
                  </span>
                </div>
                <p class="text-[11px] text-stone-600 font-normal truncate mt-0.5">Pro žáky 1.–9. třídy • Deskovky, aktivní mluvení a přirozený přízvuk</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0">✓</span>
          </div>

          <!-- Option 2: Dospělí -->
          <div
            role="option"
            aria-selected="false"
            data-value="Dospělí & Konverzace [Brzy – Čekací listina]"
            data-icon="💼"
            data-title="Angličtina pro dospělé & Konverzace"
            data-badge="⏳ Přednostní čekací listina"
            data-badge-class="bg-parchment-200 text-stone-800 border border-parchment-300"
            data-desc="Mluvení bez stresu a ostychu, praktická slovní zásoba do práce i na cesty"
            class="segment-option p-3 rounded-xl border-2 border-transparent hover:border-amber-300 hover:bg-parchment-50 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-parchment-200 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs border border-parchment-300">
                💼
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">Angličtina pro dospělé & Konverzace</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
                    ⏳ Přednostní čekací listina
                  </span>
                </div>
                <p class="text-[11px] text-stone-500 font-normal truncate mt-0.5">Mluvení bez stresu a ostychu, praktická slovní zásoba do práce i na cesty</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0 hidden">✓</span>
          </div>

          <!-- Option 3: Středoškoláci & Maturita -->
          <div
            role="option"
            aria-selected="false"
            data-value="Středoškoláci & Maturita [Brzy – Čekací listina]"
            data-icon="🎓"
            data-title="Střední škola & Maturita"
            data-badge="⏳ Přednostní čekací listina"
            data-badge-class="bg-parchment-200 text-stone-800 border border-parchment-300"
            data-desc="Příprava k maturitě (didaktické testy & ústní část), Cambridge zkoušky a konverzace"
            class="segment-option p-3 rounded-xl border-2 border-transparent hover:border-amber-300 hover:bg-parchment-50 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-parchment-200 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs border border-parchment-300">
                🎓
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">Střední škola & Maturita</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
                    ⏳ Přednostní čekací listina
                  </span>
                </div>
                <p class="text-[11px] text-stone-500 font-normal truncate mt-0.5">Příprava k maturitě (didaktické testy & ústní část), Cambridge zkoušky a konverzace</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0 hidden">✓</span>
          </div>

          <!-- Option 4: SCIO testy -->
          <div
            role="option"
            aria-selected="false"
            data-value="SCIO testy & Přijímačky na SŠ [Brzy – Čekací listina]"
            data-icon="📐"
            data-title="SCIO testy & Přijímačky na SŠ"
            data-badge="⏳ Přednostní čekací listina"
            data-badge-class="bg-parchment-200 text-stone-800 border border-parchment-300"
            data-desc="Cílená příprava pro 5. a 9. třídy na jednotné přijímací zkoušky na gymnázia a SŠ"
            class="segment-option p-3 rounded-xl border-2 border-transparent hover:border-amber-300 hover:bg-parchment-50 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-parchment-200 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs border border-parchment-300">
                📐
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">SCIO testy & Přijímačky na SŠ</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
                    ⏳ Přednostní čekací listina
                  </span>
                </div>
                <p class="text-[11px] text-stone-500 font-normal truncate mt-0.5">Cílená příprava pro 5. a 9. třídy na jednotné přijímací zkoušky na gymnázia a SŠ</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0 hidden">✓</span>
          </div>
        </div>
      </div>

      <!-- Row 1b: Teaching Format Selector (Osobně v doučovně vs. Online) -->
      <div>
        <label class="block text-xs font-black uppercase tracking-wider text-espresso-950 mb-2">
          Kde chcete, aby výuka probíhala? <span class="text-red-500">*</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-2.5" id="forma-radios">
          <label class="forma-option relative flex items-center gap-2.5 p-3 rounded-xl border-2 border-amber-500 bg-amber-50 cursor-pointer transition-all shadow-2xs">
            <input type="radio" name="forma" value="Osobně v doučovně (Uherské Hradiště)" checked class="text-amber-600 focus:ring-amber-400" />
            <div class="text-left">
              <div class="font-heading font-black text-xs text-espresso-950">🏡 Osobně v UH</div>
              <div class="text-[10px] text-stone-600">Růžová 1238</div>
            </div>
          </label>

          <label class="forma-option relative flex items-center gap-2.5 p-3 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/40 cursor-pointer transition-all">
            <input type="radio" name="forma" value="Online z domova (Google Meet)" class="text-amber-600 focus:ring-amber-400" />
            <div class="text-left">
              <div class="font-heading font-black text-xs text-espresso-950">💻 Online</div>
              <div class="text-[10px] text-stone-600">Z domova (celá ČR)</div>
            </div>
          </label>

          <label class="forma-option relative flex items-center gap-2.5 p-3 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/40 cursor-pointer transition-all">
            <input type="radio" name="forma" value="Ještě nevím / Nechám si poradit" class="text-amber-600 focus:ring-amber-400" />
            <div class="text-left">
              <div class="font-heading font-black text-xs text-espresso-950">🔄 Ještě nevím</div>
              <div class="text-[10px] text-stone-600">Poradím se s Josefem</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Row 2: Parent Name and Child Name -->
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
            Jméno rodiče <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="např. Alena Nováková"
            class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm font-medium"
          />
        </div>

        <div>
          <label for="child-name" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
            Jméno a věk dítěte <span class="text-stone-400 text-[10px]">(např. Tomáš, 10 let)</span>
          </label>
          <input
            type="text"
            id="child-name"
            name="child_name"
            placeholder="např. Tomáš, 10 let (4. třída)"
            class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm font-medium"
          />
        </div>
      </div>

      <!-- Row 3: Phone & Email with Smart Formatting and Micro-interactions -->
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
            Telefonní číslo <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              autocomplete="tel"
              placeholder="+420 777 000 000"
              class="w-full px-4 py-3 pr-10 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-400/20 transition-all text-base sm:text-sm font-medium"
            />
            <span id="phone-valid-icon" class="absolute right-3.5 top-3 text-base text-emerald-600 font-black hidden">✓</span>
          </div>
          <div id="phone-feedback" class="text-[11px] mt-1.5 min-h-[16px] transition-all"></div>
        </div>

        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
            E-mailová adresa <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="alena.novakova@email.cz"
              class="w-full px-4 py-3 pr-10 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-400/20 transition-all text-base sm:text-sm font-medium"
            />
            <span id="email-valid-icon" class="absolute right-3.5 top-3 text-base text-emerald-600 font-black hidden">✓</span>
          </div>
          <div id="email-feedback" class="text-[11px] mt-1.5 min-h-[16px] transition-all"></div>
        </div>
      </div>

      <!-- Row 4: Grade Level (Custom Rich Dropdown) -->
      <div class="relative custom-dropdown-container" id="custom-level-dropdown">
        <label id="level-label" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
          Třída / Současná úroveň <span class="text-stone-400 text-[10px] font-normal">(pro výběr her a party vrstevníků)</span>
        </label>

        <!-- Hidden native select for form submit, accessibility & fallback -->
        <select
          id="level"
          name="level"
          class="sr-only"
          tabindex="-1"
          aria-hidden="true"
        >
          <option value="ZŠ 1. stupeň (1.–3. třída)">ZŠ 1. stupeň (1.–3. třída) – Malí objevitelé & deskovky</option>
          <option value="ZŠ 2. stupeň (4.–6. třída)" selected>ZŠ 2. stupeň (4.–6. třída) – Dobrodruzi & Karak</option>
          <option value="ZŠ 2. stupeň (7.–9. třída)">ZŠ 2. stupeň (7.–9. třída) – Mladí stratégové & Příprava na SŠ</option>
          <option value="Střední škola / Maturita">Střední škola / Maturita [Přednostní čekací listina]</option>
          <option value="Dospělý začátečník / Konverzace">Dospělý / Konverzace [Přednostní čekací listina]</option>
          <option value="SCIO přijímačky">SCIO přijímačky 5. / 9. třída [Přednostní čekací listina]</option>
        </select>

        <!-- Custom Trigger Button for Level -->
        <button
          type="button"
          id="level-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="level-label level-trigger-title"
          class="w-full flex items-center justify-between gap-3 p-3 sm:p-3.5 rounded-2xl bg-parchment-50 hover:bg-white border-2 border-parchment-300 hover:border-amber-400 focus:outline-none focus:border-amber-500 focus:ring-4 focus:ring-amber-400/20 text-left transition-all cursor-pointer shadow-2xs group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div id="level-trigger-icon" class="w-10 h-10 rounded-xl bg-amber-100 text-espresso-950 border border-amber-300 flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs font-bold">
              🐉
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span id="level-trigger-title" class="font-heading font-black text-sm text-espresso-950 truncate">
                  ZŠ 2. stupeň (4.–6. třída)
                </span>
                <span id="level-trigger-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300">
                  ⭐ Nejpopulárnější • Karak
                </span>
              </div>
              <p id="level-trigger-desc" class="text-[11px] text-stone-500 font-normal truncate mt-0.5">
                Dobrodruzi & Karak • Deskovky, rozmluvení a sebevědomí do školy
              </p>
            </div>
          </div>

          <div class="w-8 h-8 rounded-lg bg-parchment-200/70 group-hover:bg-amber-100 flex items-center justify-center flex-shrink-0 transition-all border border-parchment-300/80">
            <svg id="level-chevron" class="dropdown-chevron w-4 h-4 text-espresso-950 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </button>

        <!-- Custom Dropdown Menu Listbox for Level -->
        <div
          id="level-menu"
          role="listbox"
          tabindex="-1"
