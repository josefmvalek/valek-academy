    } else if (digitsOnly.length > 0) {
      const remaining = 9 - digitsOnly.length;
      const plural = remaining === 1 ? 'číslici' : (remaining < 5 ? 'číslice' : 'číslic');
      if (phoneFeedback) {
        phoneFeedback.innerHTML = `<span class="text-stone-500">Zbývá zadat ještě ${remaining} ${plural}</span>`;
      }
      phoneValidIcon?.classList.add('hidden');
