        targetLevel = 'ZŠ 1. stupeň (1.–3. třída)';
      } else if (detail.cohort.includes('4.–6') || detail.cohort.includes('4-6')) {
        targetLevel = 'ZŠ 2. stupeň (4.–6. třída)';
      } else if (detail.cohort.includes('7.–9') || detail.cohort.includes('7-9')) {
        targetLevel = 'ZŠ 2. stupeň (7.–9. třída)';
      } else if (detail.cohort.includes('13') || detail.cohort.includes('Maturita') || detail.cohort.includes('7.–13')) {
        targetLevel = 'Střední škola / Maturita';
