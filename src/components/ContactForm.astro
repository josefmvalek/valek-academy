<script>
  import confetti from 'canvas-confetti';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-button') as HTMLButtonElement | null;
  const btnText = document.getElementById('button-text');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const segmentSelect = document.getElementById('segment-select') as HTMLSelectElement | null;
  const defaultSubmitText = btnText?.textContent || "🎁 Rezervovat 1. lekci ZDARMA";

  // Dynamic elements for audience segment adaptation
  const parentNameCol = document.getElementById('parent-name-col');
  const nameLabelText = document.getElementById('name-label-text');
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const childNameCol = document.getElementById('child-name-col');
  const childNameLabelText = document.getElementById('child-name-label-text');
  const childNameHint = document.getElementById('child-name-hint');
  const childNameInput = document.getElementById('child-name') as HTMLInputElement | null;

  const levelSelect = document.getElementById('level') as HTMLSelectElement | null;
  const levelLabelTitle = document.getElementById('level-label-title');
  const levelLabelNote = document.getElementById('level-label-note');
  const daysTimeNote = document.getElementById('days-time-note');
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

  // Initial defaults
  const defaultParentLabel = nameLabelText?.textContent?.trim() || "Jméno rodiče";
  const defaultChildLabel = childNameLabelText?.textContent?.trim() || "Jméno a věk dítěte";
  const defaultLevelLabel = levelLabelTitle?.textContent?.trim() || "Třída / současná úroveň";
  const defaultLevelNote = levelLabelNote?.textContent?.trim() || "(pro výběr her a party vrstevníků)";
  const defaultDaysTimeNote = daysTimeNote?.textContent?.trim() || "Čas 14:00–18:00 přizpůsobujeme skupince";
  const defaultMessagePlaceholder = messageInput?.placeholder || "Dobrý den, potřebovali bychom pomoci s mluvením a přípravou do školy...";

  function applySegmentMode(segmentVal: string) {
    if (!nameLabelText || !nameInput) return;

    const formEl = document.getElementById('contact-form') as HTMLFormElement | null;
    const adultNameLabelVal = formEl?.dataset.adultNameLabel || "Vaše celé jméno";
    const adultBtnTextVal = formEl?.dataset.adultBtnText || "📝 Zapsat se na čekací listinu pro dospělé";
    const teenNameLabelVal = formEl?.dataset.teenNameLabel || "Jméno studenta / zájemce";
    const teenChildLabelVal = formEl?.dataset.teenChildLabel || "Jméno rodiče";
    const teenBtnTextVal = formEl?.dataset.teenBtnText || "📝 Zapsat se na čekací listinu pro maturanty";

    const lower = (segmentVal || '').toLowerCase();
    const isAdult = lower.includes('dospěl') || lower.includes('konverzace');
    const isTeen = lower.includes('středoškoláci') || lower.includes('maturita') || lower.includes('střední');
    const isScio = lower.includes('scio') || lower.includes('přijímačky');

    if (isAdult) {
      // --- ADULT CONVERSATION MODE ---
      parentNameCol?.classList.add('sm:col-span-2');
      nameLabelText.textContent = adultNameLabelVal;
      nameInput.placeholder = "např. Ing. Petr Dvořák";

      childNameCol?.classList.add('hidden');
      if (childNameInput) {
        childNameInput.required = false;
        childNameInput.value = '';
      }

      if (levelLabelTitle) levelLabelTitle.textContent = "Vaše současná úroveň / Cíl konverzace";
      if (levelLabelNote) levelLabelNote.textContent = "(přizpůsobíme tempo i témata na míru)";

      // Auto-select Adult level if currently on a kids level
      if (levelSelect && !levelSelect.value.toLowerCase().includes('dospěl') && !levelSelect.value.toLowerCase().includes('konverzace')) {
        const adultOpt = Array.from(levelSelect.options).find(o => o.value.toLowerCase().includes('dospěl') || o.value.toLowerCase().includes('konverzace'));
        if (adultOpt) {
          levelSelect.value = adultOpt.value;
          levelSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      if (daysTimeNote) daysTimeNote.textContent = "Odpolední a večerní termíny (17:00–20:00) dle domluvy";
      if (messageInput) messageInput.placeholder = "Dobrý den, mám zájem o konverzaci bez stresu / potřebuji angličtinu do práce v oboru...";
      if (btnText) btnText.textContent = adultBtnTextVal;

    } else if (isTeen) {
      // --- TEEN / HIGH SCHOOL / MATURITA MODE ---
      parentNameCol?.classList.remove('sm:col-span-2');
      nameLabelText.textContent = teenNameLabelVal;
      nameInput.placeholder = "např. Tereza Dvořáková (3. ročník Gymnázia)";

      childNameCol?.classList.remove('hidden');
      if (childNameLabelText) childNameLabelText.textContent = teenChildLabelVal;
      if (childNameHint) childNameHint.textContent = "(nepovinné)";
      if (childNameInput) {
        childNameInput.placeholder = "např. Jan Dvořák (otec)";
        childNameInput.required = false;
      }

      if (levelLabelTitle) levelLabelTitle.textContent = "Ročník SŠ / Zaměření";
      if (levelLabelNote) levelLabelNote.textContent = "(příprava k maturitě či studiu)";

      // Auto-select High School level
      if (levelSelect && !levelSelect.value.toLowerCase().includes('střední') && !levelSelect.value.toLowerCase().includes('maturita')) {
        const ssOpt = Array.from(levelSelect.options).find(o => o.value.toLowerCase().includes('střední') || o.value.toLowerCase().includes('maturita'));
        if (ssOpt) {
          levelSelect.value = ssOpt.value;
          levelSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      if (daysTimeNote) daysTimeNote.textContent = "Odpolední 90min bloky přizpůsobujeme rozvrhu SŠ";
      if (messageInput) messageInput.placeholder = "Dobrý den, potřebuji se připravit k maturitě / zbavit se nervozity při mluvení...";
      if (btnText) btnText.textContent = teenBtnTextVal;

    } else if (isScio) {
      // --- SCIO PREPARATION MODE ---
      parentNameCol?.classList.remove('sm:col-span-2');
      nameLabelText.textContent = defaultParentLabel;
      nameInput.placeholder = "např. Alena Nováková";

      childNameCol?.classList.remove('hidden');
      if (childNameLabelText) childNameLabelText.textContent = "Jméno žáka";
      if (childNameHint) childNameHint.textContent = "(5. nebo 9. třída)";
      if (childNameInput) {
        childNameInput.placeholder = "např. Tomáš, 9. třída (příprava na gymnázium)";
        childNameInput.required = false;
      }

      if (levelLabelTitle) levelLabelTitle.textContent = "Třída a termín zkoušek";
      if (levelLabelNote) levelLabelNote.textContent = "(5. nebo 9. třída ZŠ)";

      if (levelSelect) {
        const scioOpt = Array.from(levelSelect.options).find(o => o.value.toLowerCase().includes('scio'));
        if (scioOpt) {
          levelSelect.value = scioOpt.value;
          levelSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      if (daysTimeNote) daysTimeNote.textContent = "Přípravné bloky přizpůsobujeme rozvrhu";
      if (messageInput) messageInput.placeholder = "Dobrý den, máme zájem o přípravu na přijímací zkoušky na víceleté gymnázium / SŠ...";
      if (btnText) btnText.textContent = "📝 Zapsat se na přednostní čekací listinu";

    } else {
      // --- KIDS MODE (DEFAULT) ---
      parentNameCol?.classList.remove('sm:col-span-2');
      nameLabelText.textContent = defaultParentLabel;
      nameInput.placeholder = "např. Alena Nováková";

      childNameCol?.classList.remove('hidden');
      if (childNameLabelText) childNameLabelText.textContent = defaultChildLabel;
      if (childNameHint) childNameHint.textContent = "(a věk)";
      if (childNameInput) {
        childNameInput.placeholder = "např. Tomáš, 10 let (4. třída)";
        childNameInput.required = false;
      }

      if (levelLabelTitle) levelLabelTitle.textContent = defaultLevelLabel;
      if (levelLabelNote) levelLabelNote.textContent = defaultLevelNote;

      if (levelSelect && (levelSelect.value.toLowerCase().includes('dospěl') || levelSelect.value.toLowerCase().includes('střední'))) {
        const kidsOpt = Array.from(levelSelect.options).find(o => o.value.includes('4.–6.') || o.value.includes('1.–3.'));
        if (kidsOpt) {
          levelSelect.value = kidsOpt.value;
          levelSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      if (daysTimeNote) daysTimeNote.textContent = defaultDaysTimeNote;
      if (messageInput) messageInput.placeholder = defaultMessagePlaceholder;
      if (btnText) btnText.textContent = defaultSubmitText;
    }
  }

  function checkUrlSegmentParam() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const programParam = urlParams.get('program') || '';
      const hash = window.location.hash.toLowerCase();

      let targetSegment = '';
      if (programParam === 'dospeli' || programParam === 'adults' || hash.includes('dospeli') || hash.includes('adults')) {
        targetSegment = 'adults';
      } else if (programParam === 'maturita' || programParam === 'stredoskoly' || programParam === 'teens' || hash.includes('maturita') || hash.includes('stredoskoly')) {
        targetSegment = 'teens';
      } else if (programParam === 'scio' || hash.includes('scio')) {
        targetSegment = 'scio';
      }

      if (targetSegment && segmentSelect) {
        let matchingValue = '';
        if (targetSegment === 'adults') {
          matchingValue = Array.from(segmentSelect.options).find(o => o.value.toLowerCase().includes('dospěl') || o.value.toLowerCase().includes('konverzace'))?.value || '';
        } else if (targetSegment === 'teens') {
          matchingValue = Array.from(segmentSelect.options).find(o => o.value.toLowerCase().includes('středoškoláci') || o.value.toLowerCase().includes('maturita') || o.value.toLowerCase().includes('střední'))?.value || '';
        } else if (targetSegment === 'scio') {
          matchingValue = Array.from(segmentSelect.options).find(o => o.value.toLowerCase().includes('scio'))?.value || '';
        }

        if (matchingValue) {
          segmentSelect.value = matchingValue;
          segmentSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    } catch {}
  }

  segmentSelect?.addEventListener('change', () => {
    if (segmentSelect) applySegmentMode(segmentSelect.value);
  });

  // Initial check on load
  checkUrlSegmentParam();
  if (segmentSelect) {
    applySegmentMode(segmentSelect.value);
  }

  // --- Custom Rich Dropdowns Controller ---
  function setupCustomDropdown(config: {
    containerId: string;
    triggerId: string;
    menuId: string;
    chevronId: string;
    selectId: string;
    iconId: string;
    titleId: string;
    badgeId?: string;
    descId?: string;
    optionClass: string;
  }) {
    const container = document.getElementById(config.containerId);
    const trigger = document.getElementById(config.triggerId) as HTMLButtonElement | null;
    const menu = document.getElementById(config.menuId);
    const chevron = document.getElementById(config.chevronId);
    const select = document.getElementById(config.selectId) as HTMLSelectElement | null;
    const iconEl = document.getElementById(config.iconId);
    const titleEl = document.getElementById(config.titleId);
    const badgeEl = config.badgeId ? document.getElementById(config.badgeId) : null;
    const descEl = config.descId ? document.getElementById(config.descId) : null;

    if (!trigger || !menu || !select) return;
    const triggerBtn: HTMLButtonElement = trigger;
    const menuEl: HTMLElement = menu;
    const selectEl: HTMLSelectElement = select;
    const options: HTMLElement[] = container ? Array.from(container.querySelectorAll<HTMLElement>(`.${config.optionClass}`)) : [];

    let isOpen = false;

    function openMenu() {
      // Close other custom dropdowns first
      document.querySelectorAll<HTMLElement>('.custom-dropdown-menu.dropdown-open').forEach((m: HTMLElement) => {
        if (m !== menuEl) {
          m.classList.remove('dropdown-open', 'opacity-100', 'scale-100', 'pointer-events-auto');
          m.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          const p = m.closest('.custom-dropdown-container');
          p?.querySelector('[aria-haspopup="listbox"]')?.setAttribute('aria-expanded', 'false');
          p?.querySelector('.dropdown-chevron')?.classList.remove('rotate-180');
        }
      });

      isOpen = true;
      triggerBtn.setAttribute('aria-expanded', 'true');
      menuEl.classList.add('dropdown-open', 'opacity-100', 'scale-100', 'pointer-events-auto');
      menuEl.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      if (chevron) chevron.classList.add('rotate-180');
    }

    function closeMenu() {
      isOpen = false;
      triggerBtn.setAttribute('aria-expanded', 'false');
      menuEl.classList.remove('dropdown-open', 'opacity-100', 'scale-100', 'pointer-events-auto');
      menuEl.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      if (chevron) chevron.classList.remove('rotate-180');
    }

    triggerBtn.addEventListener('click', (e: MouseEvent) => {
      e.stopPropagation();
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    function selectOption(opt: HTMLElement) {
      const val = opt.dataset.value || '';
      const icon = opt.dataset.icon || '';
      const title = opt.dataset.title || '';
      const badge = opt.dataset.badge || '';
      const badgeClass = opt.dataset.badgeClass || '';
      const desc = opt.dataset.desc || '';

      selectEl.value = val;
      selectEl.dispatchEvent(new Event('change', { bubbles: true }));

      if (iconEl) iconEl.textContent = icon;
      if (titleEl) titleEl.textContent = title;
      if (badgeEl) {
        if (badge) {
          badgeEl.textContent = badge;
          badgeEl.className = `px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider ${badgeClass}`;
          badgeEl.classList.remove('hidden');
        } else {
          badgeEl.classList.add('hidden');
        }
      }
      if (descEl) descEl.textContent = desc;

      options.forEach((o: HTMLElement) => {
        const isMatch = o.dataset.value === val;
        o.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        const check = o.querySelector('.option-check');
        if (isMatch) {
          o.classList.add('border-amber-500', 'bg-amber-50/90', 'shadow-2xs');
          o.classList.remove('border-transparent');
          check?.classList.remove('hidden');
        } else {
          o.classList.remove('border-amber-500', 'bg-amber-50/90', 'shadow-2xs');
          o.classList.add('border-transparent');
          check?.classList.add('hidden');
        }
      });

      closeMenu();
      triggerBtn.focus();
    }

    options.forEach((opt: HTMLElement) => {
      opt.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        selectOption(opt);
      });
    });

    // Sync custom dropdown when select value is changed externally (e.g. from GroupMatcher or Schedule)
    selectEl.addEventListener('change', () => {
      const currentVal = selectEl.value;
      const matchedOpt = Array.from(options).find(o => o.dataset.value === currentVal);
      if (matchedOpt) {
        const icon = matchedOpt.dataset.icon || '';
        const title = matchedOpt.dataset.title || '';
        const badge = matchedOpt.dataset.badge || '';
        const badgeClass = matchedOpt.dataset.badgeClass || '';
        const desc = matchedOpt.dataset.desc || '';

        if (iconEl) iconEl.textContent = icon;
        if (titleEl) titleEl.textContent = title;
        if (badgeEl) {
