  function updateDaysState() {
    if (!daysHiddenInput) return;
    if (selectedDays.size === 0 || selectedDays.has('Kdykoliv')) {
      daysHiddenInput.value = 'Kdykoliv po telefonické domluvě';
      dayPills.forEach((p) => {
        if (p.dataset.day === 'Kdykoliv') {
