---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  contact?: {
    formBadge?: string;
    formBadgeNote?: string;
    formTitle?: string;
    formSubtitle?: string;
    submitButtonText?: string;
    securityNote?: string;
    web3formsKey?: string;
    phoneFormatted?: string;
    programLabel?: string;
    formatLabel?: string;
    formatInPersonTitle?: string;
    formatInPersonNote?: string;
    formatOnlineTitle?: string;
    formatOnlineNote?: string;
    formatUndecidedTitle?: string;
    formatUndecidedNote?: string;
    parentNameLabel?: string;
    childNameLabel?: string;
    phoneLabel?: string;
    emailLabel?: string;
    levelLabel?: string;
    levelLabelNote?: string;
    daysLabel?: string;
    daysNote?: string;
    daysTimeNote?: string;
    messageLabel?: string;
    stepsTitle?: string;
    step1Text?: string;
    step2Text?: string;
    step3Text?: string;
    adultNameLabel?: string;
    adultSubmitButtonText?: string;
    teenNameLabel?: string;
    teenChildNameLabel?: string;
    teenSubmitButtonText?: string;
    [key: string]: any;
  };
}

const { contact = {} } = Astro.props;

const formBadge = contact.formBadge || "🎁 1. LEKCE 100% ZDARMA";
const formBadgeNote = contact.formBadgeNote || "Nezávazná přihláška";
const formTitle = contact.formTitle || "Rezervace ukázkové lekce hrou";
const formSubtitle = contact.formSubtitle || "Vyplňte krátký formulář a pan Válek se vám ozve s návrhem volných dnů v doučovně v Uherském Hradišti.";
const submitButtonText = contact.submitButtonText || "🎁 Rezervovat 1. lekci ZDARMA";
const securityNote = contact.securityNote || "🔒 Vaše kontaktní údaje jsou v naprostém bezpečí. Odesláním berete na vědomí zpracování údajů pro domluvu lekce.";
const phoneFormatted = contact.phoneFormatted || "+420 792 372 642";
const web3formsKey = contact.web3formsKey || import.meta.env.PUBLIC_WEB3FORMS_KEY || "f49fa95f-e8a5-4b5b-b462-11980de8d1bc";

const programLabel = contact.programLabel || "O jaký program máte zájem?";
const parentNameLabel = contact.parentNameLabel || "Jméno rodiče";
const childNameLabel = contact.childNameLabel || "Jméno a věk dítěte";
const phoneLabel = contact.phoneLabel || "Telefonní číslo";
const emailLabel = contact.emailLabel || "E-mailová adresa";
const levelLabel = contact.levelLabel || "Třída / Současná úroveň";
const levelLabelNote = contact.levelLabelNote || "(pro výběr her a party vrstevníků)";
const daysLabel = contact.daysLabel || "Které dny se vám nejvíc hodí?";
const daysNote = contact.daysNote || "(lze vybrat i více dnů)";
const daysTimeNote = contact.daysTimeNote || "Čas 14:00–18:00 přizpůsobujeme skupince";
const messageLabel = contact.messageLabel || "Poznámka / S čím potřebujete pomoci?";
const stepsTitle = contact.stepsTitle || "Co se stane po odeslání?";
const step1Text = contact.step1Text || "Odešlete nezávaznou poptávku (1 min)";
const step2Text = contact.step2Text || "Pan Válek se vám do 24 h ozve s volnými časy";
const step3Text = contact.step3Text || "Dítě si přijde nezávazně zahrát 1. lekci zdarma";

const selectedGroupCalloutTitle = contact.selectedGroupCalloutTitle || "🎯 Vybraná zvířecí skupinka z rozvrhu";
const selectedGroupClearText = contact.selectedGroupClearText || "✕ Změnit skupinku";
const formSuccessTitle = contact.formSuccessTitle || "Děkuji za zprávu!";
const formSuccessText = contact.formSuccessText || "Požadavek jsem přijal a ozvu se vám co nejdříve s návrhem termínu ukázkové lekce zdarma v Uherském Hradišti.";
const formErrorTitle = contact.formErrorTitle || "Omlouvám se, odeslání se nezdařilo.";
const formErrorText = contact.formErrorText || `Můžete mi prosím zavolat na ${phoneFormatted} nebo napsat přímo na WhatsApp?`;

const adultNameLabel = contact.adultNameLabel || "Vaše celé jméno";
const adultSubmitButtonText = contact.adultSubmitButtonText || "📝 Zapsat se na čekací listinu pro dospělé";
const teenNameLabel = contact.teenNameLabel || "Jméno studenta / zájemce";
const teenChildNameLabel = contact.teenChildNameLabel || "Jméno rodiče";
const teenSubmitButtonText = contact.teenSubmitButtonText || "📝 Zapsat se na čekací listinu pro maturanty";
---

<div class="lg:col-span-7">
  <div class="bg-surface-card rounded-card-xl p-6 sm:p-8 md:p-10 border-2 border-amber-300/80 shadow-card relative">
    
    <div class="flex items-center gap-2 mb-2">
      <span class="px-2.5 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-amber-400 text-espresso-950 shadow-2xs" data-tina-field={tinaField(contact, 'formBadge')} data-edit-key="contact.formBadge" data-edit-label="Formulář - štítek">
        {formBadge}
      </span>
      <span class="text-xs text-stone-500 font-bold" data-tina-field={tinaField(contact, 'formBadgeNote')} data-edit-key="contact.formBadgeNote" data-edit-label="Formulář - poznámka ke štítku">{formBadgeNote}</span>
    </div>
    <h3 class="font-heading font-black text-fluid-h2 text-espresso-950 mb-1" data-tina-field={tinaField(contact, 'formTitle')} data-edit-key="contact.formTitle" data-edit-label="Formulář - nadpis">
      {formTitle}
    </h3>
    <p class="text-xs sm:text-sm text-stone-600 mb-6 font-normal" data-tina-field={tinaField(contact, 'formSubtitle')} data-edit-key="contact.formSubtitle" data-edit-label="Formulář - podnadpis">
      {formSubtitle}
    </p>

    <form
      id="contact-form"
      class="space-y-4 sm:space-y-5"
      data-access-key={web3formsKey}
      data-adult-name-label={adultNameLabel}
      data-adult-btn-text={adultSubmitButtonText}
      data-teen-name-label={teenNameLabel}
      data-teen-child-label={teenChildNameLabel}
      data-teen-btn-text={teenSubmitButtonText}
    >
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
      <input type="hidden" id="selected-group-input" name="selected_group" value="" />

      <!-- Form interactive fields container (hidden after successful submission) -->
      <div id="form-interactive-fields" class="space-y-4 sm:space-y-5">
        <!-- Selected Animal Group Callout (Active when clicked from weekly schedule) -->
        <div id="selected-group-callout" class="hidden p-3.5 sm:p-4 rounded-card-lg bg-amber-100/90 border-2 border-amber-400 shadow-2xs transition-all">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <span id="callout-group-emoji" class="w-10 h-10 rounded-card-md bg-amber-300 text-espresso-950 flex items-center justify-center text-xl flex-shrink-0 font-bold shadow-2xs border border-amber-400">
              🦘
            </span>
            <div class="min-w-0">
              <div class="text-[11px] font-black uppercase tracking-wider text-amber-900" data-tina-field={tinaField(contact, 'selectedGroupCalloutTitle')} data-edit-key="contact.selectedGroupCalloutTitle" data-edit-label="Zvolená skupinka nadpis">
                {selectedGroupCalloutTitle}
              </div>
              <div id="callout-group-title" class="font-heading font-black text-sm sm:text-base text-espresso-950 truncate">
                🦘 Kangaroos (Pondělí 12:30 – 13:30)
              </div>
              <div id="callout-group-meta" class="text-[11px] text-stone-600 font-medium">
                1.–3. třída • 1. ukázková lekce 100% ZDARMA
              </div>
            </div>
          </div>
          <button
            type="button"
            id="clear-selected-group-btn"
            class="text-xs text-espresso-800 hover:text-red-700 font-bold px-2.5 py-1.5 rounded-xl hover:bg-amber-200/80 transition-colors whitespace-nowrap cursor-pointer flex-shrink-0 border border-amber-300 bg-white/70"
            title="Zrušit a vybrat jiné zvířátko"
            data-tina-field={tinaField(contact, 'selectedGroupClearText')}
            data-edit-key="contact.selectedGroupClearText"
            data-edit-label="Zrušit výběr zvířátka"
          >
            {selectedGroupClearText}
          </button>
        </div>
      </div>

      <!-- Row 1: Segment Choice (Custom Rich Dropdown) -->
      <div class="relative custom-dropdown-container" id="custom-segment-dropdown">
        <label id="segment-label" class="block text-xs font-black uppercase tracking-wider text-espresso-950 mb-2">
          <span data-tina-field={tinaField(contact, 'programLabel')} data-edit-key="contact.programLabel" data-edit-label="Štítek výběru programu">{programLabel}</span> <span class="text-red-500">*</span>
        </label>

        <!-- Hidden native select for form submit, accessibility & Tina fallback -->
        <select
          id="segment-select"
          name="segment"
          required
          class="sr-only"
          tabindex="-1"
          aria-hidden="true"
        >
          <option value="Děti na ZŠ (Výuka hrou v malé skupince 4–8 dětí) – 1. LEKCE ZDARMA" selected>
            🎲 Děti na ZŠ (Skupinka 4–8 dětí hrou) – 1. LEKCE 100% ZDARMA [Otevřeno]
          </option>
          <option value="Středoškoláci & Maturita (90 min intenzivní bloky) – 1. LEKCE ZDARMA">
            🎓 Střední škola a maturita (90 min bloky) – 1. LEKCE 100% ZDARMA [Otevřeno]
          </option>
          <option value="Angličtina pro dospělé & Konverzace (Miniskupinky i individuál)">
            💼 Angličtina pro dospělé & Konverzace [Otevřeno / Dle domluvy]
          </option>
          <option value="SCIO testy & Přijímačky na SŠ (Čeština & Matematika)">
            📐 SCIO testy & Přijímačky na SŠ [Přednostní zápis]
          </option>
        </select>

        <!-- Custom Trigger Button -->
        <button
          type="button"
          id="segment-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="segment-label segment-trigger-title"
          class="w-full flex items-center justify-between gap-3 p-3.5 sm:p-4 rounded-2xl bg-parchment-50 hover:bg-white border-2 border-amber-300/80 hover:border-amber-500 focus:outline-none focus:border-amber-500 focus:ring-4 focus:ring-amber-400/20 text-left transition-all cursor-pointer shadow-2xs group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div id="segment-trigger-icon" class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-300 to-amber-400 text-espresso-950 border border-amber-400/80 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs font-bold">
              🎲
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span id="segment-trigger-title" class="font-heading font-black text-sm sm:text-base text-espresso-950 truncate">
                  Děti na ZŠ (Skupinka 4–8 dětí hrou)
                </span>
                <span id="segment-trigger-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs">
                  🎁 1. lekce ZDARMA • Otevřeno
                </span>
              </div>
              <p id="segment-trigger-desc" class="text-[11px] sm:text-xs text-stone-600 font-normal truncate mt-0.5">
                Pro žáky 1.–9. třídy • Deskovky, aktivní mluvení a přirozený přízvuk
              </p>
            </div>
          </div>

          <div class="w-8 h-8 rounded-xl bg-parchment-200/80 group-hover:bg-amber-200/80 flex items-center justify-center flex-shrink-0 transition-all border border-parchment-300/80">
            <svg id="segment-chevron" class="dropdown-chevron w-4 h-4 text-espresso-950 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </button>

        <!-- Custom Dropdown Menu Listbox -->
        <div
          id="segment-menu"
          role="listbox"
          tabindex="-1"
          class="custom-dropdown-menu absolute left-0 right-0 top-[calc(100%+8px)] z-50 bg-white/95 backdrop-blur-xl border-2 border-amber-400 rounded-2xl shadow-2xl p-2 space-y-1.5 transition-all duration-200 origin-top opacity-0 scale-95 pointer-events-none"
        >
          <!-- Option 1: Děti ZŠ -->
          <div
            role="option"
            aria-selected="true"
            data-value="Děti na ZŠ (Výuka hrou v malé skupince 4–8 dětí) – 1. LEKCE ZDARMA"
            data-icon="🎲"
            data-title="Děti na ZŠ (Skupinka 4–8 dětí hrou)"
            data-badge="🎁 1. lekce ZDARMA • Otevřeno"
            data-badge-class="bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs"
            data-desc="Pro žáky 1.–9. třídy • Deskovky, aktivní mluvení a přirozený přízvuk"
            class="segment-option p-3 rounded-xl border-2 border-amber-500 bg-amber-50/90 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt shadow-2xs"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-300 to-amber-400 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs font-bold border border-amber-400">
                🎲
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">Děti na ZŠ (Skupinka 4–8 dětí hrou)</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300">
                    🎁 1. lekce ZDARMA • Otevřeno
                  </span>
                </div>
                <p class="text-[11px] text-stone-600 font-normal truncate mt-0.5">Pro žáky 1.–9. třídy • Deskovky, aktivní mluvení a přirozený přízvuk</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0">✓</span>
          </div>

          <!-- Option 2: Středoškoláci & Maturita -->
          <div
            role="option"
            aria-selected="false"
            data-value="Středoškoláci & Maturita (90 min intenzivní bloky) – 1. LEKCE ZDARMA"
            data-icon="🎓"
            data-title="Střední škola & Maturita"
            data-badge="🎁 1. lekce ZDARMA • Otevřeno"
            data-badge-class="bg-emerald-100 text-emerald-900 border border-emerald-300"
            data-desc="Příprava k maturitě (didaktické testy & ústní část), Cambridge zkoušky a konverzace"
            class="segment-option p-3 rounded-xl border-2 border-transparent hover:border-amber-300 hover:bg-parchment-50 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-amber-100 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs border border-amber-300">
                🎓
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">Střední škola & Maturita (90 min)</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300">
                    🎁 1. lekce ZDARMA • Otevřeno
                  </span>
                </div>
                <p class="text-[11px] text-stone-500 font-normal truncate mt-0.5">Příprava k maturitě (didaktické testy & ústní část), plynulost mluvení bez trémy</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0 hidden">✓</span>
          </div>

          <!-- Option 3: Dospělí -->
          <div
            role="option"
            aria-selected="false"
            data-value="Angličtina pro dospělé & Konverzace (Miniskupinky i individuál)"
            data-icon="💼"
            data-title="Angličtina pro dospělé & Konverzace"
            data-badge="💬 Otevřeno • Domluva"
            data-badge-class="bg-amber-100 text-amber-900 border border-amber-300"
            data-desc="Mluvení bez stresu a ostychu, praktická slovní zásoba do práce i na cesty"
            class="segment-option p-3 rounded-xl border-2 border-transparent hover:border-amber-300 hover:bg-parchment-50 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-parchment-200 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs border border-parchment-300">
                💼
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">Angličtina pro dospělé & Konverzace</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
                    💬 Otevřeno • Domluva
                  </span>
                </div>
                <p class="text-[11px] text-stone-500 font-normal truncate mt-0.5">Mluvení bez stresu a ostychu, praktická slovní zásoba do práce i na cesty</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0 hidden">✓</span>
          </div>

          <!-- Option 4: SCIO testy -->
          <div
            role="option"
            aria-selected="false"
            data-value="SCIO testy & Přijímačky na SŠ (Čeština & Matematika)"
            data-icon="📐"
            data-title="SCIO testy & Přijímačky na SŠ"
            data-badge="🎯 Přednostní zápis"
            data-badge-class="bg-parchment-200 text-stone-800 border border-parchment-300"
            data-desc="Cílená příprava pro 5. a 9. třídy na jednotné přijímací zkoušky na gymnázia a SŠ"
            class="segment-option p-3 rounded-xl border-2 border-transparent hover:border-amber-300 hover:bg-parchment-50 cursor-pointer transition-all flex items-center justify-between gap-3 group/opt"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-parchment-200 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 group-hover/opt:scale-110 transition-transform shadow-2xs border border-parchment-300">
                📐
              </span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-heading font-black text-sm text-espresso-950">SCIO testy & Přijímačky na SŠ</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
                    🎯 Přednostní zápis
                  </span>
                </div>
                <p class="text-[11px] text-stone-500 font-normal truncate mt-0.5">Cílená příprava pro 5. a 9. třídy na jednotné přijímací zkoušky na gymnázia a SŠ</p>
              </div>
            </div>
            <span class="option-check text-base text-amber-700 font-black flex-shrink-0 hidden">✓</span>
          </div>
        </div>
      </div>

      <!-- Místo výuky: 100% osobně v UH -->
      <input type="hidden" name="forma" value="Osobně v doučovně (Uherské Hradiště, Růžová 1238)" />
      <div class="p-3.5 sm:p-4 rounded-2xl bg-amber-50/90 border-2 border-amber-300 shadow-2xs flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5 sm:gap-3 text-xs">
        <div class="flex items-center gap-2.5 text-espresso-950 font-bold min-w-0">
          <span class="w-8 h-8 rounded-xl bg-amber-200 text-espresso-950 flex items-center justify-center text-lg flex-shrink-0 border border-amber-300">🏡</span>
          <div class="min-w-0">
            <span class="block text-[10px] font-black uppercase tracking-wider text-amber-900">Místo výuky</span>
            <span class="text-xs sm:text-sm text-espresso-950 font-bold">Doučovna Růžová 1238, Uherské Hradiště (naproti ZŠ UNESCO)</span>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs flex-shrink-0 whitespace-nowrap">
          100% naživo
        </span>
      </div>

      <!-- Row 2: Parent Name and Child Name -->
      <div class="grid sm:grid-cols-2 gap-4 transition-all duration-300" id="name-fields-container">
        <div id="parent-name-col" class="transition-all duration-300">
          <label for="name" id="name-label" class="flex items-baseline justify-between gap-1 text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5 min-h-[18px]">
            <span>
              <span id="name-label-text" data-tina-field={tinaField(contact, 'parentNameLabel')} data-edit-key="contact.parentNameLabel" data-edit-label="Štítek jména rodiče">{parentNameLabel}</span> <span class="text-red-500">*</span>
            </span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="např. Alena Nováková"
            class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm font-medium"
          />
        </div>

        <div id="child-name-col" class="transition-all duration-300">
          <label for="child-name" id="child-name-label" class="flex items-baseline justify-between gap-1 text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5 min-h-[18px]">
            <span id="child-name-label-text" data-tina-field={tinaField(contact, 'childNameLabel')} data-edit-key="contact.childNameLabel" data-edit-label="Štítek jména dítěte">{childNameLabel}</span>
            <span id="child-name-hint" class="text-stone-400 text-[10px] font-normal normal-case tracking-normal">(a věk)</span>
          </label>
          <input
            type="text"
            id="child-name"
            name="child_name"
            placeholder="např. Tomáš, 10 let (4. třída)"
            class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm font-medium"
          />
        </div>
      </div>

      <!-- Row 3: Phone & Email with Smart Formatting and Micro-interactions -->
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
