      phoneInput.classList.add('border-parchment-300');
      return;
    }

    if (!isDelete && curVal.length > 0) {
      const formatted = formatPhoneCzech(curVal);
      if (formatted) {
        phoneInput.value = formatted;
      }
    }

    const digitsOnly = phoneInput.value.replace(/\D/g, '').replace(/^(420|421)/, '');
    if (digitsOnly.length === 9) {
      if (phoneFeedback) {
        phoneFeedback.innerHTML = '<span class="text-emerald-700 font-bold flex items-center gap-1"><span>✓</span> <span>Telefonní číslo je v pořádku</span></span>';
