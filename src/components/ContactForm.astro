<script>
  import confetti from 'canvas-confetti';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-button') as HTMLButtonElement | null;
  const btnText = document.getElementById('button-text');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const segmentSelect = document.getElementById('segment-select') as HTMLSelectElement | null;
  const defaultSubmitText = btnText?.textContent || "🎁 Rezervovat 1. lekci ZDARMA";

  function updateButtonLabel() {
    if (!btnText || !segmentSelect) return;
    if (segmentSelect.value.includes('Čekací listina')) {
      btnText.textContent = "📝 Zapsat se na přednostní čekací listinu";
    } else {
      btnText.textContent = defaultSubmitText;
    }
  }

  segmentSelect?.addEventListener('change', updateButtonLabel);
  updateButtonLabel();

  // --- Custom Rich Dropdowns Controller ---
  function setupCustomDropdown(config: {
    containerId: string;
    triggerId: string;
    menuId: string;
    chevronId: string;
    selectId: string;
    iconId: string;
    titleId: string;
    badgeId?: string;
    descId?: string;
    optionClass: string;
  }) {
    const container = document.getElementById(config.containerId);
    const trigger = document.getElementById(config.triggerId) as HTMLButtonElement | null;
    const menu = document.getElementById(config.menuId);
    const chevron = document.getElementById(config.chevronId);
    const select = document.getElementById(config.selectId) as HTMLSelectElement | null;
    const iconEl = document.getElementById(config.iconId);
    const titleEl = document.getElementById(config.titleId);
    const badgeEl = config.badgeId ? document.getElementById(config.badgeId) : null;
    const descEl = config.descId ? document.getElementById(config.descId) : null;

    if (!trigger || !menu || !select) return;
    const triggerBtn: HTMLButtonElement = trigger;
    const menuEl: HTMLElement = menu;
    const selectEl: HTMLSelectElement = select;
    const options: HTMLElement[] = container ? Array.from(container.querySelectorAll<HTMLElement>(`.${config.optionClass}`)) : [];

    let isOpen = false;

    function openMenu() {
      // Close other custom dropdowns first
      document.querySelectorAll<HTMLElement>('.custom-dropdown-menu.dropdown-open').forEach((m: HTMLElement) => {
        if (m !== menuEl) {
          m.classList.remove('dropdown-open', 'opacity-100', 'scale-100', 'pointer-events-auto');
          m.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          const p = m.closest('.custom-dropdown-container');
          p?.querySelector('[aria-haspopup="listbox"]')?.setAttribute('aria-expanded', 'false');
          p?.querySelector('.dropdown-chevron')?.classList.remove('rotate-180');
        }
      });

      isOpen = true;
      triggerBtn.setAttribute('aria-expanded', 'true');
      menuEl.classList.add('dropdown-open', 'opacity-100', 'scale-100', 'pointer-events-auto');
      menuEl.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      if (chevron) chevron.classList.add('rotate-180');
    }

    function closeMenu() {
      isOpen = false;
      triggerBtn.setAttribute('aria-expanded', 'false');
      menuEl.classList.remove('dropdown-open', 'opacity-100', 'scale-100', 'pointer-events-auto');
      menuEl.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
      if (chevron) chevron.classList.remove('rotate-180');
    }

    triggerBtn.addEventListener('click', (e: MouseEvent) => {
      e.stopPropagation();
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    function selectOption(opt: HTMLElement) {
      const val = opt.dataset.value || '';
      const icon = opt.dataset.icon || '';
      const title = opt.dataset.title || '';
      const badge = opt.dataset.badge || '';
      const badgeClass = opt.dataset.badgeClass || '';
      const desc = opt.dataset.desc || '';

      selectEl.value = val;
      selectEl.dispatchEvent(new Event('change', { bubbles: true }));

      if (iconEl) iconEl.textContent = icon;
      if (titleEl) titleEl.textContent = title;
      if (badgeEl) {
        if (badge) {
          badgeEl.textContent = badge;
          badgeEl.className = `px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider ${badgeClass}`;
          badgeEl.classList.remove('hidden');
        } else {
          badgeEl.classList.add('hidden');
        }
      }
      if (descEl) descEl.textContent = desc;

      options.forEach((o: HTMLElement) => {
        const isMatch = o.dataset.value === val;
        o.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        const check = o.querySelector('.option-check');
        if (isMatch) {
          o.classList.add('border-amber-500', 'bg-amber-50/90', 'shadow-2xs');
          o.classList.remove('border-transparent');
          check?.classList.remove('hidden');
        } else {
          o.classList.remove('border-amber-500', 'bg-amber-50/90', 'shadow-2xs');
          o.classList.add('border-transparent');
          check?.classList.add('hidden');
        }
      });

      closeMenu();
      triggerBtn.focus();
    }

    options.forEach((opt: HTMLElement) => {
      opt.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        selectOption(opt);
      });
    });

    document.addEventListener('click', (e: MouseEvent) => {
      if (isOpen && !container?.contains(e.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (isOpen && e.key === 'Escape') {
        closeMenu();
        triggerBtn.focus();
      }
    });
  }

  // Initialize Segment Dropdown
  setupCustomDropdown({
    containerId: 'custom-segment-dropdown',
    triggerId: 'segment-trigger',
    menuId: 'segment-menu',
    chevronId: 'segment-chevron',
    selectId: 'segment-select',
    iconId: 'segment-trigger-icon',
    titleId: 'segment-trigger-title',
    badgeId: 'segment-trigger-badge',
    descId: 'segment-trigger-desc',
    optionClass: 'segment-option'
  });

  // Initialize Level Dropdown
  setupCustomDropdown({
    containerId: 'custom-level-dropdown',
    triggerId: 'level-trigger',
    menuId: 'level-menu',
    chevronId: 'level-chevron',
    selectId: 'level',
    iconId: 'level-trigger-icon',
    titleId: 'level-trigger-title',
    badgeId: 'level-trigger-badge',
    descId: 'level-trigger-desc',
    optionClass: 'level-option'
  });

  // Smart Phone Formatting & Validation
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  const phoneFeedback = document.getElementById('phone-feedback');
  const phoneValidIcon = document.getElementById('phone-valid-icon');
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const emailFeedback = document.getElementById('email-feedback');
  const emailValidIcon = document.getElementById('email-valid-icon');

  function formatPhoneCzech(val: string): string {
    let cleaned = val.replace(/[^\d+]/g, '');
    if (cleaned.startsWith('+420')) {
      const rest = cleaned.slice(4).replace(/\D/g, '');
      const parts = rest.match(/(\d{1,3})/g) || [];
      return '+420 ' + parts.join(' ');
    } else if (cleaned.startsWith('+')) {
      return cleaned;
    } else {
      const digits = cleaned.replace(/\D/g, '');
      if (digits.length > 9 && digits.startsWith('420')) {
        const rest = digits.slice(3);
        const parts = rest.match(/(\d{1,3})/g) || [];
        return '+420 ' + parts.join(' ');
      }
      const parts = digits.match(/(\d{1,3})/g) || [];
      return parts.join(' ');
    }
  }

  phoneInput?.addEventListener('input', (e) => {
    if (!phoneInput) return;
    const curVal = phoneInput.value;
    const formatted = formatPhoneCzech(curVal);
    if (formatted !== curVal && !(e as any).inputType?.includes('delete')) {
      phoneInput.value = formatted;
    }

    const digitsOnly = phoneInput.value.replace(/\D/g, '').replace(/^420/, '');
    if (digitsOnly.length === 9) {
      if (phoneFeedback) {
        phoneFeedback.innerHTML = '<span class="text-emerald-700 font-bold flex items-center gap-1"><span>✓</span> <span>Telefon je v pořádku</span></span>';
      }
      phoneValidIcon?.classList.remove('hidden');
      phoneInput.classList.remove('border-parchment-300', 'border-amber-400');
      phoneInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
    } else if (digitsOnly.length > 0) {
      if (phoneFeedback) {
        phoneFeedback.innerHTML = `<span class="text-stone-500">Zbývá zadat ještě ${9 - digitsOnly.length} číslice</span>`;
      }
      phoneValidIcon?.classList.add('hidden');
      phoneInput.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-parchment-300');
      phoneInput.classList.add('border-amber-400');
    } else {
      if (phoneFeedback) phoneFeedback.innerHTML = '';
      phoneValidIcon?.classList.add('hidden');
      phoneInput.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-amber-400');
      phoneInput.classList.add('border-parchment-300');
    }
  });

  // Real-time Email validation
  emailInput?.addEventListener('input', () => {
    if (!emailInput) return;
    const val = emailInput.value.trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    if (emailRegex.test(val)) {
      if (emailFeedback) {
        emailFeedback.innerHTML = '<span class="text-emerald-700 font-bold flex items-center gap-1"><span>✓</span> <span>E-mail je v pořádku</span></span>';
      }
      emailValidIcon?.classList.remove('hidden');
      emailInput.classList.remove('border-parchment-300', 'border-amber-400');
      emailInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
    } else if (val.length > 0) {
      if (emailFeedback) {
        emailFeedback.innerHTML = '<span class="text-stone-500">Zadejte prosím platnou adresu (např. jmeno@email.cz)</span>';
      }
      emailValidIcon?.classList.add('hidden');
      emailInput.classList.remove('border-emerald-500', 'bg-emerald-50/20');
      emailInput.classList.add('border-amber-400');
    } else {
      if (emailFeedback) emailFeedback.innerHTML = '';
      emailValidIcon?.classList.add('hidden');
      emailInput.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-amber-400');
      emailInput.classList.add('border-parchment-300');
    }
  });

  // Forma vyuky interactive pills
  const formaLabels = document.querySelectorAll<HTMLLabelElement>('.forma-option');
  formaLabels.forEach((lbl) => {
    const radio = lbl.querySelector<HTMLInputElement>('input[type="radio"]');
    radio?.addEventListener('change', () => {
      formaLabels.forEach((l) => {
        l.classList.remove('border-amber-500', 'bg-amber-50', 'shadow-2xs');
        l.classList.add('border-parchment-300', 'bg-parchment-50');
      });
      if (radio?.checked) {
        lbl.classList.remove('border-parchment-300', 'bg-parchment-50');
        lbl.classList.add('border-amber-500', 'bg-amber-50', 'shadow-2xs');
      }
    });
  });

  // Preferovane dny v tydnu interactive multi-select pills
  const dayPills = document.querySelectorAll<HTMLButtonElement>('.day-pill');
  const daysHiddenInput = document.getElementById('preferred-days-input') as HTMLInputElement | null;
  const selectedDays = new Set<string>(['Kdykoliv']);

  function updateDaysState() {
    if (!daysHiddenInput) return;
    if (selectedDays.size === 0 || selectedDays.has('Kdykoliv')) {
      daysHiddenInput.value = 'Kdykoliv po telefonické domluvě';
      dayPills.forEach((p) => {
        if (p.dataset.day === 'Kdykoliv') {
          p.classList.remove('border-parchment-300', 'bg-parchment-50');
          p.classList.add('border-amber-500', 'bg-amber-400', 'shadow-xs');
        } else {
          p.classList.remove('border-amber-500', 'bg-amber-400', 'shadow-xs');
          p.classList.add('border-parchment-300', 'bg-parchment-50');
        }
      });
    } else {
      const order = ['Pondělí', 'Úterý', 'Středa', 'Čtvrtek', 'Pátek'];
      const sorted = order.filter((d) => selectedDays.has(d));
      daysHiddenInput.value = sorted.join(', ');
      dayPills.forEach((p) => {
        const d = p.dataset.day;
        if (d && selectedDays.has(d)) {
          p.classList.remove('border-parchment-300', 'bg-parchment-50');
          p.classList.add('border-amber-500', 'bg-amber-400', 'shadow-xs');
        } else {
          p.classList.remove('border-amber-500', 'bg-amber-400', 'shadow-xs');
          p.classList.add('border-parchment-300', 'bg-parchment-50');
        }
      });
    }
  }

  dayPills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const day = btn.dataset.day;
      if (!day) return;

      if (day === 'Kdykoliv') {
        selectedDays.clear();
        selectedDays.add('Kdykoliv');
      } else {
        if (selectedDays.has('Kdykoliv')) {
          selectedDays.delete('Kdykoliv');
        }
        if (selectedDays.has(day)) {
          selectedDays.delete(day);
          if (selectedDays.size === 0) {
            selectedDays.add('Kdykoliv');
          }
        } else {
          selectedDays.add(day);
        }
      }
      updateDaysState();
    });
  });

  function triggerCelebration() {
    try {
      confetti({
        particleCount: 90,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#F59E0B', '#10B981', '#FBBF24', '#2A190F']
      });
      setTimeout(() => {
        confetti({
          particleCount: 50,
          angle: 60,
          spread: 60,
          origin: { x: 0.1, y: 0.7 },
          colors: ['#F59E0B', '#10B981', '#FBBF24']
        });
        confetti({
          particleCount: 50,
          angle: 120,
          spread: 60,
          origin: { x: 0.9, y: 0.7 },
          colors: ['#F59E0B', '#10B981', '#FBBF24']
        });
      }, 250);
    } catch (e) {
      // Graceful fallback
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    // Check phone valid digits length
    if (phoneInput) {
      const digits = phoneInput.value.replace(/\D/g, '').replace(/^420/, '');
      if (digits.length < 9) {
        phoneInput.focus();
        if (phoneFeedback) {
          phoneFeedback.innerHTML = '<span class="text-rose-600 font-bold">⚠️ Zadejte prosím celé 9místné telefonní číslo</span>';
        }
        submitBtn.classList.add('animate-shake');
        setTimeout(() => submitBtn.classList.remove('animate-shake'), 600);
        return;
      }
    }

    submitBtn.disabled = true;
    if (btnText) btnText.textContent = "Odesílám rezervaci...";
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    const formData = new FormData(form);
    const accessKey = form.dataset.accessKey || "";

    try {
      if (accessKey) {
        formData.append("access_key", accessKey);
        const nameVal = (document.getElementById('name') as HTMLInputElement)?.value?.trim();
        formData.append("subject", nameVal ? `Nová poptávka: 1. lekce zdarma – ${nameVal}` : "Nová poptávka 1. lekce zdarma z webu VALEK ACADEMY");
        formData.append("from_name", "VALEK ACADEMY Rezervace");
        
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          form.reset();
          selectedDays.clear();
          selectedDays.add('Kdykoliv');
          updateDaysState();
          if (phoneFeedback) phoneFeedback.innerHTML = '';
          if (emailFeedback) emailFeedback.innerHTML = '';
          phoneValidIcon?.classList.add('hidden');
          emailValidIcon?.classList.add('hidden');
          successBox?.classList.remove('hidden');
          triggerCelebration();
        } else {
          console.error("Web3Forms submission error:", data);
          errorBox?.classList.remove('hidden');
        }
      } else {
        // Fallback for development without key
        await new Promise((resolve) => setTimeout(resolve, 600));
        form.reset();
        selectedDays.clear();
        selectedDays.add('Kdykoliv');
        updateDaysState();
        if (phoneFeedback) phoneFeedback.innerHTML = '';
        if (emailFeedback) emailFeedback.innerHTML = '';
        phoneValidIcon?.classList.add('hidden');
        emailValidIcon?.classList.add('hidden');
        successBox?.classList.remove('hidden');
        triggerCelebration();
      }
    } catch {
      errorBox?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      if (btnText) updateButtonLabel();
    }
  });
</script>
