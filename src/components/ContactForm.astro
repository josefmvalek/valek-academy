    if (!phoneInput) return;
    const isDelete = (e as any).inputType?.includes('delete');
    const curVal = phoneInput.value;

    // If user is deleting and field has only the prefix left, clear completely
    if (isDelete && (curVal === '+420 ' || curVal === '+420' || curVal === '+421 ' || curVal === '+421' || curVal === '+')) {
      phoneInput.value = '';
