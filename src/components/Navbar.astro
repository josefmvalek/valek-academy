---
import ParrotLogo from './ParrotLogo.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface NavLink {
  label: string;
  href: string;
  badge?: string;
}

interface Props {
  navbar?: {
    brandName?: string;
    brandTagline?: string;
    ctaText?: string;
    navLinks?: NavLink[];
  };
  contact?: any;
  phone?: string;
  phoneFormatted?: string;
}

const {
  navbar = {},
  contact = {},
  phone = "+420792372642",
  phoneFormatted = "+420 792 372 642"
} = Astro.props;

const brandName = navbar.brandName || "VALEK ACADEMY";
const brandTagline = navbar.brandTagline || "Uherské Hradiště • Výuka hrou";
const ctaText = navbar.ctaText || "🎁 1. lekce zdarma";

const defaultNavLinks: NavLink[] = [
  { label: "Programy & Hry", href: "#programy" },
  { label: "Ceník", href: "#cenik", badge: "1. zdarma" },
  { label: "O lektorovi", href: "#o-mne" },
  { label: "Doučovna UH", href: "#kde-ucime" },
  { label: "FAQ", href: "#faq" }
];

const navLinks = (navbar.navLinks && navbar.navLinks.length > 0) ? navbar.navLinks : defaultNavLinks;
---

<header class="sticky top-0 z-50 w-full bg-[#FAF7F2]/95 backdrop-blur-md border-b border-stone-200/80 transition-all" data-tina-field={tinaField(navbar, 'brandName')}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Clean Brand Logo -->
      <a href="#" class="flex items-center gap-2.5 sm:gap-3 group flex-shrink-0">
        <ParrotLogo className="w-9 h-9 sm:w-11 sm:h-11 shadow-2xs rounded-full group-hover:scale-105 transition-transform" />
        <div class="flex flex-col">
          <span class="font-heading font-black text-base sm:text-xl text-espresso-950 tracking-tight leading-none group-hover:text-amber-800 transition-colors" data-tina-field={tinaField(navbar, 'brandName')} data-edit-key="navbar.brandName" data-edit-label="Název v hlavičce">
            {brandName}
          </span>
          <span class="text-[10px] sm:text-xs text-amber-900 font-bold tracking-wide mt-1 flex items-center gap-1.5 leading-none">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            <span data-tina-field={tinaField(navbar, 'brandTagline')} data-edit-key="navbar.brandTagline" data-edit-label="Podtitul v hlavičce">{brandTagline}</span>
          </span>
        </div>
      </a>

      <!-- Clean, Unified Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-stone-700" aria-label="Hlavní navigace">
        {navLinks.map((link, idx) => (
          <a
            href={link.href}
            class={`hover:text-amber-800 transition-colors ${link.badge ? 'font-bold text-espresso-950 flex items-center gap-1.5' : ''}`}
            data-tina-field={navbar.navLinks ? tinaField(navbar, 'navLinks', idx) : undefined}
          >
            <span>{link.label}</span>
            {link.badge && (
              <span class="text-[10px] font-black bg-amber-200/80 text-espresso-950 px-2 py-0.5 rounded-md border border-amber-300">{link.badge}</span>
            )}
          </a>
        ))}
      </nav>

      <!-- Right Action CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Phone number -->
        <a
          href={`tel:${phone}`}
          class="hidden xl:inline-flex items-center gap-1.5 text-xs font-bold text-stone-700 hover:text-espresso-950 px-3 py-2 rounded-xl hover:bg-stone-200/50 transition-colors"
          data-tina-field={contact ? tinaField(contact, 'phoneFormatted') : undefined}
        >
          <span>📞</span>
          <span data-edit-key="contact.phoneFormatted" data-edit-label="Telefon v menu">{phoneFormatted}</span>
        </a>

        <!-- Primary CTA Button -->
        <a
          href="#kontakt"
          class="btn-gold-pulse inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-xl font-heading font-black text-xs sm:text-sm text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-500 shadow-xs cursor-pointer hover:scale-[1.02] active:scale-[0.98] transition-transform"
        >
          <span data-tina-field={tinaField(navbar, 'ctaText')} data-edit-key="navbar.ctaText" data-edit-label="Text tlačítka v menu">{ctaText}</span>
        </a>
      </div>

      <!-- Minimalist Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-2 rounded-xl text-espresso-900 hover:bg-stone-200/60 transition-colors focus:outline-none"
        aria-label="Otevřít menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Smooth Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-stone-200 bg-[#FAF7F2] shadow-xl px-5 pt-3 pb-6 space-y-1">
    {navLinks.map((link, idx) => (
      <a
        href={link.href}
        class="mobile-nav-link block py-2.5 text-sm font-bold text-espresso-950 border-b border-stone-100 flex items-center justify-between"
        data-tina-field={navbar.navLinks ? tinaField(navbar, 'navLinks', idx) : undefined}
      >
        <span>{link.label}</span>
        {link.badge && (
          <span class="text-[10px] bg-amber-300 px-2 py-0.5 rounded font-black text-espresso-950">{link.badge}</span>
        )}
      </a>
    ))}

    <div class="pt-4 space-y-2.5">
      <a
        href="#kontakt"
        class="mobile-nav-link w-full py-3.5 rounded-xl font-heading font-black text-center text-espresso-950 bg-gradient-to-b from-amber-300 to-amber-500 border border-amber-500 shadow-md block"
      >
        <span data-edit-key="navbar.ctaText" data-edit-label="Text tlačítka v menu">{ctaText}</span>
      </a>
      <a
        href={`tel:${phone}`}
        class="w-full py-2.5 text-center text-xs font-bold text-stone-700 border border-stone-300 rounded-xl bg-white block"
      >
        📞 Zavolat: {phoneFormatted}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');
  const links = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      iconBars?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      menu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
