---
import ParrotLogo from './ParrotLogo.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface NavLink {
  [key: string]: any;
  label: string;
  href: string;
  badge?: string;
}

interface Props {
  navbar?: {
    [key: string]: any;
    brandName?: string;
    brandTagline?: string;
    ctaText?: string;
    navLinks?: NavLink[];
  };
  contact?: any;
  phone?: string;
  phoneFormatted?: string;
}

const {
  navbar = {},
  contact = {},
  phone = "+420792372642",
  phoneFormatted = "+420 792 372 642"
} = Astro.props;

const rawPhone = contact.phone || phone || "+420792372642";
const phoneDigits = rawPhone.replace(/\D/g, '');
const normalizedPhone = `+${phoneDigits}`;
const waPhone = phoneDigits;

const brandName = navbar.brandName || "VALEK ACADEMY";
const brandTagline = navbar.brandTagline || "Uherské Hradiště • Výuka hrou";
const ctaText = navbar.ctaText || "🎁 1. lekce zdarma";
const ctaLink = navbar.ctaLink || "#kontakt";

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = pathname === '/';
const ctaDestination = ctaLink.startsWith('#')
  ? (isHomePage ? ctaLink : `/${ctaLink}`)
  : ctaLink;

// Primary standalone top links for desktop (dynamically sourced from CMS with fallback)
const defaultNavLinks = [
  { label: "Rozvrh", href: isHomePage ? "#harmonogram" : "/rozvrh" },
  { label: "Ceník", href: isHomePage ? "#cenik" : "/cenik" },
  { label: "Programy", href: isHomePage ? "#programy" : "/#programy" },
  { label: "O lektorovi", href: isHomePage ? "#o-mne" : "/#o-mne" },
  { label: "Rádce", href: "/blog" },
  { label: "FAQ", href: isHomePage ? "#faq" : "/#faq" },
  { label: "Fotogalerie", href: "/galerie" }
];

const resolveNavLinkHref = (rawHref: string) => {
  if (!isHomePage) {
    if (rawHref === '#harmonogram' || rawHref === '/#harmonogram') return '/rozvrh';
    if (rawHref === '#cenik' || rawHref === '/#cenik') return '/cenik';
    if (rawHref.startsWith('#')) return `/${rawHref}`;
  }
  return rawHref;
};

const navLinks = (navbar.navLinks && navbar.navLinks.length > 0)
  ? navbar.navLinks.map((item: NavLink) => ({
      label: item.label,
      href: resolveNavLinkHref(item.href),
      badge: item.badge,
      rawItem: item
    }))
  : defaultNavLinks;

const drawerTitle = navbar.drawerTitle || brandName;
const drawerSubtitle = navbar.drawerSubtitle || "Rozcestník & Navigace";
const drawerCloseText = navbar.drawerCloseText || "Zavřít";
const drawerCtaText = navbar.drawerCtaText || "🎁 Rezervovat 1. lekci ZDARMA";
const drawerCtaLink = navbar.drawerCtaLink || (isHomePage ? "#kontakt" : "/rozvrh#kontakt");
const drawerLocationNote = navbar.drawerLocationNote || (contact.location ? `📍 ${contact.location} (naproti ZŠ UNESCO)` : "📍 Růžová 1238, Uherské Hradiště (naproti ZŠ UNESCO)");

interface DrawerItem {
  label: string;
  href: string;
  desc: string;
  icon: string;
  badge?: string;
  [key: string]: any;
}

interface DrawerCategory {
  category: string;
  items: DrawerItem[];
  [key: string]: any;
}

// All website sections for the slide-over sidebar drawer with safe fallback
const defaultDrawerSections: DrawerCategory[] = [
  {
    category: "Hlavní stránky",
    items: [
      { label: "Rozvrh hodin & Rezervace", href: "/rozvrh", desc: "15 zvířecích skupinek, volná místa", icon: "📅" },
      { label: "Podrobný ceník & Kalkulátor", href: "/cenik", desc: "Slevy až 31 %, balíčky a platby", icon: "🏷️" },
      { label: "Rádce pro rodiče & Tipy", href: "/blog", desc: "Články a rady lektora Josefa Válka", icon: "📚" },
      { label: "Velká fotogalerie", href: "/galerie", desc: "16 snímků doučovny a her v centru UH", icon: "📸" }
    ]
  },
  {
    category: "Sekce na webu",
    items: [
      { label: "Programy & Hry pro žáky ZŠ", href: "/#programy", desc: "Karak, Scrabble, Dobble a konverzace", icon: "🎲" },
      { label: "Průběh 60 min lekce", href: "/#metodika", desc: "4 fáze: naladění, hra, škola a rekapitulace", icon: "⏱️" },
      { label: "O lektorovi (pan Válek)", href: "/#o-mne", desc: "Vyrůstal v Melbourne, RMIT Univ.", icon: "🦘" },
      { label: "Týdenní rozvrh skupinek", href: "/#harmonogram", desc: "Výběr dne, času a volná místa", icon: "📅" },
      { label: "Kde učíme (Doučovna UH)", href: "/#kde-ucime", desc: "Růžová 1238, naproti ZŠ UNESCO", icon: "📍" },
      { label: "Časté dotazy rodičů (FAQ)", href: "/#faq", desc: "Odpovědi na vše, co vás zajímá", icon: "❓" }
    ]
  }
];

const drawerSections: DrawerCategory[] = (navbar.drawerSections && navbar.drawerSections.length > 0)
  ? navbar.drawerSections
  : defaultDrawerSections;
---

<header class="sticky top-0 z-40 w-full bg-surface-base/95 backdrop-blur-md border-b border-surface-border transition-all select-none" data-tina-field={tinaField(navbar, 'brandName')}>
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-20 gap-1.5 sm:gap-2">
      
      <!-- Clean Brand Logo -->
      <a href="/" class="flex items-center gap-1.5 sm:gap-3 group flex-shrink min-w-0">
        <ParrotLogo className="w-7 h-7 sm:w-11 sm:h-11 shadow-2xs rounded-full group-hover:scale-105 transition-transform flex-shrink-0" />
        <div class="flex flex-col min-w-0">
          <span class="font-heading font-black text-[13px] sm:text-lg lg:text-xl text-espresso-950 tracking-tight leading-none group-hover:text-amber-800 transition-colors truncate" data-tina-field={tinaField(navbar, 'brandName')} data-edit-key="navbar.brandName" data-edit-label="Název v hlavičce">
            {brandName}
          </span>
          <span class="hidden min-[380px]:flex text-[9px] sm:text-xs text-amber-900 font-bold tracking-wide mt-0.5 sm:mt-1 items-center gap-1 sm:gap-1.5 leading-none truncate">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 flex-shrink-0"></span>
            <span class="truncate" data-tina-field={tinaField(navbar, 'brandTagline')} data-edit-key="navbar.brandTagline" data-edit-label="Podtitul v hlavičce">{brandTagline}</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-xs xl:text-sm font-bold text-stone-700" aria-label="Hlavní navigace">
        {navLinks.map((link: any, lIdx: number) => (
          <a
            href={link.href}
            class="hover:text-amber-900 transition-colors whitespace-nowrap py-1.5 px-2.5 xl:px-3 rounded-card-sm hover:bg-amber-100/60 text-stone-800 font-extrabold"
            data-tina-field={link.rawItem ? tinaField(link.rawItem, 'label') : undefined}
          >
            <span data-edit-key={link.rawItem ? `navbar.navLinks.${lIdx}.label` : undefined} data-edit-label="Odkaz v menu">{link.label}</span>
          </a>
        ))}
      </nav>

      <!-- Right Action Area (Phone + Gold CTA + Slide-over Drawer Trigger) -->
      <div class="flex items-center gap-1.5 sm:gap-3 flex-shrink-0">
        
        <!-- Direct Phone Link (Desktop XL only) -->
        <a
          href={`tel:${normalizedPhone}`}
          class="hidden xl:inline-flex items-center gap-1.5 text-xs font-bold text-stone-700 hover:text-espresso-950 px-3 py-2 rounded-card-sm hover:bg-stone-200/50 transition-colors whitespace-nowrap"
          data-tina-field={contact ? tinaField(contact, 'phoneFormatted') : undefined}
        >
          <span>📞</span>
          <span data-edit-key="contact.phoneFormatted" data-edit-label="Telefon v menu">{phoneFormatted}</span>
        </a>

        <!-- Primary CTA Button (Gold Pulse with 3D haptic shadow) -->
        <a
          href={ctaDestination}
          class="btn-gold-pulse shadow-dice-btn active:shadow-dice-btn-active inline-flex items-center justify-center gap-1 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-xl font-heading font-black text-[11px] sm:text-sm text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-500 cursor-pointer transition-transform whitespace-nowrap flex-shrink-0"
        >
          <span data-tina-field={tinaField(navbar, 'ctaText')} data-edit-key="navbar.ctaText" data-edit-label="Text tlačítka v menu">{ctaText}</span>
        </a>

        <!-- Slide-over Sidebar Drawer Trigger (Visible on mobile/tablet, placed on far right, min 44x44px touch target) -->
        <button
          type="button"
          data-open-drawer
          class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 min-w-[44px] min-h-[44px] px-2.5 sm:px-3.5 py-2 rounded-xl text-xs sm:text-sm font-heading font-black text-espresso-950 bg-white hover:bg-amber-100 border-2 border-parchment-300 hover:border-amber-400 shadow-2xs transition-all cursor-pointer whitespace-nowrap lg:hidden focus:outline-hidden focus:ring-2 focus:ring-amber-400"
          aria-label="Otevřít kompletní menu a rozcestník sekcí"
          aria-expanded="false"
          aria-controls="drawer-panel"
        >
          <svg class="w-5 h-5 text-espresso-950 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span class="hidden min-[480px]:inline">Menu</span>
        </button>

      </div>

    </div>
  </div>
</header>

<!-- Slide-over Sidebar Drawer Backdrop Overlay -->
<div
  id="drawer-backdrop"
  data-close-drawer
  class="fixed inset-0 bg-espresso-950/60 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Slide-over Sidebar Drawer Panel -->
<aside
  id="drawer-panel"
  class="fixed top-0 right-0 bottom-0 w-full sm:w-[420px] max-w-[92vw] bg-[#FAF7F2] border-l border-parchment-300 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between overflow-y-auto invisible"
  role="dialog"
  aria-modal="true"
  aria-label="Kompletní navigace a sekce webu"
>
  
  <!-- Drawer Header -->
  <div class="p-5 sm:p-6 border-b border-parchment-300 bg-white/90 flex items-center justify-between sticky top-0 z-10 backdrop-blur-md">
    <div class="flex items-center gap-2.5">
      <ParrotLogo className="w-8 h-8 rounded-full shadow-2xs" />
      <div>
        <div class="font-heading font-black text-sm text-espresso-950 leading-tight" data-tina-field={tinaField(navbar, 'drawerTitle')} data-edit-key="navbar.drawerTitle" data-edit-label="Nadpis v menu">{drawerTitle}</div>
        <div class="text-[10px] text-amber-900 font-bold leading-tight" data-tina-field={tinaField(navbar, 'drawerSubtitle')} data-edit-key="navbar.drawerSubtitle" data-edit-label="Podnadpis v menu">{drawerSubtitle}</div>
      </div>
    </div>
    <button
      type="button"
      data-close-drawer
      class="p-2 rounded-xl text-stone-500 hover:text-espresso-950 hover:bg-parchment-200 transition-colors cursor-pointer text-xs font-bold flex items-center gap-1"
      aria-label="Zavřít menu"
    >
      <span>✕</span>
      <span class="hidden sm:inline" data-tina-field={tinaField(navbar, 'drawerCloseText')} data-edit-key="navbar.drawerCloseText" data-edit-label="Text zavřít">{drawerCloseText}</span>
    </button>
  </div>

  <!-- Drawer Body Navigation Links -->
  <div class="p-5 sm:p-6 space-y-6 flex-grow">
    
    {drawerSections.map((sec, sIdx) => (
      <div class="space-y-2.5" data-tina-field={tinaField(sec, 'category')}>
        <div
          class="text-[11px] font-black uppercase tracking-wider text-stone-500 px-1"
          data-edit-key={`navbar.drawerSections.${sIdx}.category`}
          data-edit-label="Kategorie v menu"
        >
          {sec.category}
        </div>
        <div class="space-y-1.5">
          {sec.items.map((item, iIdx) => (
            <a
              href={item.href}
              data-drawer-link
              class="group p-3 rounded-2xl bg-white hover:bg-amber-50 border border-parchment-300 hover:border-amber-400 shadow-2xs transition-all flex items-center justify-between gap-3 cursor-pointer"
              data-tina-field={tinaField(item, 'label')}
            >
              <div class="flex items-center gap-3 min-w-0">
                <span
                  class="text-xl flex-shrink-0 group-hover:scale-110 transition-transform"
                  data-edit-key={`navbar.drawerSections.${sIdx}.items.${iIdx}.icon`}
                  data-edit-label="Ikona odkazu"
                >{item.icon}</span>
                <div class="min-w-0">
                  <div
                    class="font-heading font-black text-xs sm:text-sm text-espresso-950 truncate group-hover:text-amber-950"
                    data-edit-key={`navbar.drawerSections.${sIdx}.items.${iIdx}.label`}
                    data-edit-label="Název odkazu v menu"
                  >
                    {item.label}
                  </div>
                  <div
                    class="text-[11px] text-stone-500 truncate font-medium"
                    data-edit-key={`navbar.drawerSections.${sIdx}.items.${iIdx}.desc`}
                    data-edit-label="Popis odkazu v menu"
                  >
                    {item.desc}
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5 flex-shrink-0">
                {item.badge && (
                  <span
                    class="text-[9px] font-black bg-amber-200 text-espresso-950 px-2 py-0.5 rounded-full border border-amber-300 whitespace-nowrap"
                    data-edit-key={`navbar.drawerSections.${sIdx}.items.${iIdx}.badge`}
                    data-edit-label="Štítek odkazu"
                  >
                    {item.badge}
                  </span>
                )}
                <span class="text-stone-400 group-hover:translate-x-1 group-hover:text-amber-700 transition-all font-bold">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

  </div>

  <!-- Drawer Footer: Quick Contact & Booking CTA -->
  <div class="p-5 sm:p-6 pb-safe border-t border-parchment-300 bg-white/95 space-y-3 sticky bottom-0 z-10 backdrop-blur-md">
    
    <a
      href={drawerCtaLink}
      data-drawer-link
      class="btn-gold-pulse w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl font-heading font-black text-xs sm:text-sm text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-500 shadow-xs text-center"
      data-tina-field={tinaField(navbar, 'drawerCtaText')}
    >
      <span data-edit-key="navbar.drawerCtaText" data-edit-label="Text tlačítka v menu">{drawerCtaText}</span>
      <span>→</span>
    </a>

    <div class="grid grid-cols-2 gap-2 pt-1">
      <a
        href={`tel:${normalizedPhone}`}
        class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-parchment-100 hover:bg-parchment-200 border border-parchment-300 text-xs font-bold text-espresso-950 transition-colors text-center"
      >
        <span>📞</span>
        <span class="truncate">{phoneFormatted}</span>
      </a>
      <a
        href={`https://wa.me/${waPhone}?text=${encodeURIComponent('Dobrý den pane Válku, rád/a bych se zeptal/a na volná místa v doučovně na 1. lekci zdarma.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-xs font-bold text-emerald-950 transition-colors text-center"
      >
        <span>💬</span>
        <span>WhatsApp</span>
      </a>
    </div>

    <div class="text-[10px] text-center text-stone-500 pt-1" data-tina-field={tinaField(navbar, 'drawerLocationNote')}>
      <span data-edit-key="navbar.drawerLocationNote" data-edit-label="Poznámka adresy v menu">{drawerLocationNote}</span>
    </div>

  </div>

</aside>

<!-- Client-side script for Slide-over Drawer behavior -->
<script>
  function setupNavDrawer() {
    const openBtns = document.querySelectorAll('[data-open-drawer]');
    const closeBtns = document.querySelectorAll('[data-close-drawer]');
    const drawerLinks = document.querySelectorAll('[data-drawer-link]');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');

    function openDrawer() {
      if (!backdrop || !panel) return;
      panel.classList.remove('invisible');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      document.body.classList.add('overflow-hidden');
      openBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'true'));
    }

    function closeDrawer() {
      if (!backdrop || !panel) return;
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      setTimeout(() => {
        if (panel.classList.contains('translate-x-full')) {
          panel.classList.add('invisible');
        }
      }, 300);
      document.body.classList.remove('overflow-hidden');
      openBtns.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
    }

    openBtns.forEach((btn) => btn.addEventListener('click', openDrawer, true));
    closeBtns.forEach((btn) => btn.addEventListener('click', closeDrawer, true));
    drawerLinks.forEach((link) => link.addEventListener('click', closeDrawer, true));

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDrawer();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupNavDrawer);
  document.addEventListener('astro:page-load', setupNavDrawer);
</script>
