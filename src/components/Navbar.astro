---
import ParrotLogo from './ParrotLogo.astro';

interface Props {
  phone?: string;
  phoneFormatted?: string;
}

const { phone = "+420777123456", phoneFormatted = "+420 777 123 456" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full light-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo with Australian Parrot & Valek Academy -->
      <a href="#" class="flex items-center gap-3.5 group">
        <div class="group-hover:scale-105 transition-transform duration-300">
          <ParrotLogo className="w-12 h-12 shadow-sm rounded-full" />
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-academy font-black text-xl text-espresso-950 group-hover:text-espresso-700 transition-colors tracking-wider">
              VALEK ACADEMY
            </span>
          </div>
          <span class="text-xs text-amber-900 font-semibold flex items-center gap-1.5 -mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            Angličtina s Čechoaustralanem
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-espresso-800" aria-label="Hlavní navigace">
        <a href="#programy" class="hover:text-espresso-950 transition-colors">Hry & Skupinky</a>
        <a href="#o-mne" class="hover:text-espresso-950 transition-colors">O lektorovi</a>
        <a href="#cenik" class="hover:text-espresso-950 transition-colors flex items-center gap-1.5">
          <span>Ceník</span>
          <span class="text-[10px] font-extrabold bg-amber-200/80 text-espresso-950 border border-amber-300 px-2 py-0.5 rounded-full">1. zdarma</span>
        </a>
        <a href="#faq" class="hover:text-espresso-950 transition-colors">FAQ</a>
      </nav>

      <!-- Right Action CTAs -->
      <div class="hidden lg:flex items-center gap-4">
        <!-- Quick Phone -->
        <a href={`tel:${phone}`} class="flex items-center gap-2 text-xs font-semibold text-espresso-800 hover:text-espresso-950 bg-parchment-100 hover:bg-parchment-200 px-3.5 py-2 rounded-xl border border-parchment-300 transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{phoneFormatted}</span>
        </a>

        <!-- Primary CTA with free lesson highlight -->
        <a href="#kontakt" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-display font-bold text-sm text-espresso-950 bg-gradient-to-b from-amber-300 to-amber-400 hover:from-amber-200 hover:to-amber-300 border border-amber-500/50 shadow-sm transition-all hover:-translate-y-0.5 active:translate-y-0">
          <span>🎁 1. lekce zdarma</span>
        </a>

        <!-- Admin Shortcut -->
        <a href="/admin" title="TinaCMS Administrace" class="p-2 text-stone-400 hover:text-espresso-800 transition-colors rounded-lg hover:bg-parchment-200">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-button" type="button" class="md:hidden p-2.5 rounded-xl bg-parchment-100 text-espresso-800 hover:bg-parchment-200 border border-parchment-300" aria-label="Otevřít menu" aria-expanded="false">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-parchment-300 bg-parchment-50/98 backdrop-blur-xl px-4 pt-4 pb-6 space-y-3">
    <a href="#programy" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-espresso-900 hover:bg-parchment-200">Hry & Skupinky</a>
    <a href="#o-mne" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-espresso-900 hover:bg-parchment-200">O lektorovi</a>
    <a href="#cenik" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-espresso-900 hover:bg-parchment-200">Ceník</a>
    <a href="#faq" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-espresso-900 hover:bg-parchment-200">FAQ</a>
    
    <div class="pt-4 border-t border-parchment-300 flex flex-col gap-3">
      <a href="#kontakt" class="mobile-nav-link w-full py-3 rounded-xl font-display font-bold text-center text-espresso-950 bg-amber-400 shadow-sm">
        🎁 1. lekce pro děti zdarma
      </a>
      <div class="flex items-center justify-between text-xs text-stone-500 px-1 pt-1">
        <a href={`tel:${phone}`} class="hover:text-espresso-900 font-semibold">📞 {phoneFormatted}</a>
        <a href="/admin" class="hover:text-espresso-900 flex items-center gap-1 font-semibold">
          Správa webu (Admin)
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      menu?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
