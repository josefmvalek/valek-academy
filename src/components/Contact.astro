---
interface Props {
  contact: {
    badge?: string;
    title?: string;
    subtitle?: string;
    email?: string;
    phone?: string;
    phoneFormatted?: string;
    whatsapp?: string;
    location?: string;
    hours?: string;
    web3formsKey?: string;
  };
}

const { contact } = Astro.props;

const badge = contact.badge || "PŮJDEME DO TOHO SPOLEČNĚ?";
const title = contact.title || "Domluvte si nezávaznou úvodní konzultaci zdarma";
const subtitle = contact.subtitle || "Vyplňte krátký formulář níže nebo mi rovnou zavolejte či napište na WhatsApp. Odpovím vám obvykle do několika hodin.";
const email = contact.email || "josef.valek@email.cz";
const phone = contact.phone || "+420777123456";
const phoneFormatted = contact.phoneFormatted || "+420 777 123 456";
const whatsapp = contact.whatsapp || "https://wa.me/420777123456";
const location = contact.location || "Online výuka (celá ČR a svět) & Osobně po dohodě";
const hours = contact.hours || "Pondělí – Pátek: 8:00 – 19:00";
const web3formsKey = contact.web3formsKey || "";
---

<section id="kontakt" class="py-20 md:py-32 relative overflow-hidden">
  <!-- Subtle ambient glow background -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glow-badge text-xs font-semibold uppercase tracking-wider">
        {badge}
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
        {title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <!-- Contact Container -->
    <div class="grid lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Direct Contact Info & Guarantees -->
      <div class="lg:col-span-5 space-y-8">
        
        <div class="glass-card rounded-3xl p-8 border border-slate-700/60 space-y-6">
          <h3 class="font-display font-bold text-2xl text-white">
            Přímé spojení na lektora
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Preferujete telefonickou domluvu nebo chat? Můžete mě kontaktovat přímo kterýkoliv všední den.
          </p>

          <div class="space-y-4 pt-2">
            <!-- Phone -->
            <a href={`tel:${phone}`} class="flex items-center gap-4 p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-brand-500/40 hover:bg-slate-800 transition-all group">
              <div class="w-12 h-12 rounded-xl bg-brand-500/15 text-brand-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                📞
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">Telefon / SMS</div>
                <div class="font-display font-bold text-base sm:text-lg text-white group-hover:text-brand-400 transition-colors">
                  {phoneFormatted}
                </div>
              </div>
            </a>

            <!-- WhatsApp -->
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/40 hover:bg-slate-800 transition-all group">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                💬
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">WhatsApp zpráva</div>
                <div class="font-display font-bold text-base sm:text-lg text-white group-hover:text-emerald-400 transition-colors">
                  Napsat na WhatsApp
                </div>
              </div>
            </a>

            <!-- E-mail -->
            <a href={`mailto:${email}`} class="flex items-center gap-4 p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-accent-500/40 hover:bg-slate-800 transition-all group">
              <div class="w-12 h-12 rounded-xl bg-accent-500/15 text-accent-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                ✉️
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">E-mailová adresa</div>
                <div class="font-display font-bold text-base sm:text-lg text-white group-hover:text-accent-400 transition-colors break-all">
                  {email}
                </div>
              </div>
            </a>

            <!-- Location & Availability -->
            <div class="p-4 rounded-2xl bg-slate-900/50 border border-slate-800/80 space-y-2 text-xs text-slate-400">
              <div class="flex items-center gap-2 text-slate-300 font-semibold">
                <span>📍 Místo:</span>
                <span class="text-slate-400 font-normal">{location}</span>
              </div>
              <div class="flex items-center gap-2 text-slate-300 font-semibold">
                <span>🕒 Pracovní doba:</span>
                <span class="text-slate-400 font-normal">{hours}</span>
              </div>
            </div>

          </div>
        </div>

        <!-- Quick Promise card -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-emerald-950/30 to-navy-900 border border-emerald-500/25 flex items-start gap-4">
          <div class="text-2xl">⚡</div>
          <div>
            <h4 class="font-display font-bold text-sm text-emerald-300">Rychlá reakce zaručena</h4>
            <p class="text-xs text-slate-400 mt-1 leading-relaxed">
              Odpovídám do několika hodin. Všechny informace jsou nezávazné – vy sami se rozhodnete, zda začneme.
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Conversion Reservation Form -->
      <div class="lg:col-span-7">
        <div class="glass-card rounded-3xl p-8 sm:p-10 border border-slate-700/60 relative">
          
          <h3 class="font-display font-bold text-2xl text-white mb-2">
            Rezervovat nezávaznou lekci zdarma
          </h3>
          <p class="text-sm text-slate-400 mb-8">
            Vyplňte krátké údaje a domluvíme termín 20minutové online konzultace.
          </p>

          <!-- Form Element -->
          <form id="contact-form" class="space-y-6" data-access-key={web3formsKey}>
            
            <!-- Honeypot anti-spam for bots -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <!-- Row 1: Name and Email -->
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Jméno a příjmení <span class="text-brand-400">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="např. Jan Novák"
                  class="w-full px-4 py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors text-sm"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Váš e-mail <span class="text-brand-400">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="jan.novak@email.cz"
                  class="w-full px-4 py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors text-sm"
                />
              </div>
            </div>

            <!-- Row 2: Phone and English Level -->
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Telefonní číslo <span class="text-slate-500 text-[10px]">(volitelné)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+420 777 000 000"
                  class="w-full px-4 py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors text-sm"
                />
              </div>

              <div>
                <label for="level" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Vaše odhadovaná úroveň
                </label>
                <select
                  id="level"
                  name="level"
                  class="w-full px-4 py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors text-sm"
                >
                  <option value="A1 - Úplný začátečník">Úplný začátečník (A1)</option>
                  <option value="A2 - Věčný začátečník" selected>Věčný začátečník / Mírně pokročilý (A2)</option>
                  <option value="B1/B2 - Středně pokročilý">Středně pokročilý (B1 / B2)</option>
                  <option value="C1+ - Pokročilý">Pokročilý / Business (C1+)</option>
                  <option value="Nevím, potřebuji otestovat">Zatím nevím, otestujeme spolu</option>
                </select>
              </div>
            </div>

            <!-- Row 3: Goal Selection -->
            <div>
              <label for="goal" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                Co je váš hlavní cíl?
              </label>
              <select
                id="goal"
                name="goal"
                class="w-full px-4 py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors text-sm"
              >
                <option value="Odbourat ostych a rozmluvit se">Odbourat ostych z mluvení a získat plynulost</option>
                <option value="Příprava na pracovní pohovor / Byznys">Příprava na pracovní pohovor / kariérní růst</option>
                <option value="Příprava na zkoušky / maturitu">Příprava na Cambridge certifikát nebo maturitu</option>
                <option value="Individuální lekce na míru">Individuální výuka 1 na 1 (obecná angličtina)</option>
                <option value="Firemní výuka">Firemní či týmové lekce</option>
              </select>
            </div>

            <!-- Row 4: Message -->
            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                Zpráva / poznámka <span class="text-slate-500 text-[10px]">(např. preferovaný čas lekce)</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Dobrý den, rád bych se domluvil na úvodní konzultaci. Časově mi nejlépe vyhovují odpoledne..."
                class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-button"
              class="w-full inline-flex items-center justify-center gap-3 py-4 px-8 rounded-2xl font-display font-bold text-base text-navy-950 bg-gradient-to-r from-brand-400 to-brand-500 hover:from-brand-300 hover:to-brand-400 shadow-glow-brand transition-all hover:scale-[1.02] active:scale-[0.98] disabled:opacity-50"
            >
              <span id="button-text">Odeslat nezávaznou poptávku zdarma</span>
              <svg id="button-icon" class="w-5 h-5 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Status Alerts -->
            <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/50 text-emerald-300 text-sm flex items-center gap-3">
              <span class="text-xl">✅</span>
              <div>
                <strong>Děkuji za zprávu!</strong> Vaše poptávka byla úspěšně odeslána. Ozvu se vám co nejdříve s návrhem termínu.
              </div>
            </div>

            <div id="form-error" class="hidden p-4 rounded-xl bg-rose-950/60 border border-rose-500/50 text-rose-300 text-sm flex items-center gap-3">
              <span class="text-xl">⚠️</span>
              <div>
                Omlouvám se, odeslání se nezdařilo. Můžete mi prosím zavolat na {phoneFormatted} nebo napsat na {email}?
              </div>
            </div>

            <p class="text-[11px] text-slate-500 text-center">
              🔒 Vaše údaje jsou v bezpečí. Slouží výhradně k domluvě úvodní lekce a nebudou předány třetím stranám.
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-button') as HTMLButtonElement | null;
  const btnText = document.getElementById('button-text');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    submitBtn.disabled = true;
    if (btnText) btnText.textContent = "Odesílám...";
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    const formData = new FormData(form);
    const accessKey = form.dataset.accessKey || "";

    try {
      if (accessKey) {
        formData.append("access_key", accessKey);
        formData.append("subject", "Nová poptávka výuky angličtiny z webu");
        
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          form.reset();
          successBox?.classList.remove('hidden');
        } else {
          errorBox?.classList.remove('hidden');
        }
      } else {
        // Fallback demo/local simulation if no Web3Forms access key is configured yet
        await new Promise((resolve) => setTimeout(resolve, 800));
        form.reset();
        successBox?.classList.remove('hidden');
      }
    } catch {
      errorBox?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      if (btnText) btnText.textContent = "Odeslat nezávaznou poptávku zdarma";
    }
  });
</script>
