---
import ParrotLogo from './ParrotLogo.astro';

interface Props {
  contact: {
    badge?: string;
    title?: string;
    subtitle?: string;
    email?: string;
    phone?: string;
    phoneFormatted?: string;
    whatsapp?: string;
    location?: string;
    hours?: string;
    web3formsKey?: string;
  };
}

const { contact } = Astro.props;

const badge = contact.badge || "PŘIHLASTE DÍTĚ NA 1. LEKCI ZDARMA";
const title = contact.title || "Rezervujte ukázkovou lekci v malé skupince zdarma";
const subtitle = contact.subtitle || "Vyberte níže možnost a já se vám ozvu. Pro žáky ZŠ je 1. lekce v malé skupince (3–6 dětí) 100% ZDARMA a nezávazná!";
const email = contact.email || "josef.valek@email.cz";
const phone = contact.phone || "+420777123456";
const phoneFormatted = contact.phoneFormatted || "+420 777 123 456";
const whatsapp = contact.whatsapp || "https://wa.me/420777123456";
const location = contact.location || "Online výuka (celá ČR i ze zahraničí) & Osobně po domluvě";
const hours = contact.hours || "Pondělí – Pátek: 8:00 – 19:00";
const web3formsKey = contact.web3formsKey || "";
---

<section id="kontakt" class="py-12 md:py-16 relative bg-[#FDFBF7] border-t border-parchment-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-8 md:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-bold uppercase tracking-wider text-amber-950">
        {badge}
      </div>
      <h2 class="font-academy font-bold text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight">
        {title}
      </h2>
      <p class="text-espresso-800/80 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <!-- Contact Container -->
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Direct Contact Info -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-parchment-50 rounded-3xl p-8 border-2 border-parchment-300 shadow-xs space-y-6">
          <div class="flex items-center gap-3.5 pb-4 border-b border-parchment-200">
            <ParrotLogo className="w-12 h-12" />
            <div>
              <h3 class="font-academy font-bold text-xl text-espresso-950 leading-tight">
                Josef Válek
              </h3>
              <p class="text-xs text-stone-600 font-medium">Vyrostl v Austrálii • 25+ let v ČR</p>
            </div>
          </div>

          <p class="text-sm text-slate-600 leading-relaxed">
            Preferujete telefonickou domluvu nebo chat přes WhatsApp? Neváhejte mi zavolat či napsat kterýkoliv všední den.
          </p>

          <div class="space-y-3 pt-1">
            <!-- Phone -->
            <a href={`tel:${phone}`} class="flex items-center gap-4 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-blue-400 hover:bg-blue-50/50 transition-all group">
              <div class="w-11 h-11 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                📞
              </div>
              <div>
                <div class="text-xs text-slate-500 font-medium">Telefon / SMS</div>
                <div class="font-display font-bold text-base text-oxford-900 group-hover:text-blue-800 transition-colors">
                  {phoneFormatted}
                </div>
              </div>
            </a>

            <!-- WhatsApp -->
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-400 hover:bg-emerald-50/50 transition-all group">
              <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                💬
              </div>
              <div>
                <div class="text-xs text-slate-500 font-medium">WhatsApp chat</div>
                <div class="font-display font-bold text-base text-oxford-900 group-hover:text-emerald-800 transition-colors">
                  Napsat na WhatsApp
                </div>
              </div>
            </a>

            <!-- E-mail -->
            <a href={`mailto:${email}`} class="flex items-center gap-4 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/50 transition-all group">
              <div class="w-11 h-11 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                ✉️
              </div>
              <div>
                <div class="text-xs text-slate-500 font-medium">E-mail</div>
                <div class="font-display font-bold text-base text-oxford-900 group-hover:text-amber-800 transition-colors break-all">
                  {email}
                </div>
              </div>
            </a>

            <!-- Location & Availability -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-1.5 text-xs text-slate-600">
              <div>📍 <strong>Místo výuky:</strong> {location}</div>
              <div>🕒 <strong>Dostupnost:</strong> {hours}</div>
            </div>

          </div>
        </div>

        <!-- Australian Trust Promise -->
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-start gap-3.5">
          <span class="text-2xl">⚡</span>
          <div>
            <h4 class="font-display font-bold text-sm text-oxford-900">1. celá lekce je 100% ZDARMA</h4>
            <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
              Dítě si přijde nezávazně vyzkoušet atmosféru a hry v malé skupince (3–6 dětí). Žádné platby předem ani skryté závazky. Rozhodnete se až poté.
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Conversion Reservation Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-8 sm:p-10 border-2 border-parchment-300 shadow-soft-lg relative">
          
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-400 text-espresso-950">
              🎁 1. LEKCE 100% ZDARMA
            </span>
            <span class="text-xs text-stone-500 font-medium">Nezávazná rezervace</span>
          </div>
          <h3 class="font-academy font-bold text-2xl text-espresso-950 mb-1">
            Rezervace ukázkové lekce hrou
          </h3>
          <p class="text-sm text-stone-600 mb-6">
            Pro děti na ZŠ je 1. lekce ve skupince 100% ZDARMA. Ostatní programy můžete předběžně zapsat na čekací listinu.
          </p>

          <form id="contact-form" class="space-y-5" data-access-key={web3formsKey}>
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <!-- Row 1: Segment Choice -->
            <div>
              <label for="segment-select" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                O jaké doučování máte zájem? <span class="text-red-500">*</span>
              </label>
              <select
                id="segment-select"
                name="segment"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 font-medium focus:outline-none focus:border-oxford-800 focus:bg-white transition-colors text-sm"
              >
                <option value="Děti na ZŠ (Výuka hrou v malé skupince 3–6 dětí) – 1. LEKCE ZDARMA" selected>
                  🎲 Děti na ZŠ (Skupinka 3–6 dětí hrou) – 1. LEKCE 100% ZDARMA [Otevřeno]
                </option>
                <option value="Dospělí & Konverzace [Brzy – Čekací listina]">
                  💼 Angličtina pro dospělé [Brzy – Přednostní čekací listina]
                </option>
                <option value="Středoškoláci & Maturita [Brzy – Čekací listina]">
                  🎓 Střední škola a maturita [Brzy – Přednostní čekací listina]
                </option>
                <option value="SCIO testy & Přijímačky na SŠ [Brzy – Čekací listina]">
                  📐 SCIO testy & Přijímačky na SŠ [Brzy – Přednostní čekací listina]
                </option>
              </select>
            </div>

            <!-- Row 2: Name and Email -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Jméno a příjmení <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="např. Alena Nováková"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-oxford-800 focus:bg-white transition-colors text-sm"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  E-mailová adresa <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="alena.novakova@email.cz"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-oxford-800 focus:bg-white transition-colors text-sm"
                />
              </div>
            </div>

            <!-- Row 3: Phone & Level -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Telefonní číslo <span class="text-slate-400 text-[10px]">(pro rychlou domluvu)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+420 777 000 000"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-oxford-800 focus:bg-white transition-colors text-sm"
                />
              </div>

              <div>
                <label for="level" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Současná úroveň / Třída
                </label>
                <select
                  id="level"
                  name="level"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:border-oxford-800 focus:bg-white transition-colors text-sm"
                >
                  <option value="ZŠ 1. stupeň">ZŠ 1. stupeň (1.–5. třída)</option>
                  <option value="ZŠ 2. stupeň" selected>ZŠ 2. stupeň (6.–9. třída)</option>
                  <option value="Střední škola / Maturita">Střední škola (příprava k maturitě)</option>
                  <option value="Dospělý začátečník / mírně pokročilý">Dospělý: Věčný začátečník / mírně pokročilý</option>
                  <option value="Dospělý středně pokročilý až pokročilý">Dospělý: Středně pokročilý až pokročilý (byznys)</option>
                  <option value="SCIO přijímačky 5. třída">SCIO přijímačky (5. třída – osmiletá gymnázia)</option>
                  <option value="SCIO přijímačky 9. třída">SCIO přijímačky (9. třída – čtyřleté obory)</option>
                </select>
              </div>
            </div>

            <!-- Row 4: Message -->
            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Poznámka / S čím potřebujete pomoci?
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Dobrý den, potřebovali bychom pro syna doučit gramatiku na ZŠ a připravit se na čtvrtletku..."
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-oxford-800 focus:bg-white transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submit-button"
              class="w-full inline-flex items-center justify-center gap-3 py-4 px-8 rounded-2xl font-display font-bold text-base text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 border border-amber-500 shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50"
            >
              <span id="button-text">Rezervovat 1. lekci ZDARMA</span>
              <svg id="button-icon" class="w-5 h-5 text-espresso-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Status Alerts -->
            <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-sm flex items-center gap-3">
              <span class="text-xl">✅</span>
              <div>
                <strong>Děkuji za zprávu!</strong> Požadavek jsem přijal a ozvu se vám co nejdříve s návrhem termínu lekce zdarma či potvrzením zápisu na čekací listinu.
              </div>
            </div>

            <div id="form-error" class="hidden p-4 rounded-xl bg-rose-50 border border-rose-300 text-rose-900 text-sm flex items-center gap-3">
              <span class="text-xl">⚠️</span>
              <div>
                Omlouvám se, odeslání se nezdařilo. Můžete mi prosím zavolat na {phoneFormatted} nebo napsat na {email}?
              </div>
            </div>

            <p class="text-[11px] text-slate-400 text-center">
              🔒 Vaše kontaktní údaje jsou v naprostém bezpečí a slouží pouze k domluvě úvodní lekce.
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-button') as HTMLButtonElement | null;
  const btnText = document.getElementById('button-text');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    submitBtn.disabled = true;
    if (btnText) btnText.textContent = "Odesílám...";
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    const formData = new FormData(form);
    const accessKey = form.dataset.accessKey || "";

    try {
      if (accessKey) {
        formData.append("access_key", accessKey);
        formData.append("subject", "Nová poptávka doučování z webu");
        
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          form.reset();
          successBox?.classList.remove('hidden');
        } else {
          errorBox?.classList.remove('hidden');
        }
      } else {
        await new Promise((resolve) => setTimeout(resolve, 800));
        form.reset();
        successBox?.classList.remove('hidden');
      }
    } catch {
      errorBox?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      if (btnText) btnText.textContent = "Rezervovat 1. lekci ZDARMA";
    }
  });
</script>
