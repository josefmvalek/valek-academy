---
import ParrotLogo from './ParrotLogo.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  contact: {
    badge?: string;
    title?: string;
    subtitle?: string;
    tutorName?: string;
    tutorCredentials?: string;
    tutorRole?: string;
    introText?: string;
    email?: string;
    phone?: string;
    phoneFormatted?: string;
    whatsapp?: string;
    whatsappText?: string;
    location?: string;
    hours?: string;
    guaranteeTitle?: string;
    guaranteeDesc?: string;
    formBadge?: string;
    formBadgeNote?: string;
    formTitle?: string;
    formSubtitle?: string;
    submitButtonText?: string;
    securityNote?: string;
    web3formsKey?: string;
  };
  locationInfo?: {
    parkingInfo?: string;
    surroundingTowns?: string;
    [key: string]: any;
  };
}

const { contact = {}, locationInfo = {} } = Astro.props;

const badge = contact.badge || "PŘIHLASTE DÍTĚ NA 1. LEKCI ZDARMA";
const title = contact.title || "Rezervujte ukázkovou lekci v malé skupince zdarma";
const subtitle = contact.subtitle || "Vyberte termín a formu výuky (osobně v UH nebo online). Pro žáky ZŠ je 1. lekce v malé skupince (4–8 dětí) 100% ZDARMA a nezávazná!";
const tutorName = contact.tutorName || "Josef Válek";
const tutorCredentials = contact.tutorCredentials || "BBA (RMIT Univ., Melbourne) • 25+ let v ČR";
const tutorRole = contact.tutorRole || "Doučovna v Uherském Hradišti";
const introText = contact.introText || "Preferujete telefonickou domluvu nebo chat přes WhatsApp? Neváhejte mi kdykoliv zavolat či napsat kterýkoliv všední den.";
const email = contact.email || "info@valekacademy.cz";
const phone = contact.phone || "+420792372642";
const phoneFormatted = contact.phoneFormatted || "+420 792 372 642";
const whatsapp = contact.whatsapp || "https://wa.me/420792372642?text=Dobr%C3%BD%20den%20Josefe%2C%20r%C3%A1d%2Fa%20bych%20se%20zeptal%2Fa%20na%20voln%C3%A9%20m%C3%ADsto%20ve%20skupince%20d%C4%9Bt%C3%AD%20na%201.%20lekci%20zdarma.";
const whatsappText = contact.whatsappText || "Napsat Josefovi na WhatsApp →";
const location = contact.location || "Růžová 1238, Uherské Hradiště";
const parkingInfo = locationInfo.parkingInfo || "Bezplatné parkovací stání přímo před vchodem do doučovny";
const surroundingTowns = locationInfo.surroundingTowns || "Pohodlná dostupnost pro rodiny z Uherského Hradiště, Starého Města, Kunovic a okolí • Online pro celou ČR.";
const hours = contact.hours || "Pondělí – Pátek: 8:00 – 19:00";
const guaranteeTitle = contact.guaranteeTitle || "1. ukázková lekce je 100% ZDARMA";
const guaranteeDesc = contact.guaranteeDesc || "Dítě si přijde nezávazně vyzkoušet deskovky a atmosféru v malé skupince (4–8 dětí). Žádné platby předem ani skryté závazky. Rozhodnete se až po lekci!";
const formBadge = contact.formBadge || "🎁 1. LEKCE 100% ZDARMA";
const formBadgeNote = contact.formBadgeNote || "Nezávazná přihláška";
const formTitle = contact.formTitle || "Rezervace ukázkové lekce hrou";
const formSubtitle = contact.formSubtitle || "Vyplňte krátký formulář a Josef se vám ozve s návrhem volných dnů v doučovně v Uherském Hradišti.";
const submitButtonText = contact.submitButtonText || "🎁 Rezervovat 1. lekci ZDARMA";
const securityNote = contact.securityNote || "🔒 Vaše kontaktní údaje jsou v naprostém bezpečí a slouží pouze k domluvě úvodní lekce.";
const web3formsKey = contact.web3formsKey || import.meta.env.PUBLIC_WEB3FORMS_KEY || "f49fa95f-e8a5-4b5b-b462-11980de8d1bc";
---

<section id="kontakt" class="py-8 sm:py-12 md:py-16 relative bg-[#FAF7F2] border-t border-parchment-300 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-6 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-xs font-extrabold uppercase tracking-wider text-amber-950" data-tina-field={tinaField(contact, 'badge')} data-edit-key="contact.badge" data-edit-label="Štítek kontaktu">
        <span>🎁</span> <span>{badge}</span>
      </div>
      <h2 class="font-academy font-black text-2xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight" data-tina-field={tinaField(contact, 'title')} data-edit-key="contact.title" data-edit-label="Nadpis kontaktu">
        {title}
      </h2>
      <p class="text-espresso-800/80 text-base sm:text-lg" data-tina-field={tinaField(contact, 'subtitle')} data-edit-key="contact.subtitle" data-edit-label="Podnadpis kontaktu">
        {subtitle}
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- Left Column: Direct Contact Info & Location Card -->
      <div class="lg:col-span-5 space-y-5">
        
        <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-amber-300/80 shadow-soft-lg space-y-5">
          <div class="flex items-center gap-3.5 pb-4 border-b border-parchment-200">
            <ParrotLogo className="w-13 h-13" />
            <div>
              <h3 class="font-heading font-black text-xl text-espresso-950 leading-tight" data-tina-field={tinaField(contact, 'tutorName')} data-edit-key="contact.tutorName" data-edit-label="Jméno lektora">
                {tutorName}
              </h3>
              <p class="text-xs text-stone-600 font-semibold" data-tina-field={tinaField(contact, 'tutorCredentials')} data-edit-key="contact.tutorCredentials" data-edit-label="Titul a zkušenosti">{tutorCredentials}</p>
              <p class="text-[11px] text-amber-800 font-bold" data-tina-field={tinaField(contact, 'tutorRole')} data-edit-key="contact.tutorRole" data-edit-label="Doučovna">{tutorRole}</p>
            </div>
          </div>

          <p class="text-sm text-espresso-800/90 leading-relaxed font-normal" data-tina-field={tinaField(contact, 'introText')} data-edit-key="contact.introText" data-edit-label="Úvodní text">
            {introText}
          </p>

          <div class="space-y-3 pt-1">
            <!-- Phone / SMS -->
            <a href={`tel:${phone}`} class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-parchment-50 border border-parchment-300 hover:border-amber-400 hover:bg-amber-50/50 transition-all group">
              <div class="w-11 h-11 rounded-xl bg-amber-400 text-espresso-950 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">
                📞
              </div>
              <div>
                <div class="text-[10px] text-stone-500 font-bold uppercase tracking-wider">Telefon / SMS</div>
                <div class="font-heading font-black text-base text-espresso-950 group-hover:text-amber-800 transition-colors" data-tina-field={tinaField(contact, 'phoneFormatted')} data-edit-key="contact.phoneFormatted" data-edit-label="Telefonní číslo">
                  {phoneFormatted}
                </div>
              </div>
            </a>

            <!-- WhatsApp -->
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 hover:border-emerald-400 hover:bg-emerald-100/60 transition-all group">
              <div class="w-11 h-11 rounded-xl bg-emerald-500 text-white flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">
                💬
              </div>
              <div>
                <div class="text-[10px] text-emerald-800 font-bold uppercase tracking-wider">WhatsApp chat (Okamžitá odpověď)</div>
                <div class="font-heading font-black text-base text-emerald-950 group-hover:underline" data-tina-field={tinaField(contact, 'whatsappText')} data-edit-key="contact.whatsappText" data-edit-label="WhatsApp text">
                  {whatsappText}
                </div>
              </div>
            </a>

            <!-- E-mail -->
            <a href={`mailto:${email}`} class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-parchment-50 border border-parchment-300 hover:border-amber-400 hover:bg-amber-50/50 transition-all group">
              <div class="w-11 h-11 rounded-xl bg-parchment-200 text-espresso-950 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">
                ✉️
              </div>
              <div>
                <div class="text-[10px] text-stone-500 font-bold uppercase tracking-wider">E-mailová adresa</div>
                <div class="font-heading font-bold text-sm sm:text-base text-espresso-950 group-hover:text-amber-800 transition-colors break-all" data-tina-field={tinaField(contact, 'email')} data-edit-key="contact.email" data-edit-label="E-mail">
                  {email}
                </div>
              </div>
            </a>

            <!-- Physical Location in Uherské Hradiště -->
            <div class="p-4 rounded-2xl bg-parchment-50 border border-parchment-300 space-y-2.5 text-xs text-espresso-900">
              <div class="flex items-start gap-2.5">
                <span class="text-base flex-shrink-0">📍</span>
                <div>
                  <strong>Místo doučovny:</strong> <span data-tina-field={tinaField(contact, 'location')} data-edit-key="contact.location" data-edit-label="Místo doučovny">{location}</span>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-base flex-shrink-0">🚗</span>
                <div>
                  <strong>Parkování:</strong> <span data-tina-field={tinaField(locationInfo, 'parkingInfo')}>{parkingInfo}</span>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-base flex-shrink-0">🕒</span>
                <div>
                  <strong>Otevírací doba:</strong> <span data-tina-field={tinaField(contact, 'hours')} data-edit-key="contact.hours" data-edit-label="Otevírací doba">{hours}</span>
                </div>
              </div>
              <div class="pt-1.5 pl-6 flex flex-wrap gap-3">
                <a
                  href="https://maps.google.com/?q=R%C5%AF%C5%BEov%C3%A1+1238,+Uhersk%C3%A9+Hradi%C5%A1t%C4%9B"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-amber-900 hover:text-amber-700 font-black underline flex items-center gap-1"
                >
                  <span>Google Mapy</span>
                  <span>↗</span>
                </a>
                <span class="text-stone-300">•</span>
                <a
                  href="https://mapy.cz/zakladni?q=R%C5%AF%C5%BEov%C3%A1%201238%2C%20Uhersk%C3%A9%20Hradi%C5%A1t%C4%9B"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-amber-900 hover:text-amber-700 font-black underline flex items-center gap-1"
                >
                  <span>Mapy.cz</span>
                  <span>↗</span>
                </a>
              </div>
              <div class="pt-2 border-t border-parchment-200 text-[11px] text-stone-600" data-tina-field={tinaField(locationInfo, 'surroundingTowns')}>
                🏘️ {surroundingTowns}
              </div>
            </div>

          </div>
        </div>

        <!-- 100% Free Lesson Guarantee Card -->
        <div class="p-5 rounded-2xl bg-amber-100/80 border border-amber-300 shadow-xs flex items-start gap-3.5">
          <span class="text-3xl">🎁</span>
          <div>
            <h4 class="font-heading font-black text-sm text-espresso-950" data-tina-field={tinaField(contact, 'guaranteeTitle')} data-edit-key="contact.guaranteeTitle" data-edit-label="Garance nadpis">{guaranteeTitle}</h4>
            <p class="text-xs text-espresso-900 mt-1 leading-relaxed" data-tina-field={tinaField(contact, 'guaranteeDesc')} data-edit-key="contact.guaranteeDesc" data-edit-label="Garance popis">
              {guaranteeDesc}
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Conversion Reservation Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-6 sm:p-8 md:p-10 border-2 border-amber-300/80 shadow-soft-lg relative">
          
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-400 text-espresso-950" data-tina-field={tinaField(contact, 'formBadge')} data-edit-key="contact.formBadge" data-edit-label="Formulář - štítek">
              {formBadge}
            </span>
            <span class="text-xs text-stone-500 font-bold" data-tina-field={tinaField(contact, 'formBadgeNote')} data-edit-key="contact.formBadgeNote" data-edit-label="Formulář - poznámka ke štítku">{formBadgeNote}</span>
          </div>
          <h3 class="font-academy font-black text-2xl sm:text-3xl text-espresso-950 mb-1" data-tina-field={tinaField(contact, 'formTitle')} data-edit-key="contact.formTitle" data-edit-label="Formulář - nadpis">
            {formTitle}
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 mb-6 font-normal" data-tina-field={tinaField(contact, 'formSubtitle')} data-edit-key="contact.formSubtitle" data-edit-label="Formulář - podnadpis">
            {formSubtitle}
          </p>

          <form id="contact-form" class="space-y-4 sm:space-y-5" data-access-key={web3formsKey}>
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <!-- Row 1: Segment Choice -->
            <div>
              <label for="segment-select" class="block text-xs font-black uppercase tracking-wider text-espresso-950 mb-2">
                O jaký program máte zájem? <span class="text-red-500">*</span>
              </label>
              <select
                id="segment-select"
                name="segment"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 font-bold focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm"
              >
                <option value="Děti na ZŠ (Výuka hrou v malé skupince 4–8 dětí) – 1. LEKCE ZDARMA" selected>
                  🎲 Děti na ZŠ (Skupinka 4–8 dětí hrou) – 1. LEKCE 100% ZDARMA [Otevřeno]
                </option>
                <option value="Dospělí & Konverzace [Brzy – Čekací listina]">
                  💼 Angličtina pro dospělé [Přednostní čekací listina]
                </option>
                <option value="Středoškoláci & Maturita [Brzy – Čekací listina]">
                  🎓 Střední škola a maturita [Přednostní čekací listina]
                </option>
                <option value="SCIO testy & Přijímačky na SŠ [Brzy – Čekací listina]">
                  📐 SCIO testy & Přijímačky na SŠ [Přednostní čekací listina]
                </option>
              </select>
            </div>

            <!-- Row 1b: Teaching Format Selector (Osobně v doučovně vs. Online) -->
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-espresso-950 mb-2">
                Kde chcete, aby výuka probíhala? <span class="text-red-500">*</span>
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-2.5" id="forma-radios">
                <label class="forma-option relative flex items-center gap-2.5 p-3 rounded-xl border-2 border-amber-500 bg-amber-50 cursor-pointer transition-all shadow-2xs">
                  <input type="radio" name="forma" value="Osobně v doučovně (Uherské Hradiště)" checked class="text-amber-600 focus:ring-amber-400" />
                  <div class="text-left">
                    <div class="font-heading font-black text-xs text-espresso-950">🏡 Osobně v UH</div>
                    <div class="text-[10px] text-stone-600">Růžová 1238</div>
                  </div>
                </label>

                <label class="forma-option relative flex items-center gap-2.5 p-3 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/40 cursor-pointer transition-all">
                  <input type="radio" name="forma" value="Online z domova (Google Meet)" class="text-amber-600 focus:ring-amber-400" />
                  <div class="text-left">
                    <div class="font-heading font-black text-xs text-espresso-950">💻 Online</div>
                    <div class="text-[10px] text-stone-600">Z domova (celá ČR)</div>
                  </div>
                </label>

                <label class="forma-option relative flex items-center gap-2.5 p-3 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/40 cursor-pointer transition-all">
                  <input type="radio" name="forma" value="Ještě nevím / Nechám si poradit" class="text-amber-600 focus:ring-amber-400" />
                  <div class="text-left">
                    <div class="font-heading font-black text-xs text-espresso-950">🔄 Ještě nevím</div>
                    <div class="text-[10px] text-stone-600">Poradím se s Josefem</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Row 2: Parent Name and Child Name -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
                  Jméno rodiče <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="např. Alena Nováková"
                  class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm font-medium"
                />
              </div>

              <div>
                <label for="child-name" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
                  Jméno a věk dítěte <span class="text-stone-400 text-[10px]">(např. Tomáš, 10 let)</span>
                </label>
                <input
                  type="text"
                  id="child-name"
                  name="child_name"
                  placeholder="např. Tomáš, 10 let (4. třída)"
                  class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm font-medium"
                />
              </div>
            </div>

            <!-- Row 3: Phone & Email with Smart Formatting and Micro-interactions -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
                  Telefonní číslo <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    autocomplete="tel"
                    placeholder="+420 777 000 000"
                    class="w-full px-4 py-3 pr-10 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-400/20 transition-all text-base sm:text-sm font-medium"
                  />
                  <span id="phone-valid-icon" class="absolute right-3.5 top-3 text-base text-emerald-600 font-black hidden">✓</span>
                </div>
                <div id="phone-feedback" class="text-[11px] mt-1.5 min-h-[16px] transition-all"></div>
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
                  E-mailová adresa <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="alena.novakova@email.cz"
                    class="w-full px-4 py-3 pr-10 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-400/20 transition-all text-base sm:text-sm font-medium"
                  />
                  <span id="email-valid-icon" class="absolute right-3.5 top-3 text-base text-emerald-600 font-black hidden">✓</span>
                </div>
                <div id="email-feedback" class="text-[11px] mt-1.5 min-h-[16px] transition-all"></div>
              </div>
            </div>

            <!-- Row 4: Grade Level -->
            <div>
              <label for="level" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
                Třída / Současná úroveň <span class="text-stone-400 text-[10px] font-normal">(pro výběr her a party vrstevníků)</span>
              </label>
              <select
                id="level"
                name="level"
                class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 font-medium focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm"
              >
                <option value="ZŠ 1. stupeň (1.–3. třída)">ZŠ 1. stupeň (1.–3. třída) – Malí objevitelé & deskovky</option>
                <option value="ZŠ 2. stupeň (4.–6. třída)" selected>ZŠ 2. stupeň (4.–6. třída) – Dobrodruzi & Karak</option>
                <option value="ZŠ 2. stupeň (7.–9. třída)">ZŠ 2. stupeň (7.–9. třída) – Mladí stratégové & Příprava na SŠ</option>
                <option value="Střední škola / Maturita">Střední škola / Maturita [Přednostní čekací listina]</option>
                <option value="Dospělý začátečník / Konverzace">Dospělý / Konverzace [Přednostní čekací listina]</option>
                <option value="SCIO přijímačky">SCIO přijímačky 5. / 9. třída [Přednostní čekací listina]</option>
              </select>
            </div>

            <!-- Row 4b: Preferred Days Multi-Select -->
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-1 mb-2">
                <label class="block text-xs font-bold uppercase tracking-wider text-espresso-950">
                  Které dny se vám nejvíc hodí? <span class="text-amber-800 text-[11px] font-semibold lowercase">(lze vybrat i více dnů)</span>
                </label>
                <span class="text-[11px] text-stone-500">Čas 14:00–18:00 přizpůsobujeme skupince</span>
              </div>

              <!-- Interactive Days Selector -->
              <input type="hidden" id="preferred-days-input" name="preferred_days" value="Kdykoliv po telefonické domluvě" />
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2" id="days-buttons-grid">
                <button
                  type="button"
                  data-day="Pondělí"
                  class="day-pill py-2.5 px-2 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/50 text-xs font-bold text-espresso-950 text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-0.5"
                >
                  <span class="text-sm font-black">Po</span>
                  <span class="text-[10px] text-stone-500 font-normal">Pondělí</span>
                </button>
                <button
                  type="button"
                  data-day="Úterý"
                  class="day-pill py-2.5 px-2 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/50 text-xs font-bold text-espresso-950 text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-0.5"
                >
                  <span class="text-sm font-black">Út</span>
                  <span class="text-[10px] text-stone-500 font-normal">Úterý</span>
                </button>
                <button
                  type="button"
                  data-day="Středa"
                  class="day-pill py-2.5 px-2 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/50 text-xs font-bold text-espresso-950 text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-0.5"
                >
                  <span class="text-sm font-black">St</span>
                  <span class="text-[10px] text-stone-500 font-normal">Středa</span>
                </button>
                <button
                  type="button"
                  data-day="Čtvrtek"
                  class="day-pill py-2.5 px-2 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/50 text-xs font-bold text-espresso-950 text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-0.5"
                >
                  <span class="text-sm font-black">Čt</span>
                  <span class="text-[10px] text-stone-500 font-normal">Čtvrtek</span>
                </button>
                <button
                  type="button"
                  data-day="Pátek"
                  class="day-pill py-2.5 px-2 rounded-xl border-2 border-parchment-300 bg-parchment-50 hover:border-amber-400 hover:bg-amber-50/50 text-xs font-bold text-espresso-950 text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-0.5"
                >
                  <span class="text-sm font-black">Pá</span>
                  <span class="text-[10px] text-stone-500 font-normal">Pátek</span>
                </button>
                <button
                  type="button"
                  data-day="Kdykoliv"
                  class="day-pill py-2.5 px-2 rounded-xl border-2 border-amber-500 bg-amber-400 text-espresso-950 shadow-xs text-xs font-bold text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-0.5"
                >
                  <span class="text-sm font-black">✨ Vše</span>
                  <span class="text-[10px] text-espresso-900 font-bold">Kdykoliv</span>
                </button>
              </div>
            </div>

            <!-- Row 5: Message -->
            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-espresso-950 mb-1.5">
                Poznámka / S čím potřebujete pomoci?
              </label>
              <textarea
                id="message"
                name="message"
                rows="2"
                placeholder="Dobrý den, potřebovali bychom pomoci s mluvením a přípravou do školy..."
                class="w-full px-4 py-3 rounded-xl bg-parchment-50 border border-parchment-300 text-espresso-950 placeholder-stone-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-colors text-base sm:text-sm resize-none font-medium"
              ></textarea>
            </div>

            <!-- Reassuring 3-Step Micro-Timeline -->
            <div class="p-3 sm:p-3.5 rounded-2xl bg-parchment-100/90 border border-parchment-300/80 space-y-1.5 text-espresso-950">
              <div class="text-[10px] font-black uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
                <span>⏱️</span> <span>Co se stane po odeslání?</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <div class="flex items-start gap-1.5">
                  <span class="w-4 h-4 rounded-full bg-amber-300 text-espresso-950 flex items-center justify-center font-black text-[10px] flex-shrink-0 mt-0.5">1</span>
                  <span class="text-stone-700 text-[11px] leading-tight">Odešlete nezávaznou poptávku (1 min)</span>
                </div>
                <div class="flex items-start gap-1.5">
                  <span class="w-4 h-4 rounded-full bg-amber-300 text-espresso-950 flex items-center justify-center font-black text-[10px] flex-shrink-0 mt-0.5">2</span>
                  <span class="text-stone-700 text-[11px] leading-tight">Josef se vám do 24 h ozve s volnými časy</span>
                </div>
                <div class="flex items-start gap-1.5">
                  <span class="w-4 h-4 rounded-full bg-emerald-500 text-white flex items-center justify-center font-black text-[10px] flex-shrink-0 mt-0.5">3</span>
                  <span class="text-stone-700 text-[11px] leading-tight">Dítě si přijde nezávazně zahrát 1. lekci zdarma</span>
                </div>
              </div>
            </div>

            <!-- Submit Button with Gold Pulse -->
            <button
              type="submit"
              id="submit-button"
              class="btn-gold-pulse w-full inline-flex items-center justify-center gap-3 py-4 px-8 rounded-2xl font-heading font-black text-base text-espresso-950 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 border border-amber-600 disabled:opacity-50 cursor-pointer"
            >
              <span id="button-text" data-tina-field={tinaField(contact, 'submitButtonText')} data-edit-key="contact.submitButtonText" data-edit-label="Text tlačítka">{submitButtonText}</span>
              <svg id="button-icon" class="w-5 h-5 text-espresso-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Status Alerts -->
            <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-sm flex items-center gap-3">
              <span class="text-2xl">✅</span>
              <div>
                <strong>Děkuji za zprávu!</strong> Požadavek jsem přijal a ozvu se vám co nejdříve s návrhem termínu ukázkové lekce zdarma v Uherském Hradišti.
              </div>
            </div>

            <div id="form-error" class="hidden p-4 rounded-xl bg-rose-50 border border-rose-300 text-rose-900 text-sm flex items-center gap-3">
              <span class="text-2xl">⚠️</span>
              <div>
                Omlouvám se, odeslání se nezdařilo. Můžete mi prosím zavolat na {phoneFormatted} nebo napsat přímo na WhatsApp?
              </div>
            </div>

            <p class="text-[11px] text-stone-500 text-center font-medium" data-tina-field={tinaField(contact, 'securityNote')} data-edit-key="contact.securityNote" data-edit-label="Bezpečnostní poznámka">
              {securityNote}
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import confetti from 'canvas-confetti';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-button') as HTMLButtonElement | null;
  const btnText = document.getElementById('button-text');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const segmentSelect = document.getElementById('segment-select') as HTMLSelectElement | null;
  const defaultSubmitText = btnText?.textContent || "🎁 Rezervovat 1. lekci ZDARMA";

  function updateButtonLabel() {
    if (!btnText || !segmentSelect) return;
    if (segmentSelect.value.includes('Čekací listina')) {
      btnText.textContent = "📝 Zapsat se na přednostní čekací listinu";
    } else {
      btnText.textContent = defaultSubmitText;
    }
  }

  segmentSelect?.addEventListener('change', updateButtonLabel);
  updateButtonLabel();

  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  const phoneFeedback = document.getElementById('phone-feedback');
  const phoneValidIcon = document.getElementById('phone-valid-icon');

  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const emailFeedback = document.getElementById('email-feedback');
  const emailValidIcon = document.getElementById('email-valid-icon');

  // Smart Czech phone number auto-formatter (+420 XXX XXX XXX)
  function formatCzechPhone(val: string): { formatted: string; digits: string } {
    let clean = val.replace(/[^\d+]/g, '');
    if (clean.startsWith('+420')) {
      clean = clean.substring(4);
    } else if (clean.startsWith('00420')) {
      clean = clean.substring(5);
    } else if (clean.startsWith('420') && clean.length > 9) {
      clean = clean.substring(3);
    }
    const digitsOnly = clean.replace(/\D/g, '').slice(0, 9);
    
    if (digitsOnly.length === 0) {
      return { formatted: '', digits: '' };
    }

    let res = '+420';
    if (digitsOnly.length > 0) res += ' ' + digitsOnly.substring(0, 3);
    if (digitsOnly.length > 3) res += ' ' + digitsOnly.substring(3, 6);
    if (digitsOnly.length > 6) res += ' ' + digitsOnly.substring(6, 9);
    return { formatted: res, digits: digitsOnly };
  }

  phoneInput?.addEventListener('input', () => {
    if (!phoneInput) return;
    const { formatted, digits } = formatCzechPhone(phoneInput.value);
    phoneInput.value = formatted;

    if (digits.length === 9) {
      if (phoneFeedback) {
        phoneFeedback.innerHTML = '<span class="text-emerald-700 font-bold flex items-center gap-1"><span>✓</span> <span>Platné české číslo</span></span>';
      }
      phoneValidIcon?.classList.remove('hidden');
      phoneInput.classList.remove('border-amber-400', 'border-parchment-300');
      phoneInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
    } else if (digits.length > 0) {
      const remaining = 9 - digits.length;
      if (phoneFeedback) {
        phoneFeedback.innerHTML = `<span class="text-amber-800 font-medium">Zbývá zadat ${remaining} ${remaining === 1 ? 'číslici' : (remaining < 5 ? 'číslice' : 'číslic')}</span>`;
      }
      phoneValidIcon?.classList.add('hidden');
      phoneInput.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-parchment-300');
      phoneInput.classList.add('border-amber-400');
    } else {
      if (phoneFeedback) phoneFeedback.innerHTML = '';
      phoneValidIcon?.classList.add('hidden');
      phoneInput.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-amber-400');
      phoneInput.classList.add('border-parchment-300');
    }
  });

  // Real-time Email validation
  emailInput?.addEventListener('input', () => {
    if (!emailInput) return;
    const val = emailInput.value.trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    if (emailRegex.test(val)) {
      if (emailFeedback) {
        emailFeedback.innerHTML = '<span class="text-emerald-700 font-bold flex items-center gap-1"><span>✓</span> <span>E-mail je v pořádku</span></span>';
      }
      emailValidIcon?.classList.remove('hidden');
      emailInput.classList.remove('border-parchment-300', 'border-amber-400');
      emailInput.classList.add('border-emerald-500', 'bg-emerald-50/20');
    } else if (val.length > 0) {
      if (emailFeedback) {
        emailFeedback.innerHTML = '<span class="text-stone-500">Zadejte prosím platnou adresu (např. jmeno@email.cz)</span>';
      }
      emailValidIcon?.classList.add('hidden');
      emailInput.classList.remove('border-emerald-500', 'bg-emerald-50/20');
      emailInput.classList.add('border-amber-400');
    } else {
      if (emailFeedback) emailFeedback.innerHTML = '';
      emailValidIcon?.classList.add('hidden');
      emailInput.classList.remove('border-emerald-500', 'bg-emerald-50/20', 'border-amber-400');
      emailInput.classList.add('border-parchment-300');
    }
  });

  // Forma vyuky interactive pills
  const formaLabels = document.querySelectorAll<HTMLLabelElement>('.forma-option');
  formaLabels.forEach((lbl) => {
    const radio = lbl.querySelector<HTMLInputElement>('input[type="radio"]');
    radio?.addEventListener('change', () => {
      formaLabels.forEach((l) => {
        l.classList.remove('border-amber-500', 'bg-amber-50', 'shadow-2xs');
        l.classList.add('border-parchment-300', 'bg-parchment-50');
      });
      if (radio.checked) {
        lbl.classList.remove('border-parchment-300', 'bg-parchment-50');
        lbl.classList.add('border-amber-500', 'bg-amber-50', 'shadow-2xs');
      }
    });
  });

  // Preferovane dny v tydnu interactive multi-select pills
  const dayPills = document.querySelectorAll<HTMLButtonElement>('.day-pill');
  const daysHiddenInput = document.getElementById('preferred-days-input') as HTMLInputElement | null;
  const selectedDays = new Set<string>(['Kdykoliv']);

  function updateDaysState() {
    if (!daysHiddenInput) return;
    if (selectedDays.size === 0 || selectedDays.has('Kdykoliv')) {
      daysHiddenInput.value = 'Kdykoliv po telefonické domluvě';
      dayPills.forEach((p) => {
        if (p.dataset.day === 'Kdykoliv') {
          p.classList.remove('border-parchment-300', 'bg-parchment-50');
          p.classList.add('border-amber-500', 'bg-amber-400', 'shadow-xs');
        } else {
          p.classList.remove('border-amber-500', 'bg-amber-400', 'shadow-xs');
          p.classList.add('border-parchment-300', 'bg-parchment-50');
        }
      });
    } else {
      const order = ['Pondělí', 'Úterý', 'Středa', 'Čtvrtek', 'Pátek'];
      const sorted = order.filter((d) => selectedDays.has(d));
      daysHiddenInput.value = sorted.join(', ');
      dayPills.forEach((p) => {
        const d = p.dataset.day;
        if (d && selectedDays.has(d)) {
          p.classList.remove('border-parchment-300', 'bg-parchment-50');
          p.classList.add('border-amber-500', 'bg-amber-400', 'shadow-xs');
        } else {
          p.classList.remove('border-amber-500', 'bg-amber-400', 'shadow-xs');
          p.classList.add('border-parchment-300', 'bg-parchment-50');
        }
      });
    }
  }

  dayPills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const day = btn.dataset.day;
      if (!day) return;

      if (day === 'Kdykoliv') {
        selectedDays.clear();
        selectedDays.add('Kdykoliv');
      } else {
        if (selectedDays.has('Kdykoliv')) {
          selectedDays.delete('Kdykoliv');
        }
        if (selectedDays.has(day)) {
          selectedDays.delete(day);
          if (selectedDays.size === 0) {
            selectedDays.add('Kdykoliv');
          }
        } else {
          selectedDays.add(day);
        }
      }
      updateDaysState();
    });
  });

  function triggerCelebration() {
    try {
      confetti({
        particleCount: 90,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#F59E0B', '#10B981', '#FBBF24', '#2A190F']
      });
      setTimeout(() => {
        confetti({
          particleCount: 50,
          angle: 60,
          spread: 60,
          origin: { x: 0.1, y: 0.7 },
          colors: ['#F59E0B', '#10B981', '#FBBF24']
        });
        confetti({
          particleCount: 50,
          angle: 120,
          spread: 60,
          origin: { x: 0.9, y: 0.7 },
          colors: ['#F59E0B', '#10B981', '#FBBF24']
        });
      }, 250);
    } catch (e) {
      // Graceful fallback
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    // Check phone valid digits length
    if (phoneInput) {
      const digits = phoneInput.value.replace(/\D/g, '').replace(/^420/, '');
      if (digits.length < 9) {
        phoneInput.focus();
        if (phoneFeedback) {
          phoneFeedback.innerHTML = '<span class="text-rose-600 font-bold">⚠️ Zadejte prosím celé 9místné telefonní číslo</span>';
        }
        submitBtn.classList.add('animate-shake');
        setTimeout(() => submitBtn.classList.remove('animate-shake'), 600);
        return;
      }
    }

    submitBtn.disabled = true;
    if (btnText) btnText.textContent = "Odesílám rezervaci...";
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    const formData = new FormData(form);
    const accessKey = form.dataset.accessKey || "";

    try {
      if (accessKey) {
        formData.append("access_key", accessKey);
        const nameVal = (document.getElementById('name') as HTMLInputElement)?.value?.trim();
        formData.append("subject", nameVal ? `Nová poptávka: 1. lekce zdarma – ${nameVal}` : "Nová poptávka 1. lekce zdarma z webu VALEK ACADEMY");
        formData.append("from_name", "VALEK ACADEMY Rezervace");
        
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          form.reset();
          selectedDays.clear();
          selectedDays.add('Kdykoliv');
          updateDaysState();
          if (phoneFeedback) phoneFeedback.innerHTML = '';
          if (emailFeedback) emailFeedback.innerHTML = '';
          phoneValidIcon?.classList.add('hidden');
          emailValidIcon?.classList.add('hidden');
          successBox?.classList.remove('hidden');
          triggerCelebration();
        } else {
          console.error("Web3Forms submission error:", data);
          errorBox?.classList.remove('hidden');
        }
      } else {
        // Fallback for development without key
        await new Promise((resolve) => setTimeout(resolve, 600));
        form.reset();
        selectedDays.clear();
        selectedDays.add('Kdykoliv');
        updateDaysState();
        if (phoneFeedback) phoneFeedback.innerHTML = '';
        if (emailFeedback) emailFeedback.innerHTML = '';
        phoneValidIcon?.classList.add('hidden');
        emailValidIcon?.classList.add('hidden');
        successBox?.classList.remove('hidden');
        triggerCelebration();
      }
    } catch {
      errorBox?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      if (btnText) updateButtonLabel();
    }
  });
</script>
