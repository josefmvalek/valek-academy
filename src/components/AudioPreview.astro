---
import { tinaField } from '@tinacms/astro/tina-field';

interface Phrase {
  [key: string]: any;
  id: string;
  audioFile?: string;
  buttonLabel: string;
  short: string;
  en: string;
  cz: string;
  duration?: number;
}

interface Props {
  className?: string;
  audio?: {
    [key: string]: any;
    title?: string;
    subtitlePrompt?: string;
    phrases?: Phrase[];
  };
  card?: any;
}

const { className = "", audio = {}, card = {} } = Astro.props;

const title = audio.title || "Ukázka rodilé výslovnosti";
const subtitlePrompt = audio.subtitlePrompt || "Poslechněte si ukázku";

const defaultPhrases: Phrase[] = [
  {
    id: "Welcome!",
    audioFile: "/uploads/Welcome-roll-the-dice.mp3",
    buttonLabel: "🇬🇧 👋 „Welcome!“",
    short: "Welcome to Valek Academy!",
    en: "Welcome to Valek Academy! Let's roll the dice and have fun speaking English together!",
    cz: "Vítejte ve Valek Academy! Hoďme kostkou a pojďme si hravě povídat anglicky!",
    duration: 6
  },
  {
    id: "dice",
    audioFile: "/uploads/Let's-roll-the-dice.mp3",
    buttonLabel: "🎲 „Roll the dice!“",
    short: "Let's roll the dice!",
    en: "Let's roll the dice! It's your turn. What board game are we going to play today?",
    cz: "Hoďme kostkou! Jsi na řadě. Jakou deskovou hru si dnes zahrajeme?",
    duration: 7
  },
  {
    id: "No fear",
    audioFile: "/uploads/Never-fear-making-mistakes.mp3",
    buttonLabel: "✨ „Never fear mistakes!“",
    short: "Never fear making mistakes!",
    en: "Never fear making mistakes. In our small team, we learn by laughing and playing!",
    cz: "Z chyb si vůbec nic nedělejte. V naší partě se učíme smíchem a hrou!",
    duration: 7
  },
  {
    id: "Mluvím česky",
    audioFile: "/uploads/Česky-vše-vysvětlím.mp3",
    buttonLabel: "🇨🇿 💡 „Česky vše vysvětlím“",
    short: "Česky vše vysvětlím",
    en: "",
    cz: "Žádný strach milí studenti, česky se krásně domluvíme. Vysvětlení v češtině šetří čas, ale jakmile pokročíte a budete lépe rozumět, budu používat angličtinu víc a víc.",
    duration: 11
  },
  {
    id: "Auf Deutsch o en español",
    audioFile: "/uploads/Auf-Deutsch-o-en-español-2.mp3",
    buttonLabel: "🇩🇪 🇪🇸 „Auf Deutsch o en español“",
    short: "Auf Deutsch o en español",
    en: "Wenn Sie Deutsch sprechen, ist das kein Problem – der Unterricht kann natürlich in Ihrer Muttersprache stattfinden. Y si hablas castellano, no hay problema: la lección puede impartirse, por supuesto, en tu lengua materna.",
    cz: "Pokud mluvíš německy, tak žádný problém – lekce může samozřejmě probíhat v tvém mateřském jazyce. A pokud mluvíš španělsky, rovněž to není problém: lekce může samozřejmě probíhat ve tvém mateřském jazyce.",
    duration: 15
  }
];

const phrases: Phrase[] = (audio.phrases && audio.phrases.length > 0) ? audio.phrases : defaultPhrases;
const firstPhrase = phrases[0] || defaultPhrases[0];

const phrasesMap: Record<string, { en: string; cz: string; short: string; duration: number; audioFile: string; index: number; buttonLabel?: string }> = {};
phrases.forEach((p, idx) => {
  phrasesMap[p.id] = {
    en: p.en,
    cz: p.cz,
    short: p.short,
    duration: p.duration || 7,
    audioFile: p.audioFile || `/uploads/${p.id}.mp3`,
    index: idx,
    buttonLabel: p.buttonLabel
  };
});
---

<div
  class={`bg-gradient-to-br from-[#1A1009] via-[#24170E] to-[#140A04] text-white rounded-2xl p-3.5 sm:p-4 shadow-xl border border-amber-500/30 ring-1 ring-amber-400/20 relative overflow-hidden group w-full max-w-full min-w-0 ${className}`}
  id="audio-preview-box"
  data-phrases={JSON.stringify(phrasesMap)}
  data-tina-field={card.audio ? tinaField(card, 'audio') : undefined}
>
  <!-- Warm ambient glow -->
  <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-amber-500/20 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute top-0 left-1/4 w-28 h-28 bg-emerald-500/10 rounded-full blur-xl pointer-events-none"></div>

  <!-- Header line -->
  <div class="flex items-center justify-between gap-2 mb-3 min-w-0">
    <div class="flex items-center gap-1.5 min-w-0 flex-1">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
      <span class="text-[10px] sm:text-xs font-black uppercase tracking-wider text-amber-300 truncate flex items-center gap-1.5" data-tina-field={audio.title ? tinaField(audio, 'title') : undefined} data-edit-key="hero.card.audio.title" data-edit-label="Nadpis zvuku">
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-400/20 text-xs">🎙️</span>
        <span class="truncate">{title}</span>
      </span>
    </div>
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <!-- Roll the Dice Interactive Button -->
      <button
        type="button"
        id="audio-roll-dice-btn"
        class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-bold bg-amber-400/20 hover:bg-amber-400 text-amber-300 hover:text-espresso-950 border border-amber-400/40 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full cursor-pointer transition-all active:scale-95 shadow-2xs group/dice"
        title="Hodit kostkou a vylosovat náhodnou hlášku lektora"
        aria-label="Hodit kostkou a vylosovat náhodnou hlášku"
      >
        <span class="dice-icon inline-block transition-transform duration-500 text-xs">🎲</span>
        <span class="hidden min-[380px]:inline">Hodit kostkou!</span>
      </button>

      <!-- Edit MP3 button (visible in Visual Editor) -->
      <button
        type="button"
        id="audio-edit-file-btn"
        data-edit-type="audio"
        data-edit-key="hero.card.audio.phrases.0.audioFile"
        data-edit-label={`Nahrávka MP3: ${firstPhrase.buttonLabel}`}
        data-audio-src={firstPhrase.audioFile || `/audio/${firstPhrase.id}.mp3`}
        class="hidden ve-audio-edit-btn items-center gap-1 text-[10px] font-bold bg-amber-400/20 hover:bg-amber-400/30 text-amber-300 border border-amber-400/40 px-2 py-0.5 rounded-full cursor-pointer transition-all"
        title="Změnit nebo nahrát .mp3 soubor nahrávky"
      >
        <span>🎵</span>
        <span class="ve-btn-label">Změnit MP3</span>
      </button>
      <span class="text-[11px] font-mono font-bold text-amber-200/90 bg-white/10 px-2.5 py-0.5 rounded-full border border-white/15 flex-shrink-0" id="audio-time">
        0:06
      </span>
    </div>
  </div>

  <!-- Interactive Phrase Chips (Fast click to hear) -->
  <div class="flex flex-wrap gap-1.5 mb-3 w-full" id="phrase-chips-container">
    {phrases.map((phrase, idx) => (
      <button
        type="button"
        data-phrase={phrase.id}
        class={`phrase-chip ${idx === 0 ? 'active bg-amber-400 text-espresso-950 border-amber-300 hover:bg-amber-300 shadow-xs' : 'bg-white/10 hover:bg-white/20 text-amber-100 border-white/15'} px-3 py-1.5 rounded-lg text-xs font-bold border transition-all cursor-pointer whitespace-nowrap flex items-center justify-center active:scale-95`}
        data-tina-field={audio.phrases ? tinaField(audio, 'phrases', idx) : undefined}
        data-edit-key={`hero.card.audio.phrases.${idx}.buttonLabel`}
        data-edit-label={`Tlačítko ${idx + 1}`}
      >
        {phrase.buttonLabel}
      </button>
    ))}
    <!-- Add new phrase button (visible in Visual Editor) -->
    <button
      type="button"
      id="ve-add-phrase-btn"
      class="hidden ve-add-phrase-chip items-center gap-1 bg-amber-400/10 hover:bg-amber-400/20 text-amber-300 border border-dashed border-amber-400/50 px-2.5 py-1.5 rounded-lg text-xs font-bold cursor-pointer transition-all active:scale-95"
      title="Přidat novou zvukovou frázi"
    >
      <span>➕</span>
      <span>Přidat frázi</span>
    </button>
  </div>

  <!-- Main interactive player row -->
  <div class="flex items-center gap-3 bg-black/40 p-2.5 rounded-xl border border-white/10 min-w-0">
    <!-- Play / Stop Button -->
    <button
      id="audio-play-btn"
      type="button"
      aria-label="Přehrát mluvenou ukázku pana Válka s rodilou výslovností"
      class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-espresso-950 flex items-center justify-center shadow-gold-glow transition-all duration-300 hover:scale-105 active:scale-95 flex-shrink-0 cursor-pointer border border-amber-300 group-hover:border-white/50"
    >
      <!-- Play Icon -->
      <svg id="audio-play-icon" class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <!-- Pause/Stop Icon (hidden initially) -->
      <svg id="audio-pause-icon" class="w-5 h-5 hidden fill-current" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>

    <!-- Visual Equalizer Waves & Speech Subtitles -->
    <div class="flex-grow min-w-0 space-y-1">
      <!-- Equalizer Bars -->
      <div class="flex items-center gap-1 sm:gap-1.5 h-5 sm:h-6">
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-2.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-3.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-6 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-2.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400/50 h-4 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-stone-600 h-2 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-stone-600 h-1.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-stone-600 h-3 transition-all"></span>
      </div>

      <!-- Spoken text subtitle -->
      <p class="text-[11px] sm:text-xs text-amber-100 font-medium leading-snug" id="audio-subtitle" data-tina-field={audio.subtitlePrompt ? tinaField(audio, 'subtitlePrompt') : undefined}>
        <strong class="text-amber-300">„{firstPhrase.short}“</strong> <span class="text-amber-200/60">–</span> <span class="text-stone-300">{subtitlePrompt}</span>
      </p>
    </div>
  </div>

  <!-- Live Speech Translation Bubble -->
  <div id="audio-speech-card" class="mt-2.5 pt-2.5 border-t border-white/10 text-xs space-y-1.5 transition-all min-w-0 overflow-hidden">
    <div id="speech-live-en-row" class={`flex items-start gap-2 text-stone-200 leading-snug min-w-0 ${!firstPhrase.en ? 'hidden' : ''}`}>
      <span class="text-amber-400 font-bold flex-shrink-0 text-xs">🗣️ AJ:</span>
      <span id="speech-live-text" class="text-amber-100 font-medium italic break-words min-w-0 text-xs" data-tina-field={firstPhrase ? tinaField(firstPhrase, 'en') : undefined} data-edit-key="hero.card.audio.phrases.0.en" data-edit-label="Anglická věta">
        {firstPhrase.en ? `„${firstPhrase.en}“` : ''}
      </span>
    </div>
    <div id="speech-live-cz-row" class="flex items-start gap-2 text-stone-400 text-[11px] leading-snug min-w-0">
      <span class="text-emerald-400 font-bold flex-shrink-0 text-xs">🇨🇿 CZ:</span>
      <span id="speech-czech-text" class="text-stone-300 break-words min-w-0" data-tina-field={firstPhrase ? tinaField(firstPhrase, 'cz') : undefined} data-edit-key="hero.card.audio.phrases.0.cz" data-edit-label="Český překlad">
        „{firstPhrase.cz}“
      </span>
    </div>
  </div>
  <!-- Hidden HTML5 Audio Element for real voice samples -->
  <audio id="native-audio" preload="auto" class="hidden"></audio>
</div>

<script>
  (() => {
    let isPlaying = false;
    let timerInterval: any = null;
    let secondsRemaining = 6;
    let activePhraseKey = '';

    let defaultPhrases: Record<string, { en: string; cz: string; short: string; duration: number; audioFile: string; index: number; buttonLabel?: string }> = {
      "Welcome!": {
        en: "Welcome to Valek Academy! Let's roll the dice and have fun speaking English together!",
        cz: "Vítejte ve Valek Academy! Hoďme kostkou a pojďme si hravě povídat anglicky!",
        short: "Welcome to Valek Academy!",
        duration: 6,
        audioFile: "/uploads/Welcome-roll-the-dice.mp3",
        index: 0
      },
      "dice": {
        en: "Let's roll the dice! It's your turn. What board game are we going to play today?",
        cz: "Hoďme kostkou! Jsi na řadě. Jakou deskovou hru si dnes zahrajeme?",
        short: "Let's roll the dice!",
        duration: 7,
        audioFile: "/uploads/Let's-roll-the-dice.mp3",
        index: 1
      },
      "No fear": {
        en: "Never fear making mistakes. In our small team, we learn by laughing and playing!",
        cz: "Z chyb si vůbec nic nedělejte. V naší partě se učíme smíchem a hrou!",
        short: "Never fear making mistakes!",
        duration: 7,
        audioFile: "/uploads/Never-fear-making-mistakes.mp3",
        index: 2
      },
      "Mluvím česky": {
        en: "",
        cz: "Žádný strach milí studenti, česky se krásně domluvíme. Vysvětlení v češtině šetří čas, ale jakmile pokročíte a budete lépe rozumět, budu používat angličtinu víc a víc.",
        short: "Česky vše vysvětlím",
        duration: 11,
        audioFile: "/uploads/Česky-vše-vysvětlím.mp3",
        index: 3
      },
      "Auf Deutsch o en español": {
        en: "Wenn Sie Deutsch sprechen, ist das kein Problem – der Unterricht kann natürlich in Ihrer Muttersprache stattfinden. Y si hablas castellano, no hay problema: la lección puede impartirse, por supuesto, en tu lengua materna.",
        cz: "Pokud mluvíš německy, tak žádný problém – lekce může samozřejmě probíhat v tvém mateřském jazyce. A pokud mluvíš španělsky, rovněž to není problém: lekce může samozřejmě probíhat ve tvém mateřském jazyce.",
        short: "Auf Deutsch o en español",
        duration: 15,
        audioFile: "/uploads/Auf-Deutsch-o-en-español-2.mp3",
        index: 4
      }
    };

    function getPhrases() {
      const previewBox = document.getElementById('audio-preview-box');
      if (previewBox?.dataset.phrases) {
        try {
          const parsed = JSON.parse(previewBox.dataset.phrases);
          if (parsed && Object.keys(parsed).length > 0) {
            return parsed;
          }
        } catch (e) {}
      }
      return defaultPhrases;
    }

    function initActivePhraseKey() {
      if (activePhraseKey) return;
      const activeChip = document.querySelector<HTMLButtonElement>('.phrase-chip.active') || document.querySelector<HTMLButtonElement>('.phrase-chip');
      if (activeChip && activeChip.getAttribute('data-phrase')) {
        activePhraseKey = activeChip.getAttribute('data-phrase')!;
      } else {
        const phrases = getPhrases();
        activePhraseKey = Object.keys(phrases)[0] || 'Welcome!';
      }
    }

    function getCurrentPhraseData() {
      initActivePhraseKey();
      const phrases = getPhrases();
      if (activePhraseKey && phrases[activePhraseKey]) {
        return phrases[activePhraseKey];
      }
      const firstKey = Object.keys(phrases)[0];
      if (firstKey && phrases[firstKey]) {
        activePhraseKey = firstKey;
        return phrases[firstKey];
      }
      return defaultPhrases["Welcome!"];
    }

    function updateEditButton() {
      const editBtn = document.getElementById('audio-edit-file-btn');
      if (!editBtn) return;
      const currentData = getCurrentPhraseData();
      const idx = currentData.index ?? 0;
      editBtn.setAttribute('data-edit-key', `hero.card.audio.phrases.${idx}.audioFile`);
      editBtn.setAttribute('data-edit-label', `Hlasová nahrávka MP3: ${currentData.short || activePhraseKey}`);
      editBtn.setAttribute('data-audio-src', currentData.audioFile || '');
    }

    function syncChipsUI() {
      initActivePhraseKey();
      const phraseChips = document.querySelectorAll<HTMLButtonElement>('.phrase-chip');
      phraseChips.forEach((c) => {
        const key = c.getAttribute('data-phrase');
        const isCurrent = key === activePhraseKey;
        c.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          c.classList.remove('bg-white/10', 'text-amber-100', 'border-white/15');
          c.classList.add('bg-amber-400', 'text-espresso-950', 'border-amber-300', 'shadow-xs');
        } else {
          c.classList.remove('bg-amber-400', 'text-espresso-950', 'border-amber-300', 'shadow-xs');
          c.classList.add('bg-white/10', 'text-amber-100', 'border-white/15');
        }
      });
      updateEditButton();
    }

    function playAudioFile() {
      const nativeAudio = document.getElementById('native-audio') as HTMLAudioElement | null;
      if (!nativeAudio) return;

      const currentData = getCurrentPhraseData();
      const audioSrc = currentData.audioFile;
      if (!audioSrc) {
        stopAudio();
        return;
      }

      nativeAudio.src = audioSrc;

      nativeAudio.onloadedmetadata = () => {
        if (nativeAudio.duration && !isNaN(nativeAudio.duration)) {
          secondsRemaining = Math.round(nativeAudio.duration);
          const timeDisplay = document.getElementById('audio-time');
          if (timeDisplay) {
            timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;
          }
        }
      };

      nativeAudio.oncanplay = () => {
        if (!isPlaying) return;
        if (nativeAudio.paused) {
          nativeAudio.play().catch(() => stopAudio());
        }
      };
      nativeAudio.ontimeupdate = () => {
        if (!nativeAudio.duration || isNaN(nativeAudio.duration)) return;
        const remaining = Math.max(0, Math.ceil(nativeAudio.duration - nativeAudio.currentTime));
        const timeDisplay = document.getElementById('audio-time');
        if (timeDisplay) {
          timeDisplay.textContent = `0:${remaining.toString().padStart(2, '0')}`;
        }
      };
      nativeAudio.onended = () => stopAudio();
      nativeAudio.onerror = () => {
        stopAudio();
      };
      nativeAudio.load();
      const playPromise = nativeAudio.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          // If browser is buffering, oncanplay listener will trigger playback
        });
      }
    }

    window.addEventListener('ve-audio-updated', ((e: CustomEvent) => {
      const { key, newUrl } = e.detail || {};
      const previewBox = document.getElementById('audio-preview-box');
      if (previewBox && key && newUrl) {
        try {
          const p = getPhrases();
          const match = key.match(/phrases\.(\d+)\.audioFile/);
          if (match) {
            const phraseIdx = parseInt(match[1], 10);
            const phraseKey = Object.keys(p).find(k => p[k].index === phraseIdx) || Object.keys(p)[phraseIdx];
            if (phraseKey && p[phraseKey]) {
              p[phraseKey].audioFile = newUrl;
              previewBox.dataset.phrases = JSON.stringify(p);
              updateEditButton();
              if (activePhraseKey === phraseKey) {
                stopAudio();
              }
            }
          }
        } catch (err) {}
      }
    }) as EventListener);

    function setPlayingState(playing: boolean) {
      isPlaying = playing;
      const currentData = getCurrentPhraseData();

      const playIcon = document.getElementById('audio-play-icon');
      const pauseIcon = document.getElementById('audio-pause-icon');
      const bars = document.querySelectorAll('.sound-wave-bar');
      const subtitle = document.getElementById('audio-subtitle');
      const timeDisplay = document.getElementById('audio-time');
      const nativeAudio = document.getElementById('native-audio') as HTMLAudioElement | null;

      if (playing) {
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');

        bars.forEach((bar, index) => {
          bar.classList.remove('h-2', 'h-4', 'h-3', 'h-5', 'h-1.5', 'bg-stone-600', 'bg-amber-400/50');
          bar.classList.add('bg-amber-400');
          const waveClass = `animate-wave-${(index % 4) + 1}`;
          bar.classList.add(waveClass);
        });

        if (subtitle) {
          subtitle.innerHTML = `<span class="text-emerald-400 font-bold animate-pulse">● Hraje:</span> <strong class="text-white">„${currentData.short}“</strong>`;
        }

        secondsRemaining = currentData.duration || 6;
        if (timeDisplay) timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;

        playAudioFile();

        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
          if (nativeAudio && !nativeAudio.paused && nativeAudio.duration) return;
          secondsRemaining--;
          if (secondsRemaining <= 0) {
            stopAudio();
            return;
          }
          if (timeDisplay) {
            timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;
          }
        }, 1000);
      } else {
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');

        bars.forEach((bar, index) => {
          bar.classList.remove('animate-wave-1', 'animate-wave-2', 'animate-wave-3', 'animate-wave-4');
          if (index > 5) {
            bar.classList.add('bg-stone-600');
          } else {
            bar.classList.add('bg-amber-400');
          }
        });

        if (subtitle) {
          subtitle.innerHTML = `<strong class="text-amber-300">„${currentData.short}“</strong> <span class="text-amber-200/60">–</span> <span class="text-stone-300">Poslechněte si ukázku</span>`;
        }

        clearInterval(timerInterval);
        if (nativeAudio) {
          nativeAudio.pause();
          nativeAudio.currentTime = 0;
        }
      }
    }

    function stopAudio() {
      setPlayingState(false);
      const currentData = getCurrentPhraseData();
      secondsRemaining = currentData.duration || 6;
      const timeDisplay = document.getElementById('audio-time');
      if (timeDisplay) timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;
      const nativeAudio = document.getElementById('native-audio') as HTMLAudioElement | null;
      if (nativeAudio) {
        nativeAudio.pause();
        nativeAudio.currentTime = 0;
      }
    }

    function addNewPhrase() {
      const previewBox = document.getElementById('audio-preview-box');
      const chipsContainer = document.getElementById('phrase-chips-container');
      const addBtn = document.getElementById('ve-add-phrase-btn');
      if (!previewBox || !chipsContainer || !addBtn) return;

      const p = getPhrases();
      const currentKeys = Object.keys(p);
      const newIdx = currentKeys.length;
      const newId = `phrase_${newIdx + 1}`;
      
      const newPhraseData = {
        id: newId,
        buttonLabel: `🎲 „Fráze ${newIdx + 1}“`,
        short: `Nová fráze ${newIdx + 1}`,
        en: "Welcome to our game! Let's roll the dice and speak English together.",
        cz: "Vítejte u naší hry! Hoďme kostkou a pojďme si povídat anglicky.",
        duration: 6,
        audioFile: "/uploads/Welcome-roll-the-dice.mp3",
        index: newIdx
      };

      p[newId] = newPhraseData;
      previewBox.dataset.phrases = JSON.stringify(p);

      // Create new button element in DOM
      const newBtn = document.createElement('button');
      newBtn.type = 'button';
      newBtn.setAttribute('data-phrase', newId);
      newBtn.className = 'phrase-chip px-3 py-1.5 rounded-lg text-xs font-bold border transition-all cursor-pointer whitespace-nowrap flex items-center justify-center active:scale-95 bg-white/10 hover:bg-white/20 text-amber-100 border-white/15';
      newBtn.setAttribute('data-edit-key', `hero.card.audio.phrases.${newIdx}.buttonLabel`);
      newBtn.setAttribute('data-edit-label', `Tlačítko ${newIdx + 1}`);
      newBtn.textContent = newPhraseData.buttonLabel;

      chipsContainer.insertBefore(newBtn, addBtn);

      // Switch active phrase to the new one
      activePhraseKey = newId;
      syncChipsUI();

      const liveText = document.getElementById('speech-live-text');
      const liveTextCz = document.getElementById('speech-czech-text');
      const subtitle = document.getElementById('audio-subtitle');
      if (liveText) {
        liveText.textContent = `„${newPhraseData.en}“`;
        liveText.setAttribute('data-edit-key', `hero.card.audio.phrases.${newIdx}.en`);
        liveText.setAttribute('data-edit-label', `Anglická věta (${newPhraseData.short})`);
      }
      if (liveTextCz) {
        liveTextCz.textContent = `„${newPhraseData.cz}“`;
        liveTextCz.setAttribute('data-edit-key', `hero.card.audio.phrases.${newIdx}.cz`);
        liveTextCz.setAttribute('data-edit-label', `Český překlad (${newPhraseData.short})`);
      }
      if (subtitle) {
        subtitle.innerHTML = `<strong class="text-amber-300">„${newPhraseData.short}“</strong> <span class="text-amber-200/60">–</span> <span class="text-emerald-400 font-bold">Nová fráze vytvořena</span>`;
      }

      window.dispatchEvent(new CustomEvent('ve-phrase-created', { detail: { phrase: newPhraseData, index: newIdx } }));
    }

    function selectAndPlayPhrase(key: string) {
      activePhraseKey = key;
      syncChipsUI();

      const data = getCurrentPhraseData();
      const liveText = document.getElementById('speech-live-text');
      const liveEnRow = document.getElementById('speech-live-en-row');
      const liveTextCz = document.getElementById('speech-czech-text');
      const subtitle = document.getElementById('audio-subtitle');
      if (liveText) {
        if (!data.en || data.en.trim() === '') {
          liveEnRow?.classList.add('hidden');
        } else {
          liveEnRow?.classList.remove('hidden');
          liveText.textContent = `„${data.en}“`;
        }
        liveText.setAttribute('data-edit-key', `hero.card.audio.phrases.${data.index}.en`);
        liveText.setAttribute('data-edit-label', `Anglická věta (${data.short || data.buttonLabel})`);
      }
      if (liveTextCz) {
        liveTextCz.textContent = `„${data.cz}“`;
        liveTextCz.setAttribute('data-edit-key', `hero.card.audio.phrases.${data.index}.cz`);
        liveTextCz.setAttribute('data-edit-label', `Český překlad (${data.short || data.buttonLabel})`);
      }
      if (subtitle) {
        subtitle.innerHTML = `<span class="text-emerald-400 font-bold animate-pulse">● Hraje:</span> <strong class="text-white">„${data.short}“</strong>`;
      }

      const activeChip = document.querySelector<HTMLButtonElement>(`.phrase-chip[data-phrase="${key}"]`);
      if (activeChip && typeof activeChip.scrollIntoView === 'function') {
        activeChip.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      }

      stopAudio();
      setPlayingState(true);
    }

    let lastHandledTime = 0;
    function handleAudioInteraction(e: Event) {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const addPhraseBtn = target.closest<HTMLButtonElement>('#ve-add-phrase-btn');
      if (addPhraseBtn) {
        addNewPhrase();
        return;
      }

      const diceBtn = target.closest<HTMLButtonElement>('#audio-roll-dice-btn');
      if (diceBtn) {
        const diceIcon = diceBtn.querySelector<HTMLElement>('.dice-icon');
        if (diceIcon) {
          diceIcon.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
          diceIcon.style.transform = 'rotate(720deg) scale(1.35)';
          setTimeout(() => {
            diceIcon.style.transition = '';
            diceIcon.style.transform = '';
          }, 600);
        }

        const phrases = getPhrases();
        const keys = Object.keys(phrases);
        if (keys.length > 0) {
          let candidates = keys.filter(k => k !== activePhraseKey);
          if (candidates.length === 0) candidates = keys;
          const chosenKey = candidates[Math.floor(Math.random() * candidates.length)];
          selectAndPlayPhrase(chosenKey);
        }
        return;
      }

      const chip = target.closest<HTMLButtonElement>('.phrase-chip');
      if (chip) {
        const key = chip.getAttribute('data-phrase') || 'gday';
        selectAndPlayPhrase(key);
        return;
      }

      const playBtn = target.closest<HTMLButtonElement>('#audio-play-btn');
      if (playBtn) {
        if (isPlaying) {
          stopAudio();
        } else {
          setPlayingState(true);
        }
        return;
      }
    }

    document.addEventListener('pointerdown', (e) => {
      lastHandledTime = Date.now();
      handleAudioInteraction(e);
    }, true);

    document.addEventListener('click', (e) => {
      if (Date.now() - lastHandledTime < 350) return;
      handleAudioInteraction(e);
    }, true);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isPlaying) {
        stopAudio();
      }
    });

    // Cleanup audio on navigation away from page
    document.addEventListener('astro:before-swap', () => {
      stopAudio();
      audioObserver.disconnect();
    });
    window.addEventListener('pagehide', stopAudio);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncChipsUI);
    } else {
      syncChipsUI();
    }
    document.addEventListener('astro:page-load', syncChipsUI);

    let lastAudioBox = document.getElementById('audio-preview-box');
    const audioObserver = new MutationObserver(() => {
      const currentBox = document.getElementById('audio-preview-box');
      if (currentBox && currentBox !== lastAudioBox) {
        lastAudioBox = currentBox;
        syncChipsUI();
      }
    });
    audioObserver.observe(document.body, { childList: true, subtree: true });
  })();
</script>
