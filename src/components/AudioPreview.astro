---
import { tinaField } from '@tinacms/astro/tina-field';

interface Phrase {
  [key: string]: any;
  id: string;
  buttonLabel: string;
  short: string;
  en: string;
  cz: string;
  duration?: number;
}

interface Props {
  className?: string;
  audio?: {
    [key: string]: any;
    title?: string;
    subtitlePrompt?: string;
    phrases?: Phrase[];
  };
  card?: any;
}

const { className = "", audio = {}, card = {} } = Astro.props;

const title = audio.title || "Poslech Josefa (Australský akcent)";
const subtitlePrompt = audio.subtitlePrompt || "Klikněte pro přehrání";

const defaultPhrases: Phrase[] = [
  {
    id: "gday",
    buttonLabel: "🦘 „G'day mate!“",
    short: "G'day mate! I'm Josef.",
    en: "G'day, mate! Welcome to Valek Academy. Let's roll the dice and have fun speaking English together!",
    cz: "Ahoj kamaráde! Vítejte ve Valek Academy. Hoďme kostkou a pojďme si hravě povídat anglicky!",
    duration: 10
  },
  {
    id: "dice",
    buttonLabel: "🎲 „Let's roll the dice!“",
    short: "Let's roll the dice!",
    en: "Let's roll the dice! It's your turn. What board game are we going to play today?",
    cz: "Hoďme kostkou! Jsi na řadě. Jakou deskovou hru si dnes zahrajeme?",
    duration: 8
  },
  {
    id: "noworries",
    buttonLabel: "✨ „No worries at all!“",
    short: "No worries at all!",
    en: "No worries at all! Never fear making mistakes. In our small team, we learn by laughing and playing!",
    cz: "Žádný stres! Z chyb si vůbec nic nedělej. V naší partě se učíme smíchem a hrou!",
    duration: 9
  }
];

const phrases: Phrase[] = (audio.phrases && audio.phrases.length > 0) ? audio.phrases : defaultPhrases;
const firstPhrase = phrases[0] || defaultPhrases[0];

const phrasesMap: Record<string, { en: string; cz: string; short: string; duration: number }> = {};
phrases.forEach((p) => {
  phrasesMap[p.id] = {
    en: p.en,
    cz: p.cz,
    short: p.short,
    duration: p.duration || (p.id === 'dice' ? 8 : p.id === 'noworries' ? 9 : 10)
  };
});
---

<div
  class={`bg-gradient-to-br from-espresso-950 via-[#1F120A] to-[#140A05] text-white rounded-2xl p-3 sm:p-5 shadow-xl border-2 border-amber-500/40 relative overflow-hidden group w-full max-w-full min-w-0 ${className}`}
  id="audio-preview-box"
  data-phrases={JSON.stringify(phrasesMap)}
  data-tina-field={card.audio ? tinaField(card, 'audio') : undefined}
>
  <!-- Warm ambient glow -->
  <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-amber-500/20 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute top-0 left-1/4 w-28 h-28 bg-emerald-500/10 rounded-full blur-xl pointer-events-none"></div>

  <!-- Header line -->
  <div class="flex items-center justify-between gap-2 mb-2.5 min-w-0">
    <div class="flex items-center gap-1.5 min-w-0 flex-1">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
      <span class="text-[10px] sm:text-[11px] font-black uppercase tracking-wider text-amber-300 truncate" data-tina-field={audio.title ? tinaField(audio, 'title') : undefined} data-edit-key="hero.card.audio.title" data-edit-label="Nadpis zvuku">
        🇦🇺 {title}
      </span>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono text-amber-200/90 bg-white/10 px-2 py-0.5 rounded-md border border-white/10 flex-shrink-0" id="audio-time">
      0:10
    </span>
  </div>

  <!-- Interactive Phrase Chips (Fast click to hear) -->
  <div class="flex flex-wrap gap-1 sm:gap-1.5 mb-2.5 w-full" id="phrase-chips-container">
    {phrases.map((phrase, idx) => (
      <button
        type="button"
        data-phrase={phrase.id}
        class={`phrase-chip ${idx === 0 ? 'active bg-amber-400 text-espresso-950 border-amber-300 hover:bg-amber-300 shadow-xs' : 'bg-white/10 hover:bg-white/20 text-amber-100 border-white/15'} px-2 sm:px-2.5 py-1 rounded-lg text-[10px] sm:text-[11px] font-bold border transition-all cursor-pointer whitespace-nowrap`}
        data-tina-field={audio.phrases ? tinaField(audio, 'phrases', idx) : undefined}
        data-edit-key={`hero.card.audio.phrases.${idx}.buttonLabel`}
        data-edit-label={`Tlačítko ${idx + 1}`}
      >
        {phrase.buttonLabel}
      </button>
    ))}
  </div>

  <!-- Main interactive player row -->
  <div class="flex items-center gap-2.5 sm:gap-3.5 bg-black/30 p-2 sm:p-2.5 rounded-xl border border-white/10 min-w-0">
    <!-- Play / Stop Button -->
    <button
      id="audio-play-btn"
      type="button"
      aria-label="Přehrát mluvenou ukázku Josefa s australským akcentem"
      class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-b from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-espresso-950 flex items-center justify-center shadow-gold-glow transition-all duration-300 hover:scale-105 active:scale-95 flex-shrink-0 cursor-pointer border border-amber-300 group-hover:border-white/50"
    >
      <!-- Play Icon -->
      <svg id="audio-play-icon" class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <!-- Pause/Stop Icon (hidden initially) -->
      <svg id="audio-pause-icon" class="w-5 h-5 hidden fill-current" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>

    <!-- Visual Equalizer Waves & Speech Subtitles -->
    <div class="flex-grow min-w-0 space-y-0.5 sm:space-y-1">
      <!-- Equalizer Bars -->
      <div class="flex items-center gap-1 sm:gap-1.5 h-5 sm:h-6">
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-2.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-3.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-6 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400 h-2.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-amber-400/50 h-4 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-stone-600 h-2 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-stone-600 h-1.5 transition-all"></span>
        <span class="sound-wave-bar w-1 sm:w-1.5 rounded-full bg-stone-600 h-3 transition-all"></span>
      </div>

      <!-- Spoken text subtitle -->
      <p class="text-[11px] sm:text-xs text-amber-100 font-medium leading-tight truncate" id="audio-subtitle" data-tina-field={audio.subtitlePrompt ? tinaField(audio, 'subtitlePrompt') : undefined}>
        <strong class="text-amber-300">„{firstPhrase.short}“</strong> – {subtitlePrompt}
      </p>
    </div>
  </div>

  <!-- Live Speech Translation Bubble -->
  <div id="audio-speech-card" class="mt-2 pt-2 border-t border-white/10 text-xs space-y-1 transition-all min-w-0 overflow-hidden">
    <div class="flex items-start gap-1.5 sm:gap-2 text-stone-300 leading-relaxed min-w-0">
      <span class="text-amber-400 font-bold flex-shrink-0 text-[10px] sm:text-xs">🗣️ AJ:</span>
      <span id="speech-live-text" class="text-white font-medium italic break-words min-w-0 text-[11px] sm:text-xs" data-tina-field={firstPhrase ? tinaField(firstPhrase, 'en') : undefined} data-edit-key="hero.card.audio.phrases.0.en" data-edit-label="Anglická věta">
        „{firstPhrase.en}“
      </span>
    </div>
    <div class="flex items-start gap-1.5 sm:gap-2 text-stone-400 text-[10px] sm:text-[11px] min-w-0">
      <span class="text-emerald-400 font-bold flex-shrink-0 text-[10px] sm:text-xs">🇨🇿 CZ:</span>
      <span id="speech-czech-text" class="break-words min-w-0" data-tina-field={firstPhrase ? tinaField(firstPhrase, 'cz') : undefined} data-edit-key="hero.card.audio.phrases.0.cz" data-edit-label="Český překlad">
        „{firstPhrase.cz}“
      </span>
    </div>
  </div>
  <!-- Hidden HTML5 Audio Element for real voice samples -->
  <audio id="native-audio" preload="auto" class="hidden"></audio>
</div>

<script>
  const playBtn = document.getElementById('audio-play-btn');
  const playIcon = document.getElementById('audio-play-icon');
  const pauseIcon = document.getElementById('audio-pause-icon');
  const bars = document.querySelectorAll('.sound-wave-bar');
  const timeDisplay = document.getElementById('audio-time');
  const subtitle = document.getElementById('audio-subtitle');
  const liveText = document.getElementById('speech-live-text');
  const nativeAudio = document.getElementById('native-audio') as HTMLAudioElement | null;

  let isPlaying = false;
  let timerInterval: any = null;
  let secondsRemaining = 10;
  let synth: SpeechSynthesis | null = null;
  let audioCtx: AudioContext | null = null;

  if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
    synth = window.speechSynthesis;
  }

  // Play a cheerful chime chord using Web Audio API
  function playWarmChime() {
    try {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      audioCtx = audioCtx || new AudioContextClass();

      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      // Friendly Australian welcome major chord (C4, E4, G4, C5)
      const notes = [261.63, 329.63, 392.00, 523.25];
      notes.forEach((freq, idx) => {
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.08);

        gain.gain.setValueAtTime(0.001, audioCtx.currentTime + idx * 0.08);
        gain.gain.exponentialRampToValueAtTime(0.12, audioCtx.currentTime + idx * 0.08 + 0.04);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.08 + 1.2);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(audioCtx.currentTime + idx * 0.08);
        osc.stop(audioCtx.currentTime + idx * 0.08 + 1.3);
      });
    } catch (e) {
      // Graceful fallback
    }
  }

    const previewBox = document.getElementById('audio-preview-box');
    let phrases: Record<string, { en: string; cz: string; short: string; duration: number }> = {
      gday: {
        en: "G'day, mate! Welcome to Valek Academy. Let's roll the dice and have fun speaking English together!",
        cz: "Ahoj kamaráde! Vítejte ve Valek Academy. Hoďme kostkou a pojďme si hravě povídat anglicky!",
        short: "G'day mate! I'm Josef.",
        duration: 10
      },
      dice: {
        en: "Let's roll the dice! It's your turn. What board game are we going to play today?",
        cz: "Hoďme kostkou! Jsi na řadě. Jakou deskovou hru si dnes zahrajeme?",
        short: "Let's roll the dice!",
        duration: 8
      },
      noworries: {
        en: "No worries at all! Never fear making mistakes. In our small team, we learn by laughing and playing!",
        cz: "Žádný stres! Z chyb si vůbec nic nedělej. V naší partě se učíme smíchem a hrou!",
        short: "No worries at all!",
        duration: 9
      }
    };

    if (previewBox?.dataset.phrases) {
      try {
        const parsed = JSON.parse(previewBox.dataset.phrases);
        phrases = { ...phrases, ...parsed };
      } catch (e) {}
    }

  let activePhraseKey = 'gday';

  const phraseChips = document.querySelectorAll<HTMLButtonElement>('.phrase-chip');
  const liveTextCz = document.getElementById('speech-czech-text');

  phraseChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.getAttribute('data-phrase') || 'gday';
      activePhraseKey = key;

      // Update active chip styles
      phraseChips.forEach(c => {
        c.classList.remove('bg-amber-400', 'text-espresso-950', 'border-amber-300', 'shadow-xs');
        c.classList.add('bg-white/10', 'text-amber-100', 'border-white/15');
      });
      chip.classList.remove('bg-white/10', 'text-amber-100', 'border-white/15');
      chip.classList.add('bg-amber-400', 'text-espresso-950', 'border-amber-300', 'shadow-xs');

      const data = phrases[key];
      if (liveText) liveText.textContent = `„${data.en}“`;
      if (liveTextCz) liveTextCz.textContent = `„${data.cz}“`;
      if (subtitle) subtitle.innerHTML = `<strong class="text-amber-300">„${data.short}“</strong> – Přehrává se`;

      stopAudio();
      setPlayingState(true);
    });
  });

  // Fallback speech synthesis in Australian English
  function fallbackSpeech() {
    if (!synth) return;
    synth.cancel();

    const data = phrases[activePhraseKey] || phrases.gday;
    const utter = new SpeechSynthesisUtterance(data.en);
    (window as any)._activeSpeechUtterance = utter;

    const voices = synth.getVoices();
    const auVoice = voices.find(v => v.lang === 'en-AU' || v.lang.startsWith('en-AU')) ||
                    voices.find(v => v.name.includes('Australia')) ||
                    voices.find(v => v.lang === 'en-GB') ||
                    voices.find(v => v.lang.startsWith('en'));

    if (auVoice) {
      utter.voice = auVoice;
    }
    utter.rate = 0.95;
    utter.pitch = 1.0;

    utter.onstart = () => {
      if (subtitle) {
        subtitle.innerHTML = `<span class="text-emerald-400 font-bold animate-pulse">● Hraje:</span> <strong class="text-white">„${data.short}“</strong>`;
      }
    };

    utter.onend = () => {
      stopAudio();
    };

    utter.onerror = () => {
      stopAudio();
    };

    synth.speak(utter);
  }

  // Play audio file (MP3 / WAV) or fallback
  function playAudioFile() {
    if (nativeAudio) {
      // Try mp3 first, then wav
      nativeAudio.src = `/audio/${activePhraseKey}.mp3`;
      
      nativeAudio.oncanplay = () => {
        if (!isPlaying) return;
        nativeAudio.play().catch(() => {
          playWarmChime();
          fallbackSpeech();
        });
      };

      nativeAudio.ontimeupdate = () => {
        if (!nativeAudio.duration || isNaN(nativeAudio.duration)) return;
        const remaining = Math.max(0, Math.ceil(nativeAudio.duration - nativeAudio.currentTime));
        if (timeDisplay) {
          timeDisplay.textContent = `0:${remaining.toString().padStart(2, '0')}`;
        }
      };

      nativeAudio.onended = () => {
        stopAudio();
      };

      nativeAudio.onerror = () => {
        // If mp3 fails, try wav
        if (nativeAudio.src.endsWith('.mp3')) {
          nativeAudio.src = `/audio/${activePhraseKey}.wav`;
          nativeAudio.play().catch(() => {
            playWarmChime();
            fallbackSpeech();
          });
        } else {
          playWarmChime();
          fallbackSpeech();
        }
      };

      nativeAudio.load();
    } else {
      playWarmChime();
      fallbackSpeech();
    }
  }

  function setPlayingState(playing: boolean) {
    isPlaying = playing;
    const currentData = phrases[activePhraseKey] || phrases.gday;

    if (playing) {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');

      bars.forEach((bar, index) => {
        bar.classList.remove('h-2', 'h-4', 'h-3', 'h-5', 'h-1.5', 'bg-stone-600', 'bg-amber-400/50');
        bar.classList.add('bg-amber-400');
        const waveClass = `animate-wave-${(index % 4) + 1}`;
        bar.classList.add(waveClass);
      });

      if (subtitle) {
        subtitle.innerHTML = `<span class="text-emerald-400 font-bold animate-pulse">● Hraje:</span> <strong class="text-white">„${currentData.short}“</strong>`;
      }

      secondsRemaining = currentData.duration;
      if (timeDisplay) timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;

      playAudioFile();

      // Countdown backup timer
      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        if (nativeAudio && !nativeAudio.paused && nativeAudio.duration) return;
        secondsRemaining--;
        if (secondsRemaining <= 0) {
          stopAudio();
          return;
        }
        if (timeDisplay) {
          timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;
        }
      }, 1000);

    } else {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');

      bars.forEach((bar, index) => {
        bar.classList.remove('animate-wave-1', 'animate-wave-2', 'animate-wave-3', 'animate-wave-4');
        if (index > 5) {
          bar.classList.add('bg-stone-600');
        } else {
          bar.classList.add('bg-amber-400');
        }
      });

      if (subtitle) {
        subtitle.innerHTML = `<strong class="text-amber-300">„${currentData.short}“</strong> – Klikněte pro přehrání`;
      }

      clearInterval(timerInterval);
      if (nativeAudio) {
        nativeAudio.pause();
        nativeAudio.currentTime = 0;
      }
      if (synth) synth.cancel();
    }
  }

  function stopAudio() {
    setPlayingState(false);
    const currentData = phrases[activePhraseKey] || phrases.gday;
    secondsRemaining = currentData.duration;
    if (timeDisplay) timeDisplay.textContent = `0:${secondsRemaining.toString().padStart(2, '0')}`;
    if (nativeAudio) {
      nativeAudio.pause();
      nativeAudio.currentTime = 0;
    }
    if (synth) synth.cancel();
  }

  playBtn?.addEventListener('click', () => {
    if (isPlaying) {
      stopAudio();
    } else {
      setPlayingState(true);
    }
  });

  // Preload voices
  if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
    window.speechSynthesis.onvoiceschanged = () => {
      window.speechSynthesis.getVoices();
    };
  }
</script>
