---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-10 h-10", size = 44 } = Astro.props;
---

<img
  src="/images/valek-academy-logo.jpg"
  alt="VALEK ACADEMY Logo"
  class={`${className} object-cover rounded-full`}
  width={size}
  height={size}
  loading="eager"
  decoding="async"
/>
