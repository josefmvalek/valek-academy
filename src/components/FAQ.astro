---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faq: {
    badge?: string;
    title?: string;
    subtitle?: string;
    items?: FaqItem[];
  };
}

const { faq } = Astro.props;

const badge = faq.badge || "ČASTÉ DOTAZY";
const title = faq.title || "Vše, co potřebujete vědět před první lekcí";
const subtitle = faq.subtitle || "Máte jakýkoliv další dotaz? Neváhejte mi zavolat nebo napsat zprávu.";
const items = faq.items || [];
---

<section id="faq" class="py-12 md:py-16 relative bg-[#FDFBF7] border-t border-parchment-300">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center space-y-3 mb-8 md:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full vintage-ribbon text-xs font-bold uppercase tracking-wider text-amber-950">
        {badge}
      </div>
      <h2 class="font-academy font-bold text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight">
        {title}
      </h2>
      <p class="text-espresso-800/80 text-base sm:text-lg max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <!-- Semantic Accordion Group -->
    <div class="space-y-4">
      {items.map((item, index) => (
        <details
          name="faq-accordion"
          class="group bg-parchment-50 rounded-2xl border border-parchment-300 overflow-hidden transition-all data-[open]:bg-white data-[open]:border-amber-400 data-[open]:shadow-sm"
          open={index === 0}
        >
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none text-left select-none text-espresso-950 font-academy font-bold text-lg hover:text-amber-900 transition-colors">
            <span class="pr-6">{item.question}</span>
            <div class="w-8 h-8 rounded-full bg-parchment-200 flex items-center justify-center flex-shrink-0 text-espresso-800 group-open:rotate-180 group-open:bg-amber-200 group-open:text-amber-950 transition-all duration-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>

          <div class="px-6 pb-6 pt-1 text-espresso-800/90 text-sm sm:text-base leading-relaxed border-t border-parchment-200 mt-1 font-normal">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Bottom prompt -->
    <div class="mt-12 text-center p-6 rounded-2xl bg-amber-100/60 border border-amber-300/80 text-espresso-950">
      <p class="text-sm font-medium">
        Máte jakýkoliv další dotaz ohledně skupinek a výuky?
        <a href="#kontakt" class="text-amber-900 font-bold underline hover:text-amber-700 ml-1">
          Napište mi do formuláře níže →
        </a>
      </p>
    </div>

  </div>
</section>
