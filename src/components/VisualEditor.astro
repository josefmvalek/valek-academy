---
// Visual In-Page Editor Component
// Enables click-to-edit inline editing directly on the live website (Texts & Images).
---

<aside id="inpage-visual-editor" class="fixed z-[9999] font-sans transition-all duration-300">
  <!-- Trigger Button (Minimized Floating Pill) -->
  <button
    id="ve-toggle-btn"
    class="fixed bottom-20 left-4 sm:bottom-6 sm:left-6 z-[9999] flex items-center gap-1.5 sm:gap-2.5 px-3 sm:px-4 py-2 sm:py-2.5 rounded-full bg-espresso-950/90 hover:bg-espresso-950 text-amber-300 hover:text-amber-200 border-2 border-amber-400 shadow-2xl backdrop-blur-md text-xs font-heading font-black cursor-pointer transition-all hover:scale-105 active:scale-95 group"
    title="Kliknutím zapnete vizuální editaci textů a obrázků přímo v živé stránce"
  >
    <span class="text-sm sm:text-base group-hover:rotate-12 transition-transform">✏️</span>
    <span id="ve-toggle-text" class="hidden sm:inline">Upravit web (texty & fotky)</span>
    <span class="sm:hidden text-[11px]">Upravit web</span>
  </button>

  <!-- Top Action Bar (Visible when editing is active) -->
  <div
    id="ve-topbar"
    class="fixed top-0 inset-x-0 bg-espresso-950/95 text-white border-b-2 border-amber-400 shadow-2xl backdrop-blur-lg px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 transform -translate-y-full transition-transform duration-300 z-[10000]"
  >
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-400 text-espresso-950 text-xs font-black uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-ping"></span>
        <span>Režim úprav aktivní</span>
      </span>
      <p class="text-xs sm:text-sm text-stone-300 font-medium hidden md:inline">
        👉 Klikněte na jakýkoliv <strong>text</strong> pro přepsání, nebo na <strong>obrázek</strong> pro nahrání nové fotky. Změny uložte tlačítkem <strong class="text-amber-300">Uložit změny</strong>.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <!-- Save Button -->
      <button
        id="ve-save-btn"
        class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-espresso-950 font-heading font-black text-xs sm:text-sm shadow-md cursor-pointer transition-transform hover:scale-105 active:scale-95 disabled:opacity-50"
      >
        <span id="ve-save-icon">💾</span>
        <span id="ve-save-text">Uložit změny</span>
      </button>

      <!-- Discard / Reload Button -->
      <button
        id="ve-cancel-btn"
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 hover:text-white border border-stone-700 text-xs font-bold cursor-pointer transition-colors"
        title="Zrušit neuložené úpravy"
      >
        <span>↺ Zrušit</span>
      </button>

      <!-- Close / Exit Button -->
      <button
        id="ve-close-btn"
        class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-stone-800 hover:bg-red-900/80 text-stone-300 hover:text-red-200 border border-stone-700 text-sm font-bold cursor-pointer transition-colors"
        title="Ukončit režim úprav"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Image Upload & Edit Modal -->
  <div
    id="ve-image-modal"
    class="fixed inset-0 bg-espresso-950/80 backdrop-blur-sm z-[10002] hidden items-center justify-center p-4"
  >
    <div class="bg-stone-900 text-white rounded-3xl border-2 border-amber-400 max-w-xl w-full p-6 shadow-2xl space-y-5 transform transition-all">
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-3 border-b border-stone-800">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl">📷</span>
            <h3 class="font-heading font-black text-lg text-amber-300" id="ve-modal-title">Změnit obrázek</h3>
          </div>
          <div class="text-[10px] text-stone-400 font-mono mt-0.5" id="ve-modal-key"></div>
        </div>
        <button id="ve-modal-close" class="text-stone-400 hover:text-white text-lg font-bold p-1 cursor-pointer">✕</button>
      </div>

      <!-- Current Image Preview -->
      <div class="space-y-2">
        <div class="text-xs font-bold text-stone-400 uppercase tracking-wider">Aktuální náhled:</div>
        <div class="relative w-full h-44 rounded-2xl overflow-hidden bg-stone-950 border border-stone-700 flex items-center justify-center p-2">
          <img id="ve-modal-preview" src="" alt="Náhled" class="max-h-full max-w-full object-contain rounded-lg" />
          <div id="ve-upload-spinner" class="absolute inset-0 bg-espresso-950/80 hidden items-center justify-center flex-col gap-2">
            <span class="text-3xl animate-spin">⏳</span>
            <span class="text-xs font-bold text-amber-300">Nahrávám obrázek na server...</span>
          </div>
        </div>
      </div>

      <!-- Upload from PC -->
      <div class="space-y-2">
        <div class="text-xs font-bold text-stone-400 uppercase tracking-wider">1. Nahrát nový obrázek z počítače:</div>
        <input type="file" id="ve-file-input" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" class="hidden" />
        <button
          id="ve-upload-btn"
          type="button"
          class="w-full py-3 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-espresso-950 font-heading font-black text-sm flex items-center justify-center gap-2 shadow-md cursor-pointer transition-all hover:scale-[1.01]"
        >
          <span>📁</span>
          <span>Vybrat obrázek z počítače (JPG, PNG, WebP)</span>
        </button>
      </div>

      <!-- Quick Gallery Presets -->
      <div class="space-y-2">
        <div class="text-xs font-bold text-stone-400 uppercase tracking-wider">2. Nebo vybrat z existujících fotek webu:</div>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2" id="ve-preset-grid">
          <button type="button" data-preset="/images/doucovna-stul.webp" class="ve-preset-btn p-1 rounded-xl border border-stone-700 hover:border-amber-400 bg-stone-950 cursor-pointer transition-all hover:scale-105" title="Stůl v doučovně">
            <img src="/images/doucovna-stul.webp" alt="Stůl" class="w-full h-12 object-cover rounded-lg" />
            <span class="text-[9px] text-stone-300 block truncate text-center mt-1">Stůl UH</span>
          </button>
          <button type="button" data-preset="/images/doucovna-hry.webp" class="ve-preset-btn p-1 rounded-xl border border-stone-700 hover:border-amber-400 bg-stone-950 cursor-pointer transition-all hover:scale-105" title="Knihovnička s hrami">
            <img src="/images/doucovna-hry.webp" alt="Knihovnička" class="w-full h-12 object-cover rounded-lg" />
            <span class="text-[9px] text-stone-300 block truncate text-center mt-1">Knihovnička</span>
          </button>
          <button type="button" data-preset="/images/board-games-3d.webp" class="ve-preset-btn p-1 rounded-xl border border-stone-700 hover:border-amber-400 bg-stone-950 cursor-pointer transition-all hover:scale-105" title="Deskové hry 3D">
            <img src="/images/board-games-3d.webp" alt="Deskovky" class="w-full h-12 object-cover rounded-lg" />
            <span class="text-[9px] text-stone-300 block truncate text-center mt-1">Deskovky</span>
          </button>
          <button type="button" data-preset="/images/josef-valek.webp" class="ve-preset-btn p-1 rounded-xl border border-stone-700 hover:border-amber-400 bg-stone-950 cursor-pointer transition-all hover:scale-105" title="Josef Válek (portrét)">
            <img src="/images/josef-valek.webp" alt="Josef" class="w-full h-12 object-cover rounded-lg" />
            <span class="text-[9px] text-stone-300 block truncate text-center mt-1">Josef foto</span>
          </button>
          <button type="button" data-preset="/images/josef-valek-thumb.webp" class="ve-preset-btn p-1 rounded-xl border border-stone-700 hover:border-amber-400 bg-stone-950 cursor-pointer transition-all hover:scale-105" title="Josef Válek (avatar)">
            <img src="/images/josef-valek-thumb.webp" alt="Josef avatar" class="w-full h-12 object-cover rounded-lg" />
            <span class="text-[9px] text-stone-300 block truncate text-center mt-1">Josef avatar</span>
          </button>
          <button type="button" data-preset="/images/poster.webp" class="ve-preset-btn p-1 rounded-xl border border-stone-700 hover:border-amber-400 bg-stone-950 cursor-pointer transition-all hover:scale-105" title="Plakát">
            <img src="/images/poster.webp" alt="Plakát" class="w-full h-12 object-cover rounded-lg" />
            <span class="text-[9px] text-stone-300 block truncate text-center mt-1">Plakát</span>
          </button>
        </div>
      </div>

      <!-- URL Input -->
      <div class="space-y-1.5">
        <div class="text-xs font-bold text-stone-400 uppercase tracking-wider">3. Nebo vložit URL cestu k obrázku:</div>
        <div class="flex gap-2">
          <input
            type="text"
            id="ve-url-input"
            placeholder="/uploads/... nebo https://..."
            class="flex-1 px-3 py-2 rounded-xl bg-stone-950 border border-stone-700 text-stone-200 text-xs focus:outline-hidden focus:border-amber-400"
          />
          <button
            id="ve-url-apply-btn"
            type="button"
            class="px-3 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-amber-300 font-bold text-xs cursor-pointer"
          >
            Použít
          </button>
        </div>
      </div>

      <!-- Modal Actions -->
      <div class="flex items-center justify-end gap-2 pt-2 border-t border-stone-800">
        <button
          id="ve-modal-cancel"
          type="button"
          class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-xs font-bold cursor-pointer"
        >
          Zavřít
        </button>
        <button
          id="ve-modal-confirm"
          type="button"
          class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-espresso-950 font-heading font-black text-xs cursor-pointer shadow-md"
        >
          ✓ Použít tento obrázek
        </button>
      </div>
    </div>
  </div>

  <!-- Success / Info Toast -->
  <div
    id="ve-toast"
    class="fixed bottom-6 right-6 bg-emerald-950 text-emerald-100 border-2 border-emerald-400 px-5 py-3 rounded-2xl shadow-2xl font-bold text-sm flex items-center gap-2.5 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none z-[10003]"
  >
    <span class="text-lg">✅</span>
    <span id="ve-toast-msg">Změny byly úspěšně uloženy do souboru!</span>
  </div>
</aside>

<style is:global>
  /* In-Page Editor Visual Guides for Texts */
  body.ve-active [data-edit-key]:not([data-edit-type="image"]) {
    outline: 2px dashed rgba(245, 158, 11, 0.6) !important;
    outline-offset: 4px;
    border-radius: 4px;
    cursor: text !important;
    position: relative;
    transition: outline-color 0.2s ease, background-color 0.2s ease;
  }

  body.ve-active [data-edit-key]:not([data-edit-type="image"]):hover {
    outline: 2px dashed rgba(217, 119, 6, 1) !important;
    background-color: rgba(254, 243, 199, 0.35) !important;
  }

  body.ve-active [data-edit-key]:not([data-edit-type="image"]):focus {
    outline: 3px solid #d97706 !important;
    background-color: rgba(254, 243, 199, 0.6) !important;
  }

  /* Text label tag on hover */
  body.ve-active [data-edit-key]:not([data-edit-type="image"]):hover::after {
    content: "✏️ " attr(data-edit-label);
    position: absolute;
    top: -24px;
    left: 0;
    background: #1c1917;
    color: #fef3c7;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid #f59e0b;
    pointer-events: none;
    z-index: 9999;
    white-space: nowrap;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
  }

  /* In-Page Editor Visual Guides for Images */
  body.ve-active [data-edit-type="image"] {
    outline: 3px dashed rgba(245, 158, 11, 0.85) !important;
    outline-offset: 2px;
    cursor: pointer !important;
    position: relative;
    transition: transform 0.2s ease, outline-color 0.2s ease;
  }

  body.ve-active [data-edit-type="image"]:hover {
    outline: 3px solid #d97706 !important;
    transform: scale(1.015);
  }

  /* Image hover badge */
  body.ve-active [data-edit-type="image"]:hover::after {
    content: "📷 Klikněte pro změnu obrázku";
    position: absolute;
    top: 8px;
    left: 8px;
    background: #1c1917;
    color: #fde68a;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 8px;
    border: 1.5px solid #f59e0b;
    pointer-events: none;
    z-index: 9999;
    white-space: nowrap;
    box-shadow: 0 6px 12px -2px rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  // Client-side In-Page Visual Editor logic
  let isEditing = false;
  let originalValues: Record<string, string> = {};
  let currentActiveImageEl: HTMLImageElement | null = null;
  let selectedImageUrl: string = "";

  const toggleBtn = document.getElementById('ve-toggle-btn');
  const toggleText = document.getElementById('ve-toggle-text');
  const topbar = document.getElementById('ve-topbar');
  const saveBtn = document.getElementById('ve-save-btn');
  const cancelBtn = document.getElementById('ve-cancel-btn');
  const closeBtn = document.getElementById('ve-close-btn');
  const toast = document.getElementById('ve-toast');
  const toastMsg = document.getElementById('ve-toast-msg');

  // Modal elements
  const imageModal = document.getElementById('ve-image-modal');
  const modalTitle = document.getElementById('ve-modal-title');
  const modalKey = document.getElementById('ve-modal-key');
  const modalPreview = document.getElementById('ve-modal-preview') as HTMLImageElement;
  const modalClose = document.getElementById('ve-modal-close');
  const modalCancel = document.getElementById('ve-modal-cancel');
  const modalConfirm = document.getElementById('ve-modal-confirm');
  const fileInput = document.getElementById('ve-file-input') as HTMLInputElement;
  const uploadBtn = document.getElementById('ve-upload-btn');
  const uploadSpinner = document.getElementById('ve-upload-spinner');
  const urlInput = document.getElementById('ve-url-input') as HTMLInputElement;
  const urlApplyBtn = document.getElementById('ve-url-apply-btn');

  function showToast(message: string, isError = false) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.className = isError
      ? "fixed bottom-6 right-6 bg-red-950 text-red-100 border-2 border-red-400 px-5 py-3 rounded-2xl shadow-2xl font-bold text-sm flex items-center gap-2.5 transform translate-y-0 opacity-100 transition-all duration-300 z-[10003]"
      : "fixed bottom-6 right-6 bg-emerald-950 text-emerald-100 border-2 border-emerald-400 px-5 py-3 rounded-2xl shadow-2xl font-bold text-sm flex items-center gap-2.5 transform translate-y-0 opacity-100 transition-all duration-300 z-[10003]";
    
    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 4000);
  }

  function toggleEditMode(activate?: boolean) {
    isEditing = typeof activate === 'boolean' ? activate : !isEditing;

    if (isEditing) {
      document.body.classList.add('ve-active');
      topbar?.classList.remove('-translate-y-full');
      topbar?.classList.add('translate-y-0');
      if (toggleText) toggleText.textContent = "Ukončit úpravy";

      // Enable text editing for text elements
      const editableElements = document.querySelectorAll<HTMLElement>('[data-edit-key]');
      editableElements.forEach((el) => {
        const isImage = el.getAttribute('data-edit-type') === 'image' || el.tagName === 'IMG';
        const key = el.getAttribute('data-edit-key');

        if (key && !(key in originalValues)) {
          if (isImage) {
            const imgEl = el.tagName === 'IMG' ? (el as HTMLImageElement) : el.querySelector('img');
            originalValues[key] = imgEl ? (imgEl.getAttribute('src') || '') : '';
          } else {
            originalValues[key] = el.innerText.trim();
          }
        }

        if (!isImage) {
          el.setAttribute('contenteditable', 'true');
          el.setAttribute('spellcheck', 'false');
        } else {
          el.removeAttribute('contenteditable');
          el.addEventListener('click', handleImageClick);
        }
      });

      // Prevent link navigation during edit mode
      document.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', handleLinkClick);
      });

      showToast("Režim úprav zapnut! Klikněte na jakýkoliv text k přepsání, nebo na obrázek k výměně.");
    } else {
      document.body.classList.remove('ve-active');
      topbar?.classList.add('-translate-y-full');
      topbar?.classList.remove('translate-y-0');
      if (toggleText) toggleText.textContent = "Upravit web (texty & fotky)";

      // Disable contenteditable and image handlers
      document.querySelectorAll<HTMLElement>('[data-edit-key]').forEach((el) => {
        el.removeAttribute('contenteditable');
        el.removeEventListener('click', handleImageClick);
      });

      // Restore link navigation
      document.querySelectorAll('a').forEach((link) => {
        link.removeEventListener('click', handleLinkClick);
      });

      closeImageModal();
    }
  }

  function handleLinkClick(e: MouseEvent) {
    if (isEditing) {
      const target = e.currentTarget as HTMLElement;
      if (target.hasAttribute('data-edit-key') || target.querySelector('[data-edit-key]')) {
        e.preventDefault();
      }
    }
  }

  // Handle clicking on an image in edit mode
  function handleImageClick(e: MouseEvent) {
    if (!isEditing) return;
    e.preventDefault();
    e.stopPropagation();

    const target = e.currentTarget as HTMLElement;
    const imgEl = target.tagName === 'IMG' ? (target as HTMLImageElement) : target.querySelector('img');
    const key = target.getAttribute('data-edit-key') || (imgEl ? imgEl.getAttribute('data-edit-key') : null);
    const label = target.getAttribute('data-edit-label') || (imgEl ? imgEl.getAttribute('data-edit-label') : 'Obrázek');

    if (!imgEl || !key) return;

    currentActiveImageEl = imgEl;
    selectedImageUrl = imgEl.getAttribute('src') || '';

    if (modalTitle) modalTitle.textContent = `Změnit: ${label}`;
    if (modalKey) modalKey.textContent = `Klíč v obsahu: ${key}`;
    if (modalPreview) modalPreview.src = selectedImageUrl;
    if (urlInput) urlInput.value = selectedImageUrl;

    openImageModal();
  }

  function openImageModal() {
    if (!imageModal) return;
    imageModal.classList.remove('hidden');
    imageModal.classList.add('flex');
  }

  function closeImageModal() {
    if (!imageModal) return;
    imageModal.classList.add('hidden');
    imageModal.classList.remove('flex');
    if (modalKey) modalKey.textContent = '';
    currentActiveImageEl = null;
  }

  // Upload file from computer
  async function handleFileUpload(file: File) {
    if (!uploadSpinner) return;
    uploadSpinner.classList.remove('hidden');
    uploadSpinner.classList.add('flex');

    const formData = new FormData();
    formData.append('file', file);

    try {
      const response = await fetch('/api/upload-image', {
        method: 'POST',
        body: formData
      });

      const data = await response.json();

      if (response.ok && data.success && data.url) {
        selectedImageUrl = data.url;
        if (modalPreview) modalPreview.src = data.url;
        if (urlInput) urlInput.value = data.url;
        showToast("✅ Obrázek byl nahrán! Klikněte na 'Použít tento obrázek'.");
      } else {
        showToast("❌ Chyba při nahrávání: " + (data.error || "Neznámá chyba"), true);
      }
    } catch (err: any) {
      showToast("❌ Chyba sítě při nahrávání: " + err.message, true);
    } finally {
      uploadSpinner.classList.add('hidden');
      uploadSpinner.classList.remove('flex');
    }
  }

  // Set deep object property by dotted path
  function setDeepValue(obj: any, path: string, value: any) {
    const keys = path.split('.');
    let current = obj;
    for (let i = 0; i < keys.length - 1; i++) {
      const k = keys[i];
      const nextK = keys[i + 1];
      const nextIsIndex = /^\d+$/.test(nextK);
      if (!current[k] || typeof current[k] !== 'object') {
        current[k] = nextIsIndex ? [] : {};
      }
      current = current[k];
    }
    current[keys[keys.length - 1]] = value;
  }

  // Save changes to API
  async function saveChanges() {
    if (!saveBtn) return;
    const saveIcon = document.getElementById('ve-save-icon');
    const saveText = document.getElementById('ve-save-text');

    if (saveIcon) saveIcon.textContent = "⏳";
    if (saveText) saveText.textContent = "Ukládám...";
    saveBtn.setAttribute('disabled', 'true');

    try {
      const payload: Record<string, any> = {};
      const editableElements = document.querySelectorAll<HTMLElement>('[data-edit-key]');
      
      editableElements.forEach((el) => {
        const key = el.getAttribute('data-edit-key');
        if (!key) return;

        const isImage = el.getAttribute('data-edit-type') === 'image' || el.tagName === 'IMG';
        
        if (isImage) {
          const imgEl = el.tagName === 'IMG' ? (el as HTMLImageElement) : el.querySelector('img');
          const value = imgEl ? (imgEl.getAttribute('src') || '') : '';
          if (value) {
            setDeepValue(payload, key, value);
            originalValues[key] = value;
          }
        } else {
          const value = el.innerText.trim();
          setDeepValue(payload, key, value);
          originalValues[key] = value;
        }
      });

      const response = await fetch('/api/save-content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (response.ok && result.success) {
        showToast("✅ Změny uloženy! Texty a fotky byly zapsány do content/pages/home.json");
      } else {
        showToast("❌ Chyba při ukládání: " + (result.error || "Neznámá chyba"), true);
      }
    } catch (err: any) {
      showToast("❌ Chyba sítě: " + err.message, true);
    } finally {
      if (saveIcon) saveIcon.textContent = "💾";
      if (saveText) saveText.textContent = "Uložit změny";
      saveBtn.removeAttribute('disabled');
    }
  }

  // Discard changes and reload original values
  function discardChanges() {
    if (confirm("Opravdu chcete zrušit neuložené úpravy a obnovit původní texty a fotky?")) {
      const editableElements = document.querySelectorAll<HTMLElement>('[data-edit-key]');
      editableElements.forEach((el) => {
        const key = el.getAttribute('data-edit-key');
        if (!key || !(key in originalValues)) return;

        const isImage = el.getAttribute('data-edit-type') === 'image' || el.tagName === 'IMG';
        if (isImage) {
          const imgEl = el.tagName === 'IMG' ? (el as HTMLImageElement) : el.querySelector('img');
          if (imgEl) {
            imgEl.src = originalValues[key];
          }
        } else {
          el.innerText = originalValues[key];
        }
      });
      showToast("Úpravy byly zrušeny.");
    }
  }

  // Event Listeners
  toggleBtn?.addEventListener('click', () => toggleEditMode());
  closeBtn?.addEventListener('click', () => toggleEditMode(false));
  saveBtn?.addEventListener('click', saveChanges);
  cancelBtn?.addEventListener('click', discardChanges);

  // Modal event listeners
  modalClose?.addEventListener('click', closeImageModal);
  modalCancel?.addEventListener('click', closeImageModal);

  uploadBtn?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      handleFileUpload(fileInput.files[0]);
    }
  });

  // Preset buttons
  document.querySelectorAll('.ve-preset-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const presetUrl = (e.currentTarget as HTMLElement).getAttribute('data-preset');
      if (presetUrl) {
        selectedImageUrl = presetUrl;
        if (modalPreview) modalPreview.src = presetUrl;
        if (urlInput) urlInput.value = presetUrl;
      }
    });
  });

  // URL apply button
  urlApplyBtn?.addEventListener('click', () => {
    if (urlInput && urlInput.value.trim()) {
      selectedImageUrl = urlInput.value.trim();
      if (modalPreview) modalPreview.src = selectedImageUrl;
    }
  });

  // Modal confirm button
  modalConfirm?.addEventListener('click', () => {
    if (currentActiveImageEl && selectedImageUrl) {
      currentActiveImageEl.src = selectedImageUrl;
      currentActiveImageEl.setAttribute('src', selectedImageUrl);
      showToast("Obrázek byl aktualizován na stránce! Nezapomeňte kliknout na 'Uložit změny'.");
      closeImageModal();
    }
  });

  // Auto-activate if ?edit=true is in URL
  if (window.location.search.includes('edit=true')) {
    toggleEditMode(true);
  }
</script>
