---
import { tinaField } from '@tinacms/astro/tina-field';
import { formatRichText } from '../lib/richText';

interface PhotoItem {
  image: string;
  title: string;
  description?: string;
  isFeatured?: boolean;
  hidden?: boolean;
  [key: string]: any;
}

interface CategoryItem {
  id: string;
  name: string;
  icon?: string;
  description?: string;
  photos?: PhotoItem[];
  [key: string]: any;
}

interface Props {
  gallery?: {
    badge?: string;
    heading?: string;
    subtitle?: string;
    backLinkText?: string;
    filterTitle?: string;
    allPhotosFilterLabel?: string;
    trustBadges?: Array<{
      icon?: string;
      text?: string;
      isHighlight?: boolean;
      [key: string]: any;
    }>;
    categories?: CategoryItem[];
    ctaBanner?: {
      badge?: string;
      title?: string;
      subtitle?: string;
      buttonText?: string;
      buttonLink?: string;
      [key: string]: any;
    };
    [key: string]: any;
  };
}

const { gallery = {} } = Astro.props;

const badge = gallery.badge || "FOTOGALERIE DOUČOVNY & HER";
const heading = gallery.heading || "Nahlédněte do naší doučovny v Uherském Hradišti";
const subtitle = gallery.subtitle || "Žádné školní lavice, zkoušení u tabule ani pasivní koukání do monitoru. Prohlédněte si, jak to u nás vypadá – velký stůl pro deskovky, desítky originálních her a přátelská rodinná atmosféra přímo v centru UH.";
const backLinkText = gallery.backLinkText || "Zpět na hlavní stránku";
const filterTitle = gallery.filterTitle || "Filtrovat fotografie podle kategorie:";
const allPhotosFilterLabel = gallery.allPhotosFilterLabel || "Všechny snímky";
const trustBadges = gallery.trustBadges || [
  { icon: "🏠", text: "Růžová 1238, UH (naproti ZŠ UNESCO)", isHighlight: false },
  { icon: "🎲", text: "Desítky originálních her", isHighlight: false },
  { icon: "👨‍🏫", text: "Mr. Válek s australským přízvukem", isHighlight: false },
  { icon: "🎁", text: "1. lekce 100% ZDARMA", isHighlight: true }
];

const categories: CategoryItem[] = gallery.categories || [];

// Flatten all photos for global indexing and lightbox navigation
interface NormalizedPhoto extends PhotoItem {
  categoryId: string;
  categoryName: string;
  categoryIcon: string;
  globalIndex: number;
  catRef: any;
  photoRef: any;
  pIdx: number;
  cIdx: number;
}

const allPhotos: NormalizedPhoto[] = [];
let photoCounter = 0;

categories.forEach((cat, cIdx) => {
  (cat.photos || []).forEach((p, pIdx) => {
    // Pokud je fotka skrytá, nezobrazuje se na webu ani v lightboxu
    if (p.hidden) return;
    allPhotos.push({
      ...p,
      categoryId: cat.id,
      categoryName: cat.name,
      categoryIcon: cat.icon || "📁",
      globalIndex: photoCounter++,
      catRef: cat,
      photoRef: p,
      pIdx,
      cIdx,
    });
  });
});

const ctaBanner = gallery.ctaBanner || {
  badge: "Přijďte se přesvědčit naživo",
  title: "Líbí se vám naše doučovna a přátelská atmosféra?",
  subtitle: "Přijďte si s dítětem nezávazně zahrát deskovku a vyzkoušet atmosféru v malé skupince. První celá lekce je 100% ZDARMA a k ničemu vás nezavazuje.",
  buttonText: "🎁 Vyzkoušet 1. lekci ZDARMA",
  buttonLink: "/rozvrh#kontakt"
};
---

<div class="gallery-wrapper py-8 sm:py-12 md:py-16 relative bg-gradient-to-b from-[#FAF7F2] via-[#FFFDF9] to-[#FAF7F2] min-h-screen">
  
  <!-- Ambient background glow -->
  <div class="absolute top-10 left-1/4 w-80 sm:w-[32rem] h-80 sm:h-[32rem] bg-amber-300/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 right-10 w-80 sm:w-[32rem] h-80 sm:h-[32rem] bg-emerald-200/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Breadcrumb -->
    <div class="mb-6 sm:mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-stone-600 hover:text-amber-900 transition-colors group" data-tina-field={tinaField(gallery, 'backLinkText')}>
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <span data-edit-key="gallery.backLinkText" data-edit-label="Zpět">{backLinkText}</span>
      </a>
    </div>

    <!-- Section Header -->
    <div class="max-w-4xl mx-auto text-center space-y-4 mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full vintage-ribbon text-xs font-black uppercase tracking-wider text-espresso-950 shadow-xs" data-tina-field={tinaField(gallery, 'badge')} data-edit-key="gallery.badge" data-edit-label="Štítek galerie">
        <span>📸</span>
        <span>{badge}</span>
      </div>

      <h1 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight" data-tina-field={tinaField(gallery, 'heading')} data-edit-key="gallery.heading" data-edit-label="Nadpis galerie" set:html={formatRichText(heading)}>
      </h1>

      <p class="text-espresso-800/85 text-sm sm:text-lg max-w-3xl mx-auto leading-relaxed" data-tina-field={tinaField(gallery, 'subtitle')} data-edit-key="gallery.subtitle" data-edit-label="Podnadpis galerie" set:html={formatRichText(subtitle)}>
      </p>

      <!-- Key trust badges strip -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-bold text-espresso-900" data-tina-field={tinaField(gallery, 'trustBadges')}>
        {trustBadges.map((b: any, idx: number) => (
          <span class={b.isHighlight ? "px-3.5 py-1.5 rounded-full bg-amber-400 text-espresso-950 border border-amber-500 shadow-2xs flex items-center gap-1.5 font-black" : "px-3 py-1.5 rounded-full bg-white border border-amber-300 shadow-2xs flex items-center gap-1.5"}>
            <span data-edit-key={`gallery.trustBadges.${idx}.icon`}>{b.icon || "✨"}</span>
            <span data-edit-key={`gallery.trustBadges.${idx}.text`} data-edit-label="Odznáček">{b.text}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="mb-10 sm:mb-14">
      <div class="text-center text-[11px] font-black uppercase tracking-wider text-stone-500 mb-3" data-tina-field={tinaField(gallery, 'filterTitle')} data-edit-key="gallery.filterTitle" data-edit-label="Nadpis filtrů">
        {filterTitle}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 max-w-4xl mx-auto" role="tablist" aria-label="Kategorie fotografií">
        <!-- All categories button -->
        <button
          type="button"
          data-category="all"
          class="gallery-cat-btn px-4 sm:px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-heading font-black cursor-pointer transition-all flex items-center gap-2 bg-amber-400 text-espresso-950 border-2 border-amber-500 shadow-xs"
          role="tab"
          aria-selected="true"
        >
          <span>🌟</span>
          <span data-tina-field={tinaField(gallery, 'allPhotosFilterLabel')} data-edit-key="gallery.allPhotosFilterLabel" data-edit-label="Filtr všechny snímky">{allPhotosFilterLabel}</span>
          <span class="px-2 py-0.5 rounded-full text-[11px] bg-espresso-950 text-amber-300 font-black">
            {allPhotos.length}
          </span>
        </button>

        <!-- Category specific buttons -->
        {categories.map((cat) => {
          const count = (cat.photos || []).filter((p) => !p.hidden).length;
          return (
            <button
              type="button"
              data-category={cat.id}
              class="gallery-cat-btn px-4 sm:px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-heading font-bold cursor-pointer transition-all flex items-center gap-2 bg-white text-espresso-900 border-2 border-parchment-300 hover:border-amber-400 hover:bg-parchment-100/60 shadow-2xs"
              role="tab"
              aria-selected="false"
              data-tina-field={tinaField(cat, 'name')}
            >
              <span>{cat.icon || "📁"}</span>
              <span>{cat.name}</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] bg-parchment-200 text-stone-700 font-bold">
                {count}
              </span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Gallery Grid (Clean 3-column responsive layout without height distortion or empty holes) -->
    <div
      id="gallery-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch"
    >
      {allPhotos.map((photo) => (
        <div
          data-category-id={photo.categoryId}
          data-photo-index={photo.globalIndex}
          data-image={photo.image}
          data-title={photo.title}
          data-desc={photo.description || ""}
          data-cat-name={photo.categoryName}
          data-cat-icon={photo.categoryIcon}
          data-tina-field={tinaField(photo.catRef, 'photos', photo.pIdx)}
          class="gallery-item group relative bg-white rounded-3xl p-3.5 sm:p-4 border border-parchment-300 hover:border-amber-400 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <!-- Image Wrapper with uniform ratio & smooth hover zoom -->
          <div 
            class="relative w-full aspect-4/3 overflow-hidden rounded-2xl bg-parchment-200"
            data-tina-field={tinaField(photo.photoRef, 'image')}
          >
            <img
              src={photo.image}
              alt={`${photo.title} – výuka angličtiny hrou, VALEK ACADEMY Uherské Hradiště`}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
            />
            
            <!-- Category Tag on Photo -->
            <div class="absolute top-3 left-3 z-10 pointer-events-none">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-black uppercase tracking-wider bg-espresso-950/85 text-amber-300 backdrop-blur-md shadow-md border border-amber-400/25">
                <span>{photo.categoryIcon}</span>
                <span>{photo.categoryName}</span>
              </span>
            </div>

            <!-- Zoom lens overlay -->
            <div class="absolute inset-0 bg-espresso-950/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
              <span class="w-12 h-12 rounded-full bg-amber-400 text-espresso-950 flex items-center justify-center text-xl font-black shadow-lg transform scale-75 group-hover:scale-100 transition-transform">
                🔍
              </span>
            </div>
          </div>

          <!-- Caption & Description (Clean, compact, no empty white space) -->
          <div class="pt-4 pb-1 px-1.5 flex flex-col justify-between flex-grow">
            <div>
              <h3 
                class="font-heading font-black text-base sm:text-lg text-espresso-950 group-hover:text-amber-900 transition-colors leading-snug"
                data-tina-field={tinaField(photo.photoRef, 'title')}
              >
                {photo.title}
              </h3>
              {photo.description && (
                <p 
                  class="text-xs sm:text-sm text-stone-600 mt-2 line-clamp-2 leading-relaxed font-normal"
                  data-tina-field={tinaField(photo.photoRef, 'description')}
                >
                  {photo.description}
                </p>
              )}
            </div>

            <div class="gallery-zoom-trigger mt-3.5 pt-2.5 border-t border-parchment-200 flex items-center justify-between text-xs font-bold text-amber-950 hover:text-amber-700 transition-colors">
              <span>Zvětšit fotografii</span>
              <span class="text-amber-700 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Empty State (hidden by default) -->
    <div id="gallery-empty" class="hidden text-center py-16">
      <div class="text-5xl mb-3">📸</div>
      <h3 class="font-heading font-black text-xl text-espresso-950 mb-1">V této kategorii zatím nejsou žádné fotografie</h3>
      <p class="text-sm text-stone-600">Vyberte prosím jinou kategorii výše.</p>
    </div>

    <!-- Bottom CTA Banner -->
    <div 
      class="mt-14 sm:mt-20 max-w-4xl mx-auto rounded-3xl p-6 sm:p-10 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 border-2 border-amber-500 shadow-xl text-center space-y-4"
      data-tina-field={tinaField(gallery, 'ctaBanner')}
    >
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-espresso-950 text-amber-300 text-[11px] font-black uppercase tracking-wider shadow-xs" data-tina-field={tinaField(ctaBanner, 'badge')}>
        <span>🎁</span> <span data-edit-key="gallery.ctaBanner.badge" data-edit-label="Štítek CTA">{ctaBanner.badge || "Přijďte se přesvědčit naživo"}</span>
      </div>
      <h2 
        class="font-heading font-black text-2xl sm:text-3xl md:text-4xl text-espresso-950 tracking-tight"
        data-tina-field={tinaField(ctaBanner, 'title')}
        data-edit-key="gallery.ctaBanner.title"
        data-edit-label="Nadpis CTA banneru"
      >
        {ctaBanner.title}
      </h2>
      <p 
        class="text-espresso-900 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed font-medium"
        data-tina-field={tinaField(ctaBanner, 'subtitle')}
        data-edit-key="gallery.ctaBanner.subtitle"
        data-edit-label="Podnadpis CTA banneru"
      >
        {ctaBanner.subtitle}
      </p>
      <div class="pt-2">
        <a
          href={ctaBanner.buttonLink || "/rozvrh#kontakt"}
          class="inline-flex items-center justify-center gap-2 py-4 px-8 rounded-2xl font-heading font-black text-base bg-espresso-950 hover:bg-espresso-900 text-amber-300 shadow-md hover:shadow-xl transition-all cursor-pointer hover:scale-105 active:scale-95"
          data-tina-field={tinaField(ctaBanner, 'buttonText')}
          data-edit-key="gallery.ctaBanner.buttonText"
          data-edit-label="Tlačítko CTA banneru"
        >
          <span>{ctaBanner.buttonText || "🎁 Vyzkoušet 1. lekci ZDARMA"}</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</div>

<!-- Modern Fullscreen Lightbox Modal (<dialog closedby="any">) -->
<dialog
  id="gallery-lightbox"
  closedby="any"
  aria-label="Prohlížeč fotografií"
  class="fixed inset-0 m-auto max-w-5xl w-[95vw] sm:w-[90vw] p-0 rounded-3xl bg-espresso-950 text-white shadow-2xl border-2 border-amber-400 backdrop:bg-black/85 backdrop:backdrop-blur-md overflow-hidden focus:outline-hidden"
>
  <div class="relative flex flex-col h-full max-h-[92vh] sm:max-h-[88vh]">
    
    <!-- Modal Header -->
    <div class="p-3.5 sm:p-4 border-b border-stone-800 flex items-center justify-between gap-3 bg-espresso-950">
      <div class="flex items-center gap-2.5 min-w-0">
        <span id="lb-cat-badge" class="px-3 py-1 rounded-full text-[10px] sm:text-xs font-black bg-amber-400 text-espresso-950 flex-shrink-0">
          Učebna
        </span>
        <h4 id="lb-title" class="font-heading font-black text-sm sm:text-base md:text-lg text-white truncate">
          Název fotografie
        </h4>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <span id="lb-counter" class="text-xs text-amber-300 font-bold px-2.5 py-1 rounded-lg bg-stone-900 border border-stone-800 hidden sm:inline">
          1 / 12
        </span>
        <button
          type="button"
          id="lb-close-btn"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-stone-800 hover:bg-stone-700 text-stone-200 hover:text-white flex items-center justify-center font-black text-lg transition-colors cursor-pointer"
          title="Zavřít (Esc)"
          aria-label="Zavřít"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Main Image Display & Navigation Arrows -->
    <div class="relative flex-grow flex items-center justify-center p-2 sm:p-6 bg-black/40 min-h-[40vh] sm:min-h-[55vh] select-none">
      
      <!-- Prev Button -->
      <button
        type="button"
        id="lb-prev-btn"
        class="absolute left-2 sm:left-4 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-espresso-950/80 hover:bg-amber-400 text-amber-300 hover:text-espresso-950 border border-amber-400/50 flex items-center justify-center text-xl font-black transition-all shadow-lg cursor-pointer hover:scale-110 active:scale-95"
        title="Předchozí fotografie (Šipka doleva)"
        aria-label="Předchozí"
      >
        ‹
      </button>

      <!-- The Active Image -->
      <div class="max-w-full max-h-[60vh] sm:max-h-[68vh] flex items-center justify-center overflow-hidden">
        <img
          id="lb-image"
          src=""
          alt=""
          class="max-w-full max-h-[60vh] sm:max-h-[68vh] object-contain rounded-xl shadow-2xl transition-transform duration-300"
        />
      </div>

      <!-- Next Button -->
      <button
        type="button"
        id="lb-next-btn"
        class="absolute right-2 sm:right-4 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-espresso-950/80 hover:bg-amber-400 text-amber-300 hover:text-espresso-950 border border-amber-400/50 flex items-center justify-center text-xl font-black transition-all shadow-lg cursor-pointer hover:scale-110 active:scale-95"
        title="Další fotografie (Šipka doprava)"
        aria-label="Další"
      >
        ›
      </button>
    </div>

    <!-- Modal Footer with detailed description and reservation action -->
    <div class="p-3.5 sm:p-4 border-t border-stone-800 bg-espresso-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p id="lb-desc" class="text-xs sm:text-sm text-stone-300 leading-relaxed font-normal max-w-2xl">
        Podrobný popis fotografie.
      </p>
      
      <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end flex-shrink-0">
        <span class="text-[11px] text-stone-500 font-bold hidden md:inline whitespace-nowrap">
          Tip: Klávesnice ‹ › nebo Esc
        </span>
        <a
          href="/rozvrh#kontakt"
          class="inline-flex items-center gap-1.5 py-2 px-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-espresso-950 text-xs font-black transition-all shadow-xs whitespace-nowrap"
        >
          <span>🎁 Rezervovat 1. lekci zdarma →</span>
        </a>
      </div>
    </div>

  </div>
</dialog>

<script>
  function initGallery() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-cat-btn');
    const items = document.querySelectorAll<HTMLElement>('.gallery-item');
    const emptyNotice = document.getElementById('gallery-empty');

    const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    const lbImage = document.getElementById('lb-image') as HTMLImageElement | null;
    const lbTitle = document.getElementById('lb-title');
    const lbDesc = document.getElementById('lb-desc');
    const lbCatBadge = document.getElementById('lb-cat-badge');
    const lbCounter = document.getElementById('lb-counter');
    const lbCloseBtn = document.getElementById('lb-close-btn');
    const lbPrevBtn = document.getElementById('lb-prev-btn');
    const lbNextBtn = document.getElementById('lb-next-btn');

    if (!dialog) return;

    let visibleItems: HTMLElement[] = Array.from(items);
    let currentIndex = 0;

    // Filter categories
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';

        // Style buttons
        filterBtns.forEach((b) => {
          b.classList.remove('bg-amber-400', 'text-espresso-950', 'border-amber-500', 'font-black', 'shadow-xs');
          b.classList.add('bg-white', 'text-espresso-900', 'border-parchment-300', 'font-bold');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.remove('bg-white', 'text-espresso-900', 'border-parchment-300', 'font-bold');
        btn.classList.add('bg-amber-400', 'text-espresso-950', 'border-amber-500', 'font-black', 'shadow-xs');
        btn.setAttribute('aria-selected', 'true');

        // Filter items in grid
        visibleItems = [];
        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category-id');
          if (cat === 'all' || itemCat === cat) {
            item.classList.remove('hidden');
            item.classList.add('flex');
            visibleItems.push(item);
          } else {
            item.classList.remove('flex');
            item.classList.add('hidden');
          }
        });

        if (emptyNotice) {
          if (visibleItems.length === 0) {
            emptyNotice.classList.remove('hidden');
          } else {
            emptyNotice.classList.add('hidden');
          }
        }
      });
    });

    // Lightbox open function
    function openLightbox(index: number) {
      if (!dialog || visibleItems.length === 0) return;
      
      // Bounds check with wrapping
      if (index < 0) index = visibleItems.length - 1;
      if (index >= visibleItems.length) index = 0;

      currentIndex = index;
      const currentItem = visibleItems[currentIndex];
      if (!currentItem) return;

      const imgSrc = currentItem.getAttribute('data-image') || '';
      const title = currentItem.getAttribute('data-title') || '';
      const desc = currentItem.getAttribute('data-desc') || '';
      const catName = currentItem.getAttribute('data-cat-name') || '';
      const catIcon = currentItem.getAttribute('data-cat-icon') || '📁';

      if (lbImage) {
        lbImage.src = imgSrc;
        lbImage.alt = `${title} – doučovna VALEK ACADEMY Uherské Hradiště`;
      }
      if (lbTitle) lbTitle.textContent = title;
      if (lbDesc) lbDesc.textContent = desc || title;
      if (lbCatBadge) lbCatBadge.textContent = `${catIcon} ${catName}`;
      if (lbCounter) lbCounter.textContent = `${currentIndex + 1} / ${visibleItems.length}`;

      if (!dialog.open) {
        dialog.showModal();
      }
    }

    const isInIframe = window.self !== window.top;

    // Attach click to all gallery cards
    items.forEach((item) => {
      item.addEventListener('click', (e) => {
        // Inside visual editor iframe, don't open lightbox on text/card clicks so user can edit fields
        if (isInIframe) {
          const target = e.target as HTMLElement;
          if (!target.closest('.gallery-zoom-trigger')) {
            return;
          }
        }
        const itemIdx = visibleItems.indexOf(item);
        if (itemIdx !== -1) {
          openLightbox(itemIdx);
        }
      });
    });

    // Navigation buttons
    if (lbPrevBtn) {
      lbPrevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(currentIndex - 1);
      });
    }

    if (lbNextBtn) {
      lbNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(currentIndex + 1);
      });
    }

    if (lbCloseBtn) {
      lbCloseBtn.addEventListener('click', () => {
        dialog.close();
      });
    }

    // Fallback backdrop click
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isDialogContent) {
          dialog.close();
        }
      });
    }

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        openLightbox(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        openLightbox(currentIndex + 1);
      }
    });

    // Mobile swipe gestures
    let touchStartX = 0;
    let touchEndX = 0;
    dialog.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    dialog.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const deltaX = touchEndX - touchStartX;
      if (Math.abs(deltaX) > 45) {
        if (deltaX < 0) {
          openLightbox(currentIndex + 1);
        } else {
          openLightbox(currentIndex - 1);
        }
      }
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initGallery);
  document.addEventListener('astro:page-load', initGallery);
</script>
