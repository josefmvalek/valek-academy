---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-36 h-36", size = 150 } = Astro.props;
---

<div class={`stamp-badge select-none inline-block ${className}`} title="Autentické australské zázemí Josefa Válka">
  <svg
    width={size}
    height={size}
    viewBox="0 0 200 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full drop-shadow-sm"
  >
    <!-- Outer decorative stamp circles -->
    <circle cx="100" cy="100" r="95" stroke="#D97706" stroke-width="2" stroke-dasharray="4 3" opacity="0.85" />
    <circle cx="100" cy="100" r="88" stroke="#1E3A8A" stroke-width="2.5" />
    <circle cx="100" cy="100" r="68" stroke="#1E3A8A" stroke-width="1.5" stroke-dasharray="2 2" />

    <!-- Circular text path definitions -->
    <defs>
      <path
        id="stampTopPath"
        d="M 22 100 A 78 78 0 0 1 178 100"
        fill="none"
      />
      <path
        id="stampBottomPath"
        d="M 178 100 A 78 78 0 0 1 22 100"
        fill="none"
      />
    </defs>

    <!-- Top curved text -->
    <text font-family="Outfit, Inter, sans-serif" font-size="10" font-weight="800" fill="#1E3A8A" letter-spacing="2.2">
      <textPath href="#stampTopPath" startOffset="50%" text-anchor="middle">
        ★ VYRŮSTAL V AUSTRÁLII ★
      </textPath>
    </text>

    <!-- Bottom curved text -->
    <text font-family="Outfit, Inter, sans-serif" font-size="9" font-weight="700" fill="#D97706" letter-spacing="2">
      <textPath href="#stampBottomPath" startOffset="50%" text-anchor="middle">
        • 25+ LET ŽIVOTA V ČR •
      </textPath>
    </text>

    <!-- Center Icon & Details -->
    <!-- Star cluster / Southern Cross representation -->
    <circle cx="82" cy="74" r="1.5" fill="#D97706" />
    <circle cx="118" cy="74" r="1.5" fill="#D97706" />
    <circle cx="100" cy="62" r="2" fill="#F59E0B" />

    <!-- Center Emblem: Australian Kangaroo & Sun rays -->
    <g transform="translate(68, 76) scale(0.65)">
      <!-- Kangaroo silhouette -->
      <path
        d="M58 8C54 4 48 3 43 5C38 7 36 12 37 18C37 20 38 23 40 25L32 34C28 32 23 32 19 35C15 38 13 44 14 50L8 56C4 59 1 65 2 71C3 78 8 83 14 85L32 87C42 88 52 82 58 74L72 52C75 47 76 41 74 36L71 28C74 24 78 20 84 18L88 17L86 13L81 14C76 15 72 18 69 22L64 16C62 12 60 9 58 8Z"
        fill="#1E3A8A"
      />
      <!-- Joey / bounce arc -->
      <path d="M12 90C28 98 58 98 78 88" stroke="#F59E0B" stroke-width="3" stroke-linecap="round" />
    </g>

    <!-- Center verified ribbon / date -->
    <rect x="52" y="132" width="96" height="20" rx="10" fill="#F8FAFC" stroke="#D97706" stroke-width="1.5" />
    <text x="100" y="145.5" font-family="Outfit, Inter, sans-serif" font-size="9" font-weight="800" fill="#0F172A" text-anchor="middle" letter-spacing="1">
      JOSEF VÁLEK
    </text>
  </svg>
</div>
