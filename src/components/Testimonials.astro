---
import { tinaField } from '@tinacms/astro/tina-field';

interface Testimonial {
  [key: string]: any;
  name: string;
  role: string;
  location: string;
  rating: number;
  quote: string;
  highlight: string;
  avatarText: string;
}

interface Props {
  className?: string;
  testimonials?: {
    badge?: string;
    title?: string;
    subtitle?: string;
    ratingScore?: string;
    ratingNote?: string;
    reviews?: Testimonial[];
  };
}

const { className = "", testimonials = {} } = Astro.props;

const defaultReviews: Testimonial[] = [
  {
    name: "Radka Malinová",
    role: "Maminka třeťačky ze ZŠ UNESCO",
    location: "Uherské Hradiště",
    rating: 5,
    highlight: "Zlepšení z trojky na jedničky s hvězdičkou",
    quote: "Dcera se dřív ve škole bála promluvit, aby se jí děti nesmály při chybě. U pana Válka si hned první hodinu zahrála Story Cubes a domů přišla nadšená. Po dvou měsících má z angličtiny samé jedničky a sama si doma pouští pohádky v originále bez českých titulků.",
    avatarText: "RM"
  },
  {
    name: "Ing. Martin Kovář",
    role: "Tatínek žáka 6. třídy",
    location: "Kunovice",
    rating: 5,
    highlight: "Konečně doučování, které není za trest",
    quote: "Hledali jsme doučování, které pro kluka nebude dalším sezením v lavici. Josefův australský přízvuk a výuka přes deskovky Karak a Scrabble je geniální koncept. Syn se na každé úterý vyloženě těší a z angličtiny je najednou jeho nejoblíbenější předmět.",
    avatarText: "MK"
  },
  {
    name: "Mgr. Lucie Vávrová",
    role: "Maminka páťáka",
    location: "Staré Město",
    rating: 5,
    highlight: "Klidné vysvětlení látky v češtině & rodinná doučovna",
    quote: "Oceňuji přátelskou atmosféru v doučovně v Růžové ulici, malé skupinky po 4 dětech a klidný lidský přístup. Když syn něčemu ve škole nerozumí, Josef mu to trpělivě česky dovysvětlí. První ukázková hodina zdarma nás okamžitě přesvědčila.",
    avatarText: "LV"
  },
  {
    name: "David S.",
    role: "Přijat na Gymnázium v Uherském Hradišti",
    location: "Uherské Hradiště",
    rating: 5,
    highlight: "Úspěšné zvládnutí přijímacích zkoušek",
    quote: "Josef mi pomohl nejen s mluvením bez českého tvrdého přízvuku, ale i s testy k přijímačkám na gympl. Všechno vysvětluje logicky a v pohodě, žádný stres ze známkování. Na lekcích jsme se vždycky nasmáli.",
    avatarText: "DS"
  }
];

const badge = testimonials.badge || "Reference rodičů ze Slovácka";
const title = testimonials.title || "Co o doučování říkají rodiče z Uherského Hradiště a okolí?";
const subtitle = testimonials.subtitle || "Skutečné zkušenosti maminek, tatínků i studentů, kterým Josef pomohl odbourat strach z angličtiny a získat sebevědomí.";
const ratingScore = testimonials.ratingScore || "5.0 / 5.0";
const ratingNote = testimonials.ratingNote || "25+ let lektorské praxe a 250+ spokojených dětí";
const reviews = testimonials.reviews || defaultReviews;
---

<section id="reference" class={`py-8 sm:py-12 md:py-20 relative bg-[#FAF7F2] border-b border-parchment-300 overflow-hidden ${className}`}>
  
  <!-- Subtle ambient lighting -->
  <div class="absolute top-1/4 right-0 w-72 sm:w-96 h-72 sm:h-96 bg-amber-300/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-0 w-72 sm:w-80 h-72 sm:h-80 bg-emerald-200/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-6 md:mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-xs font-black uppercase tracking-wider text-amber-950 shadow-xs" data-tina-field={tinaField(testimonials, 'badge')} data-edit-key="testimonials.badge" data-edit-label="Štítek referencí">
        <span>⭐</span> <span>{badge}</span>
      </div>
      <h2 class="font-heading font-black text-2xl sm:text-4xl lg:text-5xl text-espresso-950 tracking-tight" data-tina-field={tinaField(testimonials, 'title')} data-edit-key="testimonials.title" data-edit-label="Nadpis referencí">
        {title}
      </h2>
      <p class="text-espresso-800/80 text-sm sm:text-lg" data-tina-field={tinaField(testimonials, 'subtitle')} data-edit-key="testimonials.subtitle" data-edit-label="Podnadpis referencí">
        {subtitle}
      </p>

      <!-- Aggregated Rating Pill -->
      <div class="inline-flex items-center gap-3 px-4 sm:px-5 py-2 sm:py-2.5 rounded-2xl bg-white border border-amber-300/80 shadow-xs text-xs sm:text-sm font-bold text-espresso-950 mt-2">
        <div class="flex items-center text-amber-400 text-base leading-none">
          ★★★★★
        </div>
        <span class="font-black text-amber-950" data-tina-field={tinaField(testimonials, 'ratingScore')} data-edit-key="testimonials.ratingScore" data-edit-label="Skóre hodnocení">{ratingScore}</span>
        <span class="text-stone-300">•</span>
        <span class="text-stone-600 font-semibold" data-tina-field={tinaField(testimonials, 'ratingNote')} data-edit-key="testimonials.ratingNote" data-edit-label="Poznámka k hodnocení">{ratingNote}</span>
      </div>
    </div>

    <!-- Reviews: Snap Carousel on Mobile, 2-Col Grid on Desktop -->
    <div class="flex md:grid md:grid-cols-2 gap-4 sm:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-3 md:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0" id="reviews-slider" style="scrollbar-width: none; -ms-overflow-style: none;">
      {reviews.map((rev, idx) => (
        <div
          data-tina-field={tinaField(testimonials, 'reviews', idx)}
          class="w-[85vw] max-w-[340px] flex-shrink-0 snap-center md:w-auto md:max-w-none md:flex-shrink-1 bg-white rounded-3xl p-6 sm:p-8 border-2 border-parchment-300 shadow-xs hover:border-amber-400 hover:shadow-card-lift transition-all duration-300 flex flex-col justify-between group"
        >
          
          <div class="space-y-4">
            <!-- Top Stars & Highlight Badge -->
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center text-amber-400 text-lg">
                {[...Array(typeof rev.rating === 'number' ? Math.max(1, Math.min(5, rev.rating)) : 5)].map(() => (
                  <span>★</span>
                ))}
              </div>
              <span class="text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg bg-amber-100/80 text-amber-950 border border-amber-300" data-tina-field={tinaField(rev, 'highlight')} data-edit-key={`testimonials.reviews.${idx}.highlight`} data-edit-label="Tahák recenze">
                {rev.highlight}
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-espresso-900 text-sm sm:text-base leading-relaxed italic font-normal" data-tina-field={tinaField(rev, 'quote')} data-edit-key={`testimonials.reviews.${idx}.quote`} data-edit-label="Citace recenze">
              „{rev.quote}“
            </p>
          </div>

          <!-- Author Info Footer -->
          <div class="pt-5 mt-6 border-t border-parchment-200 flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-500 text-espresso-950 font-black text-sm flex items-center justify-center shadow-2xs border border-amber-300 flex-shrink-0 group-hover:scale-105 transition-transform">
              {rev.avatarText}
            </div>
            <div>
              <div class="font-heading font-black text-base text-espresso-950" data-tina-field={tinaField(rev, 'name')} data-edit-key={`testimonials.reviews.${idx}.name`} data-edit-label="Jméno rodiče">
                {rev.name}
              </div>
              <div class="text-xs text-stone-500 font-medium">
                <span data-tina-field={tinaField(rev, 'role')} data-edit-key={`testimonials.reviews.${idx}.role`} data-edit-label="Role">{rev.role}</span> • <span class="text-amber-900 font-bold" data-tina-field={tinaField(rev, 'location')} data-edit-key={`testimonials.reviews.${idx}.location`} data-edit-label="Město">{rev.location}</span>
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Mobile Pagination / Swipe Hint -->
    <div class="flex md:hidden items-center justify-center gap-2 mt-3 text-xs text-stone-500">
      <div class="flex items-center gap-1.5" id="testimonial-dots">
        {reviews.map((_, idx) => (
          <span class:list={["h-2 rounded-full transition-all testimonial-dot", idx === 0 ? "bg-amber-500 w-5" : "bg-stone-300 w-2"]}></span>
        ))}
      </div>
      <span class="text-[11px] text-stone-600 font-semibold ml-2">← Posuňte pro další recenze →</span>
    </div>

    <!-- Bottom Action Ribbon -->
    <div class="mt-8 sm:mt-12 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 p-4 px-6 rounded-2xl bg-gradient-to-r from-amber-100 via-white to-amber-100 border border-amber-300 shadow-xs">
        <span class="text-xs sm:text-sm font-bold text-espresso-950">
          🎁 Přesvědčte se sami: Přijďte si s dítětem nezávazně zahrát na první ukázkovou hodinu.
        </span>
        <a
          href="#kontakt"
          class="btn-gold-pulse px-5 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-amber-400 text-espresso-950 border border-amber-500 shadow-xs hover:scale-105 transition-all"
        >
          Objednat 1. lekci zdarma →
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  function initTestimonialsCarousel() {
    const slider = document.getElementById('reviews-slider');
    const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
    if (!slider || !dots.length) return;

    slider.addEventListener('scroll', () => {
      const scrollLeft = slider.scrollLeft;
      const cardWidth = slider.firstElementChild?.clientWidth || 300;
      const activeIdx = Math.min(dots.length - 1, Math.max(0, Math.round(scrollLeft / cardWidth)));

      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.classList.add('bg-amber-500', 'w-5');
          dot.classList.remove('bg-stone-300', 'w-2');
        } else {
          dot.classList.remove('bg-amber-500', 'w-5');
          dot.classList.add('bg-stone-300', 'w-2');
        }
      });
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initTestimonialsCarousel);
  document.addEventListener('astro:page-load', initTestimonialsCarousel);
</script>

