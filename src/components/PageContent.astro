---
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import AudienceSegments from './AudienceSegments.astro';
import ScheduleBlocks from './ScheduleBlocks.astro';
import Pricing from './Pricing.astro';
import ComparisonTable from './ComparisonTable.astro';
import HowGameLessonWorks from './HowGameLessonWorks.astro';
import LessonTimeline from './LessonTimeline.astro';
import About from './About.astro';
import GroupMatcher from './GroupMatcher.astro';
import Testimonials from './Testimonials.astro';
import ScioSection from './ScioSection.astro';
import BlogPreviewSection from './BlogPreviewSection.astro';
import FAQ from './FAQ.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { getSchedulePageData } from '../lib/data';

interface Props {
  page?: any;
  schedule?: any;
}

const { page = {}, schedule: passedSchedule } = Astro.props;
const schedule = passedSchedule || page.schedule || (await getSchedulePageData())?.schedule || {};
const navbar = page.navbar || {};
const hero = page.hero || {};
const audience = page.audience || {};
const about = page.about || {};
const pricing = page.pricing || {};
const comparison = page.comparison || {};
const testimonials = page.testimonials || {};
const howItWorks = page.howItWorks || {};
const timeline = page.timeline || {};
const groupMatcher = page.groupMatcher || {};
const scio = page.scio || {};
const blogPreview = page.blogPreview || {};
const locationInfo = page.location || {};
const faq = page.faq || {};
const contact = page.contact || {};
const footer = page.footer || {};
---

<!-- Header & Main Navigation (Editable via TinaCMS) -->
<Navbar
  navbar={navbar}
  contact={contact}
  phone={contact.phone?.replace('+', '') || '420792372642'}
  phoneFormatted={contact.phoneFormatted || '+420 792 372 642'}
/>

<main id="hlavni-obsah" class="flex-grow w-full max-w-full min-w-0 overflow-x-hidden">
  <!-- 1. Hero: Josef Válek's Melbourne roots, audio preview & clear CTA into free first lesson -->
  <Hero hero={hero} />

  <!-- 2. Target Audience: 3 core groups (ZŠ 1-3 Karak, ZŠ 4-6 Dobrodruzi, ZŠ 7-9 Příprava na SŠ) -->
  {audience.enabled !== false && <AudienceSegments audience={audience} />}

  <!-- 3. Methodology & Games: Why board games work + the 4-phase 60 min lesson blueprint -->
  {howItWorks.enabled !== false && <HowGameLessonWorks howItWorks={howItWorks} />}

  <!-- 4. The 60-Minute Lesson Timeline -->
  {timeline.enabled !== false && <LessonTimeline timeline={timeline} />}

  <!-- 5. The Teacher & Doučovna: Josef Válek's Melbourne roots, 25 years in ČR, 4 pillars + classroom photo gallery -->
  {about.enabled !== false && <About about={about} locationInfo={locationInfo} />}

  <!-- 6. Interactive Group Matcher: 3-step quiz to find ideal group & games for the child -->
  {groupMatcher.enabled !== false && (
    <GroupMatcher
      groupMatcher={groupMatcher}
      phone={contact.phone?.replace('+', '') || '420792372642'}
    />
  )}

  <!-- 7. Weekly Schedule: Animal groups timetable with Smart Group Finder -->
  <ScheduleBlocks schedule={schedule} />

  <!-- 8. Transparency & Value: Svižný ceník + 1st lesson 100% FREE -->
  {pricing.enabled !== false && <Pricing pricing={pricing} />}

  <!-- 9. Comparison: Comparison table vs school & 1-on-1 -->
  {comparison.enabled !== false && <ComparisonTable comparison={comparison} />}

  <!-- 10. Social Proof (Disabled by default, toggleable in CMS) -->
  {testimonials.enabled !== false && <Testimonials testimonials={testimonials} />}

  <!-- 11. SCIO Prep (Disabled by default, toggleable in CMS) -->
  {scio.enabled === true && <ScioSection scio={scio} />}

  <!-- 12. Educational Blog / Rádce pro rodiče -->
  {blogPreview.enabled !== false && <BlogPreviewSection preview={blogPreview} />}

  <!-- 13. Answers & Overcoming Objections: Semantic FAQ Accordion -->
  {faq.enabled !== false && <FAQ faq={faq} />}

  <!-- 14. Primary Conversion: Reservation form & Location Details -->
  {contact.enabled !== false && <Contact contact={contact} locationInfo={locationInfo} />}
</main>

<!-- Footer (Editable via TinaCMS) -->
<Footer
  footer={footer}
  contact={contact}
  email={contact.email}
  phone={contact.phone}
  phoneFormatted={contact.phoneFormatted}
/>

