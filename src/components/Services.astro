---
interface ServiceItem {
  id?: string;
  badge?: string;
  title: string;
  description: string;
  features?: string[];
  ctaText?: string;
  ctaLink?: string;
}

interface Props {
  services: {
    badge?: string;
    title?: string;
    subtitle?: string;
    items?: ServiceItem[];
  };
}

const { services } = Astro.props;

const badge = services.badge || "KURZY & SLUŽBY";
const title = services.title || "Vyberte si formát, který nejlépe odpovídá vašemu cíli";
const subtitle = services.subtitle || "Ať už potřebujete získat novou práci, připravit se na zahraniční cestu, nebo složit certifikát – mám pro vás osvědčený plán.";
const items = services.items || [];
---

<section id="kurzy" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glow-badge text-xs font-semibold uppercase tracking-wider">
        {badge}
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
        {title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        {subtitle}
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {items.map((service, index) => (
        <div class="glass-card glass-card-hover rounded-3xl p-8 sm:p-10 flex flex-col justify-between relative group overflow-hidden border border-slate-700/60">
          
          <!-- Subtle corner highlight -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-brand-500/5 rounded-bl-full group-hover:bg-brand-500/10 transition-colors pointer-events-none"></div>

          <div class="space-y-6">
            <!-- Card Header: Badge & Icon -->
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-brand-500/15 text-brand-400 border border-brand-500/30">
                {service.badge || "Kurz"}
              </span>
              <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700 text-brand-400 flex items-center justify-center font-bold text-lg">
                {index === 0 && "🎯"}
                {index === 1 && "💬"}
                {index === 2 && "💼"}
                {index === 3 && "📜"}
              </div>
            </div>

            <!-- Title & Description -->
            <div>
              <h3 class="font-display font-bold text-2xl text-white group-hover:text-brand-400 transition-colors">
                {service.title}
              </h3>
              <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
                {service.description}
              </p>
            </div>

            <!-- Feature Bullet Points -->
            <div class="pt-2 border-t border-slate-800/80">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Co je obsahem výuky:</div>
              <ul class="space-y-2.5">
                {(service.features || []).map((feat) => (
                  <li class="flex items-start gap-3 text-sm text-slate-300">
                    <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Action CTA -->
          <div class="pt-8 mt-8 border-t border-slate-800/80">
            <a
              href={service.ctaLink || "#kontakt"}
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-display font-semibold text-sm text-slate-200 hover:text-navy-950 bg-slate-800/80 hover:bg-brand-400 border border-slate-700 hover:border-brand-400 transition-all text-center group-hover:shadow-glow-brand"
            >
              <span>{service.ctaText || "Chci tento kurz"}</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Extra Banner: Free Diagnostic call -->
    <div class="mt-16 glass-card rounded-2xl p-6 sm:p-8 border border-brand-500/20 bg-gradient-to-r from-navy-900/90 via-navy-850 to-slate-900 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="font-display font-bold text-lg text-white">Nevíte jistě, který kurz nebo formát zvolit?</h4>
        <p class="text-sm text-slate-400">Při bezplatné 20minutové konzultaci otestujeme vaši úroveň a doporučím vám nejrychlejší cestu.</p>
      </div>
      <a href="#kontakt" class="flex-shrink-0 px-6 py-3 rounded-xl font-semibold text-sm text-navy-950 bg-brand-400 hover:bg-brand-300 shadow-glow-brand transition-all">
        Poradit se zdarma
      </a>
    </div>

  </div>
</section>
