      icon: "🏆",
      title: "Cíl: Doučovna Uherské Hradiště",
      location: "Růžová 1238, Uherské Hradiště",
      badge: "Zlatý certifikát",
      question: "Když se v hodině udělá chyba a Josef s úsměvem řekne „No worries!“, znamená to:",
      options: [
        { text: "To je chyba, dostaneš pětku!", isCorrect: false },
        { text: "Žádný problém, to je v pohodě!", isCorrect: true },
        { text: "Rychle otevři učebnici na straně 40!", isCorrect: false }
      ],
      explanation: "Jasně! „No worries!“ znamená Žádný problém. U nás se za chyby netrestá – učíme se praxí, deskovkami a smíchem.",
      funFact: "✨ Pozitivní atmosféra je důvod, proč se děti na doučování v Uherském Hradišti těší."
    }
  ];

  const diceDotsMap: Record<number, number[]> = {
    1: [4],
    2: [0, 8],
    3: [0, 4, 8],
    4: [0, 2, 6, 8],
    5: [0, 2, 4, 6, 8],
    6: [0, 2, 3, 5, 6, 8]
  };

  const diceBtn = document.getElementById('quest-dice-btn');
  const rollBtn = document.getElementById('quest-roll-btn');
  const nextStepBtn = document.getElementById('q-next-step-btn');
  const dotsContainer = document.getElementById('quest-dice-dots');
  const btnLabel = document.getElementById('quest-btn-label');
  const statusHint = document.getElementById('quest-status-hint');
  const scoreCounter = document.getElementById('quest-score-count');

  const cardIcon = document.getElementById('q-card-icon');
  const cardTitle = document.getElementById('q-card-title');
  const cardLocation = document.getElementById('q-card-location');
  const cardBadge = document.getElementById('q-card-badge');
  const cardStepNum = document.getElementById('q-card-step-num');
  const cardQuestion = document.getElementById('q-card-question');
  const optionsContainer = document.getElementById('q-options-container');

  const feedbackBox = document.getElementById('q-feedback-box');
  const feedbackTitle = document.getElementById('q-feedback-title');
  const feedbackText = document.getElementById('q-feedback-text');
  const feedbackFact = document.getElementById('q-feedback-fact');
  const actionFooter = document.getElementById('q-action-footer');
  const goldenVoucher = document.getElementById('golden-voucher-box');
  const canvas = document.getElementById('quest-confetti-canvas') as HTMLCanvasElement | null;

  const stepNodes = document.querySelectorAll<HTMLButtonElement>('.quest-step-node');

  let currentStep = 1;
  let isRolling = false;
  let solvedSteps = new Set<number>();
  let audioContext: AudioContext | null = null;

  // Synthesize realistic wooden dice rolling rattle using Web Audio API
  function playDiceSound() {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      audioContext = audioContext || new AudioCtx();
      if (audioContext.state === 'suspended') audioContext.resume();

      // Series of 4 quick rattle clicks
      for (let i = 0; i < 4; i++) {
        const time = audioContext.currentTime + i * 0.08;
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(320 + Math.random() * 200, time);

        gain.gain.setValueAtTime(0.08, time);
        gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);

        osc.connect(gain);
        gain.connect(audioContext.destination);

        osc.start(time);
        osc.stop(time + 0.06);
      }
    } catch (e) {}
  }

  // Synthesize pleasant victory fanfare on correct answer
  function playSuccessSound() {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      audioContext = audioContext || new AudioCtx();
      if (audioContext.state === 'suspended') audioContext.resume();

      const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
      notes.forEach((freq, idx) => {
        if (!audioContext) return;
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioContext.currentTime + idx * 0.09);

        gain.gain.setValueAtTime(0.001, audioContext.currentTime + idx * 0.09);
        gain.gain.exponentialRampToValueAtTime(0.1, audioContext.currentTime + idx * 0.09 + 0.03);
        gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + idx * 0.09 + 0.5);

        osc.connect(gain);
        gain.connect(audioContext.destination);

        osc.start(audioContext.currentTime + idx * 0.09);
        osc.stop(audioContext.currentTime + idx * 0.09 + 0.55);
      });
    } catch (e) {}
  }

  function renderDiceDots(num: number) {
    if (!dotsContainer) return;
    const activeIndices = diceDotsMap[num] || [4];
    let html = '<div class="grid grid-cols-3 grid-rows-3 w-12 h-12 gap-1.5 p-1 items-center justify-items-center">';
    for (let i = 0; i < 9; i++) {
      if (activeIndices.includes(i)) {
        html += '<div class="w-3.5 h-3.5 rounded-full bg-espresso-950 shadow-inner"></div>';
      } else {
        html += '<div></div>';
      }
    }
    html += '</div>';
    dotsContainer.innerHTML = html;
  }

  function setActiveTrackNode(stepNum: number) {
    stepNodes.forEach((node) => {
      const nodeStep = Number(node.getAttribute('data-step'));
      const pawn = node.querySelector('.pawn-indicator');

      if (nodeStep === stepNum) {
        node.classList.remove('bg-parchment-50/70', 'border-parchment-300');
        node.classList.add('bg-amber-100/90', 'border-amber-500', 'shadow-md', 'ring-2', 'ring-amber-400/50', 'quest-node-active');
        pawn?.classList.remove('hidden');
      } else {
        node.classList.remove('bg-amber-100/90', 'border-amber-500', 'shadow-md', 'ring-2', 'ring-amber-400/50', 'quest-node-active');
        node.classList.add('bg-parchment-50/70', 'border-parchment-300');
        pawn?.classList.add('hidden');
      }

      const check = node.querySelector('.step-check');
      if (solvedSteps.has(nodeStep)) {
        check?.classList.remove('hidden');
      }
    });
  }

  function displayStep(stepNum: number) {
    currentStep = stepNum;
    const data = stepsData[stepNum - 1];
    if (!data) return;

    setActiveTrackNode(stepNum);

    if (cardIcon) cardIcon.textContent = data.icon;
    if (cardTitle) cardTitle.textContent = data.title;
    if (cardLocation) cardLocation.textContent = data.location;
    if (cardBadge) cardBadge.textContent = data.badge;
    if (cardStepNum) cardStepNum.textContent = `#${data.step}`;
    if (cardQuestion) cardQuestion.textContent = data.question;

    if (feedbackBox) feedbackBox.classList.add('hidden');
    if (actionFooter) actionFooter.classList.add('hidden');

    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      data.options.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'q-opt-btn p-3.5 rounded-xl border border-parchment-300 bg-parchment-50/80 hover:bg-amber-100/70 hover:border-amber-400 text-xs font-bold text-espresso-900 text-left transition-all duration-200 flex items-center justify-between gap-2 cursor-pointer shadow-2xs group';
        btn.innerHTML = `
          <span>${opt.text}</span>
          <span class="q-opt-arrow text-stone-400 text-xs group-hover:text-amber-800 font-mono">→</span>
        `;
        btn.addEventListener('click', () => handleOptionChoice(opt.isCorrect, btn, data));
        optionsContainer.appendChild(btn);
      });
    }
  }

  function handleOptionChoice(isCorrect: boolean, clickedBtn: HTMLButtonElement, data: any) {
    const allBtns = optionsContainer?.querySelectorAll<HTMLButtonElement>('.q-opt-btn');

    if (isCorrect) {
      allBtns?.forEach(b => {
        b.disabled = true;
        b.classList.remove('hover:bg-amber-100/70', 'cursor-pointer');
      });

      clickedBtn.classList.remove('bg-parchment-50/80', 'border-parchment-300');
      clickedBtn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-950', 'ring-2', 'ring-emerald-400');
      
      const arrow = clickedBtn.querySelector('.q-opt-arrow');
      if (arrow) arrow.innerHTML = '✓';

      playSuccessSound();

      if (feedbackBox && feedbackTitle && feedbackText && feedbackFact) {
        feedbackBox.className = 'p-4 rounded-xl border bg-emerald-50/95 border-emerald-300 text-xs space-y-1 mt-2';
        feedbackTitle.innerHTML = '<span class="text-base text-emerald-700">🎉</span> <span class="text-emerald-950 font-black">Výborně! Správná odpověď</span>';
        feedbackText.innerHTML = `<strong>${data.explanation}</strong>`;
        feedbackFact.textContent = data.funFact;
        feedbackBox.classList.remove('hidden');
      }

      if (actionFooter) {
        actionFooter.classList.remove('hidden');
      }

      // Mark step solved
      solvedSteps.add(data.step);
      if (scoreCounter) scoreCounter.textContent = solvedSteps.size.toString();

      // Show checkmark on node
      const currentNode = document.querySelector(`.quest-step-node[data-step="${data.step}"]`);
      const check = currentNode?.querySelector('.step-check');
      check?.classList.remove('hidden');

      // Trigger Confetti
      triggerConfetti();

      // If at least 3 or all 6 solved, reveal Golden Voucher banner!
      if (solvedSteps.size >= 3 && goldenVoucher) {
        goldenVoucher.classList.remove('hidden');
      }

    } else {
      clickedBtn.classList.remove('bg-parchment-50/80', 'border-parchment-300');
      clickedBtn.classList.add('bg-rose-50', 'border-rose-400', 'text-rose-900');
      const arrow = clickedBtn.querySelector('.q-opt-arrow');
      if (arrow) arrow.innerHTML = '✕';

      if (feedbackBox && feedbackTitle && feedbackText && feedbackFact) {
        feedbackBox.className = 'p-4 rounded-xl border bg-amber-50/90 border-amber-300 text-xs space-y-1 mt-2';
        feedbackTitle.innerHTML = '<span class="text-base text-amber-700">💡</span> <span class="text-amber-950 font-black">Nevadí! Žádný strach, zkus to znovu.</span>';
        feedbackText.textContent = 'V doučovně Josefa žádné špatné známky neexistují – učíme se praxí a smíchem.';
        feedbackFact.textContent = '';
        feedbackBox.classList.remove('hidden');
      }
    }
  }

  function rollDice() {
    if (isRolling) return;
    isRolling = true;

    playDiceSound();
    diceBtn?.classList.add('dice-rolling-active');
    if (btnLabel) btnLabel.textContent = 'Kostka se točí...';
    if (statusHint) statusHint.textContent = 'Hledáme stanoviště...';

    // Rapid numbers animation
    let rollInterval = setInterval(() => {
      const rand = Math.floor(Math.random() * 6) + 1;
      renderDiceDots(rand);
    }, 70);

    setTimeout(() => {
      clearInterval(rollInterval);
      diceBtn?.classList.remove('dice-rolling-active');
      isRolling = false;

      // Select next step logically: either unsolved or next in order
      let nextStepNum = (currentStep % 6) + 1;
      const unsolved = stepsData.filter(s => !solvedSteps.has(s.step));
      if (unsolved.length > 0) {
        nextStepNum = unsolved[0].step;
      }

      renderDiceDots(nextStepNum);
      displayStep(nextStepNum);

      if (btnLabel) btnLabel.textContent = `🎲 Hodit znovu (#${nextStepNum})`;
      if (statusHint) statusHint.textContent = `Posun na: ${stepsData[nextStepNum - 1].title}`;
    }, 550);
  }

  // Click on any track node to jump directly
  stepNodes.forEach((node) => {
    node.addEventListener('click', () => {
      const step = Number(node.getAttribute('data-step'));
      if (step && step >= 1 && step <= 6) {
        renderDiceDots(step);
        displayStep(step);
      }
    });
  });

  // Confetti Animation
  function triggerConfetti() {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    canvas.width = canvas.parentElement?.clientWidth || 600;
    canvas.height = canvas.parentElement?.clientHeight || 400;

    const particles: any[] = [];
    const colors = ['#F59E0B', '#10B981', '#3B82F6', '#EF4444', '#8B5CF6', '#FBBF24'];

    for (let i = 0; i < 40; i++) {
      particles.push({
        x: canvas.width / 2,
        y: canvas.height / 2,
        r: Math.random() * 5 + 3,
        color: colors[Math.floor(Math.random() * colors.length)],
        vx: (Math.random() - 0.5) * 12,
        vy: (Math.random() - 0.7) * 11,
        alpha: 1
      });
    }

    let startTime = performance.now();
    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const elapsed = performance.now() - startTime;
      let hasAlive = false;

      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.24;
        p.alpha -= 0.015;

        if (p.alpha > 0) {
          hasAlive = true;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = Math.max(0, p.alpha);
          ctx.fill();
        }
      });

      if (hasAlive && elapsed < 2200) {
        requestAnimationFrame(draw);
      } else {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }
    draw();
  }

  // Event Listeners
  diceBtn?.addEventListener('click', rollDice);
  rollBtn?.addEventListener('click', rollDice);
  nextStepBtn?.addEventListener('click', rollDice);

  // Initialize
  renderDiceDots(1);
  displayStep(1);
</script>
